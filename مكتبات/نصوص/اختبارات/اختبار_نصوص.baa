#تضمين "baalib.baahd"
#تضمين "باء_نصوص.baahd"

صحيح فاشلة = ٠.

عدم تحقق(منطقي شرط، نص وصف) {
    إذا (!شرط) {
        اطبع_منسق("[فشل] %ن\س"، وصف).
        فاشلة = فاشلة + ١.
    }
}

عدم تحقق_نص(نص فعلي، نص متوقع، نص وصف) {
    منطقي سليم = فعلي != عدم && قارن_نص(فعلي، متوقع) == ٠.
    إذا (!سليم) {
        اطبع_منسق("[فشل] %ن\س"، وصف).
        فاشلة = فاشلة + ١.
    }
    إذا (فعلي != عدم) { حرر_نص(فعلي). }
}

صحيح الرئيسية() {
    تحقق(نص_يبدأ_ب("مرحبا بالعالم"، "مرحبا")، "يبدأ ب").
    تحقق(!نص_يبدأ_ب("مر"، "مرحبا")، "البادئة الأطول").
    تحقق(نص_يبدأ_ب("أ"، "")، "البادئة الفارغة").
    تحقق(نص_ينتهي_ب("مرحبا بالعالم"، "العالم")، "ينتهي ب").
    تحقق(!نص_ينتهي_ب("العالم"، "بالعالم")، "اللاحقة الأطول").
    تحقق(موضع_في_نص("أبجد أبجد"، "جد"، ٠) == ٢، "الموضع الأول").
    تحقق(موضع_في_نص("أبجد أبجد"، "جد"، ٣) == ٧، "الموضع من فهرس").
    تحقق(موضع_في_نص("أبجد"، "هوز"، ٠) == -١، "غير موجود").
    تحقق(نص_يحتوي("كتاب باء"، "باء")، "يحتوي").
    تحقق(عدد_في_نص("ااااا"، "اا") == ٢، "العد دون تداخل").
    تحقق(عدد_في_نص("أبجد"، "") == ٠، "عد الفارغ").

    تحقق_نص(مقطع_نص("أبجد هوز"، ٥، ٨)، "هوز"، "المقطع").
    تحقق_نص(مقطع_نص("أبجد"، -٣، ٩٩)، "أبجد"، "قص الحدود").
    تحقق_نص(مقطع_نص("أبجد"، ٣، ١)، ""، "الحدود المعكوسة").
    تحقق_نص(قص_نص("  \تباء\س ")، "باء"، "القص").
    تحقق_نص(قص_نص("   ")، ""، "قص الفراغ").
    تحقق_نص(استبدل_في_نص("أ-ب-ج"، "-"، "، ")، "أ، ب، ج"، "الاستبدال").
    تحقق_نص(استبدل_في_نص("أبجد"، ""، "س")، "أبجد"، "استبدال الفارغ").
    تحقق_نص(كرر_نص("با"، ٣)، "بابابا"، "التكرار").
    تحقق_نص(كرر_نص("با"، -١)، ""، "تكرار سالب").

    متجه أجزاء = قسم_نص("أ،،ب"، "،").
    تحقق(عدد_أجزاء_نص(أجزاء) == ٣، "عدد الأجزاء").
    تحقق(قارن_نص(جزء_نص(أجزاء، ٠)، "أ") == ٠، "الجزء الأول").
    تحقق(قارن_نص(جزء_نص(أجزاء، ١)، "") == ٠، "الجزء الفارغ").
    تحقق(قارن_نص(جزء_نص(أجزاء، ٢)، "ب") == ٠، "الجزء الأخير").
    تحقق(جزء_نص(أجزاء، ٣) == عدم، "فهرس خارج الحد").
    تحقق_نص(اجمع_نصوص(أجزاء، "+")، "أ++ب"، "الضم").
    حرر_أجزاء_نص(أجزاء).
    متجه كامل = قسم_نص("أبجد"، "").
    تحقق(عدد_أجزاء_نص(كامل) == ١، "قسم بفاصل فارغ").
    حرر_أجزاء_نص(كامل).

    صحيح عدد = ٠.
    تحقق(نص_إلى_صحيح("١٢٣"، &عدد) && عدد == ١٢٣، "أرقام عربية").
    تحقق(نص_إلى_صحيح("-45"، &عدد) && عدد == -٤٥، "أرقام لاتينية سالبة").
    تحقق(نص_إلى_صحيح("9223372036854775807"، &عدد)، "أكبر قيمة").
    تحقق(نص_إلى_صحيح("-9223372036854775808"، &عدد)، "أصغر قيمة").
    تحقق(!نص_إلى_صحيح("9223372036854775808"، &عدد)، "الفائض").
    تحقق(!نص_إلى_صحيح("١٢س"، &عدد)، "محرف غير رقمي").
    تحقق(!نص_إلى_صحيح("-"، &عدد)، "إشارة وحدها").
    تحقق(!نص_إلى_صحيح(""، &عدد)، "نص فارغ").

    إذا (فاشلة > ٠) {
        اطبع_منسق("فشل %ص\س"، فاشلة).
        إرجع ١.
    }
    اطبع "اختبارات باء/نصوص سليمة".
    إرجع ٠.
}
