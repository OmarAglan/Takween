#تضمين "baalib.baahd"
#تضمين "باء_نصوص.baahd"

نص نسق(نص تنسيق_ثابت، ...).

منطقي يطابق_عند(نص قيمة، نص جزء، صحيح موضع) {
    صحيح طول_جزء = طول_نص(جزء).
    إذا (موضع < ٠ || موضع + طول_جزء > طول_نص(قيمة)) { إرجع خطأ. }
    صحيح م = ٠.
    طالما (م < طول_جزء) {
        إذا (قيمة[موضع + م] != جزء[م]) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

// يضيف المحارف [بداية، نهاية) إلى الباني.
منطقي أضف_مقطعا_للباني(باني_نص باني، نص قيمة، صحيح بداية، صحيح نهاية) {
    صحيح م = بداية.
    طالما (م < نهاية) {
        نص محرف = نسق("%ح"، قيمة[م]).
        إذا (محرف == عدم) { إرجع خطأ. }
        منطقي تم = أضف_نص_للباني(باني، محرف).
        حرر_نص(محرف).
        إذا (!تم) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

نص أنه_الباني(باني_نص باني، منطقي صالح) {
    نص ناتج = عدم.
    إذا (صالح) { ناتج = نص_الباني(باني). }
    حرر_باني_نص(باني).
    إرجع ناتج.
}

منطقي نص_يبدأ_ب(نص قيمة، نص بادئة) {
    إرجع يطابق_عند(قيمة، بادئة، ٠).
}

منطقي نص_ينتهي_ب(نص قيمة، نص لاحقة) {
    إرجع يطابق_عند(قيمة، لاحقة، طول_نص(قيمة) - طول_نص(لاحقة)).
}

صحيح موضع_في_نص(نص قيمة، نص جزء، صحيح من) {
    صحيح م = من.
    إذا (م < ٠) { م = ٠. }
    صحيح أخير = طول_نص(قيمة) - طول_نص(جزء).
    طالما (م <= أخير) {
        إذا (يطابق_عند(قيمة، جزء، م)) { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

منطقي نص_يحتوي(نص قيمة، نص جزء) {
    إرجع موضع_في_نص(قيمة، جزء، ٠) >= ٠.
}

صحيح عدد_في_نص(نص قيمة، نص جزء) {
    صحيح طول_جزء = طول_نص(جزء).
    إذا (طول_جزء == ٠) { إرجع ٠. }
    صحيح عدد = ٠.
    صحيح م = موضع_في_نص(قيمة، جزء، ٠).
    طالما (م >= ٠) {
        عدد = عدد + ١.
        م = موضع_في_نص(قيمة، جزء، م + طول_جزء).
    }
    إرجع عدد.
}

نص مقطع_نص(نص قيمة، صحيح بداية، صحيح نهاية) {
    صحيح طول = طول_نص(قيمة).
    إذا (بداية < ٠) { بداية = ٠. }
    إذا (نهاية > طول) { نهاية = طول. }
    إذا (نهاية < بداية) { نهاية = بداية. }
    باني_نص باني = أنشئ_باني_نص().
    إذا (باني == عدم) { إرجع عدم. }
    إرجع أنه_الباني(باني، أضف_مقطعا_للباني(باني، قيمة، بداية، نهاية)).
}

منطقي محرف_فراغ(حرف ح) {
    إرجع ح == ' ' || ح == '\ت' || ح == '\س' || ح == '\ر'.
}

نص قص_نص(نص قيمة) {
    صحيح بداية = ٠.
    صحيح نهاية = طول_نص(قيمة).
    طالما (بداية < نهاية && محرف_فراغ(قيمة[بداية])) { بداية = بداية + ١. }
    طالما (نهاية > بداية && محرف_فراغ(قيمة[نهاية - ١])) { نهاية = نهاية - ١. }
    إرجع مقطع_نص(قيمة، بداية، نهاية).
}

نص استبدل_في_نص(نص قيمة، نص قديم، نص جديد) {
    صحيح طول_قديم = طول_نص(قديم).
    إذا (طول_قديم == ٠) { إرجع نسخ_نص(قيمة). }
    باني_نص باني = أنشئ_باني_نص().
    إذا (باني == عدم) { إرجع عدم. }
    منطقي صالح = صواب.
    صحيح سابق = ٠.
    صحيح م = موضع_في_نص(قيمة، قديم، ٠).
    طالما (صالح && م >= ٠) {
        صالح = أضف_مقطعا_للباني(باني، قيمة، سابق، م).
        إذا (صالح) { صالح = أضف_نص_للباني(باني، جديد). }
        سابق = م + طول_قديم.
        م = موضع_في_نص(قيمة، قديم، سابق).
    }
    إذا (صالح) { صالح = أضف_مقطعا_للباني(باني، قيمة، سابق، طول_نص(قيمة)). }
    إرجع أنه_الباني(باني، صالح).
}

نص كرر_نص(نص قيمة، صحيح مرات) {
    باني_نص باني = أنشئ_باني_نص().
    إذا (باني == عدم) { إرجع عدم. }
    منطقي صالح = صواب.
    صحيح م = ٠.
    طالما (صالح && م < مرات) {
        صالح = أضف_نص_للباني(باني، قيمة).
        م = م + ١.
    }
    إرجع أنه_الباني(باني، صالح).
}

عدم حرر_أجزاء_نص(متجه أجزاء) {
    إذا (أجزاء == عدم) { إرجع. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(أجزاء)).
    صحيح م = ٠.
    طالما (م < طول_متجه(أجزاء)) {
        حرر_نص(*(بيانات + م)).
        م = م + ١.
    }
    حرر_متجه(أجزاء).
}

منطقي ادفع_جزءا(متجه أجزاء، نص جزء) {
    إذا (جزء == عدم) { إرجع خطأ. }
    إذا (!ادفع_متجه(أجزاء، &جزء)) { حرر_نص(جزء). إرجع خطأ. }
    إرجع صواب.
}

متجه قسم_نص(نص قيمة، نص فاصل) {
    متجه أجزاء = أنشئ_متجه(حجم(نص)).
    إذا (أجزاء == عدم) { إرجع عدم. }
    صحيح طول_فاصل = طول_نص(فاصل).
    منطقي صالح = صواب.
    صحيح سابق = ٠.
    إذا (طول_فاصل > ٠) {
        صحيح م = موضع_في_نص(قيمة، فاصل، ٠).
        طالما (صالح && م >= ٠) {
            صالح = ادفع_جزءا(أجزاء، مقطع_نص(قيمة، سابق، م)).
            سابق = م + طول_فاصل.
            م = موضع_في_نص(قيمة، فاصل، سابق).
        }
    }
    إذا (صالح) { صالح = ادفع_جزءا(أجزاء، مقطع_نص(قيمة، سابق، طول_نص(قيمة))). }
    إذا (!صالح) { حرر_أجزاء_نص(أجزاء). إرجع عدم. }
    إرجع أجزاء.
}

صحيح عدد_أجزاء_نص(متجه أجزاء) {
    إذا (أجزاء == عدم) { إرجع ٠. }
    إرجع طول_متجه(أجزاء).
}

نص جزء_نص(متجه أجزاء، صحيح فهرس) {
    إذا (فهرس < ٠ || فهرس >= عدد_أجزاء_نص(أجزاء)) { إرجع عدم. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(أجزاء)).
    إرجع *(بيانات + فهرس).
}

نص اجمع_نصوص(متجه أجزاء، نص فاصل) {
    باني_نص باني = أنشئ_باني_نص().
    إذا (باني == عدم) { إرجع عدم. }
    منطقي صالح = صواب.
    صحيح م = ٠.
    طالما (صالح && م < عدد_أجزاء_نص(أجزاء)) {
        إذا (م > ٠) { صالح = أضف_نص_للباني(باني، فاصل). }
        إذا (صالح) { صالح = أضف_نص_للباني(باني، جزء_نص(أجزاء، م)). }
        م = م + ١.
    }
    إرجع أنه_الباني(باني، صالح).
}

صحيح قيمة_رقم(حرف ح) {
    إذا (ح >= '0' && ح <= '9') { إرجع كـ<صحيح>(ح) - كـ<صحيح>('0'). }
    إذا (ح >= '٠' && ح <= '٩') { إرجع كـ<صحيح>(ح) - كـ<صحيح>('٠'). }
    إرجع -١.
}

منطقي نص_إلى_صحيح(نص قيمة، صحيح* ناتج) {
    صحيح طول = طول_نص(قيمة).
    صحيح م = ٠.
    منطقي سالب = خطأ.
    إذا (طول > ٠ && (قيمة[٠] == '-' || قيمة[٠] == '+')) {
        سالب = قيمة[٠] == '-'.
        م = ١.
    }
    إذا (م == طول) { إرجع خطأ. }
    // يجمع بالسالب كي يتسع لأصغر قيمة صحيحة.
    صحيح حد = -9223372036854775807 - ١.
    صحيح مجموع = ٠.
    طالما (م < طول) {
        صحيح رقم = قيمة_رقم(قيمة[م]).
        إذا (رقم < ٠) { إرجع خطأ. }
        إذا (مجموع < (حد + رقم) / ١٠) { إرجع خطأ. }
        مجموع = مجموع * ١٠ - رقم.
        م = م + ١.
    }
    إذا (!سالب) {
        إذا (مجموع == حد) { إرجع خطأ. }
        مجموع = -مجموع.
    }
    *ناتج = مجموع.
    إرجع صواب.
}
