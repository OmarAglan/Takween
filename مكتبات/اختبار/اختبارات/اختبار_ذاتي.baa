#تضمين "baalib.baahd"
#تضمين "باء_اختبار.baahd"

صحيح الرئيسية() {
    ابدأ_مجموعة("التحققات الناجحة").
    تحقق_أن(صواب، "شرط صائب").
    تحقق_يساوي_صحيح(٢ + ٢، ٤، "الجمع").
    تحقق_يساوي_نص("باء"، "باء"، "نصان متساويان").
    تحقق_يساوي_نص(عدم، عدم، "عدمان متساويان").
    إذا (عدد_الناجحة() != ٤ || عدد_الفاشلة() != ٠) { إرجع ٢. }

    ابدأ_مجموعة("التحققات الفاشلة المقصودة").
    تحقق_أن(خطأ، "شرط خاطئ").
    تحقق_يساوي_صحيح(٣، ٤، "عددان مختلفان").
    تحقق_يساوي_نص("أ"، عدم، "نص وعدم").
    إذا (عدد_الناجحة() != ٤ || عدد_الفاشلة() != ٣) { إرجع ٣. }
    إذا (أنه_الاختبارات() != ١) { إرجع ٤. }
    اطبع "الاختبار الذاتي سليم".
    إرجع ٠.
}
