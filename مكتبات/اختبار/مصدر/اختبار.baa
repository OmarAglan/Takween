#تضمين "baalib.baahd"
#تضمين "باء_اختبار.baahd"

صحيح ناجحة_اختبار = ٠.
صحيح فاشلة_اختبار = ٠.
نص مجموعة_اختبار = "".

عدم ابدأ_مجموعة(نص اسم) {
    مجموعة_اختبار = اسم.
}

عدم سجل_فشل(نص وصف) {
    فاشلة_اختبار = فاشلة_اختبار + ١.
    إذا (طول_نص(مجموعة_اختبار) > ٠) {
        اطبع_منسق("[فشل] %ن: %ن\س"، مجموعة_اختبار، وصف).
    }
    وإلا { اطبع_منسق("[فشل] %ن\س"، وصف). }
}

عدم تحقق_أن(منطقي شرط، نص وصف) {
    إذا (شرط) { ناجحة_اختبار = ناجحة_اختبار + ١. }
    وإلا { سجل_فشل(وصف). }
}

عدم تحقق_يساوي_صحيح(صحيح فعلي، صحيح متوقع، نص وصف) {
    إذا (فعلي == متوقع) { ناجحة_اختبار = ناجحة_اختبار + ١. إرجع. }
    سجل_فشل(وصف).
    اطبع_منسق("       المتوقع %ص، الفعلي %ص\س"، متوقع، فعلي).
}

عدم تحقق_يساوي_نص(نص فعلي، نص متوقع، نص وصف) {
    منطقي متساويان = فعلي == عدم && متوقع == عدم.
    إذا (فعلي != عدم && متوقع != عدم) { متساويان = قارن_نص(فعلي، متوقع) == ٠. }
    إذا (متساويان) { ناجحة_اختبار = ناجحة_اختبار + ١. إرجع. }
    سجل_فشل(وصف).
    نص عرض_متوقع = متوقع.
    نص عرض_فعلي = فعلي.
    إذا (عرض_متوقع == عدم) { عرض_متوقع = "(عدم)". }
    إذا (عرض_فعلي == عدم) { عرض_فعلي = "(عدم)". }
    اطبع_منسق("       المتوقع \"%ن\"، الفعلي \"%ن\"\س"، عرض_متوقع، عرض_فعلي).
}

صحيح عدد_الناجحة() {
    إرجع ناجحة_اختبار.
}

صحيح عدد_الفاشلة() {
    إرجع فاشلة_اختبار.
}

صحيح أنه_الاختبارات() {
    صحيح كل = ناجحة_اختبار + فاشلة_اختبار.
    إذا (فاشلة_اختبار == ٠) {
        اطبع_منسق("نجح %ص من %ص\س"، ناجحة_اختبار، كل).
        إرجع ٠.
    }
    اطبع_منسق("فشل %ص من %ص\س"، فاشلة_اختبار، كل).
    إرجع ١.
}
