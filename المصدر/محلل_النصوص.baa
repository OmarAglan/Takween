            صالح = خطأ.
            حرر_نص(سطر).
            استمر.
        }
        نص خام_مفتاح = نسخ_مقطع(سطر، ٠، موضع).
        نص مفتاح = قص_طرفين(خام_مفتاح).
        حرر_نص(خام_مفتاح).
        نص خام_قيمة = نسخ_مقطع(سطر، موضع + ١، طول_نص(سطر)).

        إذا (قارن_نص(قسم، "المشروع") == ٠) {
            إذا (قارن_نص(مفتاح، "الاسم") == ٠) {
                نص قيمة = حلل_نص_في1(خام_قيمة).
                إذا (قيمة == عدم || اسم_موجود) { صالح = خطأ. إذا (قيمة != عدم) { حرر_نص(قيمة). } }
                وإلا { نموذج_اسم = قيمة. اسم_موجود = صواب. }
            }
            وإلا إذا (قارن_نص(مفتاح، "الإصدار") == ٠) {
                نص قيمة = حلل_نص_في1(خام_قيمة).
                إذا (قيمة == عدم || اصدار_موجود) { صالح = خطأ. إذا (قيمة != عدم) { حرر_نص(قيمة). } }
                وإلا { نموذج_اصدار = قيمة. اصدار_موجود = صواب. }
