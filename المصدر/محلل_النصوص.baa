                إذا (اسم == عدم || يحتوي_على(اسم، ".")) {
                    اطبع_منسق("[خطأ] اسم اعتمادية غير صالح في السطر %ص.\س"، رقم_السطر).
                    صالح = خطأ.
                }
                وإلا { داخل_اعتمادية = صواب. }
