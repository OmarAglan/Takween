        إذا (سطر == عدم || طول_نص(سطر) == ٠) {
            إذا (سطر != عدم) { حرر_نص(سطر). }
            استمر.
        }

        إذا (سطر[٠] == '[') {
            إذا (داخل_اعتمادية && !اعتمادية_لها_حقل) {
                اطبع_منسق("[خطأ] قسم اعتمادية بلا مصدر في السطر %ص.\س"، رقم_السطر).
                صالح = خطأ.
            }
            داخل_اعتمادية = خطأ.
            هدف_نشط = خطأ.
            إذا (هدف_حالي != عدم) { حرر_نص(هدف_حالي). هدف_حالي = عدم. }
            اعتمادية_لها_حقل = خطأ.
            مسار_اعتمادية = خطأ.
            اصدار_اعتمادية = خطأ.

            إذا (طول_نص(سطر) < ٣ || سطر[طول_نص(سطر) - ١] != ']') {
