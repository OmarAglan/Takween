    صحيح رقم_السطر = ٠.

    طالما (صواب) {
        نص سطر_خام = اقرأ_سطر(ملف).
        إذا (سطر_خام == عدم) { توقف. }
        رقم_السطر = رقم_السطر + ١.
        إذا (رقم_السطر == ١ && طول_نص(سطر_خام) > ٠ && كـ<صحيح>(سطر_خام[٠]) == 65279) {
            نص بلا_تمهيد = نسخ_مقطع(سطر_خام، ١، طول_نص(سطر_خام)).
