                        اسم_هدف_موجود = نموذج_اسم_هدف != عدم.
                        إذا (!اسم_هدف_موجود) { صالح = خطأ. }
                    }
                }
                إذا (اسم != عدم) { حرر_نص(اسم). }
            }
            وإلا إذا (يبدأ_ب(قسم، "الأنماط.")) {
