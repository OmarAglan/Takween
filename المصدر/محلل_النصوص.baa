#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

// builtin formatted string helper (returns heap string)
نص نسق(نص تنسيق_ثابت، ...).

// -------------------------
// نموذج التكوين (Config Model)
// -------------------------
نص نموذج_اسم = "".
نص نموذج_اصدار = "".
نص نموذج_نوع = "".
نص نموذج_مصدر = "".
نص نموذج_مخرج = "".
نص نموذج_ملفات = "".
صحيح نموذج_تحسين = ١.
نص نموذج_اعلام = "".
نص نموذج_كتب = "".
نص نموذج_تضمينات = "".
نص نموذج_هدف_باء = "".
نص نموذج_اسم_هدف = "".
نص نموذج_طلب_هدف = "".
متجه نموذج_اعتماديات.
منطقي نموذج_بيان_في1 = خطأ.
منطقي نموذج_تحقق = خطأ.

منطقي اسم_موجود = خطأ.
منطقي اصدار_موجود = خطأ.
منطقي نوع_موجود = خطأ.
منطقي مصدر_موجود = خطأ.
منطقي مخرج_موجود = خطأ.
منطقي ملفات_موجود = خطأ.
منطقي اعلام_موجود = خطأ.
منطقي كتب_موجود = خطأ.
منطقي تضمينات_موجود = خطأ.
منطقي هدف_باء_موجود = خطأ.
منطقي اسم_هدف_موجود = خطأ.
منطقي طلب_هدف_موجود = خطأ.

عدم حرر_قائمة_نصوص(متجه قائمة) {
    إذا (قائمة == عدم) { إرجع. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(قائمة)).
    صحيح م = ٠.
    طالما (م < طول_متجه(قائمة)) {
        نص قيمة = *(بيانات + م).
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
        م = م + ١.
    }
    حرر_متجه(قائمة).
}

عدم مسح_نموذج_تكوين() {
    إذا (اسم_موجود) {
        حرر_نص(نموذج_اسم).
    }
    إذا (اصدار_موجود) {
        حرر_نص(نموذج_اصدار).
    }
    إذا (نوع_موجود) {
        حرر_نص(نموذج_نوع).
    }
    إذا (مصدر_موجود) {
        حرر_نص(نموذج_مصدر).
    }
    إذا (مخرج_موجود) {
        حرر_نص(نموذج_مخرج).
    }
    إذا (ملفات_موجود) {
        حرر_نص(نموذج_ملفات).
    }
    إذا (اعلام_موجود) {
        حرر_نص(نموذج_اعلام).
    }
    إذا (كتب_موجود) {
        حرر_نص(نموذج_كتب).
    }
    إذا (تضمينات_موجود) {
        حرر_نص(نموذج_تضمينات).
    }
    إذا (هدف_باء_موجود) {
        حرر_نص(نموذج_هدف_باء).
    }
    إذا (اسم_هدف_موجود) {
        حرر_نص(نموذج_اسم_هدف).
    }
    حرر_قائمة_نصوص(نموذج_اعتماديات).

    نموذج_اسم = "".
    نموذج_اصدار = "".
    نموذج_نوع = "".
    نموذج_مصدر = "".
    نموذج_مخرج = "".
    نموذج_ملفات = "".
    نموذج_اعلام = "".
    نموذج_كتب = "".
    نموذج_تضمينات = "".
    نموذج_هدف_باء = "".
    نموذج_اسم_هدف = "".
    نموذج_تحسين = ١.
    نموذج_اعتماديات = عدم.
    نموذج_بيان_في1 = خطأ.
    نموذج_تحقق = خطأ.

    اسم_موجود = خطأ.
    اصدار_موجود = خطأ.
    نوع_موجود = خطأ.
    مصدر_موجود = خطأ.
    مخرج_موجود = خطأ.
    ملفات_موجود = خطأ.
    اعلام_موجود = خطأ.
    كتب_موجود = خطأ.
    تضمينات_موجود = خطأ.
    هدف_باء_موجود = خطأ.
    اسم_هدف_موجود = خطأ.
}

عدم حدد_هدف_تكوين(نص اسم) {
    إذا (طلب_هدف_موجود) { حرر_نص(نموذج_طلب_هدف). }
    نموذج_طلب_هدف = "".
    طلب_هدف_موجود = خطأ.
    إذا (اسم != عدم && طول_نص(اسم) > ٠) {
        نموذج_طلب_هدف = نسخ_نص(اسم).
        طلب_هدف_موجود = نموذج_طلب_هدف != عدم.
    }
}

نص احصل_اسم_الهدف() {
    إذا (اسم_هدف_موجود) { إرجع نموذج_اسم_هدف. }
    إرجع نموذج_اسم.
}

نص احصل_تكوين_الاسم() {
    إرجع نموذج_اسم.
}

نص احصل_تكوين_الإصدار() {
    إرجع نموذج_اصدار.
}

نص احصل_تكوين_النوع() {
    إرجع نموذج_نوع.
}

نص احصل_تكوين_المصدر() {
    إرجع نموذج_مصدر.
}

نص احصل_تكوين_المخرج() {
    إرجع نموذج_مخرج.
}

نص احصل_تكوين_الملفات() {
    إرجع نموذج_ملفات.
}

صحيح احصل_تكوين_التحسين() {
    إرجع نموذج_تحسين.
}

نص احصل_تكوين_الأعلام_الإضافية() {
    إرجع نموذج_اعلام.
}

نص احصل_تكوين_المكتبات() {
    إرجع نموذج_كتب.
}

نص احصل_تكوين_مسارات_التضمين() {
    إرجع نموذج_تضمينات.
}

متجه احصل_اعتماديات_المسار() {
    إرجع نموذج_اعتماديات.
}

منطقي تكوين_بيان_في1() {
    إرجع نموذج_بيان_في1.
}

نص احصل_تكوين_هدف_باء() {
    إرجع نموذج_هدف_باء.
}

منطقي احصل_تكوين_التحقق() {
    إرجع نموذج_تحقق.
}

// -------------------------
// Helpers
// -------------------------

منطقي يبدأ_ب(نص النص، نص البادئة) {
    صحيح طول_النص = طول_نص(النص).
    صحيح طول_البادئة = طول_نص(البادئة).

    إذا (طول_النص < طول_البادئة) {
        إرجع خطأ.
    }

    صحيح م = ٠.
    طالما (م < طول_البادئة) {
        إذا (النص[م] != البادئة[م]) {
            إرجع خطأ.
        }
        م = م + ١.
    }

    إرجع صواب.
}

منطقي سطر_مهمل(نص سطر) {
    صحيح طول_السطر = طول_نص(سطر).

    إذا (طول_السطر == ٠) {
        إرجع صواب.
    }

    إذا (طول_السطر >= ٢ && سطر[٠] == '/' && سطر[١] == '/') {
        إرجع صواب.
    }

    إذا (سطر[٠] == '#') {
        إرجع صواب.
    }

    إرجع خطأ.
}

صحيح بداية_القيمة(نص سطر، صحيح بداية) {
    صحيح طول_السطر = طول_نص(سطر).
    صحيح م = بداية.

    طالما (م < طول_السطر && (سطر[م] == ' ' || سطر[م] == '\ت')) {
        م = م + ١.
    }

    إرجع م.
}

منطقي قيمة_غير_فارغة(نص سطر، صحيح بداية) {
    صحيح م = بداية_القيمة(سطر، بداية).
    إرجع (م < طول_نص(سطر)).
}

نص نسخ_قيمة_مقصوصة(نص سطر، صحيح بداية) {
    صحيح م = بداية_القيمة(سطر، بداية).
    صحيح طول = طول_نص(سطر).

    نص ناتج = نسخ_نص("").

    طالما (م < طول) {
        نص حرف_كنص = نسق("%ح"، سطر[م]).
        نص جديد = دمج_نص(ناتج، حرف_كنص).
        حرر_نص(ناتج).
        حرر_نص(حرف_كنص).
        ناتج = جديد.
        م = م + ١.
    }

    إرجع ناتج.
}

منطقي يحتوي_على(نص النص، نص الجزء) {
    صحيح طول_النص = طول_نص(النص).
    صحيح طول_الجزء = طول_نص(الجزء).

    إذا (طول_الجزء == ٠) {
        إرجع صواب.
    }

    إذا (طول_الجزء > طول_النص) {
        إرجع خطأ.
    }

    صحيح م = ٠.
    طالما (م <= طول_النص - طول_الجزء) {
        منطقي مطابق = صواب.
        صحيح ن = ٠.

        طالما (ن < طول_الجزء) {
            إذا (النص[م + ن] != الجزء[ن]) {
                مطابق = خطأ.
                توقف.
            }

            ن = ن + ١.
        }

        إذا (مطابق) {
            إرجع صواب.
        }

        م = م + ١.
    }

    إرجع خطأ.
}

منطقي نوع_مدعوم(نص قيمة) {
    إرجع قارن_نص(قيمة، "تنفيذي") == ٠ || قارن_نص(قيمة، "مكتبة") == ٠.
}

منطقي نوع_في1_مدعوم(نص قيمة) {
    إرجع نوع_مدعوم(قيمة) || قارن_نص(قيمة، "اختبار") == ٠.
}

نص ادمج_وحرر_يسار_محلل(نص يسار، نص يمين) {
    نص ناتج = دمج_نص(يسار، يمين).
    حرر_نص(يسار).
    إرجع ناتج.
}

نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية) {
    إذا (قيمة == عدم || بداية < ٠ || نهاية < بداية || نهاية > طول_نص(قيمة)) {
        إرجع عدم.
    }
    نص ناتج = نسخ_نص("").
    صحيح م = بداية.
    طالما (م < نهاية) {
        نص حرف_كنص = نسق("%ح"، قيمة[م]).
        ناتج = ادمج_وحرر_يسار_محلل(ناتج، حرف_كنص).
        حرر_نص(حرف_كنص).
        م = م + ١.
    }
    إرجع ناتج.
}

نص قص_طرفين(نص قيمة) {
    إذا (قيمة == عدم) { إرجع عدم. }
    صحيح بداية = ٠.
    صحيح نهاية = طول_نص(قيمة).
    طالما (بداية < نهاية && (قيمة[بداية] == ' ' || قيمة[بداية] == '\ت')) {
        بداية = بداية + ١.
    }
    طالما (نهاية > بداية && (قيمة[نهاية - ١] == ' ' || قيمة[نهاية - ١] == '\ت')) {
        نهاية = نهاية - ١.
    }
    إرجع نسخ_مقطع(قيمة، بداية، نهاية).
}

نص احذف_تعليق_في1(نص سطر) {
    منطقي داخل_نص = خطأ.
    منطقي هروب = خطأ.
    صحيح م = ٠.
    صحيح نهاية = طول_نص(سطر).
    طالما (م < طول_نص(سطر)) {
        حرف ح = سطر[م].
        إذا (هروب) {
            هروب = خطأ.
        }
        وإلا إذا (داخل_نص && ح == '\\') {
            هروب = صواب.
        }
        وإلا إذا (ح == '"') {
            داخل_نص = !داخل_نص.
        }
        وإلا إذا (!داخل_نص && ح == '/' && م + ١ < طول_نص(سطر) && سطر[م + ١] == '/') {
            نهاية = م.
            توقف.
        }
        م = م + ١.
    }
    نص بلا_تعليق = نسخ_مقطع(سطر، ٠، نهاية).
    نص ناتج = قص_طرفين(بلا_تعليق).
    حرر_نص(بلا_تعليق).
    إرجع ناتج.
}

صحيح موضع_إسناد_في1(نص سطر) {
    منطقي داخل_نص = خطأ.
    منطقي هروب = خطأ.
    صحيح م = ٠.
    طالما (م < طول_نص(سطر)) {
        حرف ح = سطر[م].
        إذا (هروب) { هروب = خطأ. }
        وإلا إذا (داخل_نص && ح == '\\') { هروب = صواب. }
        وإلا إذا (ح == '"') { داخل_نص = !داخل_نص. }
        وإلا إذا (!داخل_نص && ح == '=') { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

نص حلل_نص_في1(نص خام) {
    نص قيمة = قص_طرفين(خام).
    إذا (قيمة == عدم || طول_نص(قيمة) < ٢ || قيمة[٠] != '"' ||
        قيمة[طول_نص(قيمة) - ١] != '"') {
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
        إرجع عدم.
    }

    نص ناتج = نسخ_نص("").
    صحيح م = ١.
    صحيح نهاية = طول_نص(قيمة) - ١.
    طالما (م < نهاية) {
        حرف ح = قيمة[م].
        إذا (ح == '\\') {
            م = م + ١.
            إذا (م >= نهاية) {
                حرر_نص(قيمة).
                حرر_نص(ناتج).
                إرجع عدم.
            }
            ح = قيمة[م].
            إذا (ح == 'n') { ح = '\س'. }
            وإلا إذا (ح == 't') { ح = '\ت'. }
            وإلا إذا (ح != '\\' && ح != '"') {
                حرر_نص(قيمة).
                حرر_نص(ناتج).
                إرجع عدم.
            }
        }
        وإلا إذا (ح == '"') {
            حرر_نص(قيمة).
            حرر_نص(ناتج).
            إرجع عدم.
        }
        إذا (ح == '\س' || ح == '\ر') {
            حرر_نص(قيمة).
            حرر_نص(ناتج).
            إرجع عدم.
        }
        نص حرف_كنص = نسق("%ح"، ح).
        ناتج = ادمج_وحرر_يسار_محلل(ناتج، حرف_كنص).
        حرر_نص(حرف_كنص).
        م = م + ١.
    }
    حرر_نص(قيمة).
    إرجع ناتج.
}

صحيح حلل_صحيح_في1(نص خام) {
    نص قيمة = قص_طرفين(خام).
    صحيح ناتج = -١.
    إذا (قارن_نص(قيمة، "0") == ٠ || قارن_نص(قيمة، "٠") == ٠) { ناتج = ٠. }
    وإلا إذا (قارن_نص(قيمة، "1") == ٠ || قارن_نص(قيمة، "١") == ٠) { ناتج = ١. }
    وإلا إذا (قارن_نص(قيمة، "2") == ٠ || قارن_نص(قيمة، "٢") == ٠) { ناتج = ٢. }
    حرر_نص(قيمة).
    إرجع ناتج.
}

صحيح حلل_منطقي_في1(نص خام) {
    نص قيمة = قص_طرفين(خام).
    صحيح ناتج = -١.
    إذا (قارن_نص(قيمة، "صواب") == ٠) { ناتج = ١. }
    وإلا إذا (قارن_نص(قيمة، "خطأ") == ٠) { ناتج = ٠. }
    حرر_نص(قيمة).
    إرجع ناتج.
}

نص حلل_مصفوفة_نصوص_في1(نص خام) {
    نص قيمة = قص_طرفين(خام).
    إذا (قيمة == عدم || طول_نص(قيمة) < ٢ || قيمة[٠] != '[' ||
        قيمة[طول_نص(قيمة) - ١] != ']') {
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
        إرجع عدم.
    }

    نص ناتج = نسخ_نص("").
    صحيح م = ١.
    صحيح نهاية = طول_نص(قيمة) - ١.
    منطقي أول = صواب.
    طالما (صواب) {
        طالما (م < نهاية && (قيمة[م] == ' ' || قيمة[م] == '\ت')) { م = م + ١. }
        إذا (م == نهاية) { توقف. }
        إذا (قيمة[م] != '"') {
            حرر_نص(قيمة). حرر_نص(ناتج). إرجع عدم.
        }
        صحيح بداية = م.
        م = م + ١.
        منطقي هروب = خطأ.
        طالما (م < نهاية) {
            حرف ح = قيمة[م].
            إذا (هروب) { هروب = خطأ. }
            وإلا إذا (ح == '\\') { هروب = صواب. }
            وإلا إذا (ح == '"') { توقف. }
            م = م + ١.
        }
        إذا (م >= نهاية || قيمة[م] != '"') {
            حرر_نص(قيمة). حرر_نص(ناتج). إرجع عدم.
        }
        نص خام_عنصر = نسخ_مقطع(قيمة، بداية، م + ١).
        نص عنصر = حلل_نص_في1(خام_عنصر).
        حرر_نص(خام_عنصر).
        إذا (عنصر == عدم) { حرر_نص(قيمة). حرر_نص(ناتج). إرجع عدم. }
        إذا (!أول) { ناتج = ادمج_وحرر_يسار_محلل(ناتج، "\س"). }
        ناتج = ادمج_وحرر_يسار_محلل(ناتج، عنصر).
        حرر_نص(عنصر).
        أول = خطأ.
        م = م + ١.
        طالما (م < نهاية && (قيمة[م] == ' ' || قيمة[م] == '\ت')) { م = م + ١. }
        إذا (م == نهاية) { توقف. }
        إذا (قيمة[م] != ',') { حرر_نص(قيمة). حرر_نص(ناتج). إرجع عدم. }
        م = م + ١.
    }
    حرر_نص(قيمة).
    إرجع ناتج.
}

منطقي ملف_بيان_في1(نص مسار) {
    عدم* ملف = فتح_ملف(مسار، "قراءة").
    إذا (ملف == عدم) { إرجع خطأ. }
    منطقي في1 = خطأ.
    طالما (صواب) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        نص فعال = احذف_تعليق_في1(سطر).
        حرر_نص(سطر).
        إذا (طول_نص(فعال) > ٠) {
            في1 = فعال[٠] == '['.
            حرر_نص(فعال).
            توقف.
        }
        حرر_نص(فعال).
    }
    اغلق_ملف(ملف).
    إرجع في1.
}

منطقي ادفع_نص_مملوك_للقائمة(متجه قائمة، نص قيمة) {
    إذا (قائمة == عدم || قيمة == عدم) {
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
        إرجع خطأ.
    }
    إذا (!ادفع_متجه(قائمة، &قيمة)) {
        حرر_نص(قيمة).
        إرجع خطأ.
    }
    إرجع صواب.
}

منطقي اضف_مصادر_في1(نص قائمة) {
    إذا (قائمة == عدم) { إرجع خطأ. }
    إذا (طول_نص(قائمة) == ٠) { حرر_نص(قائمة). إرجع صواب. }
    إذا (يحتوي_على(قائمة، "*") || يحتوي_على(قائمة، "?")) {
        اطبع "[خطأ] توسعة globs في 'المصادر' لم تنفذ بعد؛ استخدم مسارات ملفات صريحة.".
        حرر_نص(قائمة).
        إرجع خطأ.
    }
    إذا (!ملفات_موجود || طول_نص(نموذج_ملفات) == ٠) {
        نموذج_ملفات = قائمة.
        ملفات_موجود = صواب.
        إرجع صواب.
    }
    نص جديد = دمج_نص(نموذج_ملفات، "\س").
    نص كامل = دمج_نص(جديد، قائمة).
    حرر_نص(جديد).
    حرر_نص(قائمة).
    حرر_نص(نموذج_ملفات).
    نموذج_ملفات = كامل.
    إرجع كامل != عدم.
}

نص اسم_قسم_فرعي(نص قسم، نص بادئة) {
    إذا (!يبدأ_ب(قسم، بادئة) || طول_نص(قسم) <= طول_نص(بادئة)) { إرجع عدم. }
    إرجع نسخ_مقطع(قسم، طول_نص(بادئة)، طول_نص(قسم)).
}

صحيح قيمة_تحسين_سجل(نص سجل) {
    إذا (سجل == عدم || طول_نص(سجل) < ٢) { إرجع -١. }
    حرف ح = سجل[طول_نص(سجل) - ١].
    إذا (ح == '0') { إرجع ٠. }
    إذا (ح == '1') { إرجع ١. }
    إذا (ح == '2') { إرجع ٢. }
    إرجع -١.
}

صحيح تحليل_ملف_في1(نص مسار) {
    مسح_نموذج_تكوين().
    نموذج_بيان_في1 = صواب.
