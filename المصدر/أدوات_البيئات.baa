#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
نص حقل_أرشيف(نص سجل، صحيح رقم).
نص هرب_جسون_خطة(نص قيمة).
منطقي يبدأ_ب(نص النص، نص البادئة).
منطقي انسخ_ملفا_ببايتاته(نص من، نص إلى).
نص جذر_بيانات_تكوين().
نص ضم_وحرر_يسار_طقم(نص يسار، نص يمين).
منطقي ملف_موجود_طقم(نص مسار).
منطقي اقفل_مجلدا(نص مخزن، نص وصف).
عدم افتح_قفل_الطقوم(نص مخزن).
منطقي مضيف_طقم_معروف(نص مضيف).
منطقي مسار_طقم_صالح(نص مسار).
صحيح قارن_مسار_طقم(نص أ، نص ب).
منطقي تجزئة_سداسية_صالحة_طقم(نص قيمة).
نص تجزئة_ملف_جانبي_طقم(نص أرشيف).
عدم اضبط_نوع_أرشيف(صحيح نوع).
منطقي حلل_بيانات_طقم(نص مسار).
صحيح فك_أرشيف_طقم(نص أرشيف، نص مخزن، نص مرحلة).
نص جذر_مرحلة_أرشيف().
عدم انه_فك_أرشيف().
صحيح عدد_جرد_أرشيف().
منطقي تنفيذي_جرد_أرشيف(صحيح فهرس).
نص إصدار_جرد_أرشيف().
نص مضيف_جرد_أرشيف().
نص اسم_جرد_أرشيف().
نص مسار_جرد_طقم(صحيح فهرس).
نص تجزئة_جرد_طقم(صحيح فهرس).

// مخزن الأدوات وبيئاتها (takween-tool-env-v1). أداة سطر أوامر يثبتها المستخدم
// تأتي في أرشيف baa-tool-v1، وتُفك مرة واحدة إلى مدخل في المخزن معنون بتجزئة
// الأرشيف ولا يتغير بعدها. البيئة المسماة بادئة (prefix) تُنسخ إليها ملفات
// الأدوات، وقاعدة البيئة تسجل مالك كل ملف. التثبيت والحذف معاملتان: فحص مسبق
// للتعارضات، ثم سجل، ثم نقل ذري للملفات، ثم كتابة القاعدة (نقطة الالتزام).
// عملية انقطعت تُكمل أو يُتراجع عنها عند أول عملية تالية تمسك القفل.
//
// <البيانات>/أدوات/
//   .قفل                    قفل واحد للمخزن وكل البيئات
//   مخزن/<sha256>/          BAA-TOOL.json والملفات وإيصال .تكوين-أداة-v1
//   بيئات.فهرس              takween-env-index-v1: اسم بيئة في كل سطر، مرتبة
//   بيئات/<اسم>/            بادئة البيئة؛ داخليتها في .تكوين-بيئة/
//
// لا يعدل تكوين PATH، ولا يقرأ البناء شيئا من البيئات: اعتماديات المشاريع
// تبقى في البيان والقفل وإن ثُبتت أداة بالاسم نفسه.

#تعريف اسم_بيانات_أداة_بيئة "BAA-TOOL.json"
#تعريف اسم_إيصال_الأداة ".تكوين-أداة-v1"
#تعريف رأس_إيصال_الأداة "takween-tool-receipt-v1"
#تعريف رأس_قاعدة_البيئة "takween-env-db-v1"
#تعريف رأس_سجل_البيئة "takween-env-journal-v1"
#تعريف رأس_فهرس_البيئات "takween-env-index-v1"
#تعريف داخلية_البيئة ".تكوين-بيئة"
#تعريف البيئة_الافتراضية "افتراضية"

// ---------------------------------------------------------------------------
// المسارات
// ---------------------------------------------------------------------------

نص جذر_أدوات_حالي.
نص اسم_بيئة_حالية.
نص جذر_بيئة_حالية.
نص داخل_بيئة_حالية.

عدم حرر_بيئة() {
    إذا (جذر_أدوات_حالي != عدم) { حرر_نص(جذر_أدوات_حالي). جذر_أدوات_حالي = عدم. }
    إذا (اسم_بيئة_حالية != عدم) { حرر_نص(اسم_بيئة_حالية). اسم_بيئة_حالية = عدم. }
    إذا (جذر_بيئة_حالية != عدم) { حرر_نص(جذر_بيئة_حالية). جذر_بيئة_حالية = عدم. }
    إذا (داخل_بيئة_حالية != عدم) { حرر_نص(داخل_بيئة_حالية). داخل_بيئة_حالية = عدم. }
}

نص جذر_الأدوات() { إرجع جذر_أدوات_حالي. }
نص اسم_البيئة() { إرجع اسم_بيئة_حالية. }
نص جذر_البيئة() { إرجع جذر_بيئة_حالية. }

// يضبط مسارات البيئة لاسم صالح بصيغة NFC.
منطقي جهز_بيئة(نص اسم) {
    حرر_بيئة().
    نص بيانات = جذر_بيانات_تكوين().
    إذا (بيانات == عدم) {
        اطبع "[خطأ] لا يوجد مجلد بيانات لتكوين؛ اضبط TAKWEEN_DATA_HOME.".
        إرجع خطأ.
    }
    جذر_أدوات_حالي = ضم_وحرر_يسار_طقم(بيانات، "أدوات").
    اسم_بيئة_حالية = نسخ_نص(اسم).
    إذا (جذر_أدوات_حالي == عدم || اسم_بيئة_حالية == عدم) { إرجع خطأ. }
    نص بيئات = ضم_مسار(جذر_أدوات_حالي، "بيئات").
    جذر_بيئة_حالية = ضم_وحرر_يسار_طقم(بيئات، اسم).
    إذا (جذر_بيئة_حالية == عدم) { إرجع خطأ. }
    داخل_بيئة_حالية = ضم_مسار(جذر_بيئة_حالية، داخلية_البيئة).
    إرجع داخل_بيئة_حالية != عدم.
}

نص مسار_داخلي(نص اسم) {
    إرجع ضم_مسار(داخل_بيئة_حالية، اسم).
}

// ملف داخلي برقم: مرحلة/<رقم> أو مهملات/<رقم>.
نص مسار_مرقم(نص مجلد، صحيح رقم) {
    نص أساس = مسار_داخلي(مجلد).
    نص رقم_نص = نسق("%ص"، رقم).
    نص ناتج = عدم.
    إذا (أساس != عدم && رقم_نص != عدم) { ناتج = ضم_مسار(أساس، رقم_نص). }
    إذا (أساس != عدم) { حرر_نص(أساس). }
    إذا (رقم_نص != عدم) { حرر_نص(رقم_نص). }
    إرجع ناتج.
}

منطقي بيئة_موجودة() {
    نص قاعدة = مسار_داخلي("قاعدة").
    منطقي ناتج = ملف_موجود_طقم(قاعدة).
    إذا (قاعدة != عدم) { حرر_نص(قاعدة). }
    إرجع ناتج.
}

منطقي اقفل_الأدوات() {
    إذا (انشئ_مجلدات(جذر_أدوات_حالي) != ٠) {
        اطبع_منسق("[خطأ] تعذر إنشاء مجلد الأدوات: %ن\س"، جذر_أدوات_حالي).
        إرجع خطأ.
    }
    إرجع اقفل_مجلدا(جذر_أدوات_حالي، "مخزن الأدوات").
}

// عطل مقصود لاختبار الاستعادة: يخرج والقفل والسجل باقيان كما في انقطاع حقيقي.
عدم نقطة_عطل(نص اسم) {
    نص قيمة = متغير_بيئة("TAKWEEN_TEST_FAULT").
    إذا (قيمة == عدم) { إرجع. }
    منطقي مطابقة = قارن_نص(قيمة، اسم) == ٠.
    حرر_نص(قيمة).
    إذا (مطابقة) { توقف_فوري("عطل اختبار مقصود"). }
}

// ---------------------------------------------------------------------------
// ملفات الأسطر
// ---------------------------------------------------------------------------

صحيح عدد_ألسنة(نص سطر) {
    صحيح ناتج = ٠.
    صحيح م = ٠.
    طالما (م < طول_نص(سطر)) {
        إذا (سطر[م] == '\ت') { ناتج = ناتج + ١. }
        م = م + ١.
    }
    إرجع ناتج.
}

منطقي حقل_يساوي(نص سطر، صحيح رقم، نص قيمة) {
    نص حقل = حقل_أرشيف(سطر، رقم).
    منطقي ناتج = حقل != عدم && قارن_نص(حقل، قيمة) == ٠.
    إذا (حقل != عدم) { حرر_نص(حقل). }
    إرجع ناتج.
}

منطقي أرقام_فقط(نص قيمة) {
    إذا (قيمة == عدم || طول_نص(قيمة) == ٠ || طول_نص(قيمة) > ٩) { إرجع خطأ. }
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        إذا (قيمة[م] < '0' || قيمة[م] > '9') { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

نص عنصر_نصي(متجه أسطر، صحيح فهرس) {
    نص* بيانات = كـ<نص*>(بيانات_متجه(أسطر)).
    إرجع *(بيانات + فهرس).
}

// يقرأ ملفا برأس متوقع: ٠ نجاح، ١ ملف غائب، -١ رأس خاطئ أو خطأ قراءة.
صحيح اقرأ_أسطر_برأس(نص مسار، نص رأس، متجه أسطر) {
    إذا (مسار == عدم) { إرجع -١. }
    عدم* ملف = فتح_ملف(مسار، "rb").
    إذا (ملف == عدم) { إرجع ١. }
    نص أول = اقرأ_سطر(ملف).
    منطقي صالح = أول != عدم && قارن_نص(أول، رأس) == ٠.
    إذا (أول != عدم) { حرر_نص(أول). }
    طالما (صالح) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        صالح = اضف_وسيط_مملوك(أسطر، سطر).
    }
    اغلق_ملف(ملف).
    إذا (!صالح) { إرجع -١. }
    إرجع ٠.
}

// يكتب <نهائي>.مؤقت ثم يضعه مكان النهائي ذريا.
منطقي اكتب_أسطر_ذريا(نص نهائي، نص رأس، متجه أسطر) {
    إذا (نهائي == عدم) { إرجع خطأ. }
    نص مؤقت = نسق("%ن.مؤقت"، نهائي).
    عدم* ملف = عدم.
    منطقي صالح = مؤقت != عدم.
    إذا (صالح) { ملف = فتح_ملف(مؤقت، "wb"). صالح = ملف != عدم. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، رأس) >= ٠. }
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(أسطر)) {
        صالح = اكتب_سطر(ملف، عنصر_نصي(أسطر، م)) >= ٠.
        م = م + ١.
    }
    إذا (ملف != عدم && اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    إذا (صالح) { صالح = استبدل_ملف(مؤقت، نهائي) == ٠. }
    إذا (!صالح && مؤقت != عدم) { احذف_شجرة(مؤقت). }
    إذا (مؤقت != عدم) { حرر_نص(مؤقت). }
    إرجع صالح.
}

// ---------------------------------------------------------------------------
// فهرس البيئات
// ---------------------------------------------------------------------------

منطقي اقرأ_فهرس_بيئات(متجه أسماء) {
    نص مسار = ضم_مسار(جذر_أدوات_حالي، "بيئات.فهرس").
    صحيح قراءة = اقرأ_أسطر_برأس(مسار، رأس_فهرس_البيئات، أسماء).
    إذا (مسار != عدم) { حرر_نص(مسار). }
    منطقي صالح = قراءة >= ٠.
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(أسماء)) {
        نص اسم = عنصر_نصي(أسماء، م).
        صالح = هوية_حزمة_عربية(اسم) &&
               (م == ٠ || قارن_مسار_طقم(عنصر_نصي(أسماء، م - ١)، اسم) < ٠).
        م = م + ١.
    }
    إذا (!صالح) { اطبع "[خطأ] فهرس البيئات تالف.". }
    إرجع صالح.
}

// يضيف البيئة الحالية إلى الفهرس أو يحذفها منه. يتطلب القفل.
منطقي حدث_فهرس_بيئات(منطقي إضافة) {
    متجه قديمة = أنشئ_متجه(حجم(نص)).
    متجه جديدة = أنشئ_متجه(حجم(نص)).
    إذا (قديمة == عدم || جديدة == عدم) { إرجع خطأ. }
    منطقي صالح = اقرأ_فهرس_بيئات(قديمة).
    منطقي أضيف = !إضافة.
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(قديمة)) {
        نص اسم = عنصر_نصي(قديمة، م).
        صحيح ترتيب = قارن_مسار_طقم(اسم، اسم_بيئة_حالية).
        إذا (!أضيف && ترتيب >= ٠) {
            صالح = اضف_وسيط(جديدة، اسم_بيئة_حالية).
            أضيف = صواب.
        }
        إذا (ترتيب != ٠) { صالح = صالح && اضف_وسيط(جديدة، اسم). }
        م = م + ١.
    }
    إذا (صالح && !أضيف) { صالح = اضف_وسيط(جديدة، اسم_بيئة_حالية). }
    نص مسار = ضم_مسار(جذر_أدوات_حالي، "بيئات.فهرس").
    صالح = صالح && اكتب_أسطر_ذريا(مسار، رأس_فهرس_البيئات، جديدة).
    إذا (!صالح) { اطبع "[خطأ] تعذر تحديث فهرس البيئات.". }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    حرر_وسائط(قديمة).
    حرر_وسائط(جديدة).
    إرجع صالح.
}

// ---------------------------------------------------------------------------
// قاعدة البيئة (takween-env-db-v1)
// ---------------------------------------------------------------------------
//   حزمة\t<اسم>\t<إصدار>\t<مضيف>\t<sha256 الأرشيف>
//   ملف\t<المالك>\t<sha256>\t<0|1 تنفيذي>\t<مسار نسبي>
// الحزم مرتبة بالاسم، وكل حزمة تتلوها ملفاتها بترتيب جرد أرشيفها.

متجه أسطر_قاعدة = عدم.
متجه مسارات_مملوكة = عدم.
متجه ملاك_المسارات = عدم.

عدم امسح_قاعدة() {
    إذا (أسطر_قاعدة != عدم) { حرر_وسائط(أسطر_قاعدة). أسطر_قاعدة = عدم. }
    إذا (مسارات_مملوكة != عدم) { حرر_وسائط(مسارات_مملوكة). مسارات_مملوكة = عدم. }
    إذا (ملاك_المسارات != عدم) { حرر_وسائط(ملاك_المسارات). ملاك_المسارات = عدم. }
}

منطقي سطر_حزمة(نص سطر) {
    إرجع يبدأ_ب(سطر، "حزمة\ت").
}

منطقي سطر_قاعدة_صالح(نص سطر، نص مالك) {
    إذا (عدد_ألسنة(سطر) != ٤) { إرجع خطأ. }
    نص نوع = حقل_أرشيف(سطر، ٠).
    نص أ = حقل_أرشيف(سطر، ١).
    نص ب = حقل_أرشيف(سطر، ٢).
    نص ج = حقل_أرشيف(سطر، ٣).
    نص د = حقل_أرشيف(سطر، ٤).
    منطقي صالح = نوع != عدم && أ != عدم && ب != عدم && ج != عدم && د != عدم.
    إذا (صالح && قارن_نص(نوع، "حزمة") == ٠) {
        صالح = هوية_حزمة_عربية(أ) && اصدار_دلالي_صالح(ب) && مضيف_طقم_معروف(ج) &&
               تجزئة_سداسية_صالحة_طقم(د) && (مالك == عدم || قارن_مسار_طقم(مالك، أ) < ٠).
    }
    وإلا إذا (صالح && قارن_نص(نوع، "ملف") == ٠) {
        صالح = مالك != عدم && قارن_نص(أ، مالك) == ٠ && تجزئة_سداسية_صالحة_طقم(ب) &&
               (قارن_نص(ج، "0") == ٠ || قارن_نص(ج، "1") == ٠) && مسار_طقم_صالح(د).
        صالح = صالح && اضف_وسيط(مسارات_مملوكة، د) && اضف_وسيط(ملاك_المسارات، أ).
    }
    وإلا { صالح = خطأ. }
    إذا (نوع != عدم) { حرر_نص(نوع). }
    إذا (أ != عدم) { حرر_نص(أ). }
    إذا (ب != عدم) { حرر_نص(ب). }
    إذا (ج != عدم) { حرر_نص(ج). }
    إذا (د != عدم) { حرر_نص(د). }
    إرجع صالح.
}

منطقي حمل_قاعدة() {
    امسح_قاعدة().
    أسطر_قاعدة = أنشئ_متجه(حجم(نص)).
    مسارات_مملوكة = أنشئ_متجه(حجم(نص)).
    ملاك_المسارات = أنشئ_متجه(حجم(نص)).
    إذا (أسطر_قاعدة == عدم || مسارات_مملوكة == عدم || ملاك_المسارات == عدم) { إرجع خطأ. }
    نص مسار = مسار_داخلي("قاعدة").
    صحيح قراءة = اقرأ_أسطر_برأس(مسار، رأس_قاعدة_البيئة، أسطر_قاعدة).
    إذا (قراءة == ١) {
        اطبع_منسق("[خطأ] البيئة %ن غير موجودة.\س"، اسم_بيئة_حالية).
        حرر_نص(مسار).
        إرجع خطأ.
    }
    منطقي صالح = قراءة == ٠.
    نص مالك = عدم.
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(أسطر_قاعدة)) {
        نص سطر = عنصر_نصي(أسطر_قاعدة، م).
        صالح = سطر_قاعدة_صالح(سطر، مالك).
        إذا (صالح && سطر_حزمة(سطر)) {
            إذا (مالك != عدم) { حرر_نص(مالك). }
            مالك = حقل_أرشيف(سطر، ١).
        }
        م = م + ١.
    }
    إذا (مالك != عدم) { حرر_نص(مالك). }
    إذا (!صالح) { اطبع_منسق("[خطأ] قاعدة البيئة تالفة: %ن\س"، مسار). }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    إرجع صالح.
}

صحيح حزمة_في_قاعدة(نص اسم) {
    صحيح م = ٠.
    طالما (م < طول_متجه(أسطر_قاعدة)) {
        نص سطر = عنصر_نصي(أسطر_قاعدة، م).
        إذا (سطر_حزمة(سطر) && حقل_يساوي(سطر، ١، اسم)) { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

صحيح نهاية_حزمة(صحيح بداية) {
    صحيح م = بداية + ١.
    طالما (م < طول_متجه(أسطر_قاعدة) && !سطر_حزمة(عنصر_نصي(أسطر_قاعدة، م))) {
        م = م + ١.
    }
    إرجع م.
}

صحيح عدد_حزم_قاعدة() {
    صحيح ناتج = ٠.
    صحيح م = ٠.
    طالما (م < طول_متجه(أسطر_قاعدة)) {
        إذا (سطر_حزمة(عنصر_نصي(أسطر_قاعدة، م))) { ناتج = ناتج + ١. }
        م = م + ١.
    }
    إرجع ناتج.
}

// مالك مسار في القاعدة المحملة، أو عدم. القيمة مستعارة.
نص مالك_مسار(نص مسار) {
    صحيح م = ٠.
    طالما (م < طول_متجه(مسارات_مملوكة)) {
        إذا (قارن_نص(عنصر_نصي(مسارات_مملوكة، م)، مسار) == ٠) {
            إرجع عنصر_نصي(ملاك_المسارات، م).
        }
        م = م + ١.
    }
    إرجع عدم.
}

// يكتب القاعدة بلا كتلة الحزمة <اسم>، ومع كتلة جديدة مرتبة بالاسم إن مُررت.
منطقي اكتب_قاعدة(نص اسم، متجه كتلة) {
    متجه جديدة = أنشئ_متجه(حجم(نص)).
    إذا (جديدة == عدم) { إرجع خطأ. }
    منطقي صالح = صواب.
    منطقي أضيفت = كتلة == عدم.
    منطقي في_الحزمة = خطأ.
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(أسطر_قاعدة)) {
        نص سطر = عنصر_نصي(أسطر_قاعدة، م).
        إذا (سطر_حزمة(سطر)) {
            نص س_اسم = حقل_أرشيف(سطر، ١).
            في_الحزمة = قارن_نص(س_اسم، اسم) == ٠.
            إذا (!أضيفت && !في_الحزمة && قارن_مسار_طقم(س_اسم، اسم) > ٠) {
                صحيح ك = ٠.
                طالما (صالح && ك < طول_متجه(كتلة)) {
                    صالح = اضف_وسيط(جديدة، عنصر_نصي(كتلة، ك)).
                    ك = ك + ١.
                }
                أضيفت = صواب.
            }
            حرر_نص(س_اسم).
        }
        إذا (!في_الحزمة) { صالح = صالح && اضف_وسيط(جديدة، سطر). }
        م = م + ١.
    }
    صحيح ك = ٠.
    طالما (صالح && !أضيفت && ك < طول_متجه(كتلة)) {
        صالح = اضف_وسيط(جديدة، عنصر_نصي(كتلة، ك)).
        ك = ك + ١.
    }
    نص مسار = مسار_داخلي("قاعدة").
    صالح = صالح && اكتب_أسطر_ذريا(مسار، رأس_قاعدة_البيئة، جديدة).
    إذا (!صالح) { اطبع "[خطأ] تعذر كتابة قاعدة البيئة.". }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    حرر_وسائط(جديدة).
    إرجع صالح.
}

// ---------------------------------------------------------------------------
// السجل والاستعادة (takween-env-journal-v1)
// ---------------------------------------------------------------------------
//   عملية\t<تثبيت|حذف>
//   حزمة\t<اسم>\t<sha256 الأرشيف>
//   ملف\t<رقم>\t<sha256>\t<مسار نسبي>
// يُكتب ذريا قبل أن يتغير شيء في البادئة، ويُحذف بعد كتابة القاعدة.

منطقي اكتب_سجل(نص عملية، نص اسم، نص تجزئة، متجه ملفات) {
    متجه أسطر = أنشئ_متجه(حجم(نص)).
    إذا (أسطر == عدم) { إرجع خطأ. }
    منطقي صالح = اضف_وسيط_مملوك(أسطر، نسق("عملية\ت%ن"، عملية)) &&
                  اضف_وسيط_مملوك(أسطر، نسق("حزمة\ت%ن\ت%ن"، اسم، تجزئة)).
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(ملفات)) {
        صالح = اضف_وسيط(أسطر، عنصر_نصي(ملفات، م)).
        م = م + ١.
    }
    نص مسار = مسار_داخلي("سجل").
    صالح = صالح && اكتب_أسطر_ذريا(مسار، رأس_سجل_البيئة، أسطر).
    إذا (!صالح) { اطبع "[خطأ] تعذر كتابة سجل البيئة.". }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    حرر_وسائط(أسطر).
    إرجع صالح.
}

عدم امسح_مؤقتات_بيئة() {
    نص مرحلة = مسار_داخلي("مرحلة").
    نص مهملات = مسار_داخلي("مهملات").
    نص سجل = مسار_داخلي("سجل").
    إذا (مرحلة != عدم) { احذف_شجرة(مرحلة). حرر_نص(مرحلة). }
    إذا (مهملات != عدم) { احذف_شجرة(مهملات). حرر_نص(مهملات). }
    إذا (سجل != عدم) { احذف_شجرة(سجل). حرر_نص(سجل). }
}

// يعالج سطر ملف من سجل عملية منقطعة. ملتزمة: القاعدة تسجل الحزمة بتجزئتها.
منطقي استعد_ملفا(نص سطر، منطقي تثبيت، منطقي ملتزمة) {
    إذا (عدد_ألسنة(سطر) != ٣ || !يبدأ_ب(سطر، "ملف\ت")) { إرجع خطأ. }
    نص رقم = حقل_أرشيف(سطر، ١).
    نص تجزئة = حقل_أرشيف(سطر، ٢).
    نص مسار = حقل_أرشيف(سطر، ٣).
    منطقي صالح = أرقام_فقط(رقم) && تجزئة_سداسية_صالحة_طقم(تجزئة) && مسار_طقم_صالح(مسار).
    نص هدف = عدم.
    إذا (صالح) { هدف = ضم_مسار(جذر_بيئة_حالية، مسار). صالح = هدف != عدم. }
    إذا (صالح && تثبيت && !ملتزمة && ملف_موجود_طقم(هدف)) {
        // ملف نقله التثبيت المنقطع: يُحذف إن كان هو نفسه.
        نص فعلية = تجزئة_ملف_شا٢٥٦(هدف).
        إذا (فعلية != عدم && قارن_نص(فعلية، تجزئة) == ٠) { صالح = احذف_شجرة(هدف) == ٠. }
        إذا (فعلية != عدم) { حرر_نص(فعلية). }
    }
    إذا (صالح && !تثبيت && ملتزمة) {
        // الحذف لم يلتزم: يعود كل ملف نُقل إلى المهملات. ملف بالمسار نفسه
        // يُقبل إن طابق تجزئته، وإلا يوقف الاستعادة ليقرر المستخدم.
        نص مهمل = مسار_داخلي("مهملات").
        مهمل = ضم_وحرر_يسار_طقم(مهمل، رقم).
        إذا (ملف_موجود_طقم(مهمل) && ملف_موجود_طقم(هدف)) {
            نص فعلية = تجزئة_ملف_شا٢٥٦(هدف).
            صالح = فعلية != عدم && قارن_نص(فعلية، تجزئة) == ٠.
            إذا (فعلية != عدم) { حرر_نص(فعلية). }
            إذا (!صالح) {
                اطبع_منسق("[خطأ] %ن أُنشئ بعد حذف منقطع ويمنع إعادة الأصل من %ن\س"، هدف، مهمل).
            }
        }
        وإلا إذا (ملف_موجود_طقم(مهمل)) {
            نص مجلد = مجلد_مسار(هدف).
            صالح = مجلد != عدم && انشئ_مجلدات(مجلد) == ٠ && انقل_مسار(مهمل، هدف) == ٠.
            إذا (مجلد != عدم) { حرر_نص(مجلد). }
        }
        إذا (مهمل != عدم) { حرر_نص(مهمل). }
    }
    إذا (رقم != عدم) { حرر_نص(رقم). }
    إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    إذا (هدف != عدم) { حرر_نص(هدف). }
    إرجع صالح.
}

// يكمل عملية انقطعت أو يتراجع عنها، ثم يحذف المؤقتات. يتطلب القفل.
منطقي استعد_بيئة() {
    متجه أسطر = أنشئ_متجه(حجم(نص)).
    إذا (أسطر == عدم) { إرجع خطأ. }
    نص سجل = مسار_داخلي("سجل").
    صحيح قراءة = اقرأ_أسطر_برأس(سجل، رأس_سجل_البيئة، أسطر).
    إذا (سجل != عدم) { حرر_نص(سجل). }
    منطقي صالح = قراءة >= ٠.
    إذا (قراءة == ٠) {
        منطقي تثبيت = طول_متجه(أسطر) >= ٢ &&
                       قارن_نص(عنصر_نصي(أسطر، ٠)، "عملية\تتثبيت") == ٠.
        منطقي حذف = طول_متجه(أسطر) >= ٢ &&
                     قارن_نص(عنصر_نصي(أسطر، ٠)، "عملية\تحذف") == ٠.
        صالح = (تثبيت || حذف) && عدد_ألسنة(عنصر_نصي(أسطر، ١)) == ٢ &&
               يبدأ_ب(عنصر_نصي(أسطر، ١)، "حزمة\ت").
        نص اسم = عدم.
        نص تجزئة = عدم.
        إذا (صالح) {
            اسم = حقل_أرشيف(عنصر_نصي(أسطر، ١)، ١).
            تجزئة = حقل_أرشيف(عنصر_نصي(أسطر، ١)، ٢).
            صالح = هوية_حزمة_عربية(اسم) && تجزئة_سداسية_صالحة_طقم(تجزئة).
        }
        منطقي ملتزمة = خطأ.
        إذا (صالح) {
            صالح = حمل_قاعدة().
            صحيح فهرس = -١.
            إذا (صالح) { فهرس = حزمة_في_قاعدة(اسم). }
            ملتزمة = فهرس >= ٠ && حقل_يساوي(عنصر_نصي(أسطر_قاعدة، فهرس)، ٤، تجزئة).
        }
        صحيح م = ٢.
        طالما (صالح && م < طول_متجه(أسطر)) {
            صالح = استعد_ملفا(عنصر_نصي(أسطر، م)، تثبيت، ملتزمة).
            م = م + ١.
        }
        إذا (صالح) {
            إذا (تثبيت && ملتزمة) {
                اطبع_منسق("[ملاحظة] اكتمل تثبيت منقطع للأداة %ن في البيئة %ن.\س"، اسم، اسم_بيئة_حالية).
            }
            وإلا إذا (تثبيت) {
                اطبع_منسق("[ملاحظة] تراجع تكوين عن تثبيت منقطع للأداة %ن في البيئة %ن.\س"، اسم، اسم_بيئة_حالية).
            }
            وإلا إذا (ملتزمة) {
                اطبع_منسق("[ملاحظة] تراجع تكوين عن حذف منقطع للأداة %ن من البيئة %ن.\س"، اسم، اسم_بيئة_حالية).
            }
            وإلا {
                اطبع_منسق("[ملاحظة] اكتمل حذف منقطع للأداة %ن من البيئة %ن.\س"، اسم، اسم_بيئة_حالية).
            }
        }
        إذا (اسم != عدم) { حرر_نص(اسم). }
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    }
    حرر_وسائط(أسطر).
    إذا (!صالح) {
        اطبع_منسق("[خطأ] تعذرت استعادة البيئة %ن من سجلها: %ن\س"، اسم_بيئة_حالية، داخل_بيئة_حالية).
        إرجع خطأ.
    }
    امسح_مؤقتات_بيئة().
    إرجع صواب.
}

// ---------------------------------------------------------------------------
// المخزن
// ---------------------------------------------------------------------------

// أسطر إيصال مدخل المخزن من الجرد المحمل.
متجه أسطر_إيصال_أداة(نص تجزئة) {
    متجه أسطر = أنشئ_متجه(حجم(نص)).
    إذا (أسطر == عدم) { إرجع عدم. }
    منطقي صالح = اضف_وسيط_مملوك(أسطر، نسق("أرشيف\ت%ن"، تجزئة)) &&
                  اضف_وسيط_مملوك(أسطر، نسق("اسم\ت%ن"، اسم_جرد_أرشيف())) &&
                  اضف_وسيط_مملوك(أسطر، نسق("إصدار\ت%ن"، إصدار_جرد_أرشيف())) &&
                  اضف_وسيط_مملوك(أسطر، نسق("مضيف\ت%ن"، مضيف_جرد_أرشيف())).
    إذا (!صالح) { حرر_وسائط(أسطر). إرجع عدم. }
    إرجع أسطر.
}

منطقي إيصال_أداة_صالح(نص جذر، نص تجزئة) {
    متجه متوقعة = أسطر_إيصال_أداة(تجزئة).
    متجه فعلية = أنشئ_متجه(حجم(نص)).
    نص مسار = ضم_مسار(جذر، اسم_إيصال_الأداة).
    منطقي صالح = متوقعة != عدم && فعلية != عدم &&
                  اقرأ_أسطر_برأس(مسار، رأس_إيصال_الأداة، فعلية) == ٠ &&
                  طول_متجه(فعلية) == طول_متجه(متوقعة).
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(متوقعة)) {
        صالح = قارن_نص(عنصر_نصي(فعلية، م)، عنصر_نصي(متوقعة، م)) == ٠.
        م = م + ١.
    }
    إذا (متوقعة != عدم) { حرر_وسائط(متوقعة). }
    إذا (فعلية != عدم) { حرر_وسائط(فعلية). }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    إرجع صالح.
}

// يضمن مدخل المخزن لأرشيف موثق ويحمل جرد الأداة. يتطلب القفل.
صحيح جهز_مدخل_مخزن(نص أرشيف، نص تجزئة، نص مدخل) {
    اضبط_نوع_أرشيف(١).
    نص مخزن = ضم_مسار(جذر_أدوات_حالي، "مخزن").
    نص بيانات = ضم_مسار(مدخل، اسم_بيانات_أداة_بيئة).
    إذا (مخزن == عدم || بيانات == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    صحيح كود = كود_تكوين_نجاح.
    إذا (ملف_موجود_طقم(بيانات)) {
        منطقي صالح = حلل_بيانات_طقم(بيانات) && إيصال_أداة_صالح(مدخل، تجزئة) &&
                      قارن_نص(مضيف_جرد_أرشيف()، مضيف_تكوين()) == ٠.
        إذا (!صالح) {
            اطبع_منسق("[خطأ] مدخل مخزن الأدوات تالف: %ن\س"، مدخل).
            اطبع "[ملاحظة] احذف هذا المجلد ثم أعد التثبيت.".
            كود = كود_تكوين_خطأ_عام.
        }
    }
    وإلا {
        نص مرحلة = ضم_مسار(مخزن، ".مؤقت").
        إذا (مرحلة == عدم || انشئ_مجلدات(مخزن) != ٠) {
            اطبع_منسق("[خطأ] تعذر إنشاء مخزن الأدوات: %ن\س"، مخزن).
            كود = كود_تكوين_خطأ_عام.
        }
        إذا (كود == كود_تكوين_نجاح) { كود = فك_أرشيف_طقم(أرشيف، مخزن، مرحلة). }
        إذا (كود == كود_تكوين_نجاح) {
            متجه إيصال = أسطر_إيصال_أداة(تجزئة).
            نص مسار_إيصال = ضم_مسار(جذر_مرحلة_أرشيف()، اسم_إيصال_الأداة).
            إذا (إيصال == عدم || !اكتب_أسطر_ذريا(مسار_إيصال، رأس_إيصال_الأداة، إيصال)) {
                اطبع "[خطأ] تعذر كتابة إيصال الأداة.".
                كود = كود_تكوين_خطأ_عام.
            }
            إذا (إيصال != عدم) { حرر_وسائط(إيصال). }
            إذا (مسار_إيصال != عدم) { حرر_نص(مسار_إيصال). }
        }
        إذا (كود == كود_تكوين_نجاح && انقل_مسار(جذر_مرحلة_أرشيف()، مدخل) != ٠) {
            اطبع_منسق("[خطأ] تعذر نشر الأداة في المخزن: %ن\س"، مدخل).
            كود = كود_تكوين_خطأ_عام.
        }
        انه_فك_أرشيف().
        إذا (مرحلة != عدم) { احذف_شجرة(مرحلة). حرر_نص(مرحلة). }
    }
    حرر_نص(مخزن).
    حرر_نص(بيانات).
    إرجع كود.
}

// ---------------------------------------------------------------------------
// التثبيت
// ---------------------------------------------------------------------------

// تجزئة الأرشيف بعد مطابقتها للمتوقعة (--تجزئة أو <أرشيف>.sha256)، أو عدم.
نص تجزئة_أرشيف_موثقة(نص أرشيف، نص مطلوبة، صحيح* كود) {
    *كود = كود_تكوين_خطأ_عام.
    نص متوقعة = عدم.
    إذا (مطلوبة != عدم) { متوقعة = نسخ_نص(مطلوبة). }
    وإلا { متوقعة = تجزئة_ملف_جانبي_طقم(أرشيف). }
    إذا (!تجزئة_سداسية_صالحة_طقم(متوقعة)) {
        إذا (متوقعة != عدم) { حرر_نص(متوقعة). }
        إذا (مطلوبة != عدم) {
            اطبع "[خطأ] --تجزئة تتطلب SHA-256 من ٦٤ خانة hex صغيرة.".
            *كود = كود_تكوين_خطأ_استخدام.
        }
        وإلا {
            اطبع_منسق("[خطأ] لا تجزئة متوقعة للأرشيف؛ مرر --تجزئة أو ضع %ن.sha256 بجواره.\س"، أرشيف).
        }
        إرجع عدم.
    }
    نص فعلية = تجزئة_ملف_شا٢٥٦(أرشيف).
    إذا (فعلية == عدم) {
        اطبع_منسق("[خطأ] تعذر قراءة الأرشيف: %ن\س"، أرشيف).
    }
    وإلا إذا (قارن_نص(فعلية، متوقعة) != ٠) {
        اطبع_منسق("[خطأ] تجزئة الأرشيف %ن لا تطابق المتوقعة %ن.\س"، فعلية، متوقعة).
        حرر_نص(فعلية).
        فعلية = عدم.
    }
    حرر_نص(متوقعة).
    إذا (فعلية != عدم) { *كود = كود_تكوين_نجاح. }
    إرجع فعلية.
}

// ينشئ البيئة الحالية إن غابت. يتطلب القفل.
منطقي أنشئ_بيئة_مقفلة() {
    إذا (بيئة_موجودة()) { إرجع حدث_فهرس_بيئات(صواب). }
    متجه فارغة = أنشئ_متجه(حجم(نص)).
    نص قاعدة = مسار_داخلي("قاعدة").
    منطقي صالح = فارغة != عدم && قاعدة != عدم && انشئ_مجلدات(داخل_بيئة_حالية) == ٠ &&
                  اكتب_أسطر_ذريا(قاعدة، رأس_قاعدة_البيئة، فارغة).
    إذا (!صالح) { اطبع_منسق("[خطأ] تعذر إنشاء البيئة %ن: %ن\س"، اسم_بيئة_حالية، جذر_بيئة_حالية). }
    صالح = صالح && حدث_فهرس_بيئات(صواب).
    إذا (فارغة != عدم) { حرر_وسائط(فارغة). }
    إذا (قاعدة != عدم) { حرر_نص(قاعدة). }
    إرجع صالح.
}

// يفحص كل ملف في الجرد: مملوك لأداة أخرى أو موجود بلا مالك تعارض. يعد التعارضات.
صحيح افحص_تعارضات() {
    صحيح تعارضات = ٠.
    صحيح م = ٠.
    طالما (م < عدد_جرد_أرشيف()) {
        نص مسار = مسار_جرد_طقم(م).
        نص مالك = مالك_مسار(مسار).
        إذا (مالك != عدم) {
            اطبع_منسق("[خطأ] تعارض: %ن تملكه الأداة %ن.\س"، مسار، مالك).
            تعارضات = تعارضات + ١.
        }
        وإلا {
            نص هدف = ضم_مسار(جذر_بيئة_حالية، مسار).
            إذا (ملف_موجود_طقم(هدف)) {
                اطبع_منسق("[خطأ] تعارض: %ن موجود في البيئة ولا تملكه أداة.\س"، مسار).
                تعارضات = تعارضات + ١.
            }
            إذا (هدف != عدم) { حرر_نص(هدف). }
        }
        م = م + ١.
    }
    إرجع تعارضات.
}

// ينسخ ملفات الأداة من المخزن إلى مرحلة/<رقم> ويتحقق من تجزئاتها.
منطقي جهز_ملفات_مرحلة(نص مدخل، متجه سجل) {
    نص مرحلة = مسار_داخلي("مرحلة").
    منطقي صالح = مرحلة != عدم && احذف_شجرة(مرحلة) == ٠ && انشئ_مجلدات(مرحلة) == ٠.
    إذا (مرحلة != عدم) { حرر_نص(مرحلة). }
    صحيح م = ٠.
    طالما (صالح && م < عدد_جرد_أرشيف()) {
        نص مسار = مسار_جرد_طقم(م).
        نص مصدر = ضم_مسار(مدخل، مسار).
        نص وجهة = مسار_مرقم("مرحلة"، م).
        نص فعلية = عدم.
        صالح = مصدر != عدم && وجهة != عدم && انسخ_ملفا_ببايتاته(مصدر، وجهة).
        إذا (صالح) { فعلية = تجزئة_ملف_شا٢٥٦(وجهة). }
        صالح = صالح && فعلية != عدم && قارن_نص(فعلية، تجزئة_جرد_طقم(م)) == ٠.
        إذا (صالح && تنفيذي_جرد_أرشيف(م)) { صالح = اجعل_قابلا_للتنفيذ(وجهة) == ٠. }
        إذا (صالح) {
            صالح = اضف_وسيط_مملوك(سجل، نسق("ملف\ت%ص\ت%ن\ت%ن"، م، تجزئة_جرد_طقم(م)، مسار)).
        }
        إذا (!صالح) { اطبع_منسق("[خطأ] تعذر تجهيز %ن من مخزن الأدوات.\س"، مسار). }
        إذا (مصدر != عدم) { حرر_نص(مصدر). }
        إذا (وجهة != عدم) { حرر_نص(وجهة). }
        إذا (فعلية != عدم) { حرر_نص(فعلية). }
        م = م + ١.
    }
    إرجع صالح.
}

// ينقل مرحلة/<رقم> إلى مسار كل ملف. عند الفشل يحذف ما نُقل فيبقى ما كان.
منطقي انقل_ملفات_مرحلة() {
    صحيح م = ٠.
    منطقي صالح = صواب.
    طالما (صالح && م < عدد_جرد_أرشيف()) {
        نص مصدر = مسار_مرقم("مرحلة"، م).
        نص هدف = ضم_مسار(جذر_بيئة_حالية، مسار_جرد_طقم(م)).
        نص مجلد = عدم.
        صالح = مصدر != عدم && هدف != عدم.
        إذا (صالح) { مجلد = مجلد_مسار(هدف). صالح = مجلد != عدم. }
        صالح = صالح && انشئ_مجلدات(مجلد) == ٠ && انقل_مسار(مصدر، هدف) == ٠.
        إذا (!صالح) {
            اطبع_منسق("[خطأ] تعذر وضع %ن في البيئة؛ تراجع التثبيت.\س"، مسار_جرد_طقم(م)).
        }
        إذا (مصدر != عدم) { حرر_نص(مصدر). }
        إذا (هدف != عدم) { حرر_نص(هدف). }
        إذا (مجلد != عدم) { حرر_نص(مجلد). }
        إذا (صالح) { م = م + ١. }
    }
    إذا (صالح) { إرجع صواب. }
    طالما (م > ٠) {
        م = م - ١.
        نص هدف = ضم_مسار(جذر_بيئة_حالية، مسار_جرد_طقم(م)).
        إذا (هدف != عدم) { احذف_شجرة(هدف). حرر_نص(هدف). }
    }
    إرجع خطأ.
}

// كتلة الحزمة في القاعدة من الجرد المحمل.
متجه كتلة_حزمة(نص تجزئة) {
    متجه كتلة = أنشئ_متجه(حجم(نص)).
    إذا (كتلة == عدم) { إرجع عدم. }
    نص اسم = اسم_جرد_أرشيف().
    منطقي صالح = اضف_وسيط_مملوك(كتلة، نسق("حزمة\ت%ن\ت%ن\ت%ن\ت%ن"، اسم،
                                              إصدار_جرد_أرشيف()، مضيف_جرد_أرشيف()، تجزئة)).
    صحيح م = ٠.
    طالما (صالح && م < عدد_جرد_أرشيف()) {
        نص تنفيذي = "0".
        إذا (تنفيذي_جرد_أرشيف(م)) { تنفيذي = "1". }
        صالح = اضف_وسيط_مملوك(كتلة، نسق("ملف\ت%ن\ت%ن\ت%ن\ت%ن"، اسم، تجزئة_جرد_طقم(م)،
                                          تنفيذي، مسار_جرد_طقم(م))).
        م = م + ١.
    }
    إذا (!صالح) { حرر_وسائط(كتلة). إرجع عدم. }
    إرجع كتلة.
}

// يثبت أداة من المخزن في البيئة بعد الفحص المسبق. يتطلب القفل والجرد المحمل.
صحيح ثبت_في_البيئة(نص تجزئة، نص مدخل) {
    نص اسم = اسم_جرد_أرشيف().
    إذا (!حمل_قاعدة()) { إرجع كود_تكوين_خطأ_عام. }
    صحيح فهرس = حزمة_في_قاعدة(اسم).
    إذا (فهرس >= ٠) {
        إذا (حقل_يساوي(عنصر_نصي(أسطر_قاعدة، فهرس)، ٤، تجزئة)) {
            اطبع_منسق("[تم] الأداة %ن %ن مثبتة مسبقا في البيئة %ن.\س"،
                       اسم، إصدار_جرد_أرشيف()، اسم_بيئة_حالية).
            إرجع كود_تكوين_نجاح.
        }
        اطبع_منسق("[خطأ] الأداة %ن مثبتة في البيئة %ن من أرشيف آخر.\س"، اسم، اسم_بيئة_حالية).
        اطبع_منسق("[ملاحظة] احذفها أولا: تكوين أداة احذف %ن --بيئة %ن\س"، اسم، اسم_بيئة_حالية).
        إرجع كود_تكوين_خطأ_عام.
    }

    ابدأ_أحداث_مرحلة("preflight").
    صحيح تعارضات = افحص_تعارضات().
    إذا (تعارضات > ٠) {
        اطبع_منسق("[خطأ] لم تُثبت الأداة %ن: %ص تعارضا، ولم يتغير شيء في البيئة.\س"، اسم، تعارضات).
        انه_أحداث_مرحلة("preflight"، كود_تكوين_خطأ_عام).
        إرجع كود_تكوين_خطأ_عام.
    }
    انه_أحداث_مرحلة("preflight"، كود_تكوين_نجاح).

    ابدأ_أحداث_مرحلة("stage").
    متجه سجل = أنشئ_متجه(حجم(نص)).
    منطقي صالح = سجل != عدم && جهز_ملفات_مرحلة(مدخل، سجل).
    صالح = صالح && اكتب_سجل("تثبيت"، اسم، تجزئة، سجل).
    إذا (سجل != عدم) { حرر_وسائط(سجل). }
    إذا (!صالح) {
        امسح_مؤقتات_بيئة().
        انه_أحداث_مرحلة("stage"، كود_تكوين_خطأ_عام).
        إرجع كود_تكوين_خطأ_عام.
    }
    انه_أحداث_مرحلة("stage"، كود_تكوين_نجاح).

    ابدأ_أحداث_مرحلة("commit").
    إذا (!انقل_ملفات_مرحلة()) {
        امسح_مؤقتات_بيئة().
        انه_أحداث_مرحلة("commit"، كود_تكوين_خطأ_عام).
        إرجع كود_تكوين_خطأ_عام.
    }
    نقطة_عطل("install-after-move").
    انه_أحداث_مرحلة("commit"، كود_تكوين_نجاح).

    ابدأ_أحداث_مرحلة("database").
    متجه كتلة = كتلة_حزمة(تجزئة).
    صالح = كتلة != عدم && اكتب_قاعدة(اسم، كتلة).
    إذا (كتلة != عدم) { حرر_وسائط(كتلة). }
    إذا (!صالح) {
        // القاعدة لم تتغير: السجل يتراجع عن الملفات المنقولة.
        استعد_بيئة().
        انه_أحداث_مرحلة("database"، كود_تكوين_خطأ_عام).
        إرجع كود_تكوين_خطأ_عام.
    }
    امسح_مؤقتات_بيئة().
    انه_أحداث_مرحلة("database"، كود_تكوين_نجاح).
    اطبع_منسق("[تم] ثُبتت الأداة %ن %ن (%ص ملفا) في البيئة %ن: %ن\س"، اسم، إصدار_جرد_أرشيف()،
               عدد_جرد_أرشيف()، اسم_بيئة_حالية، جذر_بيئة_حالية).
    إرجع كود_تكوين_نجاح.
}

صحيح ثبت_أداة_مقفلة(نص أرشيف، نص تجزئة) {
    إذا (!بيئة_موجودة()) {
        إذا (قارن_نص(اسم_بيئة_حالية، البيئة_الافتراضية) != ٠) {
            اطبع_منسق("[خطأ] البيئة %ن غير موجودة؛ أنشئها: تكوين بيئة أنشئ %ن\س"،
                       اسم_بيئة_حالية، اسم_بيئة_حالية).
            إرجع كود_تكوين_خطأ_عام.
        }
        إذا (!أنشئ_بيئة_مقفلة()) { إرجع كود_تكوين_خطأ_عام. }
    }
    إذا (!استعد_بيئة()) { إرجع كود_تكوين_خطأ_عام. }

    ابدأ_أحداث_مرحلة("store").
    نص مدخل = ضم_مسار(جذر_أدوات_حالي، "مخزن").
    مدخل = ضم_وحرر_يسار_طقم(مدخل، تجزئة).
    صحيح كود = كود_تكوين_خطأ_داخلي.
    إذا (مدخل != عدم) { كود = جهز_مدخل_مخزن(أرشيف، تجزئة، مدخل). }
    انه_أحداث_مرحلة("store"، كود).
    إذا (كود == كود_تكوين_نجاح) {
        نص اسم = نسخ_نص(اسم_جرد_أرشيف()).
        اصدر_حدث_حزمة("package_started"، اسم، ٠).
        كود = ثبت_في_البيئة(تجزئة، مدخل).
        اصدر_حدث_حزمة("package_finished"، اسم، كود).
        حرر_نص(اسم).
    }
    إذا (مدخل != عدم) { حرر_نص(مدخل). }
    إرجع كود.
}

صحيح ثبت_أداة(نص أرشيف، نص تجزئة_مطلوبة) {
    ابدأ_أحداث_مرحلة("verify_archive").
    صحيح كود = كود_تكوين_نجاح.
    نص تجزئة = تجزئة_أرشيف_موثقة(أرشيف، تجزئة_مطلوبة، &كود).
    انه_أحداث_مرحلة("verify_archive"، كود).
    إذا (تجزئة == عدم) { إرجع كود. }
    إذا (!اقفل_الأدوات()) { حرر_نص(تجزئة). إرجع كود_تكوين_خطأ_عام. }
    كود = ثبت_أداة_مقفلة(أرشيف، تجزئة).
    امسح_قاعدة().
    افتح_قفل_الطقوم(جذر_أدوات_حالي).
    حرر_نص(تجزئة).
    إرجع كود.
}

// ---------------------------------------------------------------------------
// الحذف
// ---------------------------------------------------------------------------

// يجمع ملفات الحزمة التي تطابق تجزئاتها في سجل الحذف. المعدل والغائب يبقيان.
منطقي اجمع_ملفات_حذف(صحيح بداية، صحيح نهاية، متجه سجل) {
    منطقي صالح = صواب.
    صحيح م = بداية + ١.
    طالما (صالح && م < نهاية) {
        نص سطر = عنصر_نصي(أسطر_قاعدة، م).
        نص تجزئة = حقل_أرشيف(سطر، ٢).
        نص مسار = حقل_أرشيف(سطر، ٤).
        نص هدف = ضم_مسار(جذر_بيئة_حالية، مسار).
        صالح = تجزئة != عدم && مسار != عدم && هدف != عدم.
        إذا (صالح && !ملف_موجود_طقم(هدف)) {
            اطبع_منسق("[ملاحظة] %ن غائب عن البيئة مسبقا.\س"، مسار).
        }
        وإلا إذا (صالح) {
            نص فعلية = تجزئة_ملف_شا٢٥٦(هدف).
            إذا (فعلية != عدم && قارن_نص(فعلية، تجزئة) == ٠) {
                صالح = اضف_وسيط_مملوك(سجل، نسق("ملف\ت%ص\ت%ن\ت%ن"، طول_متجه(سجل)، تجزئة، مسار)).
            }
            وإلا {
                اطبع_منسق("[تحذير] %ن معدل بعد التثبيت؛ أُبقي في البيئة بلا مالك.\س"، مسار).
            }
            إذا (فعلية != عدم) { حرر_نص(فعلية). }
        }
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إذا (هدف != عدم) { حرر_نص(هدف). }
        م = م + ١.
    }
    إرجع صالح.
}

// ينقل كل ملف في سجل الحذف إلى مهملات/<رقم>، ويعيد ما نُقل عند الفشل.
منطقي انقل_إلى_المهملات(متجه سجل) {
    نص مهملات = مسار_داخلي("مهملات").
    منطقي صالح = مهملات != عدم && احذف_شجرة(مهملات) == ٠ && انشئ_مجلدات(مهملات) == ٠.
    إذا (مهملات != عدم) { حرر_نص(مهملات). }
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(سجل)) {
        نص مسار = حقل_أرشيف(عنصر_نصي(سجل، م)، ٣).
        نص هدف = ضم_مسار(جذر_بيئة_حالية، مسار).
        نص مهمل = مسار_مرقم("مهملات"، م).
        صالح = مسار != عدم && هدف != عدم && مهمل != عدم && انقل_مسار(هدف، مهمل) == ٠.
        إذا (!صالح) { اطبع_منسق("[خطأ] تعذر حذف %ن؛ تراجع الحذف.\س"، مسار). }
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إذا (هدف != عدم) { حرر_نص(هدف). }
        إذا (مهمل != عدم) { حرر_نص(مهمل). }
        إذا (صالح) { م = م + ١. }
    }
    إذا (صالح) { إرجع صواب. }
    طالما (م > ٠) {
        م = م - ١.
        نص مسار = حقل_أرشيف(عنصر_نصي(سجل، م)، ٣).
        نص هدف = ضم_مسار(جذر_بيئة_حالية، مسار).
        نص مهمل = مسار_مرقم("مهملات"، م).
        إذا (هدف != عدم && مهمل != عدم) { انقل_مسار(مهمل، هدف). }
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إذا (هدف != عدم) { حرر_نص(هدف). }
        إذا (مهمل != عدم) { حرر_نص(مهمل). }
    }
    إرجع خطأ.
}

صحيح احذف_أداة_مقفلة(نص اسم) {
    إذا (!بيئة_موجودة()) {
        اطبع_منسق("[خطأ] البيئة %ن غير موجودة.\س"، اسم_بيئة_حالية).
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (!استعد_بيئة() || !حمل_قاعدة()) { إرجع كود_تكوين_خطأ_عام. }
    صحيح بداية = حزمة_في_قاعدة(اسم).
    إذا (بداية < ٠) {
        اطبع_منسق("[خطأ] الأداة %ن غير مثبتة في البيئة %ن.\س"، اسم، اسم_بيئة_حالية).
        إرجع كود_تكوين_خطأ_عام.
    }
    اصدر_حدث_حزمة("package_started"، اسم، ٠).
    نص تجزئة = حقل_أرشيف(عنصر_نصي(أسطر_قاعدة، بداية)، ٤).

    ابدأ_أحداث_مرحلة("preflight").
    متجه سجل = أنشئ_متجه(حجم(نص)).
    منطقي صالح = سجل != عدم && تجزئة != عدم &&
                  اجمع_ملفات_حذف(بداية، نهاية_حزمة(بداية)، سجل).
    صالح = صالح && اكتب_سجل("حذف"، اسم، تجزئة، سجل).
    صحيح كود = كود_تكوين_نجاح.
    إذا (!صالح) { كود = كود_تكوين_خطأ_عام. امسح_مؤقتات_بيئة(). }
    انه_أحداث_مرحلة("preflight"، كود).

    إذا (كود == كود_تكوين_نجاح) {
        ابدأ_أحداث_مرحلة("commit").
        إذا (!انقل_إلى_المهملات(سجل)) { كود = كود_تكوين_خطأ_عام. امسح_مؤقتات_بيئة(). }
        وإلا { نقطة_عطل("remove-after-move"). }
        انه_أحداث_مرحلة("commit"، كود).
    }
    إذا (كود == كود_تكوين_نجاح) {
        ابدأ_أحداث_مرحلة("database").
        إذا (!اكتب_قاعدة(اسم، عدم)) {
            // الحذف لم يلتزم: السجل يعيد الملفات من المهملات.
            استعد_بيئة().
            كود = كود_تكوين_خطأ_عام.
        }
        وإلا { امسح_مؤقتات_بيئة(). }
        انه_أحداث_مرحلة("database"، كود).
    }
    إذا (كود == كود_تكوين_نجاح) {
        اطبع_منسق("[تم] حُذفت الأداة %ن من البيئة %ن.\س"، اسم، اسم_بيئة_حالية).
    }
    اصدر_حدث_حزمة("package_finished"، اسم، كود).
    إذا (سجل != عدم) { حرر_وسائط(سجل). }
    إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    إرجع كود.
}

صحيح احذف_أداة(نص اسم) {
    إذا (!اقفل_الأدوات()) { إرجع كود_تكوين_خطأ_عام. }
    صحيح كود = احذف_أداة_مقفلة(اسم).
    امسح_قاعدة().
    افتح_قفل_الطقوم(جذر_أدوات_حالي).
    إرجع كود.
}

// ---------------------------------------------------------------------------
// العرض
// ---------------------------------------------------------------------------

صحيح اعرض_الأدوات(منطقي جسون) {
    إذا (!بيئة_موجودة() && قارن_نص(اسم_بيئة_حالية، البيئة_الافتراضية) != ٠) {
        اطبع_منسق("[خطأ] البيئة %ن غير موجودة.\س"، اسم_بيئة_حالية).
        إرجع كود_تكوين_خطأ_عام.
    }
    // البيئة الافتراضية قبل أول تثبيت فارغة.
    منطقي فارغة = !بيئة_موجودة().
    إذا (!فارغة && !حمل_قاعدة()) { إرجع كود_تكوين_خطأ_عام. }
    نص جذر_آمن = هرب_جسون_خطة(جذر_بيئة_حالية).
    إذا (جسون) {
        اطبع "{".
        اطبع "  \"schema_version\": \"takween-tool-list-v1\",".
        اطبع_منسق("  \"environment\": \"%ن\",\س"، اسم_بيئة_حالية).
        اطبع_منسق("  \"path\": \"%ن\",\س"، جذر_آمن).
        اطبع "  \"tools\": [".
    }
    صحيح معروض = ٠.
    نص سابق = عدم.
    صحيح م = ٠.
    طالما (!فارغة && م < طول_متجه(أسطر_قاعدة)) {
        نص سطر = عنصر_نصي(أسطر_قاعدة، م).
        إذا (سطر_حزمة(سطر)) {
            نص اسم = حقل_أرشيف(سطر، ١).
            نص إصدار = حقل_أرشيف(سطر، ٢).
            نص مضيف = حقل_أرشيف(سطر، ٣).
            نص تجزئة = حقل_أرشيف(سطر، ٤).
            صحيح ملفات = نهاية_حزمة(م) - م - ١.
            إذا (جسون) {
                إذا (سابق != عدم) { اطبع_منسق("%ن,\س"، سابق). حرر_نص(سابق). }
                سابق = نسق("    {\"name\": \"%ن\", \"version\": \"%ن\", \"host\": \"%ن\", \"archive_sha256\": \"%ن\", \"files\": %ص}"،
                           اسم، إصدار، مضيف، تجزئة، ملفات).
            }
            وإلا { اطبع_منسق("%ن\ت%ن\ت%ن\ت%ص\س"، اسم، إصدار، مضيف، ملفات). }
            معروض = معروض + ١.
            حرر_نص(اسم). حرر_نص(إصدار). حرر_نص(مضيف). حرر_نص(تجزئة).
        }
        م = م + ١.
    }
    إذا (جسون) {
        إذا (سابق != عدم) { اطبع سابق. حرر_نص(سابق). }
        اطبع "  ]".
        اطبع "}".
    }
    وإلا إذا (معروض == ٠) {
        اطبع_منسق("لا توجد أدوات مثبتة في البيئة %ن.\س"، اسم_بيئة_حالية).
    }
    إذا (جذر_آمن != عدم) { حرر_نص(جذر_آمن). }
    امسح_قاعدة().
    إرجع كود_تكوين_نجاح.
}

// مالك مسار نسبي داخل البيئة. يقبل '\' فاصلا. غير المملوك ينتهي بالكود ١.
صحيح اعرض_مالك(نص مدخل، منطقي جسون) {
    نص مسار = طبع_مسار(مدخل).
    إذا (مسار == عدم || !مسار_طقم_صالح(مسار)) {
        اطبع_منسق("[خطأ] مسار غير صالح داخل البيئة: %ن\س"، مدخل).
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إرجع كود_تكوين_خطأ_استخدام.
    }
    إذا (!حمل_قاعدة()) { حرر_نص(مسار). إرجع كود_تكوين_خطأ_عام. }
    نص مالك = مالك_مسار(مسار).
    إذا (جسون) {
        اطبع "{".
        اطبع "  \"schema_version\": \"takween-tool-owner-v1\",".
        اطبع_منسق("  \"environment\": \"%ن\",\س"، اسم_بيئة_حالية).
        اطبع_منسق("  \"path\": \"%ن\",\س"، مسار).
        إذا (مالك != عدم) { اطبع_منسق("  \"owner\": \"%ن\"\س"، مالك). }
        وإلا { اطبع "  \"owner\": null". }
        اطبع "}".
    }
    وإلا إذا (مالك != عدم) { اطبع مالك. }
    وإلا { اطبع_منسق("[خطأ] لا تملك أداة %ن في البيئة %ن.\س"، مسار، اسم_بيئة_حالية). }
    صحيح كود = كود_تكوين_نجاح.
    إذا (مالك == عدم) { كود = كود_تكوين_خطأ_عام. }
    امسح_قاعدة().
    حرر_نص(مسار).
    إرجع كود.
}
