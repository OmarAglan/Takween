#تعريف كود_تكوين_نجاح 0
#تعريف كود_تكوين_خطأ_عام 1
#تعريف كود_تكوين_خطأ_استخدام 2
#تعريف كود_تكوين_غير_مدعوم 3
#تعريف كود_تكوين_فشل_أداة 4
#تعريف كود_تكوين_خطأ_داخلي 5

// Parser + Config Model
صحيح تحليل_ملف_تكوين(نص مسار).
عدم مسح_نموذج_تكوين().
عدم حدد_هدف_تكوين(نص اسم).
عدم حدد_نمط_تكوين(نص اسم).

نص احصل_تكوين_الاسم().
نص احصل_تكوين_الإصدار().
نص احصل_تكوين_النوع().
نص احصل_تكوين_المصدر().
نص احصل_تكوين_المخرج().
نص احصل_تكوين_الملفات().
صحيح احصل_تكوين_التحسين().
نص احصل_تكوين_النمط().
نص احصل_تكوين_الأعلام_الإضافية().
نص احصل_تكوين_المكتبات().
نص احصل_تكوين_مسارات_التضمين().
نص احصل_اسم_الهدف().
متجه احصل_اعتماديات_المسار().
منطقي تكوين_بيان_في1().
نص احصل_تكوين_هدف_باء().
نص احصل_تكوين_المجمع().
نص احصل_تكوين_اصدار_باء().
نص احصل_تكوين_قدرات_الهدف().
منطقي احصل_تكوين_التحقق().
نص احصل_اعضاء_مساحة_العمل().
منطقي تكوين_له_اختبارات().

// takween-build-events-v1 JSONL stream written to an explicit consumer file.
منطقي اضبط_ملف_أحداث(نص مسار).
منطقي أحداث_مفعلة().
عدم ابدأ_أحداث_عملية(نص عملية).
عدم انه_أحداث_عملية(صحيح كود).
عدم ابدأ_أحداث_مرحلة(نص مرحلة).
عدم انه_أحداث_مرحلة(نص مرحلة، صحيح كود).
عدم اصدر_حدث_هدف(نص نوع، نص اسم، صحيح كود).
عدم اصدر_حدث_حزمة(نص نوع، نص اسم، صحيح كود).
عدم اصدر_حدث_أثر(نص نوع_أثر، نص مسار).

// Semantic Versioning 2.0.0 + deterministic AND constraints.
منطقي اصدار_دلالي_صالح(نص قيمة).
صحيح قارن_اصدار_دلالي(نص يسار، نص يمين).
منطقي قيد_اصدار_دلالي_صالح(نص قيد).
منطقي يطابق_قيد_اصدار(نص إصدار، نص قيد).

// Target discovery internals
صحيح اكتشف_معلومات_الهدف().
عدم حدد_جذر_اكتشاف_الهدف(نص جذر).
نص لاحقة_تنفيذ_الهدف().
نص هدف_باء_فعلي().
نص اصدار_باء_فعلي().
منطقي تحقق_قيود_باء_والهدف().
منطقي تحقق_قدرات_بناء_الهدف().
منطقي هوية_حزمة_عربية(نص قيمة).
منطقي تحقق_هوية_حزمة_عربية(نص قيمة، نص موضع).

// Dependency resolver internals
صحيح حل_اعتماديات(متجه وسائط).
عدم حدد_وضع_مقفل(منطقي قيمة).
عدم حدد_وضع_دون_شبكة(منطقي قيمة).
عدم حدد_وضع_توريد(منطقي قيمة).
منطقي جهز_أرشيف_حزمة(نص مسار_أرشيف، نص تجزئة، نص مجلد_الحزم،
                       منطقي تحقق_فقط، نص* مسار_محتوى).
منطقي ورد_أرشيف_حزمة(نص مسار_أرشيف، نص تجزئة، نص اسم، نص إصدار).

// Target DAG: deterministic dependency-first order for the selected target.
متجه رتب_أهداف_البناء(نص اسم، صحيح* كود).

// Deterministic build plan. It owns argv and dependency-first target order.
نوع خطة_بناء = عدم*.
خطة_بناء ابن_خطة_البناء(متجه وسائط_محلولة، متجه ترتيب_الأهداف، نص مسار_الناتج،
                         نص علم_التحسين، صحيح* كود_الخطة).
خطة_بناء ابن_خطة_الفحص(متجه وسائط_محلولة، متجه ترتيب_الأهداف،
                        صحيح* كود_الخطة).
متجه وسائط_خطة_البناء(خطة_بناء خطة).
متجه ترتيب_خطة_البناء(خطة_بناء خطة).
متجه نمط_خطة_البناء(خطة_بناء خطة).
عدم حرر_خطة_البناء(خطة_بناء خطة).
نص خطة_بناء_إلى_جسون(خطة_بناء خطة، نص العملية).

// Content-addressed aggregate receipt over Baa's per-unit object cache.
صحيح ثبت_كاش_محتوى_البناء(خطة_بناء خطة).

// Commands
صحيح تنفيذ_تهيئة().
صحيح تنفيذ_بناء().
صحيح تنفيذ_فحص().
صحيح تنفيذ_عرض_خطة().
صحيح تنفيذ_تشغيل().
صحيح تنفيذ_تنظيف().
صحيح تنفيذ_تحقق_دون_شبكة().
صحيح تنفيذ_توريد().
صحيح تنفيذ_فهرس_مساحة_العمل().
صحيح تنفيذ_عملية_مساحة(نص عملية، نص حزمة، منطقي كل_الحزم،
                        نص نمط، منطقي مقفل، نص مشغل).
