#تعريف كود_تكوين_نجاح 0
#تعريف كود_تكوين_خطأ_عام 1
#تعريف كود_تكوين_خطأ_استخدام 2
#تعريف كود_تكوين_غير_مدعوم 3
#تعريف كود_تكوين_فشل_أداة 4
#تعريف كود_تكوين_خطأ_داخلي 5

// Parser + Config Model
صحيح تحليل_ملف_تكوين(نص مسار).
عدم مسح_نموذج_تكوين().

نص احصل_تكوين_الاسم().
نص احصل_تكوين_الإصدار().
نص احصل_تكوين_النوع().
نص احصل_تكوين_المصدر().
نص احصل_تكوين_المخرج().
نص احصل_تكوين_الملفات().
صحيح احصل_تكوين_التحسين().
نص احصل_تكوين_الأعلام_الإضافية().
نص احصل_تكوين_المكتبات().
نص احصل_تكوين_مسارات_التضمين().
متجه احصل_اعتماديات_المسار().
منطقي تكوين_بيان_في1().
نص احصل_تكوين_هدف_باء().
منطقي احصل_تكوين_التحقق().

// Semantic Versioning 2.0.0 + deterministic AND constraints.
منطقي اصدار_دلالي_صالح(نص قيمة).
صحيح قارن_اصدار_دلالي(نص يسار، نص يمين).
منطقي قيد_اصدار_دلالي_صالح(نص قيد).
منطقي يطابق_قيد_اصدار(نص إصدار، نص قيد).

// Target discovery internals
صحيح اكتشف_معلومات_الهدف().
نص لاحقة_تنفيذ_الهدف().
نص هدف_باء_فعلي().

// Dependency resolver internals
صحيح حل_اعتماديات(متجه وسائط).
عدم حدد_وضع_مقفل(منطقي قيمة).

// Commands
صحيح تنفيذ_تهيئة().
صحيح تنفيذ_بناء().
صحيح تنفيذ_فحص().
صحيح تنفيذ_تشغيل().
صحيح تنفيذ_تنظيف().
