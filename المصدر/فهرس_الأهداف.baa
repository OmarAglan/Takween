#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
منطقي يبدأ_ب(نص النص، نص البادئة).
نص احذف_تعليق_في1(نص سطر).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
نص قص_طرفين(نص قيمة).
نص اسم_قسم_فرعي(نص قسم، نص بادئة).
صحيح موضع_إسناد_في1(نص سطر).
نص حلل_نص_في1(نص خام).
نص حلل_مصفوفة_نصوص_في1(نص خام).
منطقي نوع_في1_مدعوم(نص قيمة).
عدم حرر_قائمة_نصوص(متجه قائمة).
عدم حدد_هدف_تكوين(نص اسم).
نص الصق_وحرر_يسار(نص يسار، نص يمين).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).

صحيح موضع_فاصل_هدف(نص سجل) {
    صحيح م = ٠.
    طالما (م < طول_نص(سجل)) {
        إذا (سجل[م] == '\ت') { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

صحيح موضع_فاصل_اعتماديات_هدف(نص سجل) {
    منطقي وجد_الأول = خطأ.
    صحيح م = ٠.
    طالما (م < طول_نص(سجل)) {
        إذا (سجل[م] == '\ت') {
            إذا (وجد_الأول) { إرجع م. }
            وجد_الأول = صواب.
        }
        م = م + ١.
    }
    إرجع -١.
}

منطقي اضف_سجل_هدف(متجه فهرس، نص اسم، نص نوع، نص اعتماديات) {
    إذا (فهرس == عدم || اسم == عدم || نوع == عدم) { إرجع خطأ. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(فهرس)).
    صحيح م = ٠.
    طالما (م < طول_متجه(فهرس)) {
        نص سجل = *(بيانات + م).
        صحيح فاصل = موضع_فاصل_هدف(سجل).
        إذا (فاصل >= ٠) {
            نص موجود = نسخ_مقطع(سجل، ٠، فاصل).
            منطقي مكرر = موجود != عدم && قارن_نص(موجود، اسم) == ٠.
            إذا (موجود != عدم) { حرر_نص(موجود). }
            إذا (مكرر) {
                اطبع_منسق("[خطأ] اسم هدف مكرر: %ن\س"، اسم).
                إرجع خطأ.
            }
        }
        م = م + ١.
    }
    نص بداية = دمج_نص(اسم، "\ت").
    نص مع_نوع = دمج_نص(بداية، نوع).
    حرر_نص(بداية).
    نص مع_فاصل = دمج_نص(مع_نوع، "\ت").
    حرر_نص(مع_نوع).
    نص نص_اعتماديات = "".
    إذا (اعتماديات != عدم) { نص_اعتماديات = اعتماديات. }
    نص سجل = دمج_نص(مع_فاصل، نص_اعتماديات).
    حرر_نص(مع_فاصل).
    إذا (سجل == عدم || !ادفع_متجه(فهرس، &سجل)) {
        إذا (سجل != عدم) { حرر_نص(سجل). }
        إرجع خطأ.
    }
    إرجع صواب.
}

متجه اقرأ_فهرس_الأهداف() {
    عدم* ملف = فتح_ملف("مشروع.تكوين"، "قراءة").
    إذا (ملف == عدم) { إرجع عدم. }
    متجه فهرس = أنشئ_متجه(حجم(نص)).
    نص اسم = عدم.
    نص نوع = عدم.
    نص اعتماديات = عدم.
    منطقي داخل = خطأ.
    منطقي صالح = فهرس != عدم.

    طالما (صالح) {
        نص خام = اقرأ_سطر(ملف).
        إذا (خام == عدم) { توقف. }
        نص سطر = احذف_تعليق_في1(خام).
        حرر_نص(خام).
        إذا (سطر == عدم || طول_نص(سطر) == ٠) {
            إذا (سطر != عدم) { حرر_نص(سطر). }
            استمر.
        }

        إذا (سطر[٠] == '[') {
            إذا (داخل) {
                إذا (نوع == عدم || !اضف_سجل_هدف(فهرس، اسم، نوع، اعتماديات)) { صالح = خطأ. }
                إذا (اسم != عدم) { حرر_نص(اسم). اسم = عدم. }
                إذا (نوع != عدم) { حرر_نص(نوع). نوع = عدم. }
                إذا (اعتماديات != عدم) { حرر_نص(اعتماديات). اعتماديات = عدم. }
            }
            داخل = خطأ.
            إذا (طول_نص(سطر) < ٣ || سطر[طول_نص(سطر) - ١] != ']') {
                صالح = خطأ.
            }
            وإلا {
                نص خام_قسم = نسخ_مقطع(سطر، ١، طول_نص(سطر) - ١).
                نص قسم = قص_طرفين(خام_قسم).
                حرر_نص(خام_قسم).
                إذا (قسم != عدم && يبدأ_ب(قسم، "الأهداف.")) {
                    اسم = اسم_قسم_فرعي(قسم، "الأهداف.").
                    داخل = اسم != عدم && طول_نص(اسم) > ٠.
                    إذا (!داخل) { صالح = خطأ. }
                }
                إذا (قسم != عدم) { حرر_نص(قسم). }
            }
            حرر_نص(سطر).
            استمر.
        }

        إذا (داخل) {
            صحيح موضع = موضع_إسناد_في1(سطر).
            إذا (موضع <= ٠) { صالح = خطأ. }
            وإلا {
                نص خام_مفتاح = نسخ_مقطع(سطر، ٠، موضع).
                نص مفتاح = قص_طرفين(خام_مفتاح).
                حرر_نص(خام_مفتاح).
                إذا (مفتاح != عدم && قارن_نص(مفتاح، "النوع") == ٠) {
                    نص خام_نوع = نسخ_مقطع(سطر، موضع + ١، طول_نص(سطر)).
                    نص قيمة = حلل_نص_في1(خام_نوع).
                    حرر_نص(خام_نوع).
                    إذا (قيمة == عدم || نوع != عدم || !نوع_في1_مدعوم(قيمة)) {
                        إذا (قيمة != عدم) { حرر_نص(قيمة). }
                        صالح = خطأ.
                    }
                    وإلا { نوع = قيمة. }
                }
                وإلا إذا (مفتاح != عدم && قارن_نص(مفتاح، "يعتمد_على") == ٠) {
                    نص خام_اعتماديات = نسخ_مقطع(سطر، موضع + ١، طول_نص(سطر)).
                    نص قيمة = حلل_مصفوفة_نصوص_في1(خام_اعتماديات).
                    حرر_نص(خام_اعتماديات).
                    إذا (قيمة == عدم || اعتماديات != عدم) {
                        إذا (قيمة != عدم) { حرر_نص(قيمة). }
                        صالح = خطأ.
                    }
                    وإلا { اعتماديات = قيمة. }
                }
                إذا (مفتاح != عدم) { حرر_نص(مفتاح). }
            }
        }
        حرر_نص(سطر).
    }

    إذا (صالح && داخل) {
        إذا (نوع == عدم || !اضف_سجل_هدف(فهرس، اسم، نوع، اعتماديات)) { صالح = خطأ. }
    }
    إذا (اسم != عدم) { حرر_نص(اسم). }
    إذا (نوع != عدم) { حرر_نص(نوع). }
    إذا (اعتماديات != عدم) { حرر_نص(اعتماديات). }
    اغلق_ملف(ملف).
    إذا (!صالح) { حرر_قائمة_نصوص(فهرس). إرجع عدم. }
    إرجع فهرس.
}

صحيح موضع_نص_في_قائمة(متجه قائمة، نص مطلوب) {
    إذا (قائمة == عدم || مطلوب == عدم) { إرجع -١. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(قائمة)).
    صحيح م = ٠.
    طالما (م < طول_متجه(قائمة)) {
        إذا (قارن_نص(*(بيانات + م)، مطلوب) == ٠) { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

صحيح موضع_هدف_في_فهرس(متجه فهرس، نص مطلوب) {
    إذا (فهرس == عدم || مطلوب == عدم) { إرجع -١. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(فهرس)).
    صحيح م = ٠.
    طالما (م < طول_متجه(فهرس)) {
        نص سجل = *(بيانات + م).
        صحيح فاصل = موضع_فاصل_هدف(سجل).
        نص اسم = نسخ_مقطع(سجل، ٠، فاصل).
        منطقي مطابق = اسم != عدم && قارن_نص(اسم، مطلوب) == ٠.
        إذا (اسم != عدم) { حرر_نص(اسم). }
        إذا (مطابق) { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

نص اسم_هدف_من_سجل(نص سجل) {
    إرجع نسخ_مقطع(سجل، ٠، موضع_فاصل_هدف(سجل)).
}

نص نوع_هدف_من_سجل(نص سجل) {
    صحيح أول = موضع_فاصل_هدف(سجل).
    صحيح ثاني = موضع_فاصل_اعتماديات_هدف(سجل).
    إرجع نسخ_مقطع(سجل، أول + ١، ثاني).
}

نص اعتماديات_هدف_من_سجل(نص سجل) {
    صحيح فاصل = موضع_فاصل_اعتماديات_هدف(سجل).
    إرجع نسخ_مقطع(سجل، فاصل + ١، طول_نص(سجل)).
}

نص ابن_مسار_دورة_أهداف(متجه نشطة، صحيح بداية، نص مكرر) {
    نص ناتج = نسخ_نص("").
    نص* بيانات = كـ<نص*>(بيانات_متجه(نشطة)).
    صحيح م = بداية.
    منطقي أول = صواب.
    طالما (م < طول_متجه(نشطة)) {
        إذا (!أول) { ناتج = الصق_وحرر_يسار(ناتج، " -> "). }
        ناتج = الصق_وحرر_يسار(ناتج، *(بيانات + م)).
        أول = خطأ.
        م = م + ١.
    }
    إذا (!أول) { ناتج = الصق_وحرر_يسار(ناتج، " -> "). }
    إرجع الصق_وحرر_يسار(ناتج، مكرر).
}

منطقي زر_هدف_في_الرسم(متجه فهرس، نص اسم، متجه نشطة،
                        متجه منجزة، متجه ترتيب) {
    إذا (موضع_نص_في_قائمة(منجزة، اسم) >= ٠) { إرجع صواب. }
    إذا (طول_متجه(نشطة) >= ٢٥٦) {
        اطبع "[خطأ] عمق DAG الأهداف يتجاوز الحد الدفاعي 256.".
        إرجع خطأ.
    }
    صحيح موضع = موضع_هدف_في_فهرس(فهرس، اسم).
    إذا (موضع < ٠) {
        اطبع_منسق("[خطأ] يعتمد الرسم على هدف غير موجود: %ن\س"، اسم).
        إرجع خطأ.
    }
    إذا (!اضف_وسيط(نشطة، اسم)) { إرجع خطأ. }

    نص* بيانات_فهرس = كـ<نص*>(بيانات_متجه(فهرس)).
    نص سجل = *(بيانات_فهرس + موضع).
    نص اعتماديات = اعتماديات_هدف_من_سجل(سجل).
    منطقي صالح = اعتماديات != عدم.
    صحيح بداية = ٠.
    طالما (صالح && بداية < طول_نص(اعتماديات)) {
        صحيح نهاية = بداية.
        طالما (نهاية < طول_نص(اعتماديات) && اعتماديات[نهاية] != '\س') {
            نهاية = نهاية + ١.
        }
        نص اعتماد = نسخ_مقطع(اعتماديات، بداية، نهاية).
        صحيح موضع_اعتماد = موضع_هدف_في_فهرس(فهرس، اعتماد).
        إذا (موضع_اعتماد < ٠) {
            اطبع_منسق("[خطأ] الهدف '%ن' يعتمد على هدف غير موجود: %ن\س"، اسم، اعتماد).
            صالح = خطأ.
        }
        وإلا {
            نص سجل_اعتماد = *(بيانات_فهرس + موضع_اعتماد).
            نص نوع_اعتماد = نوع_هدف_من_سجل(سجل_اعتماد).
            إذا (نوع_اعتماد == عدم || قارن_نص(نوع_اعتماد، "مكتبة") != ٠) {
                اطبع_منسق("[خطأ] الهدف '%ن' لا يستطيع الاعتماد على '%ن': الاعتمادية يجب أن تكون مكتبة.\س"،
                           اسم، اعتماد).
                صالح = خطأ.
            }
            إذا (نوع_اعتماد != عدم) { حرر_نص(نوع_اعتماد). }
        }
        إذا (صالح) {
            صحيح موضع_نشط = موضع_نص_في_قائمة(نشطة، اعتماد).
            إذا (موضع_نشط >= ٠) {
                نص دورة = ابن_مسار_دورة_أهداف(نشطة، موضع_نشط، اعتماد).
                اطبع_منسق("[خطأ] دورة في اعتماديات الأهداف: %ن\س"، دورة).
                حرر_نص(دورة).
                صالح = خطأ.
            }
            وإلا {
                صالح = زر_هدف_في_الرسم(فهرس، اعتماد، نشطة، منجزة، ترتيب).
            }
        }
        حرر_نص(اعتماد).
        إذا (نهاية >= طول_نص(اعتماديات)) { توقف. }
        بداية = نهاية + ١.
    }
    إذا (اعتماديات != عدم) { حرر_نص(اعتماديات). }

    نص نشط_مسحوب = عدم.
    إذا (!اسحب_متجه(نشطة، &نشط_مسحوب)) { صالح = خطأ. }
    إذا (نشط_مسحوب != عدم) { حرر_نص(نشط_مسحوب). }
    إذا (صالح && موضع_نص_في_قائمة(منجزة، اسم) < ٠) {
        إذا (!اضف_وسيط(منجزة، اسم) || !اضف_وسيط(ترتيب، اسم)) { صالح = خطأ. }
    }
    إرجع صالح.
}

منطقي تحقق_رسم_الأهداف(متجه فهرس) {
    متجه نشطة = أنشئ_متجه(حجم(نص)).
    متجه منجزة = أنشئ_متجه(حجم(نص)).
    متجه ترتيب = أنشئ_متجه(حجم(نص)).
    منطقي صالح = نشطة != عدم && منجزة != عدم && ترتيب != عدم.
    نص* بيانات = كـ<نص*>(بيانات_متجه(فهرس)).
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(فهرس)) {
        نص اسم = اسم_هدف_من_سجل(*(بيانات + م)).
        إذا (اسم == عدم) { صالح = خطأ. }
        وإلا {
            صالح = زر_هدف_في_الرسم(فهرس، اسم، نشطة، منجزة، ترتيب).
            حرر_نص(اسم).
        }
        م = م + ١.
    }
    حرر_قائمة_نصوص(نشطة).
    حرر_قائمة_نصوص(منجزة).
    حرر_قائمة_نصوص(ترتيب).
    إرجع صالح.
}

متجه رتب_أهداف_البناء(نص اسم، صحيح* كود) {
    *كود = كود_تكوين_نجاح.
    متجه فهرس = اقرأ_فهرس_الأهداف().
    إذا (فهرس == عدم) { *كود = كود_تكوين_خطأ_عام. إرجع عدم. }
    إذا (طول_متجه(فهرس) == ٠) {
        متجه ترتيب_قديم = أنشئ_متجه(حجم(نص)).
        إذا (ترتيب_قديم == عدم || !اضف_وسيط(ترتيب_قديم، اسم)) {
            حرر_قائمة_نصوص(ترتيب_قديم).
            حرر_قائمة_نصوص(فهرس).
            *كود = كود_تكوين_خطأ_داخلي.
            إرجع عدم.
        }
        حرر_قائمة_نصوص(فهرس).
        إرجع ترتيب_قديم.
    }
    إذا (!تحقق_رسم_الأهداف(فهرس)) {
        حرر_قائمة_نصوص(فهرس).
        *كود = كود_تكوين_خطأ_عام.
        إرجع عدم.
    }

    متجه نشطة = أنشئ_متجه(حجم(نص)).
    متجه منجزة = أنشئ_متجه(حجم(نص)).
    متجه ترتيب = أنشئ_متجه(حجم(نص)).
    منطقي صالح = نشطة != عدم && منجزة != عدم && ترتيب != عدم.
    إذا (صالح) { صالح = زر_هدف_في_الرسم(فهرس، اسم، نشطة، منجزة، ترتيب). }
    حرر_قائمة_نصوص(نشطة).
    حرر_قائمة_نصوص(منجزة).
    حرر_قائمة_نصوص(فهرس).
    إذا (!صالح) {
        حرر_قائمة_نصوص(ترتيب).
        *كود = كود_تكوين_خطأ_عام.
        إرجع عدم.
    }
    إرجع ترتيب.
}

نص هرب_اسم_جسون(نص قيمة) {
    نص ناتج = نسخ_نص("").
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        نص جزء = عدم.
        إذا (ح == '"') { جزء = نسخ_نص("\\\""). }
        وإلا إذا (ح == '\\') { جزء = نسخ_نص("\\\\"). }
        وإلا { جزء = نسق("%ح"، ح). }
        ناتج = الصق_وحرر_يسار(ناتج، جزء).
        حرر_نص(جزء).
        م = م + ١.
    }
    إرجع ناتج.
}

صحيح تنفيذ_حالة_الأهداف() {
    إذا (تحليل_ملف_تكوين("مشروع.تكوين") != ٠) { إرجع كود_تكوين_خطأ_عام. }
    متجه فهرس = اقرأ_فهرس_الأهداف().
    إذا (فهرس == عدم) { إرجع كود_تكوين_خطأ_عام. }
    إذا (طول_متجه(فهرس) == ٠) {
        إذا (!اضف_سجل_هدف(فهرس، احصل_تكوين_الاسم()، احصل_تكوين_النوع()، "")) {
            حرر_قائمة_نصوص(فهرس). إرجع كود_تكوين_خطأ_عام.
        }
    }
    إذا (!تحقق_رسم_الأهداف(فهرس)) {
        حرر_قائمة_نصوص(فهرس).
        إرجع كود_تكوين_خطأ_عام.
    }

    اطبع "{".
    اطبع "  \"schema_version\": \"takween-targets-v1\",".
    اطبع "  \"targets\": [".
    نص* بيانات = كـ<نص*>(بيانات_متجه(فهرس)).
    صحيح م = ٠.
    طالما (م < طول_متجه(فهرس)) {
        نص سجل = *(بيانات + م).
        صحيح فاصل = موضع_فاصل_هدف(سجل).
        صحيح فاصل_اعتماديات = موضع_فاصل_اعتماديات_هدف(سجل).
        نص اسم = نسخ_مقطع(سجل، ٠، فاصل).
        نص نوع = نسخ_مقطع(سجل، فاصل + ١، فاصل_اعتماديات).
        نص آمن = هرب_اسم_جسون(اسم).
        نص نوع_آلي = "test".
        إذا (قارن_نص(نوع، "تنفيذي") == ٠) { نوع_آلي = "executable". }
        وإلا إذا (قارن_نص(نوع، "مكتبة") == ٠) { نوع_آلي = "library". }
        منطقي جاهز = قارن_نص(نوع_آلي، "library") != ٠.
        نص نص_فاصلة = "".
        إذا (م + ١ < طول_متجه(فهرس)) { نص_فاصلة = ",". }
        نص نص_حالة = "unsupported".
        نص نص_بناء = "false".
        نص نص_تشغيل = "false".
        نص نص_اختبار = "false".
        إذا (جاهز) { نص_حالة = "ready". نص_بناء = "true". نص_تشغيل = "true". }
        إذا (قارن_نص(نوع_آلي، "test") == ٠) { نص_اختبار = "true". }
        اطبع_منسق("    {\"name\":\"%ن\",\"kind\":\"%ن\",\"status\":\"%ن\",\"buildable\":%ن,\"runnable\":%ن,\"test\":%ن}%ن\س"،
                   آمن، نوع_آلي، نص_حالة، نص_بناء، نص_تشغيل، نص_اختبار، نص_فاصلة).
        حرر_نص(اسم). حرر_نص(نوع). حرر_نص(آمن).
        م = م + ١.
    }
    اطبع "  ]".
    اطبع "}".
    حرر_قائمة_نصوص(فهرس).
    إرجع كود_تكوين_نجاح.
}

صحيح تنفيذ_اختبار(نص مطلوب) {
    متجه فهرس = اقرأ_فهرس_الأهداف().
    إذا (فهرس == عدم) { إرجع كود_تكوين_خطأ_عام. }
    إذا (!تحقق_رسم_الأهداف(فهرس)) {
        حرر_قائمة_نصوص(فهرس).
        إرجع كود_تكوين_خطأ_عام.
    }
    نص* بيانات = كـ<نص*>(بيانات_متجه(فهرس)).
    منطقي وجد = خطأ.
    صحيح م = ٠.
    طالما (م < طول_متجه(فهرس)) {
        نص سجل = *(بيانات + م).
        صحيح فاصل = موضع_فاصل_هدف(سجل).
        صحيح فاصل_اعتماديات = موضع_فاصل_اعتماديات_هدف(سجل).
        نص اسم = نسخ_مقطع(سجل، ٠، فاصل).
        نص نوع = نسخ_مقطع(سجل، فاصل + ١، فاصل_اعتماديات).
        منطقي بلا_تحديد = مطلوب == عدم.
        إذا (!بلا_تحديد) { بلا_تحديد = طول_نص(مطلوب) == ٠. }
        منطقي مطابق = بلا_تحديد.
        إذا (!بلا_تحديد) { مطابق = قارن_نص(اسم، مطلوب) == ٠. }
        إذا (مطابق && قارن_نص(نوع، "اختبار") == ٠) {
            وجد = صواب.
            إذا (أحداث_مفعلة()) { اصدر_حدث_هدف("target_started"، اسم، ٠). }
            اطبع_منسق("[INFO] اختبار الهدف: %ن\س"، اسم).
            حدد_هدف_تكوين(اسم).
            صحيح كود = تنفيذ_تشغيل().
            إذا (أحداث_مفعلة()) { اصدر_حدث_هدف("target_finished"، اسم، كود). }
            اطبع_منسق("[INFO] انتهى هدف الاختبار بكود: %ص\س"، كود).
            حرر_نص(اسم). حرر_نص(نوع).
            إذا (كود != ٠) { حرر_قائمة_نصوص(فهرس). إرجع كود. }
            إذا (!بلا_تحديد) { توقف. }
        }
        وإلا {
            حرر_نص(اسم). حرر_نص(نوع).
        }
        م = م + ١.
    }
    حرر_قائمة_نصوص(فهرس).
    إذا (!وجد) {
        اطبع "[خطأ] لا يوجد هدف اختبار مطابق في مشروع.تكوين.".
        إرجع كود_تكوين_غير_مدعوم.
    }
    إرجع كود_تكوين_نجاح.
}
