#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
منطقي يحتوي_على_تنفيذ(نص النص، نص الجزء).

#تعريف حد_ملفات_الأرشيف 1024
#تعريف حد_حجم_ملف_الأرشيف 8388608
#تعريف حد_حجم_الأرشيف_المفكوك 67108864
#تعريف حد_طول_مسار_الأرشيف 512
#تعريف حد_طول_سطر_الأرشيف 16778368

نص حقل_أرشيف(نص سجل، صحيح رقم) {
    إذا (سجل == عدم || رقم < ٠ || رقم > ٤) { إرجع عدم. }
    صحيح بداية = ٠.
    صحيح حقل = ٠.
    صحيح م = ٠.
    صحيح طول = طول_نص(سجل).
    طالما (م <= طول) {
        منطقي نهاية = م == طول.
        إذا (!نهاية) { نهاية = سجل[م] == '\ت'. }
        إذا (نهاية) {
            إذا (حقل == رقم) { إرجع نسخ_مقطع(سجل، بداية، م). }
            حقل = حقل + ١.
            بداية = م + ١.
        }
        م = م + ١.
    }
    إرجع عدم.
}

صحيح حلل_عدد_أرشيف(نص قيمة، صحيح حد) {
    إذا (قيمة == عدم || طول_نص(قيمة) == ٠) { إرجع -١. }
    صحيح ناتج = ٠.
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        صحيح رقم = -١.
        إذا (ح >= '0' && ح <= '9') { رقم = كـ<صحيح>(ح) - كـ<صحيح>('0'). }
        وإلا إذا (ح >= '٠' && ح <= '٩') { رقم = كـ<صحيح>(ح) - كـ<صحيح>('٠'). }
        إذا (رقم < ٠ || ناتج > (حد - رقم) / ١٠) { إرجع -١. }
        ناتج = ناتج + ناتج + ناتج + ناتج + ناتج +
                ناتج + ناتج + ناتج + ناتج + ناتج + رقم.
        م = م + ١.
    }
    إرجع ناتج.
}

صحيح قيمة_سداسية(حرف ح) {
    إذا (ح >= '0' && ح <= '9') { إرجع كـ<صحيح>(ح) - كـ<صحيح>('0'). }
    إذا (ح >= 'a' && ح <= 'f') { إرجع ١٠ + كـ<صحيح>(ح) - كـ<صحيح>('a'). }
    إرجع -١.
}

منطقي مسارا_أرشيف_متساويان(نص أ، نص ب) {
    إذا (طول_نص(أ) != طول_نص(ب)) { إرجع خطأ. }
    صحيح م = ٠.
    طالما (م < طول_نص(أ)) {
        إذا (أ[م] != ب[م]) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي مسار_بادئة_مجلد(نص بادئة، نص كامل) {
    إذا (طول_نص(كامل) <= طول_نص(بادئة)) { إرجع خطأ. }
    صحيح م = ٠.
    طالما (م < طول_نص(بادئة)) {
        إذا (بادئة[م] != كامل[م]) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع كامل[طول_نص(بادئة)] == '/'.
}

منطقي مسارا_أرشيف_متصادمان(نص أ، نص ب) {
    إرجع مسارا_أرشيف_متساويان(أ، ب) || مسار_بادئة_مجلد(أ، ب) || مسار_بادئة_مجلد(ب، أ).
}

منطقي مسار_أرشيف_آمن(نص مسار) {
    إذا (مسار == عدم || طول_نص(مسار) == ٠ || طول_نص(مسار) > حد_طول_مسار_الأرشيف) { إرجع خطأ. }
    إذا (مسار[٠] == '/' || مسار[٠] == '\\' || مسار[طول_نص(مسار) - ١] == '/') { إرجع خطأ. }
    صحيح بداية = ٠.
    صحيح م = ٠.
    طالما (م <= طول_نص(مسار)) {
        إذا (م < طول_نص(مسار)) {
            حرف ح = مسار[م].
            إذا (ح == '\\' || ح == ':' || ح == '\ت' || ح == '\س' || ح == '\ر') { إرجع خطأ. }
        }
        إذا (م == طول_نص(مسار) || مسار[م] == '/') {
            إذا (م == بداية) { إرجع خطأ. }
            نص جزء = نسخ_مقطع(مسار، بداية، م).
            منطقي خطر = جزء == عدم || قارن_نص(جزء، ".") == ٠ || قارن_نص(جزء، "..") == ٠.
            إذا (جزء != عدم) { حرر_نص(جزء). }
            إذا (خطر) { إرجع خطأ. }
            بداية = م + ١.
        }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي قائمة_مسارات_تتصادم(متجه مسارات، نص مسار) {
    نص* بيانات = كـ<نص*>(بيانات_متجه(مسارات)).
    صحيح م = ٠.
    طالما (م < طول_متجه(مسارات)) {
        إذا (مسارا_أرشيف_متصادمان(*(بيانات + م)، مسار)) { إرجع صواب. }
        م = م + ١.
    }
    إرجع خطأ.
}

منطقي تحقق_استخراج_أرشيف(نص مجلد، نص تجزئة_أرشيف) {
    نص مسار_إيصال = ضم_مسار(مجلد، ".تكوين-استخراج-v1").
    عدم* ملف = فتح_ملف(مسار_إيصال، "قراءة").
    إذا (مسار_إيصال != عدم) { حرر_نص(مسار_إيصال). }
    إذا (ملف == عدم) { إرجع خطأ. }
    نص رأس = اقرأ_سطر(ملف).
    نص سطر_تجزئة = اقرأ_سطر(ملف).
    منطقي صالح = رأس != عدم && قارن_نص(رأس، "takween-extract-v1") == ٠ &&
                  سطر_تجزئة != عدم.
    إذا (صالح) {
        نص نوع = حقل_أرشيف(سطر_تجزئة، ٠).
        نص قيمة = حقل_أرشيف(سطر_تجزئة، ١).
        صالح = نوع != عدم && قيمة != عدم && قارن_نص(نوع، "أرشيف") == ٠ &&
               قارن_نص(قيمة، تجزئة_أرشيف) == ٠.
        إذا (نوع != عدم) { حرر_نص(نوع). }
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
    }
    إذا (رأس != عدم) { حرر_نص(رأس). }
    إذا (سطر_تجزئة != عدم) { حرر_نص(سطر_تجزئة). }

    متجه مسارات = أنشئ_متجه(حجم(نص)).
    صحيح عدد = ٠.
    صحيح مجموع = ٠.
    منطقي انتهى = خطأ.
    طالما (صالح) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        نص نوع = حقل_أرشيف(سطر، ٠).
        إذا (نوع != عدم && قارن_نص(نوع، "نهاية") == ٠) {
            نص نص_عدد = حقل_أرشيف(سطر، ١).
            نص نص_مجموع = حقل_أرشيف(سطر، ٢).
            انتهى = نص_عدد != عدم && نص_مجموع != عدم &&
                    حلل_عدد_أرشيف(نص_عدد، حد_ملفات_الأرشيف) == عدد &&
                    حلل_عدد_أرشيف(نص_مجموع، حد_حجم_الأرشيف_المفكوك) == مجموع.
            إذا (نص_عدد != عدم) { حرر_نص(نص_عدد). }
            إذا (نص_مجموع != عدم) { حرر_نص(نص_مجموع). }
            حرر_نص(نوع). حرر_نص(سطر).
            توقف.
        }
        نص مسار = حقل_أرشيف(سطر، ١).
        نص نص_حجم = حقل_أرشيف(سطر، ٢).
        نص تجزئة = حقل_أرشيف(سطر، ٣).
        صحيح حجم_ملف = حلل_عدد_أرشيف(نص_حجم، حد_حجم_ملف_الأرشيف).
        صالح = نوع != عدم && قارن_نص(نوع، "ملف") == ٠ && مسار_أرشيف_آمن(مسار) &&
               حجم_ملف >= ٠ && تجزئة != عدم && !قائمة_مسارات_تتصادم(مسارات، مسار).
        نص كامل = عدم.
        نص فعلية = عدم.
        إذا (صالح) { كامل = ضم_مسار(مجلد، مسار). }
        إذا (صالح && كامل != عدم) { فعلية = تجزئة_ملف_SHA256(كامل). }
        إذا (صالح) { صالح = فعلية != عدم && قارن_نص(فعلية، تجزئة) == ٠. }
        إذا (صالح) { صالح = اضف_وسيط(مسارات، مسار). }
        إذا (صالح) { عدد = عدد + ١. مجموع = مجموع + حجم_ملف. }
        إذا (كامل != عدم) { حرر_نص(كامل). }
        إذا (فعلية != عدم) { حرر_نص(فعلية). }
        إذا (نوع != عدم) { حرر_نص(نوع). }
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إذا (نص_حجم != عدم) { حرر_نص(نص_حجم). }
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
        حرر_نص(سطر).
    }
    نص زائد = عدم.
    إذا (صالح && انتهى) { زائد = اقرأ_سطر(ملف). }
    إذا (زائد != عدم) { صالح = خطأ. حرر_نص(زائد). }
    اغلق_ملف(ملف).
    حرر_وسائط(مسارات).
    نص بيان = ضم_مسار(مجلد، "مشروع.تكوين").
    عدم* ملف_بيان = فتح_ملف(بيان، "قراءة").
    إذا (ملف_بيان != عدم) { اغلق_ملف(ملف_بيان). }
    إذا (بيان != عدم) { حرر_نص(بيان). }
    إرجع صالح && انتهى && ملف_بيان != عدم.
}

منطقي اكتب_حمولة_أرشيف(نص كامل، نص حمولة، صحيح حجم_ملف) {
    ط٨* بيانات = عدم.
    منطقي صالح = صواب.
    إذا (حجم_ملف > ٠) { بيانات = كـ<ط٨*>(حجز_ذاكرة(حجم_ملف)). صالح = بيانات != عدم. }
    صحيح موضع = ٠.
    طالما (صالح && موضع < حجم_ملف) {
        صحيح موضع_سداسي = موضع + موضع.
        صحيح عال = قيمة_سداسية(حمولة[موضع_سداسي]).
        صحيح منخفض = قيمة_سداسية(حمولة[موضع_سداسي + ١]).
        إذا (عال < ٠ || منخفض < ٠) { صالح = خطأ. توقف. }
        صحيح بايت = عال + عال + عال + عال + عال + عال + عال + عال +
                     عال + عال + عال + عال + عال + عال + عال + عال + منخفض.
        *(بيانات + موضع) = كـ<ط٨>(بايت).
        موضع = موضع + ١.
    }
    عدم* خرج = عدم.
    إذا (صالح) { خرج = فتح_ملف(كامل، "wb"). صالح = خرج != عدم. }
    إذا (صالح && حجم_ملف > ٠) { صالح = اكتب_ملف(خرج، بيانات، حجم_ملف) == حجم_ملف. }
    إذا (خرج != عدم && اغلق_ملف(خرج) != ٠) { صالح = خطأ. }
    إذا (بيانات != عدم) { تحرير_ذاكرة(بيانات). }
    إرجع صالح.
}

صحيح تحقق_سجل_أرشيف(نص سطر، متجه مسارات، نص سابق، صحيح حد_متبقي) {
    نص نوع = حقل_أرشيف(سطر، ٠).
    نص مسار = حقل_أرشيف(سطر، ١).
    نص نص_حجم = حقل_أرشيف(سطر، ٢).
    نص تجزئة = حقل_أرشيف(سطر، ٣).
    نص حمولة = حقل_أرشيف(سطر، ٤).
    صحيح حجم_ملف = حلل_عدد_أرشيف(نص_حجم، حد_حجم_ملف_الأرشيف).
    منطقي صالح = صواب.
    إذا (نوع == عدم) { صالح = خطأ. }
    إذا (صالح) { صالح = قارن_نص(نوع، "ملف") == ٠. }
    إذا (صالح) { صالح = مسار_أرشيف_آمن(مسار). }
    إذا (صالح) { صالح = حجم_ملف >= ٠. }
    إذا (صالح) { صالح = حجم_ملف <= حد_متبقي. }
    إذا (صالح) { صالح = تجزئة != عدم. }
    إذا (صالح) { صالح = طول_نص(تجزئة) == ٦٤. }
    إذا (صالح) { صالح = حمولة != عدم. }
    إذا (صالح) { صالح = طول_نص(حمولة) == حجم_ملف + حجم_ملف. }
    إذا (صالح) { صالح = !قائمة_مسارات_تتصادم(مسارات، مسار). }
    إذا (صالح) {
        إذا (سابق != عدم) { صالح = قارن_نص(سابق، مسار) < ٠. }
    }
    إذا (!صالح) { اطبع "[خطأ] سجل ملف غير آمن أو متجاوز لحدود takween-archive-v1.". }
    إذا (نوع != عدم) { حرر_نص(نوع). }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    إذا (نص_حجم != عدم) { حرر_نص(نص_حجم). }
    إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    إذا (حمولة != عدم) { حرر_نص(حمولة). }
    إذا (!صالح) { إرجع -١. }
    إرجع حجم_ملف.
}

منطقي تحقق_محتوى_مفكوك_مقابل_الأرشيف(نص مسار_أرشيف، نص مجلد) {
    عدم* ملف = فتح_ملف(مسار_أرشيف، "قراءة").
    إذا (ملف == عدم) { إرجع خطأ. }
    نص رأس = اقرأ_سطر(ملف).
    منطقي صالح = رأس != عدم && قارن_نص(رأس، "takween-archive-v1") == ٠.
    إذا (رأس != عدم) { حرر_نص(رأس). }
    متجه مسارات = أنشئ_متجه(حجم(نص)).
    صالح = صالح && مسارات != عدم.
    صحيح عدد = ٠.
    صحيح مجموع = ٠.
    منطقي انتهى = خطأ.
    نص سابق = عدم.
    طالما (صالح) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        إذا (طول_نص(سطر) > حد_طول_سطر_الأرشيف) {
            حرر_نص(سطر). صالح = خطأ. توقف.
        }
        نص نوع = حقل_أرشيف(سطر، ٠).
        إذا (نوع != عدم && قارن_نص(نوع، "نهاية") == ٠) {
            نص نص_عدد = حقل_أرشيف(سطر، ١).
            نص نص_مجموع = حقل_أرشيف(سطر، ٢).
            انتهى = نص_عدد != عدم && نص_مجموع != عدم &&
                    حلل_عدد_أرشيف(نص_عدد، حد_ملفات_الأرشيف) == عدد &&
                    حلل_عدد_أرشيف(نص_مجموع، حد_حجم_الأرشيف_المفكوك) == مجموع.
            إذا (نص_عدد != عدم) { حرر_نص(نص_عدد). }
            إذا (نص_مجموع != عدم) { حرر_نص(نص_مجموع). }
            حرر_نص(نوع). حرر_نص(سطر).
            توقف.
        }
        إذا (نوع != عدم) { حرر_نص(نوع). }
        إذا (عدد >= حد_ملفات_الأرشيف) { صالح = خطأ. }
        صحيح حجم_ملف = -١.
        إذا (صالح) {
            حجم_ملف = تحقق_سجل_أرشيف(سطر، مسارات، سابق،
                                      حد_حجم_الأرشيف_المفكوك - مجموع).
            صالح = حجم_ملف >= ٠.
        }
        نص مسار = عدم.
        نص متوقعة = عدم.
        نص كاملة = عدم.
        نص فعلية = عدم.
        إذا (صالح) { مسار = حقل_أرشيف(سطر، ١). متوقعة = حقل_أرشيف(سطر، ٣). }
        إذا (صالح) { كاملة = ضم_مسار(مجلد، مسار). صالح = كاملة != عدم. }
        إذا (صالح) { فعلية = تجزئة_ملف_SHA256(كاملة). صالح = فعلية != عدم. }
        إذا (صالح) { صالح = قارن_نص(فعلية، متوقعة) == ٠. }
        إذا (صالح) { صالح = اضف_وسيط(مسارات، مسار). }
        إذا (صالح) {
            إذا (سابق != عدم) { حرر_نص(سابق). }
            سابق = نسخ_نص(مسار).
            صالح = سابق != عدم.
            عدد = عدد + ١. مجموع = مجموع + حجم_ملف.
        }
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إذا (متوقعة != عدم) { حرر_نص(متوقعة). }
        إذا (كاملة != عدم) { حرر_نص(كاملة). }
        إذا (فعلية != عدم) { حرر_نص(فعلية). }
        حرر_نص(سطر).
    }
    إذا (سابق != عدم) { حرر_نص(سابق). }
    نص زائد = عدم.
    إذا (صالح && انتهى) { زائد = اقرأ_سطر(ملف). }
    إذا (زائد != عدم) { صالح = خطأ. حرر_نص(زائد). }
    اغلق_ملف(ملف).
    حرر_وسائط(مسارات).
    إرجع صالح && انتهى.
}

منطقي اكتب_ملف_أرشيف(نص وجهة، نص مسار، نص حمولة، صحيح حجم_ملف، نص تجزئة) {
    نص كامل = ضم_مسار(وجهة، مسار).
    نص مجلد = عدم.
    منطقي صالح = كامل != عدم.
    إذا (صالح) { مجلد = مجلد_مسار(كامل). صالح = مجلد != عدم. }
    إذا (صالح) { صالح = انشئ_مجلدات(مجلد) == ٠. }
    إذا (صالح) { صالح = اكتب_حمولة_أرشيف(كامل، حمولة، حجم_ملف). }
    نص فعلية = عدم.
    إذا (صالح) { فعلية = تجزئة_ملف_SHA256(كامل). }
    إذا (صالح) { صالح = فعلية != عدم && قارن_نص(فعلية، تجزئة) == ٠. }
    إذا (كامل != عدم) { حرر_نص(كامل). }
    إذا (مجلد != عدم) { حرر_نص(مجلد). }
    إذا (فعلية != عدم) { حرر_نص(فعلية). }
    إرجع صالح.
}

صحيح استخرج_سجل_أرشيف(نص سطر، نص وجهة، متجه مسارات، متجه إيصالات،
                        نص سابق، صحيح حد_متبقي) {
    صحيح حجم_ملف = تحقق_سجل_أرشيف(سطر، مسارات، سابق، حد_متبقي).
    إذا (حجم_ملف < ٠) { إرجع -١. }
    نص مسار = حقل_أرشيف(سطر، ١).
    نص تجزئة = حقل_أرشيف(سطر، ٣).
    نص حمولة = حقل_أرشيف(سطر، ٤).
    منطقي صالح = مسار != عدم && تجزئة != عدم && حمولة != عدم.
    إذا (صالح) { صالح = اكتب_ملف_أرشيف(وجهة، مسار، حمولة، حجم_ملف، تجزئة). }
    إذا (صالح) { صالح = اضف_وسيط(مسارات، مسار). }
    نص إيصال = عدم.
    إذا (صالح) {
        إيصال = نسق("ملف\ت%ن\ت%ص\ت%ن"، مسار، حجم_ملف، تجزئة).
        صالح = إيصال != عدم && اضف_وسيط(إيصالات، إيصال).
    }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    إذا (حمولة != عدم) { حرر_نص(حمولة). }
    إذا (إيصال != عدم) { حرر_نص(إيصال). }
    إذا (!صالح) { إرجع -١. }
    إرجع حجم_ملف.
}

منطقي اكتب_إيصال_أرشيف(نص وجهة، نص تجزئة_أرشيف، متجه إيصالات، صحيح عدد، صحيح مجموع) {
    نص مسار = ضم_مسار(وجهة، ".تكوين-استخراج-v1").
    عدم* ملف = عدم.
    منطقي صالح = مسار != عدم.
    إذا (صالح) { ملف = فتح_ملف(مسار، "wb"). صالح = ملف != عدم. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، "takween-extract-v1") >= ٠. }
    نص سطر_تجزئة = نسق("أرشيف\ت%ن"، تجزئة_أرشيف).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر_تجزئة) >= ٠. }
    نص* سجلات = كـ<نص*>(بيانات_متجه(إيصالات)).
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(إيصالات)) {
        صالح = اكتب_سطر(ملف، *(سجلات + م)) >= ٠.
        م = م + ١.
    }
    نص نهاية = نسق("نهاية\ت%ص\ت%ص"، عدد، مجموع).
    إذا (صالح) { صالح = اكتب_سطر(ملف، نهاية) >= ٠. }
    إذا (ملف != عدم && اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    إذا (سطر_تجزئة != عدم) { حرر_نص(سطر_تجزئة). }
    إذا (نهاية != عدم) { حرر_نص(نهاية). }
    إرجع صالح.
}

منطقي فك_أرشيف_إلى(نص مسار_أرشيف، نص تجزئة_أرشيف، نص وجهة) {
    عدم* ملف = فتح_ملف(مسار_أرشيف، "قراءة").
    إذا (ملف == عدم) { اطبع "[خطأ] تعذر فتح أرشيف الحزمة.". إرجع خطأ. }
    نص رأس = اقرأ_سطر(ملف).
    منطقي صالح = رأس != عدم && قارن_نص(رأس، "takween-archive-v1") == ٠.
    إذا (رأس != عدم) { حرر_نص(رأس). }
    إذا (!صالح) { اطبع "[خطأ] الأرشيف لا يطابق takween-archive-v1.". }
    إذا (صالح) { صالح = احذف_شجرة(وجهة) == ٠ && انشئ_مجلدات(وجهة) == ٠. }
    متجه مسارات = أنشئ_متجه(حجم(نص)).
    متجه إيصالات = أنشئ_متجه(حجم(نص)).
    صالح = صالح && مسارات != عدم && إيصالات != عدم.
    صحيح عدد = ٠.
    صحيح مجموع = ٠.
    منطقي انتهى = خطأ.
    نص سابق = عدم.
    طالما (صالح) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        إذا (طول_نص(سطر) > حد_طول_سطر_الأرشيف) {
            اطبع "[خطأ] تجاوز سطر الأرشيف حد الموارد.".
            حرر_نص(سطر). صالح = خطأ. توقف.
        }
        نص نوع = حقل_أرشيف(سطر، ٠).
        إذا (نوع != عدم && قارن_نص(نوع، "نهاية") == ٠) {
            نص نص_عدد = حقل_أرشيف(سطر، ١).
            نص نص_مجموع = حقل_أرشيف(سطر، ٢).
            انتهى = نص_عدد != عدم && نص_مجموع != عدم &&
                    حلل_عدد_أرشيف(نص_عدد، حد_ملفات_الأرشيف) == عدد &&
                    حلل_عدد_أرشيف(نص_مجموع، حد_حجم_الأرشيف_المفكوك) == مجموع.
            إذا (نص_عدد != عدم) { حرر_نص(نص_عدد). }
            إذا (نص_مجموع != عدم) { حرر_نص(نص_مجموع). }
            حرر_نص(نوع). حرر_نص(سطر).
            توقف.
        }
        إذا (نوع != عدم) { حرر_نص(نوع). }
        إذا (عدد >= حد_ملفات_الأرشيف) { صالح = خطأ. }
        صحيح حجم_مستخرج = -١.
        إذا (صالح) {
            حجم_مستخرج = استخرج_سجل_أرشيف(سطر، وجهة، مسارات، إيصالات، سابق،
                                            حد_حجم_الأرشيف_المفكوك - مجموع).
            صالح = حجم_مستخرج >= ٠.
        }
        إذا (صالح) {
            نص مسار = حقل_أرشيف(سطر، ١).
            إذا (سابق != عدم) { حرر_نص(سابق). }
            سابق = مسار.
            صالح = سابق != عدم.
            عدد = عدد + ١. مجموع = مجموع + حجم_مستخرج.
        }
        حرر_نص(سطر).
    }
    إذا (سابق != عدم) { حرر_نص(سابق). }
    نص زائد = عدم.
    إذا (صالح && انتهى) { زائد = اقرأ_سطر(ملف). }
    إذا (زائد != عدم) { صالح = خطأ. حرر_نص(زائد). }
    اغلق_ملف(ملف).
    صالح = صالح && انتهى.
    إذا (صالح) { صالح = اكتب_إيصال_أرشيف(وجهة، تجزئة_أرشيف، إيصالات، عدد، مجموع). }
    حرر_وسائط(مسارات). حرر_وسائط(إيصالات).
    إذا (صالح) { صالح = تحقق_استخراج_أرشيف(وجهة، تجزئة_أرشيف). }
    إذا (!صالح) { احذف_شجرة(وجهة). }
    إرجع صالح.
}

منطقي جهز_أرشيف_حزمة(نص مسار_أرشيف، نص تجزئة، نص مجلد_الحزم،
                       منطقي تحقق_فقط، نص* مسار_محتوى) {
    إذا (مسار_محتوى == عدم) { إرجع خطأ. }
    نص جذر_تجزئة = ضم_مسار(مجلد_الحزم، "sha256").
    نص وجهة = ضم_مسار(جذر_تجزئة، تجزئة).
    إذا (جذر_تجزئة != عدم) { حرر_نص(جذر_تجزئة). }
    إذا (وجهة == عدم) { إرجع خطأ. }
    منطقي صالح = تحقق_استخراج_أرشيف(وجهة، تجزئة).
    إذا (صالح) { صالح = تحقق_محتوى_مفكوك_مقابل_الأرشيف(مسار_أرشيف، وجهة). }
    إذا (!صالح && تحقق_فقط) {
        اطبع "[خطأ] التحقق دون شبكة يتطلب cache أرشيف صالحا ومفكوكا مسبقا.".
    }
    إذا (!صالح && !تحقق_فقط) { صالح = فك_أرشيف_إلى(مسار_أرشيف، تجزئة، وجهة). }
    إذا (صالح) {
        *مسار_محتوى = طبع_مسار(وجهة).
        صالح = *مسار_محتوى != عدم.
    }
    حرر_نص(وجهة).
    إرجع صالح.
}

منطقي ورد_أرشيف_حزمة(نص مسار_أرشيف، نص تجزئة، نص اسم، نص إصدار) {
    نص جذر = ضم_مسار("مورد"، اسم).
    نص جذر_إصدار = ضم_مسار(جذر، إصدار).
    نص وجهة = ضم_مسار(جذر_إصدار، تجزئة).
    إذا (جذر != عدم) { حرر_نص(جذر). }
    إذا (جذر_إصدار != عدم) { حرر_نص(جذر_إصدار). }
    إذا (وجهة == عدم) { إرجع خطأ. }
    منطقي صالح = فك_أرشيف_إلى(مسار_أرشيف، تجزئة، وجهة).
    حرر_نص(وجهة).
    إرجع صالح.
}
