#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
عدم حرر_وسائط(متجه وسائط).
نص حقل_أرشيف(نص سجل، صحيح رقم).
نص هرب_جسون_خطة(نص قيمة).
منطقي يساوي_أمر(نص قيمة، نص عربي، نص انجليزي).
منطقي وسيط_جسون(نص قيمة).
نص مخزن_الطقوم().
منطقي ملف_موجود_طقم(نص مسار).
نص قمة_طقم(نص إصدار، نص مضيف).
عدم اضبط_نوع_أرشيف(صحيح نوع).
منطقي اقفل_الطقوم(نص مخزن).
عدم افتح_قفل_الطقوم(نص مخزن).
عدم امسح_جرد_طقم().
صحيح عدد_جرد_أرشيف().
نص إصدار_جرد_أرشيف().
نص مضيف_جرد_أرشيف().
منطقي حلل_بيانات_طقم(نص مسار).
نص اقرأ_إيصال_طقم(نص جذر، نص إصدار، نص مضيف).
منطقي اقرأ_فهرس_طقوم(نص مخزن، متجه أسطر).
منطقي حدث_فهرس_طقوم(نص مخزن، نص إصدار، نص مضيف، نص تجزئة).
منطقي تحقق_ملفات_طقم(نص جذر، منطقي اضبط_التنفيذ).
صحيح ثبت_طقم(نص أرشيف، نص تجزئة_مطلوبة).

// أوامر طقم فوق مخزن الطقوم (طقوم_باء.baa).

#تعريف اسم_بيانات_الطقم "BAA-SDK.json"

// ---------------------------------------------------------------------------
// الأوامر الأخرى
// ---------------------------------------------------------------------------

// جذر طقم مثبت لهذا المضيف، أو عدم مع رسالة.
نص جذر_طقم_مثبت(نص مخزن، نص إصدار) {
    إذا (!اصدار_دلالي_صالح(إصدار)) {
        اطبع_منسق("[خطأ] إصدار طقم غير صالح: %ن\س"، إصدار).
        إرجع عدم.
    }
    نص قمة = قمة_طقم(إصدار، مضيف_تكوين()).
    نص جذر = ضم_مسار(مخزن، قمة).
    نص بيانات = ضم_مسار(جذر، اسم_بيانات_الطقم).
    منطقي موجود = ملف_موجود_طقم(بيانات).
    حرر_نص(قمة).
    إذا (بيانات != عدم) { حرر_نص(بيانات). }
    إذا (!موجود) {
        اطبع_منسق("[خطأ] طقم باء %ن غير مثبت لهذا المضيف.\س"، إصدار).
        إذا (جذر != عدم) { حرر_نص(جذر). }
        إرجع عدم.
    }
    إرجع جذر.
}

صحيح اعرض_مسار_طقم(نص إصدار) {
    نص مخزن = مخزن_الطقوم().
    إذا (مخزن == عدم) { إرجع كود_تكوين_خطأ_عام. }
    نص جذر = جذر_طقم_مثبت(مخزن، إصدار).
    حرر_نص(مخزن).
    إذا (جذر == عدم) { إرجع كود_تكوين_خطأ_عام. }
    اطبع جذر.
    حرر_نص(جذر).
    إرجع كود_تكوين_نجاح.
}

صحيح تحقق_طقم(نص إصدار) {
    نص مخزن = مخزن_الطقوم().
    إذا (مخزن == عدم) { إرجع كود_تكوين_خطأ_عام. }
    نص جذر = جذر_طقم_مثبت(مخزن، إصدار).
    حرر_نص(مخزن).
    إذا (جذر == عدم) { إرجع كود_تكوين_خطأ_عام. }
    نص بيانات = ضم_مسار(جذر، اسم_بيانات_الطقم).
    اضبط_نوع_أرشيف(٠).
    منطقي صالح = بيانات != عدم && حلل_بيانات_طقم(بيانات).
    إذا (بيانات != عدم) { حرر_نص(بيانات). }
    إذا (صالح) {
        صالح = قارن_نص(إصدار_جرد_أرشيف()، إصدار) == ٠ &&
               قارن_نص(مضيف_جرد_أرشيف()، مضيف_تكوين()) == ٠.
        إذا (!صالح) { اطبع "[خطأ] BAA-SDK.json لا يطابق مجلد الطقم.". }
    }
    إذا (صالح) {
        نص تجزئة = اقرأ_إيصال_طقم(جذر، إصدار، مضيف_تكوين()).
        صالح = تجزئة != عدم.
        إذا (!صالح) { اطبع "[خطأ] إيصال تثبيت الطقم مفقود أو تالف.". }
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    }
    إذا (صالح) { صالح = تحقق_ملفات_طقم(جذر، خطأ). }
    إذا (صالح) {
        اطبع_منسق("[تم] طقم باء %ن سليم: %ص ملفا تطابق BAA-SDK.json.\س"، إصدار، عدد_جرد_أرشيف()).
    }
    امسح_جرد_طقم().
    حرر_نص(جذر).
    إذا (!صالح) { إرجع كود_تكوين_خطأ_عام. }
    إرجع كود_تكوين_نجاح.
}

صحيح احذف_طقم(نص إصدار) {
    إذا (!اصدار_دلالي_صالح(إصدار)) {
        اطبع_منسق("[خطأ] إصدار طقم غير صالح: %ن\س"، إصدار).
        إرجع كود_تكوين_خطأ_استخدام.
    }
    نص مخزن = مخزن_الطقوم().
    إذا (مخزن == عدم) { إرجع كود_تكوين_خطأ_عام. }
    إذا (انشئ_مجلدات(مخزن) != ٠ || !اقفل_الطقوم(مخزن)) {
        حرر_نص(مخزن).
        إرجع كود_تكوين_خطأ_عام.
    }
    نص قمة = قمة_طقم(إصدار، مضيف_تكوين()).
    نص جذر = ضم_مسار(مخزن، قمة).
    نص بيانات = ضم_مسار(جذر، اسم_بيانات_الطقم).
    نص محذوف = ضم_مسار(مخزن، ".محذوف").
    صحيح كود = كود_تكوين_نجاح.
    منطقي موجود = ملف_موجود_طقم(بيانات).
    إذا (موجود) {
        // إعادة التسمية تخرج الطقم من المخزن ذريا قبل حذف ملفاته.
        احذف_شجرة(محذوف).
        إذا (انقل_مسار(جذر، محذوف) != ٠) {
            اطبع_منسق("[خطأ] تعذر حذف الطقم: %ن\س"، جذر).
            كود = كود_تكوين_خطأ_عام.
        }
    }
    إذا (كود == كود_تكوين_نجاح &&
        !حدث_فهرس_طقوم(مخزن، إصدار، مضيف_تكوين()، عدم)) {
        كود = كود_تكوين_خطأ_عام.
    }
    إذا (موجود && كود == كود_تكوين_نجاح) { احذف_شجرة(محذوف). }
    افتح_قفل_الطقوم(مخزن).
    إذا (كود == كود_تكوين_نجاح) {
        إذا (موجود) { اطبع_منسق("[تم] حُذف طقم باء %ن.\س"، إصدار). }
        وإلا {
            اطبع_منسق("[خطأ] طقم باء %ن غير مثبت لهذا المضيف.\س"، إصدار).
            كود = كود_تكوين_خطأ_عام.
        }
    }
    حرر_نص(قمة).
    إذا (جذر != عدم) { حرر_نص(جذر). }
    إذا (بيانات != عدم) { حرر_نص(بيانات). }
    إذا (محذوف != عدم) { حرر_نص(محذوف). }
    حرر_نص(مخزن).
    إرجع كود.
}

صحيح اعرض_الطقوم(منطقي جسون) {
    نص مخزن = مخزن_الطقوم().
    إذا (مخزن == عدم) { إرجع كود_تكوين_خطأ_عام. }
    متجه أسطر = أنشئ_متجه(حجم(نص)).
    إذا (أسطر == عدم || !اقرأ_فهرس_طقوم(مخزن، أسطر)) {
        حرر_نص(مخزن).
        إذا (أسطر != عدم) { حرر_وسائط(أسطر). }
        إرجع كود_تكوين_خطأ_عام.
    }
    نص مخزن_آمن = هرب_جسون_خطة(مخزن).
    إذا (جسون) {
        اطبع "{".
        اطبع "  \"schema_version\": \"takween-sdk-list-v1\",".
        اطبع_منسق("  \"store\": \"%ن\",\س"، مخزن_آمن).
        اطبع "  \"sdks\": [".
    }
    صحيح معروض = ٠.
    نص سابق = عدم.
    نص* بيانات = كـ<نص*>(بيانات_متجه(أسطر)).
    صحيح م = ٠.
    طالما (م < طول_متجه(أسطر)) {
        نص سطر = *(بيانات + م).
        نص إصدار = حقل_أرشيف(سطر، ٠).
        نص مضيف = حقل_أرشيف(سطر، ١).
        نص تجزئة = حقل_أرشيف(سطر، ٢).
        نص قمة = قمة_طقم(إصدار، مضيف).
        نص جذر = ضم_مسار(مخزن، قمة).
        نص ملف_بيانات = ضم_مسار(جذر، اسم_بيانات_الطقم).
        // سطر بلا مجلد منشور بقية عملية انقطعت؛ لا يُعرض.
        إذا (ملف_موجود_طقم(ملف_بيانات)) {
            إذا (جسون) {
                إذا (سابق != عدم) { اطبع_منسق("%ن,\س"، سابق). حرر_نص(سابق). }
                نص جذر_آمن = هرب_جسون_خطة(جذر).
                سابق = نسق("    {\"version\": \"%ن\", \"host\": \"%ن\", \"archive_sha256\": \"%ن\", \"path\": \"%ن\"}"،
                           إصدار، مضيف، تجزئة، جذر_آمن).
                حرر_نص(جذر_آمن).
            }
            وإلا {
                اطبع_منسق("%ن\ت%ن\ت%ن\س"، إصدار، مضيف، جذر).
            }
            معروض = معروض + ١.
        }
        حرر_نص(إصدار). حرر_نص(مضيف). حرر_نص(تجزئة).
        حرر_نص(قمة).
        إذا (جذر != عدم) { حرر_نص(جذر). }
        إذا (ملف_بيانات != عدم) { حرر_نص(ملف_بيانات). }
        م = م + ١.
    }
    إذا (جسون) {
        إذا (سابق != عدم) { اطبع سابق. حرر_نص(سابق). }
        اطبع "  ]".
        اطبع "}".
    }
    وإلا إذا (معروض == ٠) {
        اطبع_منسق("لا توجد طقوم باء مثبتة في %ن\س"، مخزن).
    }
    حرر_نص(مخزن_آمن).
    حرر_وسائط(أسطر).
    حرر_نص(مخزن).
    إرجع كود_تكوين_نجاح.
}

عدم اطبع_استخدام_طقم() {
    اطبع "[خطأ] استخدم: تكوين طقم ثبت <أرشيف> [--تجزئة <sha256>]".
    اطبع "               تكوين طقم قائمة [--جسون]".
    اطبع "               تكوين طقم مسار|تحقق|احذف <إصدار>".
    اطبع "               تكوين طقم مختار".
}

صحيح تنفيذ_طقم(صحيح عدد، نص[] معاملات) {
    إذا (عدد < ٣) {
        اطبع_استخدام_طقم().
        إرجع كود_تكوين_خطأ_استخدام.
    }
    نص فرعي = هوية_قياسية(معاملات[٢]).
    إذا (فرعي == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    صحيح كود = كود_تكوين_خطأ_استخدام.
    إذا (يساوي_أمر(فرعي، "ثبت"، "install") || قارن_نص(فرعي، "ثبّت") == ٠) {
        نص أرشيف = عدم.
        نص تجزئة = عدم.
        منطقي صالح = صواب.
        صحيح م = ٣.
        طالما (صالح && م < عدد) {
            إذا (قارن_نص(معاملات[م]، "--تجزئة") == ٠ || قارن_نص(معاملات[م]، "--sha256") == ٠) {
                إذا (تجزئة != عدم || م + ١ >= عدد) { صالح = خطأ. }
                وإلا { م = م + ١. تجزئة = معاملات[م]. }
            }
            وإلا إذا (أرشيف == عدم) { أرشيف = معاملات[م]. }
            وإلا { صالح = خطأ. }
            م = م + ١.
        }
        إذا (صالح && أرشيف != عدم) { كود = ثبت_طقم(أرشيف، تجزئة). }
        وإلا { اطبع_استخدام_طقم(). }
    }
    وإلا إذا (يساوي_أمر(فرعي، "قائمة"، "list")) {
        إذا (عدد == ٣) { كود = اعرض_الطقوم(خطأ). }
        وإلا إذا (عدد == ٤ && وسيط_جسون(معاملات[٣])) { كود = اعرض_الطقوم(صواب). }
        وإلا { اطبع_استخدام_طقم(). }
    }
    وإلا إذا (يساوي_أمر(فرعي، "مسار"، "path")) {
        إذا (عدد == ٤) { كود = اعرض_مسار_طقم(معاملات[٣]). }
        وإلا { اطبع_استخدام_طقم(). }
    }
    وإلا إذا (يساوي_أمر(فرعي، "تحقق"، "verify")) {
        إذا (عدد == ٤) { كود = تحقق_طقم(معاملات[٣]). }
        وإلا { اطبع_استخدام_طقم(). }
    }
    وإلا إذا (يساوي_أمر(فرعي، "مختار"، "which")) {
        إذا (عدد == ٣) { كود = اعرض_طقما_مختارا(). }
        وإلا { اطبع_استخدام_طقم(). }
    }
    وإلا إذا (يساوي_أمر(فرعي، "احذف"، "remove")) {
        إذا (عدد == ٤) { كود = احذف_طقم(معاملات[٣]). }
        وإلا { اطبع_استخدام_طقم(). }
    }
    وإلا {
        اطبع_منسق("[خطأ] أمر طقم غير معروف: %ن\س"، فرعي).
        اطبع_استخدام_طقم().
    }
    حرر_نص(فرعي).
    إرجع كود.
}
