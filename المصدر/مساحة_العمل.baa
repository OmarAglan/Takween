#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
نص هرب_جسون_خطة(نص قيمة).
منطقي يحتوي_على_تنفيذ(نص النص، نص الجزء).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).

نص حقل_عضو_مساحة(نص سجل، صحيح رقم) {
    إذا (سجل == عدم || رقم < ٠ || رقم > ٢) { إرجع عدم. }
    صحيح حقل = ٠.
    صحيح بداية = ٠.
    صحيح م = ٠.
    طالما (م <= طول_نص(سجل)) {
        إذا (م == طول_نص(سجل) || سجل[م] == '\ت') {
            إذا (حقل == رقم) { إرجع نسخ_مقطع(سجل، بداية، م). }
            حقل = حقل + ١.
            بداية = م + ١.
        }
        م = م + ١.
    }
    إرجع عدم.
}

منطقي فهرس_مساحة_يحوي_اسما(متجه فهرس، نص اسم) {
    نص* بيانات = كـ<نص*>(بيانات_متجه(فهرس)).
    صحيح م = ٠.
    طالما (م < طول_متجه(فهرس)) {
        نص موجود = حقل_عضو_مساحة(*(بيانات + م)، ٠).
        منطقي مطابق = موجود != عدم && قارن_نص(موجود، اسم) == ٠.
        إذا (موجود != عدم) { حرر_نص(موجود). }
        إذا (مطابق) { إرجع صواب. }
        م = م + ١.
    }
    إرجع خطأ.
}

متجه اقرأ_فهرس_مساحة_العمل() {
    حدد_هدف_تكوين("").
    حدد_نمط_تكوين("").
    إذا (تحليل_ملف_تكوين("مشروع.تكوين") != ٠) { إرجع عدم. }
    نص أعضاء = احصل_اعضاء_مساحة_العمل().
    إذا (أعضاء == عدم || طول_نص(أعضاء) == ٠) {
        اطبع "[خطأ] البيان الجذر لا يعرّف [مساحة_العمل].الأعضاء.".
        إرجع عدم.
    }
    نص قائمة = نسخ_نص(أعضاء).
    متجه فهرس = أنشئ_متجه(حجم(نص)).
    إذا (قائمة == عدم || فهرس == عدم) {
        إذا (قائمة != عدم) { حرر_نص(قائمة). }
        إذا (فهرس != عدم) { حرر_وسائط(فهرس). }
        إرجع عدم.
    }

    منطقي صالح = صواب.
    صحيح بداية = ٠.
    طالما (صالح && بداية < طول_نص(قائمة)) {
        صحيح نهاية = بداية.
        طالما (نهاية < طول_نص(قائمة) && قائمة[نهاية] != '\س') {
            نهاية = نهاية + ١.
        }
        نص مسار = نسخ_مقطع(قائمة، بداية، نهاية).
        نص بيان = عدم.
        إذا (مسار != عدم) { بيان = ضم_مسار(مسار، "مشروع.تكوين"). }
        إذا (بيان == عدم || تحليل_ملف_تكوين(بيان) != ٠ ||
            !تكوين_بيان_في1()) {
            اطبع_منسق("[خطأ] عضو مساحة العمل ليس حزمة v1 صالحة: %ن\س"، مسار).
            صالح = خطأ.
        }
        نص اسم = عدم.
        إذا (صالح) {
            اسم = نسخ_نص(احصل_تكوين_الاسم()).
            صالح = اسم != عدم && هوية_حزمة_عربية(اسم).
        }
        إذا (صالح && طول_نص(احصل_اعضاء_مساحة_العمل()) > ٠) {
            اطبع_منسق("[خطأ] مساحة العمل المتداخلة غير مدعومة: %ن\س"، مسار).
            صالح = خطأ.
        }
        إذا (صالح && فهرس_مساحة_يحوي_اسما(فهرس، اسم)) {
            اطبع_منسق("[خطأ] اسم حزمة مكرر في مساحة العمل: %ن\س"، اسم).
            صالح = خطأ.
        }
        إذا (صالح) {
            نص له_اختبار = "0".
            إذا (تكوين_له_اختبارات()) { له_اختبار = "1". }
            نص سجل = نسق("%ن\ت%ن\ت%ن"، اسم، مسار، له_اختبار).
            إذا (سجل == عدم || !اضف_وسيط(فهرس، سجل)) { صالح = خطأ. }
            إذا (سجل != عدم) { حرر_نص(سجل). }
        }
        إذا (اسم != عدم) { حرر_نص(اسم). }
        إذا (بيان != عدم) { حرر_نص(بيان). }
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إذا (نهاية >= طول_نص(قائمة)) { توقف. }
        بداية = نهاية + ١.
    }
    حرر_نص(قائمة).
    إذا (!صالح) {
        حرر_وسائط(فهرس).
        إرجع عدم.
    }
    إرجع فهرس.
}

صحيح تنفيذ_فهرس_مساحة_العمل() {
    متجه فهرس = اقرأ_فهرس_مساحة_العمل().
    إذا (فهرس == عدم) { إرجع كود_تكوين_خطأ_عام. }
    اطبع "{".
    اطبع "  \"schema_version\": \"takween-workspace-v1\",".
    اطبع "  \"members\": [".
    نص* بيانات = كـ<نص*>(بيانات_متجه(فهرس)).
    صحيح م = ٠.
    طالما (م < طول_متجه(فهرس)) {
        نص اسم = حقل_عضو_مساحة(*(بيانات + م)، ٠).
        نص مسار = حقل_عضو_مساحة(*(بيانات + م)، ١).
        نص اختبار = حقل_عضو_مساحة(*(بيانات + م)، ٢).
        نص اسم_آمن = هرب_جسون_خطة(اسم).
        نص مسار_آمن = هرب_جسون_خطة(مسار).
        نص فاصلة = "".
        إذا (م + ١ < طول_متجه(فهرس)) { فاصلة = ",". }
        نص له_اختبار = "false".
        إذا (اختبار != عدم && قارن_نص(اختبار، "1") == ٠) { له_اختبار = "true". }
        اطبع_منسق("    {\"name\":\"%ن\",\"path\":\"%ن\",\"order\":%ص,\"has_tests\":%ن}%ن\س"،
                   اسم_آمن، مسار_آمن، م، له_اختبار، فاصلة).
        إذا (اسم != عدم) { حرر_نص(اسم). }
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إذا (اختبار != عدم) { حرر_نص(اختبار). }
        إذا (اسم_آمن != عدم) { حرر_نص(اسم_آمن). }
        إذا (مسار_آمن != عدم) { حرر_نص(مسار_آمن). }
        م = م + ١.
    }
    اطبع "  ]".
    اطبع "}".
    حرر_وسائط(فهرس).
    إرجع كود_تكوين_نجاح.
}

صحيح شغل_عملية_عضو(نص عملية، نص اسم، نص مسار، نص نمط،
                     منطقي مقفل، نص مشغل) {
    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي صالح = وسائط != عدم && اضف_وسيط(وسائط، مشغل) &&
                  اضف_وسيط(وسائط، عملية).
    إذا (صالح && نمط != عدم && طول_نص(نمط) > ٠) {
        صالح = اضف_وسيط(وسائط، "--نمط") && اضف_وسيط(وسائط، نمط).
    }
    إذا (صالح && مقفل) { صالح = اضف_وسيط(وسائط، "--مقفل"). }
    إذا (!صالح) {
        إذا (وسائط != عدم) { حرر_وسائط(وسائط). }
        إرجع كود_تكوين_خطأ_داخلي.
    }
    اطبع_منسق("[INFO] مساحة العمل: %ن الحزمة %ن (%ن)\س"، عملية، اسم، مسار).
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    مقبض_عملية مقبض = ابدأ_عملية(بيانات، طول_متجه(وسائط)، مسار،
                                  عدم، ٠، عدم، عدم).
    إذا (مقبض == عدم) {
        حرر_وسائط(وسائط).
        إرجع كود_تكوين_فشل_أداة.
    }
    صحيح كود = انتظر_عملية(مقبض).
    حرر_عملية(مقبض).
    حرر_وسائط(وسائط).
    إذا (كود < ٠) { إرجع كود_تكوين_فشل_أداة. }
    إرجع كود.
}

صحيح تنفيذ_عملية_مساحة(نص عملية، نص حزمة، منطقي كل_الحزم،
                        نص نمط، منطقي مقفل، نص مشغل) {
    متجه فهرس = اقرأ_فهرس_مساحة_العمل().
    إذا (فهرس == عدم) { إرجع كود_تكوين_خطأ_عام. }
    نص مشغل_فعلي = مشغل.
    نص مشغل_مملوك = عدم.
    إذا (يحتوي_على_تنفيذ(مشغل، "/") || يحتوي_على_تنفيذ(مشغل، "\\")) {
        مشغل_مملوك = طبع_مسار(مشغل).
        إذا (مشغل_مملوك != عدم) { مشغل_فعلي = مشغل_مملوك. }
    }
    صحيح عدد_منفذ = ٠.
    صحيح كود = كود_تكوين_نجاح.
    نص* بيانات = كـ<نص*>(بيانات_متجه(فهرس)).
    صحيح م = ٠.
    طالما (م < طول_متجه(فهرس)) {
        نص اسم = حقل_عضو_مساحة(*(بيانات + م)، ٠).
        نص مسار = حقل_عضو_مساحة(*(بيانات + م)، ١).
        نص اختبار = حقل_عضو_مساحة(*(بيانات + م)، ٢).
        منطقي مختار = كل_الحزم.
        إذا (!كل_الحزم && حزمة != عدم && طول_نص(حزمة) > ٠) {
            مختار = قارن_نص(اسم، حزمة) == ٠.
        }
        منطقي عملية_اختبار = قارن_نص(عملية، "اختبار") == ٠.
        إذا (مختار && كل_الحزم && عملية_اختبار &&
            (اختبار == عدم || قارن_نص(اختبار، "1") != ٠)) {
            مختار = خطأ.
        }
        إذا (مختار) {
            عدد_منفذ = عدد_منفذ + ١.
            كود = شغل_عملية_عضو(عملية، اسم، مسار، نمط، مقفل، مشغل_فعلي).
        }
        إذا (اسم != عدم) { حرر_نص(اسم). }
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إذا (اختبار != عدم) { حرر_نص(اختبار). }
        إذا (كود != ٠) { توقف. }
        م = م + ١.
    }
    إذا (مشغل_مملوك != عدم) { حرر_نص(مشغل_مملوك). }
    حرر_وسائط(فهرس).
    إذا (كود != ٠) { إرجع كود. }
    إذا (عدد_منفذ == ٠) {
        إذا (حزمة != عدم && طول_نص(حزمة) > ٠) {
            اطبع_منسق("[خطأ] حزمة مساحة العمل غير موجودة أو بلا اختبار مطابق: %ن\س"، حزمة).
        }
        وإلا { اطبع "[خطأ] لا توجد حزم مساحة عمل قابلة للعملية المطلوبة.". }
        إرجع كود_تكوين_غير_مدعوم.
    }
    اطبع_منسق("[تم] اكتملت عملية مساحة العمل على %ص حزمة.\س"، عدد_منفذ).
    إرجع كود_تكوين_نجاح.
}
