#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

// builtin formatted string helper (returns heap string)
نص نسق(نص تنسيق_ثابت، ...).

صحيح اكتب_سطر_آمن(عدم* ملف، نص سطر) {
    صحيح ن = اكتب_سطر(ملف، سطر).
    إذا (ن < ٠) {
        إرجع كود_تكوين_خطأ_عام.
    }

    إرجع كود_تكوين_نجاح.
}

نص الصق_وحرر_يسار(نص يسار، نص يمين) {
    نص ناتج = دمج_نص(يسار، يمين).
    حرر_نص(يسار).
    إرجع ناتج.
}

منطقي نص_فارغ_او_مسافات(نص س) {
    إذا (س == عدم) {
        إرجع صواب.
    }

    صحيح طول = طول_نص(س).
    إذا (طول == ٠) {
        إرجع صواب.
    }

    صحيح م = ٠.
    طالما (م < طول) {
        إذا (س[م] != ' ' && س[م] != '\ت') {
            إرجع خطأ.
        }

        م = م + ١.
    }

    إرجع صواب.
}

منطقي حرف_مسافة(حرف ح) {
    إرجع ح == ' ' || ح == '\ت'.
}

نص قص_مسافات(نص قيمة) {
    صحيح بداية = ٠.
    صحيح نهاية = طول_نص(قيمة).

    طالما (بداية < نهاية && حرف_مسافة(قيمة[بداية])) {
        بداية = بداية + ١.
    }
    طالما (نهاية > بداية && حرف_مسافة(قيمة[نهاية - ١])) {
        نهاية = نهاية - ١.
    }

    نص ناتج = نسخ_نص("").
    صحيح م = بداية.
    طالما (م < نهاية) {
        نص كنص = نسق("%ح"، قيمة[م]).
        ناتج = الصق_وحرر_يسار(ناتج، كنص).
        حرر_نص(كنص).
        م = م + ١.
    }
    إرجع ناتج.
}

منطقي نص_صالح_للمسار(نص قيمة) {
    إذا (قيمة == عدم) {
        إرجع خطأ.
    }

    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        إذا (ح == '\س' || ح == '\ر') {
            إرجع خطأ.
        }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي ينتهي_بفاصل_مسار(نص مسار) {
    إذا (مسار == عدم || طول_نص(مسار) == ٠) {
        إرجع خطأ.
    }

    حرف آخر = مسار[طول_نص(مسار) - ١].
    إرجع (آخر == '/' || آخر == '\\').
}

منطقي مسار_مطلق_ويندوز(نص مسار) {
    إذا (مسار == عدم) {
        إرجع خطأ.
    }

    صحيح طول = طول_نص(مسار).

    إذا (طول >= 2 && مسار[1] == ':') {
        إرجع صواب.
    }

    إذا (طول >= 2 && مسار[0] == '\\' && مسار[1] == '\\') {
        إرجع صواب.
    }

    إذا (طول >= 1 && (مسار[0] == '/' || مسار[0] == '\\')) {
        إرجع صواب.
    }

    إرجع خطأ.
}

منطقي يحتوي_على_تنفيذ(نص النص، نص الجزء) {
    صحيح طول_النص = طول_نص(النص).
    صحيح طول_الجزء = طول_نص(الجزء).

    إذا (طول_الجزء == ٠) {
        إرجع صواب.
    }

    إذا (طول_الجزء > طول_النص) {
        إرجع خطأ.
    }

    صحيح م = ٠.
    طالما (م <= طول_النص - طول_الجزء) {
        منطقي مطابق = صواب.
        صحيح ن = ٠.

        طالما (ن < طول_الجزء) {
            إذا (النص[م + ن] != الجزء[ن]) {
                مطابق = خطأ.
                توقف.
            }
            ن = ن + ١.
        }

        إذا (مطابق) {
            إرجع صواب.
        }
        م = م + ١.
    }

    إرجع خطأ.
}

منطقي مسار_نسبي_آمن(نص مسار) {
    إرجع نص_صالح_للمسار(مسار) && !مسار_مطلق_ويندوز(مسار) &&
           !يحتوي_على_تنفيذ(مسار، "..").
}

منطقي نموذج_آمن_للتنفيذ() {
    إذا (!نص_صالح_للمسار(احصل_تكوين_الاسم()) ||
        يحتوي_على_تنفيذ(احصل_تكوين_الاسم()، "/") ||
        يحتوي_على_تنفيذ(احصل_تكوين_الاسم()، "\\") ||
        يحتوي_على_تنفيذ(احصل_تكوين_الاسم()، "..")) {
        اطبع "[خطأ] اسم المشروع غير آمن كاسم ناتج.".
        إرجع خطأ.
    }

    إذا (!مسار_نسبي_آمن(احصل_تكوين_المصدر()) ||
        !مسار_نسبي_آمن(احصل_تكوين_المخرج())) {
        اطبع "[خطأ] مسارا المصدر والمخرج يجب أن يكونا نسبيين داخل المشروع وبلا اجتياز '..'.".
        إرجع خطأ.
    }

    إذا (!نص_فارغ_او_مسافات(احصل_تكوين_الأعلام_الإضافية())) {
        اطبع "[خطأ] الحقل 'أعلام_إضافية' معطل أمنيا؛ استخدم حقول تكوين typed معروفة.".
        إرجع خطأ.
    }

    إرجع صواب.
}

منطقي مسار_جذر_محرك(نص مسار) {
    إذا (طول_نص(مسار) == ٣ &&
        ((مسار[٠] >= 'A' && مسار[٠] <= 'Z') || (مسار[٠] >= 'a' && مسار[٠] <= 'z')) &&
        مسار[١] == ':' &&
        (مسار[٢] == '\\' || مسار[٢] == '/')) {
        إرجع صواب.
    }
    إرجع خطأ.
}

منطقي مسار_خطر_للتنظيف(نص مسار) {
    إذا (نص_فارغ_او_مسافات(مسار)) {
        إرجع صواب.
    }

    إذا (قارن_نص(مسار، ".") == ٠ || قارن_نص(مسار، "./") == ٠ || قارن_نص(مسار، ".\\") == ٠) {
        إرجع صواب.
    }

    إذا (قارن_نص(مسار، "/") == ٠ || قارن_نص(مسار، "\\") == ٠ || مسار_جذر_محرك(مسار)) {
        إرجع صواب.
    }

    إذا (يحتوي_على_تنفيذ(مسار، "..")) {
        إرجع صواب.
    }

    إرجع خطأ.
}

منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة) {
    إذا (وسائط == عدم || قيمة == عدم) {
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
        إرجع خطأ.
    }
    إذا (!ادفع_متجه(وسائط، &قيمة)) {
        حرر_نص(قيمة).
        إرجع خطأ.
    }
    إرجع صواب.
}

منطقي اضف_وسيط(متجه وسائط، نص قيمة) {
    إرجع اضف_وسيط_مملوك(وسائط، نسخ_نص(قيمة)).
}

عدم حرر_وسائط(متجه وسائط) {
    إذا (وسائط == عدم) { إرجع. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    صحيح م = ٠.
    طالما (م < طول_متجه(وسائط)) {
        نص قيمة = *(بيانات + م).
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
        م = م + ١.
    }
    حرر_متجه(وسائط).
}

صحيح شغل_وسائط(متجه وسائط) {
    إذا (وسائط == عدم || طول_متجه(وسائط) == ٠) { إرجع -١. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    مقبض_عملية عملية = ابدأ_عملية(بيانات، طول_متجه(وسائط)، عدم، عدم، ٠، عدم، عدم).
    إذا (عملية == عدم) { إرجع -١. }
    صحيح كود = انتظر_عملية(عملية).
    حرر_عملية(عملية).
    إرجع كود.
}

منطقي اضف_ملفات_من(متجه وسائط، نص جذر، نص مصدر، نص قائمة_الملفات) {
    نص جذر_المصدر = ضم_مسار(جذر، مصدر).
    إذا (جذر_المصدر == عدم) { إرجع خطأ. }
    نص جزء = نسخ_نص("").
    صحيح طول = طول_نص(قائمة_الملفات).
    صحيح م = ٠.

    طالما (م <= طول) {
        منطقي نهاية_جزء = م == طول.
        حرف ح = ','.
        إذا (!نهاية_جزء) {
            ح = قائمة_الملفات[م].
            نهاية_جزء = ح == ',' || ح == '،' || ح == '\س'.
        }

        إذا (نهاية_جزء) {
            نص مقصوص = قص_مسافات(جزء).
            حرر_نص(جزء).
            جزء = نسخ_نص("").

            إذا (نص_فارغ_او_مسافات(مقصوص) || !مسار_نسبي_آمن(مقصوص)) {
                حرر_نص(مقصوص).
                حرر_نص(جزء).
                حرر_نص(جذر_المصدر).
                إرجع خطأ.
            }

            نص مسار = ضم_مسار(جذر_المصدر، مقصوص).
            حرر_نص(مقصوص).
            إذا (مسار == عدم) {
                حرر_نص(جزء).
                حرر_نص(جذر_المصدر).
                إرجع خطأ.
            }

            إذا (!اضف_وسيط_مملوك(وسائط، مسار)) {
                حرر_نص(جزء).
                حرر_نص(جذر_المصدر).
                إرجع خطأ.
            }
        }
        وإلا {
            نص كنص = نسق("%ح"، ح).
            جزء = الصق_وحرر_يسار(جزء، كنص).
            حرر_نص(كنص).
        }

        م = م + ١.
    }

    حرر_نص(جزء).
    حرر_نص(جذر_المصدر).
    إرجع صواب.
}

متجه انسخ_قائمة_نصوص(متجه أصل) {
    متجه نسخة = أنشئ_متجه(حجم(نص)).
    إذا (نسخة == عدم) { إرجع عدم. }
    إذا (أصل == عدم) { إرجع نسخة. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(أصل)).
    صحيح م = ٠.
    طالما (م < طول_متجه(أصل)) {
        إذا (!اضف_وسيط(نسخة، *(بيانات + م))) {
            حرر_وسائط(نسخة).
            إرجع عدم.
        }
        م = م + ١.
    }
    إرجع نسخة.
}

منطقي قائمة_تحوي_نص(متجه قائمة، نص قيمة) {
    إذا (قائمة == عدم) { إرجع خطأ. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(قائمة)).
    صحيح م = ٠.
    طالما (م < طول_متجه(قائمة)) {
        إذا (قارن_نص(*(بيانات + م)، قيمة) == ٠) { إرجع صواب. }
        م = م + ١.
    }
    إرجع خطأ.
}

منطقي اضف_تضمين_مملوك(متجه وسائط، نص مسار) {
    إذا (!اضف_وسيط(وسائط، "-I")) {
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إرجع خطأ.
    }
    إرجع اضف_وسيط_مملوك(وسائط، مسار).
}

منطقي اضف_تضمينات_من(متجه وسائط، نص جذر، نص قائمة) {
    إذا (قائمة == عدم || طول_نص(قائمة) == ٠) { إرجع صواب. }
    نص جزء = نسخ_نص("").
    صحيح طول = طول_نص(قائمة).
    صحيح م = ٠.
    طالما (م <= طول) {
        منطقي نهاية = م == طول.
        حرف ح = ','.
        إذا (!نهاية) {
            ح = قائمة[م].
            نهاية = ح == '\س' || ح == ',' || ح == '،'.
        }
        إذا (نهاية) {
            نص مقصوص = قص_مسافات(جزء).
            حرر_نص(جزء).
            جزء = نسخ_نص("").
            إذا (نص_فارغ_او_مسافات(مقصوص) || !مسار_نسبي_آمن(مقصوص)) {
                حرر_نص(مقصوص). حرر_نص(جزء). إرجع خطأ.
            }
            نص كامل = ضم_مسار(جذر، مقصوص).
            حرر_نص(مقصوص).
            إذا (!اضف_تضمين_مملوك(وسائط، كامل)) {
                حرر_نص(جزء). إرجع خطأ.
            }
        }
        وإلا {
            نص كنص = نسق("%ح"، ح).
            جزء = الصق_وحرر_يسار(جزء، كنص).
            حرر_نص(كنص).
        }
        م = م + ١.
    }
    حرر_نص(جزء).
    إرجع صواب.
}

منطقي اضف_اعتماديات_من(متجه وسائط، نص جذر، متجه اعتماديات،
                        متجه نشطة، متجه منجزة، صحيح عمق) {
    إذا (عمق > ١٦) {
        اطبع "[خطأ] تجاوز عمق اعتماديات المسار 16؛ تحقق من وجود دورة.".
        إرجع خطأ.
    }
    إذا (اعتماديات == عدم) { إرجع صواب. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(اعتماديات)).
    صحيح م = ٠.
    طالما (م < طول_متجه(اعتماديات)) {
        نص كامل_خام = ضم_مسار(جذر، *(بيانات + م)).
        نص كامل = طبع_مسار(كامل_خام).
        حرر_نص(كامل_خام).
        إذا (كامل == عدم) { إرجع خطأ. }
        إذا (قائمة_تحوي_نص(نشطة، كامل)) {
            اطبع_منسق("[خطأ] دورة في اعتماديات المسار عند: %ن\س"، كامل).
            حرر_نص(كامل).
            إرجع خطأ.
        }
        إذا (قائمة_تحوي_نص(منجزة، كامل)) {
            حرر_نص(كامل).
            م = م + ١.
            استمر.
        }
        إذا (!اضف_وسيط(نشطة، كامل)) { حرر_نص(كامل). إرجع خطأ. }

        نص بيان = ضم_مسار(كامل، "مشروع.تكوين").
        صحيح نتيجة = تحليل_ملف_تكوين(بيان).
        حرر_نص(بيان).
        إذا (نتيجة != ٠ || !تكوين_بيان_في1()) {
            اطبع_منسق("[خطأ] اعتمادية المسار ليست حزمة v1 صالحة: %ن\س"، كامل).
            حرر_نص(كامل).
            إرجع خطأ.
        }
        منطقي صالح = اضف_تضمين_مملوك(وسائط، نسخ_نص(كامل)).
        إذا (صالح) {
            صالح = اضف_تضمينات_من(وسائط، كامل، احصل_تكوين_مسارات_التضمين()).
        }
        إذا (صالح) {
            صالح = اضف_ملفات_من(وسائط، كامل، احصل_تكوين_المصدر()، احصل_تكوين_الملفات()).
        }
        متجه أبناء = انسخ_قائمة_نصوص(احصل_اعتماديات_المسار()).
        إذا (أبناء == عدم) { صالح = خطأ. }
        إذا (صالح) { صالح = اضف_اعتماديات_من(وسائط، كامل، أبناء، نشطة، منجزة، عمق + ١). }
        حرر_وسائط(أبناء).

        نص منزوعة = عدم.
        إذا (اسحب_متجه(نشطة، &منزوعة) && منزوعة != عدم) { حرر_نص(منزوعة). }
        إذا (صالح && !اضف_وسيط(منجزة، كامل)) { صالح = خطأ. }
        حرر_نص(كامل).
        إذا (!صالح) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي اضف_اعتماديات_المشروع(متجه وسائط) {
    متجه اعتماديات = انسخ_قائمة_نصوص(احصل_اعتماديات_المسار()).
    إذا (اعتماديات == عدم) { إرجع خطأ. }
    إذا (طول_متجه(اعتماديات) == ٠) { حرر_وسائط(اعتماديات). إرجع صواب. }
    متجه نشطة = أنشئ_متجه(حجم(نص)).
    متجه منجزة = أنشئ_متجه(حجم(نص)).
    منطقي صالح = نشطة != عدم && منجزة != عدم.
    إذا (صالح) { صالح = اضف_اعتماديات_من(وسائط، "."، اعتماديات، نشطة، منجزة، ٠). }
    حرر_وسائط(اعتماديات).
    حرر_وسائط(نشطة).
    حرر_وسائط(منجزة).
    منطقي استعيد = تحليل_ملف_تكوين("مشروع.تكوين") == ٠.
    إرجع صالح && استعيد.
}

نص علم_تحسين_كنص(صحيح تحسين) {
    إذا (تحسين == 0) {
        إرجع نسخ_نص("-O0").
    }

    إذا (تحسين == 2) {
        إرجع نسخ_نص("-O2").
    }

    إرجع نسخ_نص("-O1").
}

نص ابن_مسار_الناتج() {
    نص مسار = نسخ_نص(احصل_تكوين_المخرج()).

    إذا (!ينتهي_بفاصل_مسار(مسار)) {
        مسار = الصق_وحرر_يسار(مسار، "/").
    }

    مسار = الصق_وحرر_يسار(مسار، احصل_تكوين_الاسم()).

    إذا (قارن_نص(احصل_تكوين_النوع()، "تنفيذي") == ٠) {
        مسار = الصق_وحرر_يسار(مسار، ".exe").
    }
    وإلا {
        مسار = الصق_وحرر_يسار(مسار، ".out").
    }

    إرجع مسار.
}

صحيح جهز_مجلد_المخرج() {
    إذا (انشئ_مجلدات(احصل_تكوين_المخرج()) != ٠) {
        اطبع "[خطأ] فشل إنشاء/التحقق من مجلد المخرج.".
        إرجع كود_تكوين_خطأ_عام.
    }

    إرجع كود_تكوين_نجاح.
}

متجه ابن_وسائط_البناء(نص مسار_الناتج، نص علم_التحسين) {
    نص مسار_الكاش = ضم_مسار(احصل_تكوين_المخرج()، ".takween-cache").
    نص مسار_البيان = ضم_مسار(احصل_تكوين_المخرج()، "build-manifest.json").
    إذا (مسار_الكاش == عدم || مسار_البيان == عدم) {
        إذا (مسار_الكاش != عدم) { حرر_نص(مسار_الكاش). }
        إذا (مسار_البيان != عدم) { حرر_نص(مسار_البيان). }
        إرجع عدم.
    }

    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي فشل = وسائط == عدم.
    إذا (!اضف_وسيط(وسائط، "baa")) { فشل = صواب. }
    إذا (!اضف_ملفات_من(وسائط، "."، احصل_تكوين_المصدر()، احصل_تكوين_الملفات())) { فشل = صواب. }
    إذا (!اضف_تضمينات_من(وسائط، "."، احصل_تكوين_مسارات_التضمين())) { فشل = صواب. }
    إذا (!اضف_اعتماديات_المشروع(وسائط)) { فشل = صواب. }
    نص هدف_باء = احصل_تكوين_هدف_باء().
    إذا (هدف_باء != عدم && طول_نص(هدف_باء) > ٠) {
        إذا (!اضف_وسيط_مملوك(وسائط، دمج_نص("--target="، هدف_باء))) { فشل = صواب. }
    }
    إذا (!اضف_وسيط(وسائط، علم_التحسين)) { فشل = صواب. }
    إذا (احصل_تكوين_التحقق()) {
        إذا (!اضف_وسيط(وسائط، "--verify")) { فشل = صواب. }
    }
    إذا (!اضف_وسيط(وسائط، "--incremental")) { فشل = صواب. }
    إذا (!اضف_وسيط(وسائط، "--cache-dir")) { فشل = صواب. }
    إذا (!اضف_وسيط_مملوك(وسائط، مسار_الكاش)) { فشل = صواب. }
    إذا (!اضف_وسيط(وسائط، "--emit-build-manifest")) { فشل = صواب. }
    إذا (!اضف_وسيط_مملوك(وسائط، مسار_البيان)) { فشل = صواب. }
    إذا (!اضف_وسيط(وسائط، "-o")) { فشل = صواب. }
    إذا (!اضف_وسيط(وسائط، مسار_الناتج)) { فشل = صواب. }
    إذا (فشل) {
        حرر_وسائط(وسائط).
        إرجع عدم.
    }
    إرجع وسائط.
}

متجه ابن_وسائط_الفحص() {
    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي فشل = وسائط == عدم.
    إذا (!اضف_وسيط(وسائط، "baa")) { فشل = صواب. }
    إذا (!اضف_وسيط(وسائط، "--check")) { فشل = صواب. }
    إذا (!اضف_وسيط(وسائط، "--diagnostics=json")) { فشل = صواب. }
    إذا (!اضف_ملفات_من(وسائط، "."، احصل_تكوين_المصدر()، احصل_تكوين_الملفات())) { فشل = صواب. }
    إذا (!اضف_تضمينات_من(وسائط، "."، احصل_تكوين_مسارات_التضمين())) { فشل = صواب. }
    إذا (!اضف_اعتماديات_المشروع(وسائط)) { فشل = صواب. }
    نص هدف_باء = احصل_تكوين_هدف_باء().
    إذا (هدف_باء != عدم && طول_نص(هدف_باء) > ٠) {
        إذا (!اضف_وسيط_مملوك(وسائط، دمج_نص("--target="، هدف_باء))) { فشل = صواب. }
    }
    إذا (فشل) {
        حرر_وسائط(وسائط).
        إرجع عدم.
    }
    إرجع وسائط.
}

صحيح اكتب_قالب_ملف_المشروع() {
    عدم* ملف = فتح_ملف("مشروع.تكوين"، "كتابة").
    إذا (ملف == عدم) {
        اطبع "[خطأ] لا يمكن إنشاء ملف مشروع.تكوين.".
        إرجع كود_تكوين_خطأ_عام.
    }

    إذا (اكتب_سطر_آمن(ملف، "الاسم: تطبيقي_الأول") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "الإصدار: 1.0.0") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "النوع: تنفيذي") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "المصدر: المصدر/") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "المخرج: بناء/") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "ملفات: الرئيسية.baa") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "التحسين: ١") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }

    اغلق_ملف(ملف).
    إرجع كود_تكوين_نجاح.
}

صحيح اكتب_قالب_الملف_الرئيسي() {
    عدم* ملف = فتح_ملف("المصدر/الرئيسية.baa"، "كتابة").
    إذا (ملف == عدم) {
        اطبع "[خطأ] لا يمكن إنشاء المصدر/الرئيسية.baa.".
        إرجع كود_تكوين_خطأ_عام.
    }

    إذا (اكتب_سطر_آمن(ملف، "صحيح الرئيسية() {") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "    اطبع \"مرحباً من تكوين\".") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "    إرجع ٠.") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }
    إذا (اكتب_سطر_آمن(ملف، "}") != ٠) { اغلق_ملف(ملف). إرجع كود_تكوين_خطأ_عام. }

    اغلق_ملف(ملف).
    إرجع كود_تكوين_نجاح.
}

صحيح تنفيذ_تهيئة() {
    إذا (انشئ_مجلدات("المصدر") != ٠) {
        اطبع "[خطأ] لا يمكن إنشاء مجلد المصدر.".
        إرجع كود_تكوين_خطأ_عام.
    }

    إذا (اكتب_قالب_ملف_المشروع() != ٠) {
        إرجع كود_تكوين_خطأ_عام.
    }

    إذا (اكتب_قالب_الملف_الرئيسي() != ٠) {
        إرجع كود_تكوين_خطأ_عام.
    }

    اطبع "[تم] تمت تهيئة مشروع تكوين MVP.".
    إرجع كود_تكوين_نجاح.
}

صحيح تنفيذ_بناء() {
    صحيح نتيجة = تحليل_ملف_تكوين("مشروع.تكوين").
    إذا (نتيجة != ٠) {
        إرجع نتيجة.
    }

    إذا (!نموذج_آمن_للتنفيذ()) {
        إرجع كود_تكوين_خطأ_عام.
    }

    إذا (قارن_نص(احصل_تكوين_النوع()، "تنفيذي") != ٠) {
        اطبع_منسق("[غير مدعوم بعد] بناء هدف النوع '%ن' مستقلا سيُفعّل في مرحلة لاحقة.\س"، احصل_تكوين_النوع()).
        إرجع كود_تكوين_غير_مدعوم.
    }

    إذا (جهز_مجلد_المخرج() != ٠) {
        إرجع كود_تكوين_خطأ_عام.
    }

    نص مسار_الناتج = ابن_مسار_الناتج().
    نص علم_التحسين = علم_تحسين_كنص(احصل_تكوين_التحسين()).
    متجه وسائط_البناء = ابن_وسائط_البناء(مسار_الناتج، علم_التحسين).

    إذا (وسائط_البناء == عدم) {
        حرر_نص(علم_التحسين).
        حرر_نص(مسار_الناتج).
        اطبع "[خطأ] تعذر إنشاء خطة استدعاء Baa.".
        إرجع كود_تكوين_خطأ_عام.
    }

    اطبع_منسق("[INFO] بناء المشروع: %ن\س"، احصل_تكوين_الاسم()).

    صحيح كود_خروج = شغل_وسائط(وسائط_البناء).
    حرر_وسائط(وسائط_البناء).
    حرر_نص(علم_التحسين).
    حرر_نص(مسار_الناتج).

    إذا (كود_خروج != ٠) {
        اطبع_منسق("[خطأ] فشل البناء. كود الخروج: %ص\س"، كود_خروج).
        إرجع كود_تكوين_خطأ_عام.
    }

    اطبع "[تم] اكتمل البناء بنجاح.".
    إرجع كود_تكوين_نجاح.
}

صحيح تنفيذ_فحص() {
    صحيح نتيجة = تحليل_ملف_تكوين("مشروع.تكوين").
    إذا (نتيجة != ٠) {
        إرجع نتيجة.
    }
    إذا (!نموذج_آمن_للتنفيذ()) {
        إرجع كود_تكوين_خطأ_عام.
    }

    متجه وسائط = ابن_وسائط_الفحص().
    إذا (وسائط == عدم) {
        إرجع كود_تكوين_خطأ_عام.
    }

    صحيح كود_الخروج = شغل_وسائط(وسائط).
    حرر_وسائط(وسائط).
    إرجع كود_الخروج.
}

صحيح تنفيذ_تشغيل() {
    صحيح نتيجة_بناء = تنفيذ_بناء().
    إذا (نتيجة_بناء != ٠) {
        إرجع نتيجة_بناء.
    }

    نص مسار_الناتج = ابن_مسار_الناتج().
    متجه وسائط = أنشئ_متجه(حجم(نص)).
    إذا (وسائط == عدم || !اضف_وسيط(وسائط، مسار_الناتج)) {
        حرر_وسائط(وسائط).
        حرر_نص(مسار_الناتج).
        إرجع كود_تكوين_خطأ_عام.
    }

    اطبع_منسق("[INFO] تشغيل الناتج: %ن\س"، مسار_الناتج).
    صحيح كود_الخروج = شغل_وسائط(وسائط).

    حرر_وسائط(وسائط).
    حرر_نص(مسار_الناتج).

    إذا (كود_الخروج != ٠) {
        اطبع_منسق("[خطأ] فشل التشغيل. كود الخروج: %ص\س"، كود_الخروج).
        إرجع كود_الخروج.
    }

    إرجع كود_تكوين_نجاح.
}

صحيح تنفيذ_تنظيف() {
    صحيح نتيجة = تحليل_ملف_تكوين("مشروع.تكوين").

    إذا (نتيجة == ٠) {
        نص مسار_المخرج = احصل_تكوين_المخرج().
        إذا (مسار_خطر_للتنظيف(مسار_المخرج) || !نص_صالح_للمسار(مسار_المخرج)) {
            اطبع_منسق("[خطأ] مسار مخرج غير آمن للتنظيف: %ن\س", مسار_المخرج).
            إرجع كود_تكوين_خطأ_عام.
        }

        صحيح كود_حذف = احذف_شجرة(مسار_المخرج).
        إذا (كود_حذف != ٠) {
            اطبع_منسق("[خطأ] فشل تنظيف المخرج. كود الخروج: %ص\س"، كود_حذف).
            إرجع كود_تكوين_خطأ_عام.
        }
    }
    وإلا {
        صحيح كود_حذف = احذف_شجرة("بناء").
        إذا (كود_حذف != ٠) {
            اطبع_منسق("[خطأ] فشل تنظيف المخرج الافتراضي. كود الخروج: %ص\س"، كود_حذف).
            إرجع كود_تكوين_خطأ_عام.
        }
    }

    اطبع "[تم] تنظيف مخرجات البناء.".
    إرجع كود_تكوين_نجاح.
}


