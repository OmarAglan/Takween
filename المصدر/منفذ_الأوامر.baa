#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

// builtin formatted string helper (returns heap string)
نص نسق(نص تنسيق_ثابت، ...).
نص ابن_مسار_الناتج().

صحيح اكتب_سطر_آمن(عدم* ملف، نص سطر) {
    صحيح ن = اكتب_سطر(ملف، سطر).
    إذا (ن < ٠) {
        إرجع كود_تكوين_فشل_أداة.
    }

    إرجع كود_تكوين_نجاح.
}

نص الصق_وحرر_يسار(نص يسار، نص يمين) {
    نص ناتج = دمج_نص(يسار، يمين).
    حرر_نص(يسار).
    إرجع ناتج.
}

منطقي نص_فارغ_او_مسافات(نص س) {
    إذا (س == عدم) {
        إرجع صواب.
    }

    صحيح طول = طول_نص(س).
    إذا (طول == ٠) {
        إرجع صواب.
    }

    صحيح م = ٠.
    طالما (م < طول) {
        إذا (س[م] != ' ' && س[م] != '\ت') {
            إرجع خطأ.
        }

        م = م + ١.
    }

    إرجع صواب.
}

منطقي حرف_مسافة(حرف ح) {
    إرجع ح == ' ' || ح == '\ت'.
}

نص قص_مسافات(نص قيمة) {
    صحيح بداية = ٠.
    صحيح نهاية = طول_نص(قيمة).

    طالما (بداية < نهاية && حرف_مسافة(قيمة[بداية])) {
        بداية = بداية + ١.
    }
    طالما (نهاية > بداية && حرف_مسافة(قيمة[نهاية - ١])) {
        نهاية = نهاية - ١.
    }

    نص ناتج = نسخ_نص("").
    صحيح م = بداية.
    طالما (م < نهاية) {
        نص كنص = نسق("%ح"، قيمة[م]).
        ناتج = الصق_وحرر_يسار(ناتج، كنص).
        حرر_نص(كنص).
        م = م + ١.
    }
    إرجع ناتج.
}

منطقي نص_صالح_للمسار(نص قيمة) {
    إذا (قيمة == عدم) {
        إرجع خطأ.
    }

    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        إذا (ح == '\س' || ح == '\ر') {
            إرجع خطأ.
        }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي ينتهي_بفاصل_مسار(نص مسار) {
    إذا (مسار == عدم || طول_نص(مسار) == ٠) {
        إرجع خطأ.
    }

    حرف آخر = مسار[طول_نص(مسار) - ١].
    إرجع (آخر == '/' || آخر == '\\').
}

منطقي مسار_مطلق_ويندوز(نص مسار) {
    إذا (مسار == عدم) {
        إرجع خطأ.
    }

    صحيح طول = طول_نص(مسار).

    إذا (طول >= 2 && مسار[1] == ':') {
        إرجع صواب.
    }

    إذا (طول >= 2 && مسار[0] == '\\' && مسار[1] == '\\') {
        إرجع صواب.
    }

    إذا (طول >= 1 && (مسار[0] == '/' || مسار[0] == '\\')) {
        إرجع صواب.
    }

    إرجع خطأ.
}

منطقي يحتوي_على_تنفيذ(نص النص، نص الجزء) {
    صحيح طول_النص = طول_نص(النص).
    صحيح طول_الجزء = طول_نص(الجزء).

    إذا (طول_الجزء == ٠) {
        إرجع صواب.
    }

    إذا (طول_الجزء > طول_النص) {
        إرجع خطأ.
    }

    صحيح م = ٠.
    طالما (م <= طول_النص - طول_الجزء) {
        منطقي مطابق = صواب.
        صحيح ن = ٠.

        طالما (ن < طول_الجزء) {
            إذا (النص[م + ن] != الجزء[ن]) {
                مطابق = خطأ.
                توقف.
            }
            ن = ن + ١.
        }

        إذا (مطابق) {
            إرجع صواب.
        }
        م = م + ١.
    }

    إرجع خطأ.
}

منطقي مسار_نسبي_آمن(نص مسار) {
    إرجع نص_صالح_للمسار(مسار) && !مسار_مطلق_ويندوز(مسار) &&
           !يحتوي_على_تنفيذ(مسار، "..").
}

منطقي نموذج_آمن_للتنفيذ() {
    إذا (!نص_صالح_للمسار(احصل_تكوين_الاسم()) ||
        يحتوي_على_تنفيذ(احصل_تكوين_الاسم()، "/") ||
        يحتوي_على_تنفيذ(احصل_تكوين_الاسم()، "\\") ||
        يحتوي_على_تنفيذ(احصل_تكوين_الاسم()، "..")) {
        اطبع "[خطأ] اسم المشروع غير آمن كاسم ناتج.".
        إرجع خطأ.
    }

    إذا (!مسار_نسبي_آمن(احصل_تكوين_المصدر()) ||
        !مسار_نسبي_آمن(احصل_تكوين_المخرج())) {
        اطبع "[خطأ] مسارا المصدر والمخرج يجب أن يكونا نسبيين داخل المشروع وبلا اجتياز '..'.".
        إرجع خطأ.
    }

    إذا (!نص_فارغ_او_مسافات(احصل_تكوين_الأعلام_الإضافية())) {
        اطبع "[خطأ] الحقل 'أعلام_إضافية' معطل أمنيا؛ استخدم حقول تكوين typed معروفة.".
        إرجع خطأ.
    }

    إرجع صواب.
}

منطقي مسار_جذر_محرك(نص مسار) {
    إذا (طول_نص(مسار) == ٣ &&
        ((مسار[٠] >= 'A' && مسار[٠] <= 'Z') || (مسار[٠] >= 'a' && مسار[٠] <= 'z')) &&
        مسار[١] == ':' &&
        (مسار[٢] == '\\' || مسار[٢] == '/')) {
        إرجع صواب.
    }
    إرجع خطأ.
}

منطقي مسار_خطر_للتنظيف(نص مسار) {
    إذا (نص_فارغ_او_مسافات(مسار)) {
        إرجع صواب.
    }

    إذا (قارن_نص(مسار، ".") == ٠ || قارن_نص(مسار، "./") == ٠ || قارن_نص(مسار، ".\\") == ٠) {
        إرجع صواب.
    }

    إذا (قارن_نص(مسار، "/") == ٠ || قارن_نص(مسار، "\\") == ٠ || مسار_جذر_محرك(مسار)) {
        إرجع صواب.
    }

    إذا (يحتوي_على_تنفيذ(مسار، "..")) {
        إرجع صواب.
    }

    إرجع خطأ.
}

منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة) {
    إذا (وسائط == عدم || قيمة == عدم) {
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
        إرجع خطأ.
    }
    إذا (!ادفع_متجه(وسائط، &قيمة)) {
        حرر_نص(قيمة).
        إرجع خطأ.
    }
    إرجع صواب.
}

منطقي اضف_وسيط(متجه وسائط، نص قيمة) {
    إرجع اضف_وسيط_مملوك(وسائط، نسخ_نص(قيمة)).
}

عدم حرر_وسائط(متجه وسائط) {
    إذا (وسائط == عدم) { إرجع. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    صحيح م = ٠.
    طالما (م < طول_متجه(وسائط)) {
        نص قيمة = *(بيانات + م).
        إذا (قيمة != عدم) { حرر_نص(قيمة). }
        م = م + ١.
    }
    حرر_متجه(وسائط).
}

صحيح شغل_وسائط(متجه وسائط) {
    إذا (وسائط == عدم || طول_متجه(وسائط) == ٠) { إرجع كود_تكوين_خطأ_داخلي. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    مقبض_عملية عملية = ابدأ_عملية(بيانات، طول_متجه(وسائط)، عدم، عدم، ٠، عدم، عدم).
    إذا (عملية == عدم) { إرجع كود_تكوين_فشل_أداة. }
    صحيح كود = انتظر_عملية(عملية).
    حرر_عملية(عملية).
    إذا (كود < ٠) { إرجع كود_تكوين_فشل_أداة. }
    إرجع كود.
}

منطقي اضف_ملفات_من(متجه وسائط، نص جذر، نص مصدر، نص قائمة_الملفات) {
    نص جذر_المصدر = ضم_مسار(جذر، مصدر).
    إذا (جذر_المصدر == عدم) { إرجع خطأ. }
    نص جزء = نسخ_نص("").
    صحيح طول = طول_نص(قائمة_الملفات).
    صحيح م = ٠.

    طالما (م <= طول) {
        منطقي نهاية_جزء = م == طول.
        حرف ح = ','.
        إذا (!نهاية_جزء) {
            ح = قائمة_الملفات[م].
            نهاية_جزء = ح == ',' || ح == '،' || ح == '\س'.
        }

        إذا (نهاية_جزء) {
            نص مقصوص = قص_مسافات(جزء).
            حرر_نص(جزء).
            جزء = نسخ_نص("").

            إذا (نص_فارغ_او_مسافات(مقصوص) || !مسار_نسبي_آمن(مقصوص)) {
                حرر_نص(مقصوص).
                حرر_نص(جزء).
                حرر_نص(جذر_المصدر).
                إرجع خطأ.
            }

            نص مسار = ضم_مسار(جذر_المصدر، مقصوص).
            حرر_نص(مقصوص).
            إذا (مسار == عدم) {
                حرر_نص(جزء).
                حرر_نص(جذر_المصدر).
                إرجع خطأ.
            }

            إذا (!اضف_وسيط_مملوك(وسائط، مسار)) {
                حرر_نص(جزء).
                حرر_نص(جذر_المصدر).
                إرجع خطأ.
            }
        }
        وإلا {
            نص كنص = نسق("%ح"، ح).
            جزء = الصق_وحرر_يسار(جزء، كنص).
            حرر_نص(كنص).
        }

        م = م + ١.
    }

    حرر_نص(جزء).
    حرر_نص(جذر_المصدر).
    إرجع صواب.
}

منطقي اضف_تضمين_مملوك(متجه وسائط، نص مسار) {
    إذا (!اضف_وسيط(وسائط، "-I")) {
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إرجع خطأ.
    }
    إرجع اضف_وسيط_مملوك(وسائط، مسار).
}

منطقي اضف_تضمينات_من(متجه وسائط، نص جذر، نص قائمة) {
    إذا (قائمة == عدم || طول_نص(قائمة) == ٠) { إرجع صواب. }
    نص جزء = نسخ_نص("").
    صحيح طول = طول_نص(قائمة).
    صحيح م = ٠.
    طالما (م <= طول) {
        منطقي نهاية = م == طول.
        حرف ح = ','.
        إذا (!نهاية) {
            ح = قائمة[م].
            نهاية = ح == '\س' || ح == ',' || ح == '،'.
        }
        إذا (نهاية) {
            نص مقصوص = قص_مسافات(جزء).
            حرر_نص(جزء).
            جزء = نسخ_نص("").
            إذا (نص_فارغ_او_مسافات(مقصوص) || !مسار_نسبي_آمن(مقصوص)) {
                حرر_نص(مقصوص). حرر_نص(جزء). إرجع خطأ.
            }
            نص كامل = ضم_مسار(جذر، مقصوص).
            حرر_نص(مقصوص).
            إذا (!اضف_تضمين_مملوك(وسائط، كامل)) {
                حرر_نص(جزء). إرجع خطأ.
            }
        }
        وإلا {
            نص كنص = نسق("%ح"، ح).
            جزء = الصق_وحرر_يسار(جزء، كنص).
            حرر_نص(كنص).
        }
        م = م + ١.
    }
    حرر_نص(جزء).
    إرجع صواب.
}

نص علم_تحسين_كنص(صحيح تحسين) {
    إذا (تحسين == 0) {
        إرجع نسخ_نص("-O0").
    }

    إذا (تحسين == 2) {
        إرجع نسخ_نص("-O2").
    }

    إرجع نسخ_نص("-O1").
}

صحيح جهز_مجلد_المخرج() {
    إذا (انشئ_مجلدات(احصل_تكوين_المخرج()) != ٠) {
        اطبع "[خطأ] فشل إنشاء/التحقق من مجلد المخرج.".
        إرجع كود_تكوين_فشل_أداة.
    }

    إرجع كود_تكوين_نجاح.
}

متجه جهز_وسائط_الاعتماديات(صحيح* كود_الخطة) {
    متجه وسائط_محلولة = أنشئ_متجه(حجم(نص)).
    إذا (وسائط_محلولة == عدم) {
        *كود_الخطة = كود_تكوين_خطأ_داخلي.
        إرجع عدم.
    }
    صحيح نتيجة = حل_اعتماديات(وسائط_محلولة).
    إذا (نتيجة != ٠) {
        *كود_الخطة = نتيجة.
        حرر_وسائط(وسائط_محلولة).
        إرجع عدم.
    }
    إرجع وسائط_محلولة.
}

خطة_بناء جهز_خطة_البناء(صحيح* كود_الخطة) {
    *كود_الخطة = كود_تكوين_نجاح.
    صحيح نتيجة = تحليل_ملف_تكوين("مشروع.تكوين").
    إذا (نتيجة != ٠) {
        *كود_الخطة = نتيجة.
        إرجع عدم.
    }

    إذا (!نموذج_آمن_للتنفيذ()) {
        *كود_الخطة = كود_تكوين_خطأ_عام.
        إرجع عدم.
    }

    إذا (قارن_نص(احصل_تكوين_النوع()، "تنفيذي") != ٠ &&
        قارن_نص(احصل_تكوين_النوع()، "اختبار") != ٠) {
        اطبع_منسق("[غير مدعوم بعد] بناء هدف النوع '%ن' مستقلا سيُفعّل في مرحلة لاحقة.\س"، احصل_تكوين_النوع()).
        *كود_الخطة = كود_تكوين_غير_مدعوم.
        إرجع عدم.
    }

    صحيح نتيجة_اكتشاف = اكتشف_معلومات_الهدف().
    إذا (نتيجة_اكتشاف != ٠) {
        *كود_الخطة = نتيجة_اكتشاف.
        إرجع عدم.
    }
    إذا (!تحقق_قدرات_بناء_الهدف()) {
        *كود_الخطة = كود_تكوين_غير_مدعوم.
        إرجع عدم.
    }

    متجه وسائط_محلولة = جهز_وسائط_الاعتماديات(كود_الخطة).
    إذا (وسائط_محلولة == عدم) { إرجع عدم. }
    نص مسار_الناتج = ابن_مسار_الناتج().
    نص علم_التحسين = علم_تحسين_كنص(احصل_تكوين_التحسين()).
    إذا (مسار_الناتج == عدم || علم_التحسين == عدم) {
        إذا (مسار_الناتج != عدم) { حرر_نص(مسار_الناتج). }
        إذا (علم_التحسين != عدم) { حرر_نص(علم_التحسين). }
        حرر_وسائط(وسائط_محلولة).
        *كود_الخطة = كود_تكوين_خطأ_داخلي.
        إرجع عدم.
    }
    خطة_بناء خطة = ابن_خطة_البناء(وسائط_محلولة، مسار_الناتج،
                                   علم_التحسين، كود_الخطة).
    حرر_وسائط(وسائط_محلولة).
    حرر_نص(علم_التحسين).
    حرر_نص(مسار_الناتج).
    إرجع خطة.
}

خطة_بناء جهز_خطة_الفحص(صحيح* كود_الخطة) {
    *كود_الخطة = كود_تكوين_نجاح.
    صحيح نتيجة = تحليل_ملف_تكوين("مشروع.تكوين").
    إذا (نتيجة != ٠) {
        *كود_الخطة = نتيجة.
        إرجع عدم.
    }
    إذا (!نموذج_آمن_للتنفيذ()) {
        *كود_الخطة = كود_تكوين_خطأ_عام.
        إرجع عدم.
    }
    متجه وسائط_محلولة = جهز_وسائط_الاعتماديات(كود_الخطة).
    إذا (وسائط_محلولة == عدم) { إرجع عدم. }
    خطة_بناء خطة = ابن_خطة_الفحص(وسائط_محلولة، كود_الخطة).
    حرر_وسائط(وسائط_محلولة).
    إرجع خطة.
}

صحيح تنفيذ_بناء() {
    صحيح كود_الخطة = كود_تكوين_نجاح.
    خطة_بناء خطة = جهز_خطة_البناء(&كود_الخطة).
    إذا (خطة == عدم) {
        اطبع "[خطأ] تعذر إنشاء خطة استدعاء Baa.".
        إرجع كود_الخطة.
    }

    صحيح نتيجة_المخرج = جهز_مجلد_المخرج().
    إذا (نتيجة_المخرج != ٠) {
        حرر_وسائط(خطة).
        إرجع نتيجة_المخرج.
    }

    اطبع_منسق("[INFO] بناء المشروع: %ن\س"، احصل_تكوين_الاسم()).

    صحيح كود_خروج = شغل_وسائط(خطة).
    حرر_وسائط(خطة).

    إذا (كود_خروج != ٠) {
        اطبع_منسق("[خطأ] فشل البناء. كود الخروج: %ص\س"، كود_خروج).
        إذا (كود_خروج > ٠) { إرجع كود_خروج. }
        إرجع كود_تكوين_فشل_أداة.
    }

    اطبع "[تم] اكتمل البناء بنجاح.".
    إرجع كود_تكوين_نجاح.
}

صحيح تنفيذ_فحص() {
    صحيح كود_الخطة = كود_تكوين_نجاح.
    خطة_بناء خطة = جهز_خطة_الفحص(&كود_الخطة).
    إذا (خطة == عدم) {
        إرجع كود_الخطة.
    }

    صحيح كود_الخروج = شغل_وسائط(خطة).
    حرر_وسائط(خطة).
    إرجع كود_الخروج.
}

صحيح تنفيذ_عرض_خطة() {
    صحيح كود_الخطة = كود_تكوين_نجاح.
    خطة_بناء خطة = جهز_خطة_البناء(&كود_الخطة).
    إذا (خطة == عدم) { إرجع كود_الخطة. }
    نص بيان = خطة_بناء_إلى_جسون(خطة، "build").
    حرر_وسائط(خطة).
    إذا (بيان == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    اطبع بيان.
    حرر_نص(بيان).
    إرجع كود_تكوين_نجاح.
}

صحيح تنفيذ_تشغيل() {
    صحيح نتيجة_بناء = تنفيذ_بناء().
    إذا (نتيجة_بناء != ٠) {
        إرجع نتيجة_بناء.
    }

    نص مسار_الناتج = ابن_مسار_الناتج().
    متجه وسائط = أنشئ_متجه(حجم(نص)).
    إذا (وسائط == عدم || !اضف_وسيط(وسائط، مسار_الناتج)) {
        حرر_وسائط(وسائط).
        حرر_نص(مسار_الناتج).
        إرجع كود_تكوين_خطأ_داخلي.
    }

    اطبع_منسق("[INFO] تشغيل الناتج: %ن\س"، مسار_الناتج).
    صحيح كود_الخروج = شغل_وسائط(وسائط).

    حرر_وسائط(وسائط).
    حرر_نص(مسار_الناتج).

    إذا (كود_الخروج != ٠) {
        اطبع_منسق("[خطأ] فشل التشغيل. كود الخروج: %ص\س"، كود_الخروج).
        إرجع كود_الخروج.
    }

    إرجع كود_تكوين_نجاح.
}

