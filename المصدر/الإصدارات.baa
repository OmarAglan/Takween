#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
نص قص_طرفين(نص قيمة).

منطقي حرف_اصدار_رقمي(حرف ح) {
    إرجع ح >= '0' && ح <= '9'.
}

منطقي حرف_معرف_اصدار(حرف ح) {
    إرجع حرف_اصدار_رقمي(ح) || (ح >= 'A' && ح <= 'Z') ||
           (ح >= 'a' && ح <= 'z') || ح == '-'.
}

منطقي حلل_رقم_اصدار(نص قيمة، صحيح بداية، صحيح نهاية، صحيح* ناتج) {
    إذا (قيمة == عدم || ناتج == عدم || بداية < ٠ || نهاية <= بداية) { إرجع خطأ. }
    إذا (نهاية - بداية > ١ && قيمة[بداية] == '0') { إرجع خطأ. }
    صحيح عدد = ٠.
    صحيح م = بداية.
    طالما (م < نهاية) {
        حرف ح = قيمة[م].
        إذا (!حرف_اصدار_رقمي(ح)) { إرجع خطأ. }
        صحيح رقم = كـ<صحيح>(ح - '0').
        إذا (عدد > 214748364 || (عدد == 214748364 && رقم > 7)) { إرجع خطأ. }
        عدد = عدد * ١٠ + رقم.
        م = م + ١.
    }
    *ناتج = عدد.
    إرجع صواب.
}

منطقي تحقق_معرفات_اصدار(نص قيمة، صحيح بداية، صحيح نهاية، منطقي سابق) {
    إذا (بداية >= نهاية) { إرجع خطأ. }
    صحيح بدء = بداية.
    صحيح م = بداية.
    طالما (م <= نهاية) {
        منطقي حد = م == نهاية.
        إذا (!حد) { حد = قيمة[م] == '.'. }
        إذا (حد) {
            إذا (م == بدء) { إرجع خطأ. }
            منطقي رقمي = صواب.
            صحيح ن = بدء.
            طالما (ن < م) {
                إذا (!حرف_معرف_اصدار(قيمة[ن])) { إرجع خطأ. }
                إذا (!حرف_اصدار_رقمي(قيمة[ن])) { رقمي = خطأ. }
                ن = ن + ١.
            }
            إذا (سابق && رقمي && م - بدء > ١ && قيمة[بدء] == '0') { إرجع خطأ. }
            بدء = م + ١.
        }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي حلل_حدود_اصدار(نص قيمة، صحيح* رئيسي، صحيح* فرعي، صحيح* رقعة،
                      صحيح* بدء_سابق، صحيح* نهاية_سابق) {
    إذا (قيمة == عدم || رئيسي == عدم || فرعي == عدم || رقعة == عدم ||
        بدء_سابق == عدم || نهاية_سابق == عدم) { إرجع خطأ. }
    صحيح طول = طول_نص(قيمة).
    إذا (طول < ٥) { إرجع خطأ. }
    صحيح زائد = طول.
    صحيح ناقص = طول.
    صحيح م = ٠.
    طالما (م < طول) {
        إذا (قيمة[م] == '+' && زائد == طول) { زائد = م. }
        وإلا إذا (قيمة[م] == '-' && ناقص == طول && زائد == طول) { ناقص = م. }
        م = م + ١.
    }
    صحيح نهاية_لب = ناقص.
    إذا (زائد < نهاية_لب) { نهاية_لب = زائد. }
    صحيح نقطة١ = -١.
    صحيح نقطة٢ = -١.
    م = ٠.
    طالما (م < نهاية_لب) {
        إذا (قيمة[م] == '.') {
            إذا (نقطة١ < ٠) { نقطة١ = م. }
            وإلا إذا (نقطة٢ < ٠) { نقطة٢ = م. }
            وإلا { إرجع خطأ. }
        }
        م = م + ١.
    }
    إذا (نقطة١ <= ٠ || نقطة٢ <= نقطة١ + ١ || نقطة٢ + ١ >= نهاية_لب) { إرجع خطأ. }
    إذا (!حلل_رقم_اصدار(قيمة، ٠، نقطة١، رئيسي) ||
        !حلل_رقم_اصدار(قيمة، نقطة١ + ١، نقطة٢، فرعي) ||
        !حلل_رقم_اصدار(قيمة، نقطة٢ + ١، نهاية_لب، رقعة)) { إرجع خطأ. }

    *بدء_سابق = -١.
    *نهاية_سابق = -١.
    إذا (ناقص < زائد) {
        إذا (!تحقق_معرفات_اصدار(قيمة، ناقص + ١، زائد، صواب)) { إرجع خطأ. }
        *بدء_سابق = ناقص + ١.
        *نهاية_سابق = زائد.
    }
    إذا (زائد < طول && !تحقق_معرفات_اصدار(قيمة، زائد + ١، طول، خطأ)) { إرجع خطأ. }
    إرجع صواب.
}

منطقي اصدار_دلالي_صالح(نص قيمة) {
    صحيح رئيسي = ٠. صحيح فرعي = ٠. صحيح رقعة = ٠.
    صحيح بدء = -١. صحيح نهاية = -١.
    إرجع حلل_حدود_اصدار(قيمة، &رئيسي، &فرعي، &رقعة، &بدء، &نهاية).
}

منطقي مقطع_رقمي(نص قيمة، صحيح بداية، صحيح نهاية) {
    صحيح م = بداية.
    إذا (بداية >= نهاية) { إرجع خطأ. }
    طالما (م < نهاية) {
        إذا (!حرف_اصدار_رقمي(قيمة[م])) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

صحيح نهاية_معرف(نص قيمة، صحيح بداية، صحيح نهاية) {
    صحيح م = بداية.
    طالما (م < نهاية && قيمة[م] != '.') { م = م + ١. }
    إرجع م.
}

صحيح قارن_سابق_اصدار(نص يسار، صحيح بدء_يسار، صحيح نهاية_يسار،
                      نص يمين، صحيح بدء_يمين، صحيح نهاية_يمين) {
    صحيح ي = بدء_يسار.
    صحيح م = بدء_يمين.
    طالما (ي < نهاية_يسار && م < نهاية_يمين) {
        صحيح نهاية_ي = نهاية_معرف(يسار، ي، نهاية_يسار).
        صحيح نهاية_م = نهاية_معرف(يمين، م، نهاية_يمين).
        منطقي رقمي_ي = مقطع_رقمي(يسار، ي، نهاية_ي).
        منطقي رقمي_م = مقطع_رقمي(يمين، م، نهاية_م).
        إذا (رقمي_ي && !رقمي_م) { إرجع -١. }
        إذا (!رقمي_ي && رقمي_م) { إرجع ١. }
        إذا (رقمي_ي && رقمي_م) {
            إذا (نهاية_ي - ي < نهاية_م - م) { إرجع -١. }
            إذا (نهاية_ي - ي > نهاية_م - م) { إرجع ١. }
        }
        نص جزء_ي = نسخ_مقطع(يسار، ي، نهاية_ي).
        نص جزء_م = نسخ_مقطع(يمين، م، نهاية_م).
        إذا (جزء_ي == عدم || جزء_م == عدم) {
            إذا (جزء_ي != عدم) { حرر_نص(جزء_ي). }
            إذا (جزء_م != عدم) { حرر_نص(جزء_م). }
            إرجع -٢.
        }
        صحيح مقارنة = قارن_نص(جزء_ي، جزء_م).
        حرر_نص(جزء_ي). حرر_نص(جزء_م).
        إذا (مقارنة < ٠) { إرجع -١. }
        إذا (مقارنة > ٠) { إرجع ١. }
        ي = نهاية_ي + ١.
        م = نهاية_م + ١.
    }
    إذا (ي < نهاية_يسار) { إرجع ١. }
    إذا (م < نهاية_يمين) { إرجع -١. }
    إرجع ٠.
}

صحيح قارن_اصدار_دلالي(نص يسار، نص يمين) {
    صحيح ر١ = ٠. صحيح ف١ = ٠. صحيح ق١ = ٠. صحيح ب١ = -١. صحيح ن١ = -١.
    صحيح ر٢ = ٠. صحيح ف٢ = ٠. صحيح ق٢ = ٠. صحيح ب٢ = -١. صحيح ن٢ = -١.
    إذا (!حلل_حدود_اصدار(يسار، &ر١، &ف١، &ق١، &ب١، &ن١) ||
        !حلل_حدود_اصدار(يمين، &ر٢، &ف٢، &ق٢، &ب٢، &ن٢)) { إرجع -٢. }
    إذا (ر١ < ر٢) { إرجع -١. } إذا (ر١ > ر٢) { إرجع ١. }
    إذا (ف١ < ف٢) { إرجع -١. } إذا (ف١ > ف٢) { إرجع ١. }
    إذا (ق١ < ق٢) { إرجع -١. } إذا (ق١ > ق٢) { إرجع ١. }
    إذا (ب١ < ٠ && ب٢ < ٠) { إرجع ٠. }
    إذا (ب١ < ٠) { إرجع ١. }
    إذا (ب٢ < ٠) { إرجع -١. }
    إرجع قارن_سابق_اصدار(يسار، ب١، ن١، يمين، ب٢، ن٢).
}

صحيح تحقق_مقارنة_اصدار(نص إصدار، نص مقارنة) {
    إذا (قارن_نص(مقارنة، "*") == ٠) {
        إذا (اصدار_دلالي_صالح(إصدار)) { إرجع ١. }
        إرجع -١.
    }
    صحيح بداية = ٠.
    صحيح نوع = ٠.
    إذا (مقارنة[٠] == '^') { نوع = ١. بداية = ١. }
    وإلا إذا (مقارنة[٠] == '~') { نوع = ٢. بداية = ١. }
    وإلا إذا (مقارنة[٠] == '>' && طول_نص(مقارنة) > ١ && مقارنة[١] == '=') { نوع = ٣. بداية = ٢. }
    وإلا إذا (مقارنة[٠] == '<' && طول_نص(مقارنة) > ١ && مقارنة[١] == '=') { نوع = ٤. بداية = ٢. }
    وإلا إذا (مقارنة[٠] == '>') { نوع = ٥. بداية = ١. }
    وإلا إذا (مقارنة[٠] == '<') { نوع = ٦. بداية = ١. }
    وإلا إذا (مقارنة[٠] == '=') { بداية = ١. }
    إذا (بداية >= طول_نص(مقارنة)) { إرجع -١. }
    نص أساس = نسخ_مقطع(مقارنة، بداية، طول_نص(مقارنة)).
    إذا (أساس == عدم || !اصدار_دلالي_صالح(أساس) || !اصدار_دلالي_صالح(إصدار)) {
        إذا (أساس != عدم) { حرر_نص(أساس). }
        إرجع -١.
    }
    صحيح نتيجة = قارن_اصدار_دلالي(إصدار، أساس).
    منطقي يطابق = خطأ.
    إذا (نوع == ٠) { يطابق = نتيجة == ٠. }
    وإلا إذا (نوع == ٣) { يطابق = نتيجة >= ٠. }
    وإلا إذا (نوع == ٤) { يطابق = نتيجة <= ٠. }
    وإلا إذا (نوع == ٥) { يطابق = نتيجة > ٠. }
    وإلا إذا (نوع == ٦) { يطابق = نتيجة < ٠. }
    وإلا {
        صحيح ر١ = ٠. صحيح ف١ = ٠. صحيح ق١ = ٠. صحيح ب١ = -١. صحيح ن١ = -١.
        صحيح ر٢ = ٠. صحيح ف٢ = ٠. صحيح ق٢ = ٠. صحيح ب٢ = -١. صحيح ن٢ = -١.
        حلل_حدود_اصدار(إصدار، &ر١، &ف١، &ق١، &ب١، &ن١).
        حلل_حدود_اصدار(أساس، &ر٢، &ف٢، &ق٢، &ب٢، &ن٢).
        إذا (نوع == ٢) { يطابق = نتيجة >= ٠ && ر١ == ر٢ && ف١ == ف٢. }
        وإلا إذا (ر٢ > ٠) { يطابق = نتيجة >= ٠ && ر١ == ر٢. }
        وإلا إذا (ف٢ > ٠) { يطابق = نتيجة >= ٠ && ر١ == ٠ && ف١ == ف٢. }
        وإلا { يطابق = نتيجة >= ٠ && ر١ == ٠ && ف١ == ٠ && ق١ == ق٢. }
    }
    حرر_نص(أساس).
    إذا (يطابق) { إرجع ١. }
    إرجع ٠.
}

صحيح طبق_قيد_اصدار(نص إصدار، نص قيد، منطقي تحقق_فقط) {
    نص نظيف = قص_طرفين(قيد).
    إذا (نظيف == عدم || طول_نص(نظيف) == ٠) {
        إذا (نظيف != عدم) { حرر_نص(نظيف). }
        إرجع -١.
    }
    صحيح بداية = ٠.
    صحيح م = ٠.
    منطقي كل_مطابق = صواب.
    منطقي وجد = خطأ.
    طالما (م <= طول_نص(نظيف)) {
        منطقي حد = م == طول_نص(نظيف).
        إذا (!حد) { حد = نظيف[م] == ' ' || نظيف[م] == '\ت'. }
        إذا (حد) {
            إذا (م > بداية) {
                نص جزء = نسخ_مقطع(نظيف، بداية، م).
                صحيح نتيجة = تحقق_مقارنة_اصدار(إصدار، جزء).
                حرر_نص(جزء).
                إذا (نتيجة < ٠) { حرر_نص(نظيف). إرجع -١. }
                إذا (!تحقق_فقط && نتيجة == ٠) { كل_مطابق = خطأ. }
                وجد = صواب.
            }
            بداية = م + ١.
        }
        م = م + ١.
    }
    حرر_نص(نظيف).
    إذا (!وجد) { إرجع -١. }
    إذا (كل_مطابق) { إرجع ١. }
    إرجع ٠.
}

منطقي قيد_اصدار_دلالي_صالح(نص قيد) {
    إرجع طبق_قيد_اصدار("0.0.0"، قيد، صواب) >= ٠.
}

منطقي يطابق_قيد_اصدار(نص إصدار، نص قيد) {
    إرجع طبق_قيد_اصدار(إصدار، قيد، خطأ) == ١.
}
