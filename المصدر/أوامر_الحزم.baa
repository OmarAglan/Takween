#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
نص قص_طرفين(نص قيمة).
نص احذف_تعليق_في1(نص سطر).
منطقي يبدأ_ب(نص النص، نص البادئة).
منطقي يحتوي_على(نص النص، نص الجزء).
نص حقل_سجل_اعتمادية(نص سجل، صحيح رقم).
منطقي ملفا_قفل_متطابقان(نص يسار، نص يمين).
منطقي تجزئة_شا٢٥٦_صالحة(نص قيمة).
منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).

// -------------------------
// Byte copies and manifest lines
// -------------------------

// Copies a file byte for byte. The manifest is restored from such a copy, so
// a failed edit leaves exactly the bytes the user had, BOM and CRLF included.
منطقي انسخ_ملفا_ببايتاته(نص من، نص إلى) {
    عدم* مصدر = فتح_ملف(من، "rb").
    إذا (مصدر == عدم) { إرجع خطأ. }
    عدم* وجهة = فتح_ملف(إلى، "wb").
    إذا (وجهة == عدم) { اغلق_ملف(مصدر). إرجع خطأ. }
    عدم* مخزن = حجز_ذاكرة(4096).
    منطقي صالح = مخزن != عدم.
    طالما (صالح) {
        صحيح عدد = اقرأ_ملف(مصدر، مخزن، 4096).
        إذا (عدد <= ٠) { توقف. }
        صالح = اكتب_ملف(وجهة، مخزن، عدد) == عدد.
    }
    إذا (مخزن != عدم) { تحرير_ذاكرة(مخزن). }
    اغلق_ملف(مصدر).
    إذا (اغلق_ملف(وجهة) != ٠) { صالح = خطأ. }
    إرجع صالح.
}

منطقي سطر_ينتهي_بعودة(نص سطر) {
    صحيح طول = طول_نص(سطر).
    إذا (طول == ٠) { إرجع خطأ. }
    إرجع سطر[طول - ١] == '\ر'.
}

// The line without its CR, comment and surrounding blanks.
نص سطر_بيان_منظف(نص سطر) {
    نص بلا_عودة = عدم.
    إذا (سطر_ينتهي_بعودة(سطر)) { بلا_عودة = نسخ_مقطع(سطر، ٠، طول_نص(سطر) - ١). }
    وإلا { بلا_عودة = نسخ_نص(سطر). }
    إذا (بلا_عودة == عدم) { إرجع عدم. }
    نص ناتج = احذف_تعليق_في1(بلا_عودة).
    حرر_نص(بلا_عودة).
    إرجع ناتج.
}

منطقي سطر_بيان_فارغ(نص سطر) {
    صحيح م = ٠.
    طالما (م < طول_نص(سطر)) {
        حرف ح = سطر[م].
        إذا (ح != ' ' && ح != '\ت' && ح != '\ر') { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

نص سطر_رقم(متجه أسطر، صحيح رقم) {
    نص* بيانات = كـ<نص*>(بيانات_متجه(أسطر)).
    إرجع *(بيانات + رقم).
}

متجه اقرأ_أسطر_البيان() {
    عدم* ملف = فتح_ملف("مشروع.تكوين"، "rb").
    إذا (ملف == عدم) {
        اطبع "[خطأ] تعذر قراءة مشروع.تكوين.".
        إرجع عدم.
    }
    متجه أسطر = أنشئ_متجه(حجم(نص)).
    منطقي صالح = أسطر != عدم.
    طالما (صالح) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        صالح = اضف_وسيط_مملوك(أسطر، سطر).
    }
    اغلق_ملف(ملف).
    إذا (!صالح) {
        إذا (أسطر != عدم) { حرر_وسائط(أسطر). }
        اطبع "[خطأ] تعذر قراءة مشروع.تكوين.".
        إرجع عدم.
    }
    إرجع أسطر.
}

// Writes lines [0, بداية), then جديدة, then [نهاية, end). New lines follow
// the manifest's line ending so that an edit never mixes LF and CRLF.
منطقي اكتب_بيانا_معدلا(متجه أسطر، صحيح بداية، صحيح نهاية، متجه جديدة) {
    منطقي عودة = خطأ.
    إذا (طول_متجه(أسطر) > ٠) { عودة = سطر_ينتهي_بعودة(سطر_رقم(أسطر، ٠)). }
    عدم* ملف = فتح_ملف("مشروع.تكوين"، "wb").
    إذا (ملف == عدم) {
        اطبع "[خطأ] تعذر كتابة مشروع.تكوين.".
        إرجع خطأ.
    }
    منطقي صالح = صواب.
    صحيح م = ٠.
    طالما (صالح && م < بداية) {
        صالح = اكتب_سطر(ملف، سطر_رقم(أسطر، م)) >= ٠.
        م = م + ١.
    }
    م = ٠.
    طالما (صالح && م < طول_متجه(جديدة)) {
        نص سطر = عدم.
        إذا (عودة) { سطر = نسق("%ن\ر"، سطر_رقم(جديدة، م)). }
        وإلا { سطر = نسخ_نص(سطر_رقم(جديدة، م)). }
        صالح = سطر != عدم.
        إذا (سطر != عدم) {
            صالح = اكتب_سطر(ملف، سطر) >= ٠.
            حرر_نص(سطر).
        }
        م = م + ١.
    }
    م = نهاية.
    طالما (صالح && م < طول_متجه(أسطر)) {
        صالح = اكتب_سطر(ملف، سطر_رقم(أسطر، م)) >= ٠.
        م = م + ١.
    }
    إذا (اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    إذا (!صالح) { اطبع "[خطأ] فشلت كتابة مشروع.تكوين كاملة.". }
    إرجع صالح.
}

// -------------------------
// Dependency sections
// -------------------------

// The header line of [الاعتماديات.<اسم>], or -1.
صحيح ابحث_قسم_اعتمادية(متجه أسطر، نص اسم) {
    نص رأس = نسق("[الاعتماديات.%ن]"، اسم).
    إذا (رأس == عدم) { إرجع -١. }
    صحيح وجد = -١.
    صحيح م = ٠.
    طالما (وجد < ٠ && م < طول_متجه(أسطر)) {
        نص منظف = سطر_بيان_منظف(سطر_رقم(أسطر، م)).
        إذا (منظف != عدم) {
            إذا (قارن_نص(منظف، رأس) == ٠) { وجد = م. }
            حرر_نص(منظف).
        }
        م = م + ١.
    }
    حرر_نص(رأس).
    إرجع وجد.
}

// One past the section's last key line. Blank and comment lines that lead
// into the next section stay with that section.
صحيح نهاية_قسم(متجه أسطر، صحيح رأس) {
    صحيح نهاية = رأس + ١.
    صحيح م = رأس + ١.
    طالما (م < طول_متجه(أسطر)) {
        نص منظف = سطر_بيان_منظف(سطر_رقم(أسطر، م)).
        منطقي قسم = خطأ.
        إذا (منظف != عدم) {
            إذا (طول_نص(منظف) > ٠) {
                إذا (منظف[٠] == '[') { قسم = صواب. }
                وإلا { نهاية = م + ١. }
            }
            حرر_نص(منظف).
        }
        إذا (قسم) { توقف. }
        م = م + ١.
    }
    إرجع نهاية.
}

// New dependency sections go after the last existing one, or at the end.
صحيح موضع_اعتمادية_جديدة(متجه أسطر) {
    صحيح آخر = -١.
    صحيح م = ٠.
    طالما (م < طول_متجه(أسطر)) {
        نص منظف = سطر_بيان_منظف(سطر_رقم(أسطر، م)).
        إذا (منظف != عدم) {
            إذا (يبدأ_ب(منظف، "[الاعتماديات.")) { آخر = م. }
            حرر_نص(منظف).
        }
        م = م + ١.
    }
    إذا (آخر < ٠) { إرجع طول_متجه(أسطر). }
    إرجع نهاية_قسم(أسطر، آخر).
}

// A manifest string body: backslash and quote escaped, controls refused.
نص اهرب_قيمة_بيان(نص قيمة) {
    نص ناتج = نسخ_نص("").
    صحيح م = ٠.
    طالما (ناتج != عدم && م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        إذا (كـ<صحيح>(ح) < 32) { حرر_نص(ناتج). إرجع عدم. }
        نص جزء = عدم.
        إذا (ح == '\\' || ح == '"') { جزء = نسق("\\%ح"، ح). }
        وإلا { جزء = نسق("%ح"، ح). }
        نص جديد = عدم.
        إذا (جزء != عدم) { جديد = دمج_نص(ناتج، جزء). حرر_نص(جزء). }
        حرر_نص(ناتج).
        ناتج = جديد.
        م = م + ١.
    }
    إرجع ناتج.
}

منطقي اضف_مفتاح_نصي(متجه أسطر، نص مفتاح، نص قيمة) {
    نص مهربة = اهرب_قيمة_بيان(قيمة).
    إذا (مهربة == عدم) {
        اطبع_منسق("[خطأ] قيمة '%ن' تحوي محرف تحكم.\س"، مفتاح).
        إرجع خطأ.
    }
    نص سطر = نسق("%ن = \"%ن\""، مفتاح، مهربة).
    حرر_نص(مهربة).
    إرجع اضف_وسيط_مملوك(أسطر، سطر).
}

// -------------------------
// Edit transaction
// -------------------------

نص نسخة_البيان = "".  // Empty when no edit is open.

// Parses the v1 manifest, keeps a byte copy of it and returns its lines.
متجه ابدأ_تعديل_البيان(صحيح* كود) {
    *كود = كود_تكوين_خطأ_عام.
    صحيح تحليل = تحليل_ملف_تكوين("مشروع.تكوين").
    إذا (تحليل != ٠) { *كود = تحليل. إرجع عدم. }
    إذا (!تكوين_بيان_في1()) {
        اطبع "[خطأ] أوامر الحزم تعمل على بيان takween-manifest-v1 فقط.".
        *كود = كود_تكوين_غير_مدعوم.
        إرجع عدم.
    }
    إذا (انشئ_مجلدات(".takween") != ٠) {
        اطبع "[خطأ] تعذر إنشاء مجلد .takween.".
        *كود = كود_تكوين_فشل_أداة.
        إرجع عدم.
    }
    نسخة_البيان = ضم_مسار(".takween"، "manifest-before-edit").
    منطقي محفوظة = خطأ.
    إذا (نسخة_البيان != عدم) { محفوظة = انسخ_ملفا_ببايتاته("مشروع.تكوين"، نسخة_البيان). }
    إذا (!محفوظة) {
        اطبع "[خطأ] تعذر حفظ نسخة من مشروع.تكوين قبل تعديله.".
        إذا (نسخة_البيان != عدم) { حرر_نص(نسخة_البيان). }
        نسخة_البيان = "".
        *كود = كود_تكوين_فشل_أداة.
        إرجع عدم.
    }
    متجه أسطر = اقرأ_أسطر_البيان().
    إذا (أسطر == عدم) {
        احذف_شجرة(نسخة_البيان).
        حرر_نص(نسخة_البيان). نسخة_البيان = "".
        *كود = كود_تكوين_فشل_أداة.
        إرجع عدم.
    }
    *كود = كود_تكوين_نجاح.
    إرجع أسطر.
}

عدم انه_تعديل_البيان(متجه أسطر) {
    إذا (أسطر != عدم) { حرر_وسائط(أسطر). }
    إذا (نسخة_البيان != عدم) {
        إذا (طول_نص(نسخة_البيان) > ٠) {
            احذف_شجرة(نسخة_البيان).
            حرر_نص(نسخة_البيان).
            نسخة_البيان = "".
        }
    }
}

صحيح حل_بعد_التعديل() {
    حدد_وضع_مقفل(خطأ).
    حدد_وضع_دون_شبكة(خطأ).
    حدد_وضع_توريد(خطأ).
    متجه وسائط = أنشئ_متجه(حجم(نص)).
    إذا (وسائط == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    صحيح كود = حل_اعتماديات(وسائط).
    حرر_وسائط(وسائط).
    إرجع كود.
}

// Writes the edit, re-reads the manifest and resolves. On any failure the
// original bytes go back. The resolver writes تكوين.قفل only on success.
صحيح طبق_تعديل_البيان(متجه أسطر، صحيح بداية، صحيح نهاية، متجه جديدة) {
    صحيح كود = كود_تكوين_خطأ_عام.
    منطقي صالح = اكتب_بيانا_معدلا(أسطر، بداية، نهاية، جديدة).
    إذا (صالح) {
        صحيح تحليل = تحليل_ملف_تكوين("مشروع.تكوين").
        صالح = تحليل == ٠ && تكوين_بيان_في1().
        إذا (!صالح) { اطبع "[خطأ] البيان بعد التعديل ليس takween-manifest-v1 صالحا.". }
    }
    إذا (صالح) {
        كود = حل_بعد_التعديل().
        صالح = كود == ٠.
    }
    إذا (صالح) { إرجع كود_تكوين_نجاح. }
    إذا (!انسخ_ملفا_ببايتاته(نسخة_البيان، "مشروع.تكوين")) {
        اطبع_منسق("[خطأ] تعذرت استعادة مشروع.تكوين؛ النسخة الأصلية محفوظة في %ن\س"، نسخة_البيان).
        حرر_نص(نسخة_البيان).
        نسخة_البيان = "".
        إرجع كود_تكوين_خطأ_داخلي.
    }
    تحليل_ملف_تكوين("مشروع.تكوين").
    اطبع "[خطأ] لم يطبق التعديل؛ أعيد مشروع.تكوين كما كان.".
    إذا (كود == ٠) { كود = كود_تكوين_خطأ_عام. }
    إرجع كود.
}

// -------------------------
// Local package index
// -------------------------

// Reads TAKWEEN_PACKAGE_INDEX into owned "name<TAB>version" records.
متجه اقرأ_سجلات_الفهرس(صحيح* كود) {
    *كود = كود_تكوين_خطأ_عام.
    نص فهرس = متغير_بيئة("TAKWEEN_PACKAGE_INDEX").
    منطقي بلا_فهرس = فهرس == عدم.
    إذا (فهرس != عدم) { بلا_فهرس = طول_نص(فهرس) == ٠. }
    إذا (بلا_فهرس) {
        اطبع "[خطأ] أوامر الفهرس تتطلب فهرسا محليا صريحا في TAKWEEN_PACKAGE_INDEX؛ السجل العام مؤجل.".
        إذا (فهرس != عدم) { حرر_نص(فهرس). }
        إرجع عدم.
    }
    عدم* ملف = فتح_ملف(فهرس، "قراءة").
    إذا (ملف == عدم) {
        اطبع_منسق("[خطأ] تعذر فتح فهرس الحزم المحلي: %ن\س"، فهرس).
        حرر_نص(فهرس).
        إرجع عدم.
    }
    حرر_نص(فهرس).
    نص رأس = اقرأ_سطر(ملف).
    منطقي صالح = خطأ.
    إذا (رأس != عدم) {
        صالح = قارن_نص(رأس، "takween-index-v1") == ٠.
        حرر_نص(رأس).
    }
    إذا (!صالح) { اطبع "[خطأ] فهرس الحزم لا يطابق takween-index-v1.". }
    متجه سجلات = أنشئ_متجه(حجم(نص)).
    إذا (سجلات == عدم) { صالح = خطأ. }
    طالما (صالح) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        إذا (طول_نص(سطر) > ٠) {
            نص اسم = حقل_سجل_اعتمادية(سطر، ٠).
            نص إصدار = حقل_سجل_اعتمادية(سطر، ١).
            نص تجزئة = حقل_سجل_اعتمادية(سطر، ٢).
            نص أرشيف = حقل_سجل_اعتمادية(سطر، ٣).
            صالح = اسم != عدم && إصدار != عدم && تجزئة != عدم && أرشيف != عدم.
            إذا (صالح) { صالح = اصدار_دلالي_صالح(إصدار) && تجزئة_شا٢٥٦_صالحة(تجزئة). }
            إذا (!صالح) { اطبع "[خطأ] سجل غير صالح في takween-index-v1.". }
            إذا (صالح) { صالح = تحقق_هوية_حزمة_مؤهلة(اسم، "اسم الحزمة في الفهرس"). }
            إذا (صالح) { صالح = اضف_وسيط_مملوك(سجلات، نسق("%ن\ت%ن"، اسم، إصدار)). }
            إذا (اسم != عدم) { حرر_نص(اسم). }
            إذا (إصدار != عدم) { حرر_نص(إصدار). }
            إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
            إذا (أرشيف != عدم) { حرر_نص(أرشيف). }
        }
        حرر_نص(سطر).
    }
    اغلق_ملف(ملف).
    إذا (!صالح) {
        إذا (سجلات != عدم) { حرر_وسائط(سجلات). }
        إرجع عدم.
    }
    *كود = كود_تكوين_نجاح.
    إرجع سجلات.
}

منطقي اصدار_تمهيدي(نص إصدار) {
    صحيح م = ٠.
    طالما (م < طول_نص(إصدار)) {
        إذا (إصدار[م] == '+') { إرجع خطأ. }
        إذا (إصدار[م] == '-') { إرجع صواب. }
        م = م + ١.
    }
    إرجع خطأ.
}

// Orders versions by precedence, then by text when only build metadata
// differs, exactly as the resolver breaks ties.
صحيح قارن_اصدارين(نص يسار، نص يمين) {
    صحيح ترتيب = قارن_اصدار_دلالي(يسار، يمين).
    إذا (ترتيب != ٠) { إرجع ترتيب. }
    إرجع قارن_نص(يسار، يمين).
}

// The highest version of اسم in the index that is not a prerelease.
نص أعلى_اصدار_مستقر(متجه سجلات، نص اسم) {
    نص أفضل = عدم.
    صحيح م = ٠.
    طالما (م < طول_متجه(سجلات)) {
        نص سجل = سطر_رقم(سجلات، م).
        نص اسم_سجل = حقل_سجل_اعتمادية(سجل، ٠).
        نص إصدار = حقل_سجل_اعتمادية(سجل، ١).
        منطقي مرشح = خطأ.
        إذا (اسم_سجل != عدم && إصدار != عدم) {
            مرشح = قارن_نص(اسم_سجل، اسم) == ٠ && !اصدار_تمهيدي(إصدار).
        }
        إذا (مرشح && أفضل != عدم) { مرشح = قارن_اصدارين(إصدار، أفضل) > ٠. }
        إذا (مرشح) {
            إذا (أفضل != عدم) { حرر_نص(أفضل). }
            أفضل = إصدار.
            إصدار = عدم.
        }
        إذا (اسم_سجل != عدم) { حرر_نص(اسم_سجل). }
        إذا (إصدار != عدم) { حرر_نص(إصدار). }
        م = م + ١.
    }
    إرجع أفضل.
}

// "^<highest stable>" for an index package, or عدم with a diagnostic.
نص قيد_افتراضي_من_الفهرس(نص حزمة، صحيح* كود) {
    متجه سجلات = اقرأ_سجلات_الفهرس(كود).
    إذا (سجلات == عدم) { إرجع عدم. }
    نص أعلى = أعلى_اصدار_مستقر(سجلات، حزمة).
    حرر_وسائط(سجلات).
    إذا (أعلى == عدم) {
        اطبع_منسق("[خطأ] لا يوجد إصدار مستقر للحزمة %ن في الفهرس المحلي؛ حدد --إصدار.\س"، حزمة).
        *كود = كود_تكوين_خطأ_عام.
        إرجع عدم.
    }
    نص قيد = نسق("^%ن"، أعلى).
    حرر_نص(أعلى).
    إرجع قيد.
}

// -------------------------
// Commands
// -------------------------

منطقي خيار_يساوي(نص قيمة، نص عربي، نص انجليزي) {
    إرجع قارن_نص(قيمة، عربي) == ٠ || قارن_نص(قيمة، انجليزي) == ٠.
}

// The last segment of a namespaced name; a plain name is its own segment.
نص المقطع_الأخير(نص اسم) {
    صحيح بداية = ٠.
    صحيح م = ٠.
    طالما (م < طول_نص(اسم)) {
        إذا (اسم[م] == '/') { بداية = م + ١. }
        م = م + ١.
    }
    إرجع نسخ_مقطع(اسم، بداية، طول_نص(اسم)).
}

صحيح خطأ_استخدام_أضف() {
    اطبع "[خطأ] استخدم: تكوين أضف <حزمة> [--إصدار <قيد>] [--باسم <اسم>]".
    اطبع "       أو: تكوين أضف <اسم> --مسار <مسار>".
    اطبع "       أو: تكوين أضف <اسم> --مستودع <رابط> --التزام <commit>".
    إرجع كود_تكوين_خطأ_استخدام.
}

صحيح تنفيذ_أضف(صحيح عدد، نص[] معاملات) {
    نص موضعي = عدم.
    نص قيد = عدم.
    نص مستعار_خام = عدم.
    نص مسار = عدم.
    نص مستودع = عدم.
    نص التزام = عدم.
    صحيح م = ٢.
    طالما (م < عدد) {
        نص و = معاملات[م].
        منطقي له_قيمة = خيار_يساوي(و، "--إصدار"، "--version") ||
                         خيار_يساوي(و، "--باسم"، "--as") ||
                         خيار_يساوي(و، "--مسار"، "--path") ||
                         خيار_يساوي(و، "--مستودع"، "--git") ||
                         خيار_يساوي(و، "--التزام"، "--commit").
        إذا (له_قيمة) {
            إذا (م + ١ >= عدد) { إرجع خطأ_استخدام_أضف(). }
            نص قيمة = معاملات[م + ١].
            منطقي مكرر = خطأ.
            إذا (خيار_يساوي(و، "--إصدار"، "--version")) { مكرر = قيد != عدم. قيد = قيمة. }
            وإلا إذا (خيار_يساوي(و، "--باسم"، "--as")) { مكرر = مستعار_خام != عدم. مستعار_خام = قيمة. }
            وإلا إذا (خيار_يساوي(و، "--مسار"، "--path")) { مكرر = مسار != عدم. مسار = قيمة. }
            وإلا إذا (خيار_يساوي(و، "--مستودع"، "--git")) { مكرر = مستودع != عدم. مستودع = قيمة. }
            وإلا { مكرر = التزام != عدم. التزام = قيمة. }
            إذا (مكرر) { اطبع_منسق("[خطأ] خيار مكرر: %ن\س"، و). إرجع كود_تكوين_خطأ_استخدام. }
            م = م + ١.
        }
        وإلا إذا (يبدأ_ب(و، "--")) {
            اطبع_منسق("[خطأ] خيار غير معروف لأمر أضف: %ن\س"، و).
            إرجع خطأ_استخدام_أضف().
        }
        وإلا {
            إذا (موضعي != عدم) { إرجع خطأ_استخدام_أضف(). }
            موضعي = و.
        }
        م = م + ١.
    }
    إذا (موضعي == عدم) { إرجع خطأ_استخدام_أضف(). }
    إذا (مسار != عدم && (مستودع != عدم || التزام != عدم || قيد != عدم || مستعار_خام != عدم)) {
        اطبع "[خطأ] --مسار لا يجتمع مع --مستودع أو --التزام أو --إصدار أو --باسم.".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    إذا ((مستودع != عدم) != (التزام != عدم)) {
        اطبع "[خطأ] --مستودع و--التزام يأتيان معا.".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    إذا (مستودع != عدم && (قيد != عدم || مستعار_خام != عدم)) {
        اطبع "[خطأ] اعتمادية Git لا تقبل --إصدار أو --باسم؛ الاسم الموضعي هو اسمها.".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    إذا (قيد != عدم) {
        إذا (!قيد_اصدار_دلالي_صالح(قيد)) {
            اطبع_منسق("[خطأ] قيد إصدار غير صالح: %ن\س"، قيد).
            إرجع كود_تكوين_خطأ_استخدام.
        }
    }

    منطقي من_الفهرس = مسار == عدم && مستودع == عدم.
    نص حزمة = عدم.
    نص مستعار = عدم.
    إذا (من_الفهرس) {
        حزمة = هوية_من_الطرفية(موضعي، صواب).
        إذا (حزمة == عدم) {
            اطبع "[خطأ] اسم الحزمة يجب أن يكون اسما عربيا، أو نطاقا عربيا ثم '/' ثم اسما عربيا.".
            إرجع كود_تكوين_خطأ_استخدام.
        }
        إذا (مستعار_خام != عدم) { مستعار = هوية_من_الطرفية(مستعار_خام، خطأ). }
        وإلا { مستعار = المقطع_الأخير(حزمة). }
    }
    وإلا { مستعار = هوية_من_الطرفية(موضعي، خطأ). }
    إذا (مستعار == عدم) {
        اطبع "[خطأ] اسم الاعتمادية يجب أن يكون اسما عربيا فقط دون نطاق.".
        إذا (حزمة != عدم) { حرر_نص(حزمة). }
        إرجع كود_تكوين_خطأ_استخدام.
    }

    صحيح كود = ٠.
    متجه أسطر = ابدأ_تعديل_البيان(&كود).
    نص قيد_نهائي = عدم.
    متجه جديدة = عدم.
    إذا (أسطر != عدم) {
        إذا (ابحث_قسم_اعتمادية(أسطر، مستعار) >= ٠) {
            اطبع_منسق("[خطأ] الاعتمادية '%ن' موجودة؛ احذفها أولا أو استخدم حدّث.\س"، مستعار).
            كود = كود_تكوين_خطأ_عام.
        }
    }
    إذا (أسطر != عدم && كود == ٠ && من_الفهرس) {
        إذا (قيد != عدم) { قيد_نهائي = نسخ_نص(قيد). }
        وإلا { قيد_نهائي = قيد_افتراضي_من_الفهرس(حزمة، &كود). }
        إذا (قيد_نهائي == عدم && كود == ٠) { كود = كود_تكوين_خطأ_داخلي. }
    }
    إذا (أسطر != عدم && كود == ٠) {
        جديدة = أنشئ_متجه(حجم(نص)).
        صحيح موضع = موضع_اعتمادية_جديدة(أسطر).
        منطقي صالح = جديدة != عدم.
        إذا (صالح && موضع > ٠) {
            إذا (!سطر_بيان_فارغ(سطر_رقم(أسطر، موضع - ١))) { صالح = اضف_وسيط(جديدة، ""). }
        }
        إذا (صالح) { صالح = اضف_وسيط_مملوك(جديدة، نسق("[الاعتماديات.%ن]"، مستعار)). }
        إذا (صالح && من_الفهرس) {
            إذا (قارن_نص(حزمة، مستعار) != ٠) { صالح = اضف_مفتاح_نصي(جديدة، "الحزمة"، حزمة). }
        }
        إذا (صالح && من_الفهرس) { صالح = اضف_مفتاح_نصي(جديدة، "الإصدار"، قيد_نهائي). }
        إذا (صالح && مسار != عدم) { صالح = اضف_مفتاح_نصي(جديدة، "المسار"، مسار). }
        إذا (صالح && مستودع != عدم) { صالح = اضف_مفتاح_نصي(جديدة، "git"، مستودع). }
        إذا (صالح && التزام != عدم) { صالح = اضف_مفتاح_نصي(جديدة، "commit"، التزام). }
        إذا (صالح) { كود = طبق_تعديل_البيان(أسطر، موضع، موضع، جديدة). }
        وإلا { كود = كود_تكوين_خطأ_عام. }
    }
    إذا (أسطر != عدم && كود == ٠) {
        إذا (من_الفهرس) {
            اطبع_منسق("[تم] أضيفت الاعتمادية %ن: %ن %ن\س"، مستعار، حزمة، قيد_نهائي).
        }
        وإلا { اطبع_منسق("[تم] أضيفت الاعتمادية %ن.\س"، مستعار). }
    }
    انه_تعديل_البيان(أسطر).
    إذا (جديدة != عدم) { حرر_وسائط(جديدة). }
    إذا (قيد_نهائي != عدم) { حرر_نص(قيد_نهائي). }
    إذا (حزمة != عدم) { حرر_نص(حزمة). }
    حرر_نص(مستعار).
    إرجع كود.
}

صحيح تنفيذ_احذف(صحيح عدد، نص[] معاملات) {
    إذا (عدد != ٣) {
        اطبع "[خطأ] استخدم: تكوين احذف <اسم_الاعتمادية>".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    نص مستعار = هوية_من_الطرفية(معاملات[٢]، خطأ).
    إذا (مستعار == عدم) {
        اطبع "[خطأ] اسم الاعتمادية يجب أن يكون اسما عربيا فقط دون نطاق.".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    صحيح كود = ٠.
    متجه أسطر = ابدأ_تعديل_البيان(&كود).
    متجه جديدة = عدم.
    إذا (أسطر != عدم) {
        صحيح رأس = ابحث_قسم_اعتمادية(أسطر، مستعار).
        إذا (رأس < ٠) {
            اطبع_منسق("[خطأ] لا توجد اعتمادية باسم %ن في مشروع.تكوين.\س"، مستعار).
            كود = كود_تكوين_خطأ_عام.
        }
        وإلا {
            صحيح بداية = رأس.
            صحيح نهاية = نهاية_قسم(أسطر، رأس).
            // Drop the blank line that separated the section from the one before.
            منطقي فارغ_قبل = خطأ.
            إذا (بداية > ٠) { فارغ_قبل = سطر_بيان_فارغ(سطر_رقم(أسطر، بداية - ١)). }
            منطقي فارغ_بعد = صواب.
            إذا (نهاية < طول_متجه(أسطر)) { فارغ_بعد = سطر_بيان_فارغ(سطر_رقم(أسطر، نهاية)). }
            إذا (فارغ_قبل && فارغ_بعد) { بداية = بداية - ١. }
            جديدة = أنشئ_متجه(حجم(نص)).
            إذا (جديدة == عدم) { كود = كود_تكوين_خطأ_داخلي. }
            وإلا { كود = طبق_تعديل_البيان(أسطر، بداية، نهاية، جديدة). }
        }
    }
    إذا (أسطر != عدم && كود == ٠) { اطبع_منسق("[تم] حذفت الاعتمادية %ن.\س"، مستعار). }
    انه_تعديل_البيان(أسطر).
    إذا (جديدة != عدم) { حرر_وسائط(جديدة). }
    حرر_نص(مستعار).
    إرجع كود.
}

// Re-resolves every dependency and reports whether تكوين.قفل changed.
صحيح حدث_القفل() {
    صحيح تحليل = تحليل_ملف_تكوين("مشروع.تكوين").
    إذا (تحليل != ٠) { إرجع تحليل. }
    إذا (!تكوين_بيان_في1()) {
        اطبع "[خطأ] أوامر الحزم تعمل على بيان takween-manifest-v1 فقط.".
        إرجع كود_تكوين_غير_مدعوم.
    }
    عدم* قائم = فتح_ملف("تكوين.قفل"، "rb").
    منطقي كان_موجودا = قائم != عدم.
    إذا (قائم != عدم) { اغلق_ملف(قائم). }
    نص سابق = عدم.
    إذا (كان_موجودا) {
        إذا (انشئ_مجلدات(".takween") != ٠) {
            اطبع "[خطأ] تعذر إنشاء مجلد .takween.".
            إرجع كود_تكوين_فشل_أداة.
        }
        سابق = ضم_مسار(".takween"، "lock-before-update.json").
        منطقي محفوظ = خطأ.
        إذا (سابق != عدم) { محفوظ = انسخ_ملفا_ببايتاته("تكوين.قفل"، سابق). }
        إذا (!محفوظ) {
            اطبع "[خطأ] تعذر حفظ نسخة من تكوين.قفل.".
            إذا (سابق != عدم) { حرر_نص(سابق). }
            إرجع كود_تكوين_فشل_أداة.
        }
    }
    صحيح كود = حل_بعد_التعديل().
    إذا (كود == ٠) {
        إذا (!كان_موجودا) { اطبع "[تم] أنشئ تكوين.قفل.". }
        وإلا إذا (ملفا_قفل_متطابقان(سابق، "تكوين.قفل")) { اطبع "[تم] تكوين.قفل محدث؛ لم يتغير الحل.". }
        وإلا { اطبع "[تم] حدث تكوين.قفل.". }
    }
    إذا (سابق != عدم) { احذف_شجرة(سابق). حرر_نص(سابق). }
    إرجع كود.
}

// The index package behind a version dependency, or عدم with a diagnostic.
نص حزمة_اعتمادية_اصدار(نص مستعار) {
    متجه سجلات = احصل_اعتماديات_المسار().
    نص حزمة = عدم.
    منطقي وجد = خطأ.
    صحيح عدد_سجلات = ٠.
    إذا (سجلات != عدم) { عدد_سجلات = طول_متجه(سجلات). }
    صحيح م = ٠.
    طالما (!وجد && م < عدد_سجلات) {
        نص سجل = سطر_رقم(سجلات، م).
        نص اسم = حقل_سجل_اعتمادية(سجل، ٠).
        إذا (اسم != عدم) {
            إذا (قارن_نص(اسم، مستعار) == ٠) { وجد = صواب. }
            حرر_نص(اسم).
        }
        إذا (وجد) {
            نص نوع = حقل_سجل_اعتمادية(سجل، ١).
            إذا (نوع != عدم) {
                إذا (قارن_نص(نوع، "version") == ٠) { حزمة = حقل_سجل_اعتمادية(سجل، ٢). }
                حرر_نص(نوع).
            }
        }
        م = م + ١.
    }
    إذا (!وجد) { اطبع_منسق("[خطأ] لا توجد اعتمادية باسم %ن في مشروع.تكوين.\س"، مستعار). }
    وإلا إذا (حزمة == عدم) {
        اطبع_منسق("[خطأ] حدّث %ن يدعم اعتماديات الإصدار فقط؛ عدّل مسار أو commit اعتمادية المسار وGit في البيان.\س"، مستعار).
    }
    إرجع حزمة.
}

// The line of the section's الإصدار key, or -1.
صحيح سطر_قيد_الإصدار(متجه أسطر، صحيح رأس) {
    صحيح نهاية = نهاية_قسم(أسطر، رأس).
    صحيح م = رأس + ١.
    طالما (م < نهاية) {
        نص منظف = سطر_بيان_منظف(سطر_رقم(أسطر، م)).
        منطقي مطابق = خطأ.
        منطقي له_مفتاح = خطأ.
        إذا (منظف != عدم) { له_مفتاح = يبدأ_ب(منظف، "الإصدار"). }
        إذا (له_مفتاح) {
            نص باقي = نسخ_مقطع(منظف، طول_نص("الإصدار")، طول_نص(منظف)).
            نص مقصوص = عدم.
            إذا (باقي != عدم) { مقصوص = قص_طرفين(باقي). حرر_نص(باقي). }
            إذا (مقصوص != عدم) {
                إذا (طول_نص(مقصوص) > ٠) { مطابق = مقصوص[٠] == '='. }
                حرر_نص(مقصوص).
            }
        }
        إذا (منظف != عدم) { حرر_نص(منظف). }
        إذا (مطابق) { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

صحيح حدث_اعتمادية(نص مستعار) {
    صحيح كود = ٠.
    متجه أسطر = ابدأ_تعديل_البيان(&كود).
    نص حزمة = عدم.
    نص قيد = عدم.
    متجه جديدة = عدم.
    إذا (أسطر != عدم) {
        حزمة = حزمة_اعتمادية_اصدار(مستعار).
        إذا (حزمة == عدم) { كود = كود_تكوين_خطأ_عام. }
    }
    إذا (أسطر != عدم && كود == ٠) {
        قيد = قيد_افتراضي_من_الفهرس(حزمة، &كود).
        إذا (قيد == عدم && كود == ٠) { كود = كود_تكوين_خطأ_داخلي. }
    }
    إذا (أسطر != عدم && كود == ٠) {
        صحيح رأس = ابحث_قسم_اعتمادية(أسطر، مستعار).
        صحيح سطر = -١.
        إذا (رأس >= ٠) { سطر = سطر_قيد_الإصدار(أسطر، رأس). }
        جديدة = أنشئ_متجه(حجم(نص)).
        إذا (سطر < ٠ || جديدة == عدم) {
            اطبع_منسق("[خطأ] تعذر العثور على سطر الإصدار للاعتمادية %ن.\س"، مستعار).
            كود = كود_تكوين_خطأ_داخلي.
        }
        وإلا إذا (!اضف_مفتاح_نصي(جديدة، "الإصدار"، قيد)) { كود = كود_تكوين_خطأ_داخلي. }
        وإلا { كود = طبق_تعديل_البيان(أسطر، سطر، سطر + ١، جديدة). }
    }
    إذا (أسطر != عدم && كود == ٠) {
        اطبع_منسق("[تم] حدثت الاعتمادية %ن: %ن %ن\س"، مستعار، حزمة، قيد).
    }
    انه_تعديل_البيان(أسطر).
    إذا (جديدة != عدم) { حرر_وسائط(جديدة). }
    إذا (حزمة != عدم) { حرر_نص(حزمة). }
    إذا (قيد != عدم) { حرر_نص(قيد). }
    إرجع كود.
}

صحيح تنفيذ_حدث(صحيح عدد، نص[] معاملات) {
    إذا (عدد == ٢) {
        اترك_طقم_القفل().
        إرجع حدث_القفل().
    }
    إذا (عدد != ٣) {
        اطبع "[خطأ] استخدم: تكوين حدّث [اسم_الاعتمادية]".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    نص مستعار = هوية_من_الطرفية(معاملات[٢]، خطأ).
    إذا (مستعار == عدم) {
        اطبع "[خطأ] اسم الاعتمادية يجب أن يكون اسما عربيا فقط دون نطاق.".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    صحيح كود = حدث_اعتمادية(مستعار).
    حرر_نص(مستعار).
    إرجع كود.
}

// Name ascending, then version descending.
صحيح قارن_نتيجتي_بحث(نص يسار، نص يمين) {
    نص اسم_يسار = حقل_سجل_اعتمادية(يسار، ٠).
    نص اسم_يمين = حقل_سجل_اعتمادية(يمين، ٠).
    نص إصدار_يسار = حقل_سجل_اعتمادية(يسار، ١).
    نص إصدار_يمين = حقل_سجل_اعتمادية(يمين، ١).
    صحيح ترتيب = قارن_نص(اسم_يسار، اسم_يمين).
    إذا (ترتيب == ٠) { ترتيب = قارن_اصدارين(إصدار_يمين، إصدار_يسار). }
    حرر_نص(اسم_يسار). حرر_نص(اسم_يمين). حرر_نص(إصدار_يسار). حرر_نص(إصدار_يمين).
    إرجع ترتيب.
}

صحيح تنفيذ_ابحث(صحيح عدد، نص[] معاملات) {
    منطقي استخدام_صحيح = عدد == ٣.
    إذا (استخدام_صحيح) { استخدام_صحيح = طول_نص(معاملات[٢]) > ٠. }
    إذا (!استخدام_صحيح) {
        اطبع "[خطأ] استخدم: تكوين ابحث <نص>".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    نص استعلام = هوية_قياسية(معاملات[٢]).
    إذا (استعلام == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    إذا (قارن_نص(استعلام، معاملات[٢]) != ٠) {
        اطبع_منسق("[ملاحظة] طُبّع نص البحث إلى صيغة NFC: %ن\س"، استعلام).
    }
    صحيح كود = ٠.
    متجه سجلات = اقرأ_سجلات_الفهرس(&كود).
    إذا (سجلات == عدم) { حرر_نص(استعلام). إرجع كود. }
    متجه نتائج = أنشئ_متجه(حجم(نص)).
    منطقي صالح = نتائج != عدم.
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(سجلات)) {
        نص سجل = سطر_رقم(سجلات، م).
        نص اسم = حقل_سجل_اعتمادية(سجل، ٠).
        إذا (اسم != عدم) {
            إذا (يحتوي_على(اسم، استعلام)) { صالح = اضف_وسيط(نتائج، سجل). }
            حرر_نص(اسم).
        }
        م = م + ١.
    }
    إذا (صالح) {
        نص* بيانات = كـ<نص*>(بيانات_متجه(نتائج)).
        م = ٠.
        طالما (م < طول_متجه(نتائج)) {
            صحيح ن = م + ١.
            طالما (ن < طول_متجه(نتائج)) {
                إذا (قارن_نتيجتي_بحث(*(بيانات + م)، *(بيانات + ن)) > ٠) {
                    نص مؤقت = *(بيانات + م).
                    *(بيانات + م) = *(بيانات + ن).
                    *(بيانات + ن) = مؤقت.
                }
                ن = ن + ١.
            }
            م = م + ١.
        }
        نص سابق = عدم.
        م = ٠.
        طالما (م < طول_متجه(نتائج)) {
            // The same name and version listed twice prints once.
            نص حالي = *(بيانات + م).
            منطقي جديد = صواب.
            إذا (سابق != عدم) { جديد = قارن_نص(حالي، سابق) != ٠. }
            إذا (جديد) { اطبع_منسق("%ن\س"، حالي). }
            سابق = حالي.
            م = م + ١.
        }
        إذا (طول_متجه(نتائج) == ٠) { اطبع "[ملاحظة] لا توجد حزم مطابقة في الفهرس المحلي.". }
    }
    إذا (نتائج != عدم) { حرر_وسائط(نتائج). }
    حرر_وسائط(سجلات).
    حرر_نص(استعلام).
    إذا (!صالح) { إرجع كود_تكوين_خطأ_داخلي. }
    إرجع كود_تكوين_نجاح.
}
