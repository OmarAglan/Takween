#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
منطقي اضف_ملفات_من(متجه وسائط، نص جذر، نص مصدر، نص قائمة_الملفات).
منطقي اضف_تضمينات_من(متجه وسائط، نص جذر، نص قائمة).
منطقي مسار_نسبي_آمن(نص مسار).

متجه انسخ_قائمة_حزم(متجه أصل) {
    متجه نسخة = أنشئ_متجه(حجم(نص)).
    إذا (نسخة == عدم) { إرجع عدم. }
    إذا (أصل == عدم) { إرجع نسخة. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(أصل)).
    صحيح م = ٠.
    طالما (م < طول_متجه(أصل)) {
        إذا (!اضف_وسيط(نسخة، *(بيانات + م))) {
            حرر_وسائط(نسخة).
            إرجع عدم.
        }
        م = م + ١.
    }
    إرجع نسخة.
}

منطقي قائمة_حزم_تحوي(متجه قائمة، نص قيمة) {
    إذا (قائمة == عدم) { إرجع خطأ. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(قائمة)).
    صحيح م = ٠.
    طالما (م < طول_متجه(قائمة)) {
        إذا (قارن_نص(*(بيانات + م)، قيمة) == ٠) { إرجع صواب. }
        م = م + ١.
    }
    إرجع خطأ.
}

نص حقل_سجل_اعتمادية(نص سجل، صحيح رقم) {
    إذا (سجل == عدم || رقم < ٠ || رقم > ٣) { إرجع عدم. }
    صحيح بداية = ٠.
    صحيح حقل = ٠.
    صحيح م = ٠.
    صحيح طول = طول_نص(سجل).
    طالما (م <= طول) {
        منطقي نهاية = م == طول.
        إذا (!نهاية) { نهاية = سجل[م] == '\ت'. }
        إذا (نهاية) {
            إذا (حقل == رقم) { إرجع نسخ_مقطع(سجل، بداية، م). }
            حقل = حقل + ١.
            بداية = م + ١.
        }
        م = م + ١.
    }
    إرجع عدم.
}

صحيح شغل_جت(متجه وسائط، نص مسار_الخرج، نص مسار_الخطأ) {
    إذا (وسائط == عدم || طول_متجه(وسائط) == ٠) { إرجع -١. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    مقبض_عملية عملية = ابدأ_عملية(بيانات، طول_متجه(وسائط)، عدم، عدم، ٠،
                                  مسار_الخرج، مسار_الخطأ).
    إذا (عملية == عدم) { إرجع -١. }
    صحيح كود = انتظر_عملية(عملية).
    حرر_عملية(عملية).
    إرجع كود.
}

منطقي رأس_جت_يطابق(نص مجلد، نص تثبيت، نص مسار_الرأس، نص مسار_السجل) {
    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي صالح = وسائط != عدم.
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "git"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-C"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، مجلد). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "rev-parse"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "--verify"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "HEAD^{commit}"). }
    صحيح كود = -١.
    إذا (صالح) { كود = شغل_جت(وسائط، مسار_الرأس، مسار_السجل). }
    حرر_وسائط(وسائط).
    إذا (!صالح || كود != ٠) { إرجع خطأ. }

    عدم* ملف = فتح_ملف(مسار_الرأس، "قراءة").
    إذا (ملف == عدم) { إرجع خطأ. }
    نص رأس = اقرأ_سطر(ملف).
    اغلق_ملف(ملف).
    منطقي مطابق = خطأ.
    إذا (رأس != عدم) { مطابق = قارن_نص(رأس، تثبيت) == ٠. حرر_نص(رأس). }
    إرجع مطابق.
}

منطقي ثبت_شجرة_جت(نص مجلد، نص تثبيت، نص مسار_السجل) {
    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي صالح = وسائط != عدم.
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "git"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-C"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، مجلد). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "core.symlinks=false"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "core.hooksPath=.git/hooks-disabled"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "checkout"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "--detach"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "--force"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "--quiet"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، تثبيت). }
    صحيح كود = -١.
    إذا (صالح) { كود = شغل_جت(وسائط، مسار_السجل، مسار_السجل). }
    حرر_وسائط(وسائط).
    إذا (!صالح || كود != ٠) { إرجع خطأ. }

    وسائط = أنشئ_متجه(حجم(نص)).
    صالح = وسائط != عدم.
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "git"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-C"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، مجلد). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "clean"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-ffdx"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "--quiet"). }
    كود = -١.
    إذا (صالح) { كود = شغل_جت(وسائط، مسار_السجل، مسار_السجل). }
    حرر_وسائط(وسائط).
    إرجع صالح && كود == ٠.
}

نص جهز_اعتمادية_جت(نص مصدر، نص تثبيت، نص مجلد_الحزم) {
    نص مجلد = ضم_مسار(مجلد_الحزم، تثبيت).
    نص مسار_الرأس = ضم_مسار(".takween"، "git-head.txt").
    نص مسار_السجل = ضم_مسار(".takween"، "git-process.log").
    إذا (مجلد == عدم || مسار_الرأس == عدم || مسار_السجل == عدم) {
        إذا (مجلد != عدم) { حرر_نص(مجلد). }
        إذا (مسار_الرأس != عدم) { حرر_نص(مسار_الرأس). }
        إذا (مسار_السجل != عدم) { حرر_نص(مسار_السجل). }
        إرجع عدم.
    }

    إذا (رأس_جت_يطابق(مجلد، تثبيت، مسار_الرأس، مسار_السجل)) {
        منطقي صالح_كاش = ثبت_شجرة_جت(مجلد، تثبيت، مسار_السجل).
        إذا (صالح_كاش) {
            صالح_كاش = رأس_جت_يطابق(مجلد، تثبيت، مسار_الرأس، مسار_السجل).
        }
        حرر_نص(مسار_الرأس). حرر_نص(مسار_السجل).
        إذا (صالح_كاش) { إرجع مجلد. }
        مسار_الرأس = ضم_مسار(".takween"، "git-head.txt").
        مسار_السجل = ضم_مسار(".takween"، "git-process.log").
        إذا (مسار_الرأس == عدم || مسار_السجل == عدم) {
            إذا (مسار_الرأس != عدم) { حرر_نص(مسار_الرأس). }
            إذا (مسار_السجل != عدم) { حرر_نص(مسار_السجل). }
            حرر_نص(مجلد).
            إرجع عدم.
        }
    }

    إذا (احذف_شجرة(مجلد) != ٠) {
        اطبع "[خطأ] تعذر تنظيف cache اعتمادية Git غير الصالح.".
        حرر_نص(مجلد). حرر_نص(مسار_الرأس). حرر_نص(مسار_السجل).
        إرجع عدم.
    }

    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي صالح = وسائط != عدم.
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "git"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "core.symlinks=false"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "core.hooksPath=.git/hooks-disabled"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "protocol.allow=never"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "protocol.file.allow=always"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "protocol.https.allow=always"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "protocol.ssh.allow=always"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "-c"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "protocol.git.allow=always"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "clone"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "--no-checkout"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "--quiet"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، "--"). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، مصدر). }
    إذا (صالح) { صالح = اضف_وسيط(وسائط، مجلد). }
    صحيح كود = -١.
    إذا (صالح) { كود = شغل_جت(وسائط، مسار_السجل، مسار_السجل). }
    حرر_وسائط(وسائط).
    إذا (!صالح || كود != ٠) {
        اطبع_منسق("[خطأ] فشل جلب اعتمادية Git المثبتة. كود الخروج: %ص\س"، كود).
        احذف_شجرة(مجلد).
        حرر_نص(مجلد). حرر_نص(مسار_الرأس). حرر_نص(مسار_السجل).
        إرجع عدم.
    }

    صالح = ثبت_شجرة_جت(مجلد، تثبيت، مسار_السجل).
    إذا (صالح) { صالح = رأس_جت_يطابق(مجلد، تثبيت، مسار_الرأس، مسار_السجل). }
    حرر_نص(مسار_الرأس). حرر_نص(مسار_السجل).
    إذا (!صالح) {
        اطبع "[خطأ] لم ينتج Git شجرة عمل تطابق commit المثبت.".
        احذف_شجرة(مجلد).
        حرر_نص(مجلد).
        إرجع عدم.
    }
    إرجع مجلد.
}

نص الصق_قفل(نص يسار، نص يمين) {
    نص ناتج = دمج_نص(يسار، يمين).
    حرر_نص(يسار).
    إرجع ناتج.
}

نص هرب_JSON_قفل(نص قيمة) {
    نص ناتج = نسخ_نص("").
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        نص جزء = عدم.
        إذا (ح == '"') { جزء = نسخ_نص("\\\""). }
        وإلا إذا (ح == '\\') { جزء = نسخ_نص("\\\\"). }
        وإلا إذا (ح == '\س') { جزء = نسخ_نص("\\n"). }
        وإلا إذا (ح == '\ر') { جزء = نسخ_نص("\\r"). }
        وإلا إذا (ح == '\ت') { جزء = نسخ_نص("\\t"). }
        وإلا { جزء = نسق("%ح"، ح). }
        ناتج = الصق_قفل(ناتج، جزء).
        حرر_نص(جزء).
        م = م + ١.
    }
    إرجع ناتج.
}

نص ابن_سجل_قفل(نص اسم_مستعار، نص اسم، نص إصدار، نص أب، نص نوع، نص مصدر، نص تثبيت) {
    نص ا = هرب_JSON_قفل(اسم_مستعار).
    نص س = هرب_JSON_قفل(اسم).
    نص ص = هرب_JSON_قفل(إصدار).
    نص ب = هرب_JSON_قفل(أب).
    نص م = هرب_JSON_قفل(مصدر).
    نص ت = هرب_JSON_قفل(تثبيت).
    نص سجل = عدم.
    إذا (قارن_نص(نوع، "git") == ٠) {
        سجل = نسق("{\"alias\":\"%ن\",\"name\":\"%ن\",\"version\":\"%ن\",\"parent\":\"%ن\",\"source\":{\"kind\":\"git\",\"url\":\"%ن\",\"commit\":\"%ن\"}}"،
                    ا، س، ص، ب، م، ت).
    }
    وإلا {
        سجل = نسق("{\"alias\":\"%ن\",\"name\":\"%ن\",\"version\":\"%ن\",\"parent\":\"%ن\",\"source\":{\"kind\":\"path\",\"path\":\"%ن\"}}"،
                    ا، س، ص، ب، م).
    }
    حرر_نص(ا). حرر_نص(س). حرر_نص(ص). حرر_نص(ب). حرر_نص(م). حرر_نص(ت).
    إرجع سجل.
}

عدم فرز_سجلات_قفل(متجه سجلات) {
    إذا (سجلات == عدم) { إرجع. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(سجلات)).
    صحيح م = ٠.
    طالما (م < طول_متجه(سجلات)) {
        صحيح ن = م + ١.
        طالما (ن < طول_متجه(سجلات)) {
            إذا (قارن_نص(*(بيانات + م)، *(بيانات + ن)) > ٠) {
                نص مؤقت = *(بيانات + م).
                *(بيانات + م) = *(بيانات + ن).
                *(بيانات + ن) = مؤقت.
            }
            ن = ن + ١.
        }
        م = م + ١.
    }
}

منطقي اكتب_القفل(متجه سجلات، نص هدف_القفل) {
    فرز_سجلات_قفل(سجلات).
    عدم* ملف = فتح_ملف("تكوين.قفل"، "wb").
    إذا (ملف == عدم) {
        اطبع "[خطأ] تعذر كتابة تكوين.قفل.".
        إرجع خطأ.
    }
    نص اسم = هرب_JSON_قفل(احصل_تكوين_الاسم()).
    نص إصدار = هرب_JSON_قفل(احصل_تكوين_الإصدار()).
    نص قيد = نسخ_نص("").
    نص هدف = هرب_JSON_قفل(هدف_القفل).
    منطقي صالح = اكتب_سطر(ملف، "{") >= ٠.
    نص سطر = نسق("  \"schema_version\": \"takween-lock-v1\",").
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    سطر = نسق("  \"resolver_version\": \"0.1.0\",").
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    سطر = نسق("  \"project\": {\"name\":\"%ن\",\"version\":\"%ن\"},"، اسم، إصدار).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    سطر = نسق("  \"baa\": {\"constraint\":\"%ن\",\"target\":\"%ن\"},"، قيد، هدف).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    إذا (صالح) { صالح = اكتب_سطر(ملف، "  \"packages\": [") >= ٠. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(سجلات)).
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(سجلات)) {
        نص فاصلة = "".
        إذا (م + ١ < طول_متجه(سجلات)) { فاصلة = ",". }
        سطر = نسق("    %ن%ن"، *(بيانات + م)، فاصلة).
        صالح = اكتب_سطر(ملف، سطر) >= ٠.
        حرر_نص(سطر).
        م = م + ١.
    }
    إذا (صالح) { صالح = اكتب_سطر(ملف، "  ]") >= ٠. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، "}") >= ٠. }
    إذا (اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    حرر_نص(اسم). حرر_نص(إصدار). حرر_نص(قيد). حرر_نص(هدف).
    إذا (!صالح) { اطبع "[خطأ] فشلت كتابة تكوين.قفل كاملة.". }
    إرجع صالح.
}

منطقي حل_سجلات(متجه وسائط، نص جذر، متجه اعتماديات، متجه نشطة، متجه منجزة،
                متجه حواف، متجه قفل، نص مجلد_الحزم، نص أب، صحيح عمق) {
    إذا (عمق > ١٦) {
        اطبع "[خطأ] تجاوز عمق الاعتماديات 16؛ تحقق من وجود دورة.".
        إرجع خطأ.
    }
    إذا (اعتماديات == عدم) { إرجع صواب. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(اعتماديات)).
    صحيح م = ٠.
    طالما (م < طول_متجه(اعتماديات)) {
        نص سجل = *(بيانات + م).
        نص اسم_مستعار = حقل_سجل_اعتمادية(سجل، ٠).
        نص نوع = حقل_سجل_اعتمادية(سجل، ١).
        نص مصدر = حقل_سجل_اعتمادية(سجل، ٢).
        نص تثبيت = حقل_سجل_اعتمادية(سجل، ٣).
        إذا (اسم_مستعار == عدم || نوع == عدم || مصدر == عدم || تثبيت == عدم) {
            إذا (اسم_مستعار != عدم) { حرر_نص(اسم_مستعار). }
            إذا (نوع != عدم) { حرر_نص(نوع). }
            إذا (مصدر != عدم) { حرر_نص(مصدر). }
            إذا (تثبيت != عدم) { حرر_نص(تثبيت). }
            إرجع خطأ.
        }

        نص حافة = نسق("%ن\ت%ن"، أب، اسم_مستعار).
        إذا (قائمة_حزم_تحوي(حواف، حافة)) {
            اطبع_منسق("[خطأ] اسم اعتمادية مكرر تحت '%ن': %ن\س"، أب، اسم_مستعار).
            حرر_نص(حافة). حرر_نص(اسم_مستعار). حرر_نص(نوع). حرر_نص(مصدر). حرر_نص(تثبيت).
            إرجع خطأ.
        }
        إذا (!اضف_وسيط(حواف، حافة)) {
            حرر_نص(حافة). حرر_نص(اسم_مستعار). حرر_نص(نوع). حرر_نص(مصدر). حرر_نص(تثبيت).
            إرجع خطأ.
        }
        حرر_نص(حافة).

        نص كامل = عدم.
        نص هوية = عدم.
        إذا (قارن_نص(نوع، "path") == ٠) {
            إذا (!مسار_نسبي_آمن(مصدر)) {
                اطبع_منسق("[خطأ] مسار اعتمادية غير آمن: %ن\س"، مصدر).
            }
            وإلا {
                نص خام = ضم_مسار(جذر، مصدر).
                إذا (خام != عدم) {
                    كامل = طبع_مسار(خام).
                    حرر_نص(خام).
                }
                إذا (كامل != عدم) { هوية = دمج_نص("path:"، كامل). }
            }
        }
        وإلا إذا (قارن_نص(نوع، "git") == ٠) {
            كامل = جهز_اعتمادية_جت(مصدر، تثبيت، مجلد_الحزم).
            هوية = دمج_نص("git:"، تثبيت).
        }
        وإلا { اطبع_منسق("[خطأ] نوع مصدر اعتمادية غير معروف: %ن\س"، نوع). }
        إذا (كامل == عدم || هوية == عدم) {
            إذا (كامل != عدم) { حرر_نص(كامل). }
            إذا (هوية != عدم) { حرر_نص(هوية). }
            حرر_نص(اسم_مستعار). حرر_نص(نوع). حرر_نص(مصدر). حرر_نص(تثبيت).
            إرجع خطأ.
        }
        إذا (قائمة_حزم_تحوي(نشطة، هوية)) {
            اطبع_منسق("[خطأ] دورة اعتماديات عند: %ن\س"، هوية).
            حرر_نص(كامل). حرر_نص(هوية). حرر_نص(اسم_مستعار). حرر_نص(نوع). حرر_نص(مصدر). حرر_نص(تثبيت).
            إرجع خطأ.
        }
        إذا (قائمة_حزم_تحوي(منجزة، هوية)) {
            حرر_نص(كامل). حرر_نص(هوية). حرر_نص(اسم_مستعار). حرر_نص(نوع). حرر_نص(مصدر). حرر_نص(تثبيت).
            م = م + ١.
            استمر.
        }
        إذا (!اضف_وسيط(نشطة، هوية)) {
            حرر_نص(كامل). حرر_نص(هوية). حرر_نص(اسم_مستعار). حرر_نص(نوع). حرر_نص(مصدر). حرر_نص(تثبيت).
            إرجع خطأ.
        }

        نص بيان = ضم_مسار(كامل، "مشروع.تكوين").
        إذا (بيان == عدم) {
            حرر_نص(كامل). حرر_نص(هوية). حرر_نص(اسم_مستعار). حرر_نص(نوع). حرر_نص(مصدر). حرر_نص(تثبيت).
            إرجع خطأ.
        }
        صحيح نتيجة = تحليل_ملف_تكوين(بيان).
        حرر_نص(بيان).
        منطقي صالح = نتيجة == ٠ && تكوين_بيان_في1().
        إذا (!صالح) { اطبع_منسق("[خطأ] الاعتمادية ليست حزمة v1 صالحة: %ن\س"، كامل). }
        نص اسم_حزمة = عدم.
        نص إصدار_حزمة = عدم.
        متجه أبناء = عدم.
        إذا (صالح) {
            اسم_حزمة = نسخ_نص(احصل_تكوين_الاسم()).
            إصدار_حزمة = نسخ_نص(احصل_تكوين_الإصدار()).
            أبناء = انسخ_قائمة_حزم(احصل_اعتماديات_المسار()).
            صالح = اسم_حزمة != عدم && إصدار_حزمة != عدم && أبناء != عدم.
        }
        إذا (صالح) { صالح = اضف_وسيط(وسائط، "-I"). }
        إذا (صالح) { صالح = اضف_وسيط(وسائط، كامل). }
        إذا (صالح) { صالح = اضف_تضمينات_من(وسائط، كامل، احصل_تكوين_مسارات_التضمين()). }
        إذا (صالح) { صالح = اضف_ملفات_من(وسائط، كامل، احصل_تكوين_المصدر()، احصل_تكوين_الملفات()). }
        نص مصدر_قفل = مصدر.
        إذا (قارن_نص(نوع، "path") == ٠) { مصدر_قفل = كامل. }
        إذا (صالح) {
            نص سجل_قفل = ابن_سجل_قفل(اسم_مستعار، اسم_حزمة، إصدار_حزمة، أب، نوع، مصدر_قفل، تثبيت).
            إذا (سجل_قفل == عدم || !اضف_وسيط_مملوك(قفل، سجل_قفل)) { صالح = خطأ. }
        }
        نص أب_ابناء = نسق("%ن/%ن"، أب، اسم_مستعار).
        إذا (أب_ابناء == عدم) { صالح = خطأ. }
        إذا (صالح) {
            صالح = حل_سجلات(وسائط، كامل، أبناء، نشطة، منجزة، حواف، قفل،
                             مجلد_الحزم، أب_ابناء، عمق + ١).
        }
        إذا (أب_ابناء != عدم) { حرر_نص(أب_ابناء). }
        حرر_وسائط(أبناء).
        إذا (اسم_حزمة != عدم) { حرر_نص(اسم_حزمة). }
        إذا (إصدار_حزمة != عدم) { حرر_نص(إصدار_حزمة). }

        نص منزوعة = عدم.
        إذا (اسحب_متجه(نشطة، &منزوعة)) {
            إذا (منزوعة != عدم) { حرر_نص(منزوعة). }
        }
        إذا (صالح) { صالح = اضف_وسيط(منجزة، هوية). }
        حرر_نص(كامل). حرر_نص(هوية). حرر_نص(اسم_مستعار). حرر_نص(نوع). حرر_نص(مصدر). حرر_نص(تثبيت).
        إذا (!صالح) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي حل_اعتماديات(متجه وسائط) {
    منطقي بيان_في1 = تكوين_بيان_في1().
    متجه اعتماديات = انسخ_قائمة_حزم(احصل_اعتماديات_المسار()).
    إذا (اعتماديات == عدم) { إرجع خطأ. }
    إذا (!بيان_في1) { حرر_وسائط(اعتماديات). إرجع صواب. }

    نص هدف_القفل = عدم.
    نص هدف_فعلي = هدف_باء_فعلي().
    إذا (هدف_فعلي != عدم) {
        إذا (طول_نص(هدف_فعلي) > ٠) { هدف_القفل = نسخ_نص(هدف_فعلي). }
    }
    إذا (هدف_القفل == عدم) {
        نص هدف_مطلوب = احصل_تكوين_هدف_باء().
        إذا (هدف_مطلوب != عدم) {
            إذا (طول_نص(هدف_مطلوب) > ٠) { هدف_القفل = نسخ_نص(هدف_مطلوب). }
        }
    }
    إذا (هدف_القفل == عدم) {
        إذا (اكتشف_معلومات_الهدف() != ٠) { حرر_وسائط(اعتماديات). إرجع خطأ. }
        هدف_القفل = نسخ_نص(هدف_باء_فعلي()).
    }
    إذا (هدف_القفل == عدم) {
        حرر_وسائط(اعتماديات).
        إرجع خطأ.
    }

    متجه نشطة = أنشئ_متجه(حجم(نص)).
    متجه منجزة = أنشئ_متجه(حجم(نص)).
    متجه حواف = أنشئ_متجه(حجم(نص)).
    متجه قفل = أنشئ_متجه(حجم(نص)).
    نص مجلد_الحزم = ضم_مسار(".takween"، "packages").
    منطقي صالح = نشطة != عدم && منجزة != عدم && حواف != عدم && قفل != عدم && مجلد_الحزم != عدم.
    إذا (صالح && طول_متجه(اعتماديات) > ٠) {
        صالح = انشئ_مجلدات(مجلد_الحزم) == ٠.
    }
    إذا (صالح) {
        صالح = حل_سجلات(وسائط، "."، اعتماديات، نشطة، منجزة، حواف، قفل،
                         مجلد_الحزم، "root"، ٠).
    }
    حرر_وسائط(اعتماديات).
    حرر_وسائط(نشطة).
    حرر_وسائط(منجزة).
    حرر_وسائط(حواف).
    إذا (مجلد_الحزم != عدم) { حرر_نص(مجلد_الحزم). }
    منطقي استعيد = تحليل_ملف_تكوين("مشروع.تكوين") == ٠.
    إذا (صالح && استعيد) { صالح = اكتب_القفل(قفل، هدف_القفل). }
    حرر_وسائط(قفل).
    حرر_نص(هدف_القفل).
    إرجع صالح && استعيد.
}
