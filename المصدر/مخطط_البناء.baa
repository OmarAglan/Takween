#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص الصق_وحرر_يسار(نص يسار، نص يمين).
منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
منطقي اضف_ملفات_من(متجه وسائط، نص جذر، نص مصدر، نص قائمة_الملفات).
منطقي اضف_تضمينات_من(متجه وسائط، نص جذر، نص قائمة).

منطقي اضف_وسائط_محلولة(متجه وسائط، متجه وسائط_محلولة) {
    إذا (وسائط_محلولة == عدم) { إرجع صواب. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط_محلولة)).
    صحيح م = ٠.
    طالما (م < طول_متجه(وسائط_محلولة)) {
        إذا (!اضف_وسيط(وسائط، *(بيانات + م))) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

متجه انسخ_وسائط_خطة(متجه أصل) {
    متجه نسخة = أنشئ_متجه(حجم(نص)).
    إذا (نسخة == عدم || !اضف_وسائط_محلولة(نسخة، أصل)) {
        إذا (نسخة != عدم) { حرر_وسائط(نسخة). }
        إرجع عدم.
    }
    إرجع نسخة.
}

متجه ابن_بيانات_نمط_خطة() {
    متجه بيانات = أنشئ_متجه(حجم(نص)).
    نص تحسين = نسق("%ص"، احصل_تكوين_التحسين()).
    نص تحقق = "false".
    إذا (احصل_تكوين_التحقق()) { تحقق = "true". }
    منطقي صالح = بيانات != عدم && تحسين != عدم.
    إذا (صالح) { صالح = اضف_وسيط(بيانات، احصل_تكوين_النمط()). }
    إذا (صالح) { صالح = اضف_وسيط(بيانات، تحسين). }
    إذا (صالح) { صالح = اضف_وسيط(بيانات، تحقق). }
    إذا (تحسين != عدم) { حرر_نص(تحسين). }
    إذا (!صالح) {
        إذا (بيانات != عدم) { حرر_وسائط(بيانات). }
        إرجع عدم.
    }
    إرجع بيانات.
}

خطة_بناء غلف_خطة_البناء(متجه وسائط، متجه ترتيب_الأهداف) {
    متجه ترتيب = انسخ_وسائط_خطة(ترتيب_الأهداف).
    متجه نمط = ابن_بيانات_نمط_خطة().
    متجه غلاف = أنشئ_متجه(حجم(متجه)).
    إذا (ترتيب == عدم || نمط == عدم || غلاف == عدم ||
        !ادفع_متجه(غلاف، &وسائط) || !ادفع_متجه(غلاف، &ترتيب) ||
        !ادفع_متجه(غلاف، &نمط)) {
        إذا (ترتيب != عدم) { حرر_وسائط(ترتيب). }
        إذا (نمط != عدم) { حرر_وسائط(نمط). }
        إذا (غلاف != عدم) { حرر_متجه(غلاف). }
        إرجع عدم.
    }
    إرجع غلاف.
}

متجه وسائط_خطة_البناء(خطة_بناء خطة) {
    إذا (خطة == عدم || طول_متجه(خطة) != ٣) { إرجع عدم. }
    متجه* بيانات = كـ<متجه*>(بيانات_متجه(خطة)).
    إرجع *بيانات.
}

متجه ترتيب_خطة_البناء(خطة_بناء خطة) {
    إذا (خطة == عدم || طول_متجه(خطة) != ٣) { إرجع عدم. }
    متجه* بيانات = كـ<متجه*>(بيانات_متجه(خطة)).
    إرجع *(بيانات + ١).
}

متجه نمط_خطة_البناء(خطة_بناء خطة) {
    إذا (خطة == عدم || طول_متجه(خطة) != ٣) { إرجع عدم. }
    متجه* بيانات = كـ<متجه*>(بيانات_متجه(خطة)).
    إرجع *(بيانات + ٢).
}

عدم حرر_خطة_البناء(خطة_بناء خطة) {
    إذا (خطة == عدم) { إرجع. }
    متجه وسائط = وسائط_خطة_البناء(خطة).
    متجه ترتيب = ترتيب_خطة_البناء(خطة).
    متجه نمط = نمط_خطة_البناء(خطة).
    إذا (وسائط != عدم) { حرر_وسائط(وسائط). }
    إذا (ترتيب != عدم) { حرر_وسائط(ترتيب). }
    إذا (نمط != عدم) { حرر_وسائط(نمط). }
    حرر_متجه(خطة).
}

خطة_بناء ابن_خطة_البناء(متجه وسائط_محلولة، متجه ترتيب_الأهداف، نص مسار_الناتج،
                          نص علم_التحسين، صحيح* كود_الخطة) {
    *كود_الخطة = كود_تكوين_نجاح.
    نص مسار_الكاش = ضم_مسار(احصل_تكوين_المخرج()، ".takween-cache").
    نص مسار_البيان = ضم_مسار(احصل_تكوين_المخرج()، "build-manifest.json").
    إذا (مسار_الكاش == عدم || مسار_البيان == عدم) {
        إذا (مسار_الكاش != عدم) { حرر_نص(مسار_الكاش). }
        إذا (مسار_البيان != عدم) { حرر_نص(مسار_البيان). }
        *كود_الخطة = كود_تكوين_خطأ_داخلي.
        إرجع عدم.
    }

    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي فشل = وسائط == عدم.
    إذا (!فشل && !اضف_وسيط(وسائط، "baa")) { فشل = صواب. }
    إذا (!فشل && !اضف_ملفات_من(وسائط، "."، احصل_تكوين_المصدر()، احصل_تكوين_الملفات())) {
        فشل = صواب.
    }
    إذا (!فشل && !اضف_تضمينات_من(وسائط، "."، احصل_تكوين_مسارات_التضمين())) {
        فشل = صواب.
    }
    إذا (!فشل && !اضف_وسائط_محلولة(وسائط، وسائط_محلولة)) { فشل = صواب. }

    نص هدف_باء = احصل_تكوين_هدف_باء().
    إذا (!فشل && هدف_باء != عدم && طول_نص(هدف_باء) > ٠) {
        إذا (!اضف_وسيط_مملوك(وسائط، دمج_نص("--target="، هدف_باء))) { فشل = صواب. }
    }

    نص اختيار_المجمع = احصل_تكوين_المجمع().
    إذا (!فشل && اختيار_المجمع != عدم && طول_نص(اختيار_المجمع) > ٠) {
        إذا (قارن_نص(اختيار_المجمع، "نظم") == ٠) {
            إذا (!اضف_وسيط(وسائط، "--assembler=nazm")) { فشل = صواب. }
        }
        وإلا إذا (قارن_نص(اختيار_المجمع، "غاز") == ٠) {
            إذا (!اضف_وسيط(وسائط، "--assembler=gas")) { فشل = صواب. }
        }
        وإلا { فشل = صواب. }
    }
    وإلا إذا (!فشل) {
        // لا تعتمد الخطة الحتمية على تغير default المصرّف في إصدار لاحق.
        إذا (!اضف_وسيط(وسائط، "--assembler=gas")) { فشل = صواب. }
    }

    إذا (!فشل && !اضف_وسيط(وسائط، علم_التحسين)) { فشل = صواب. }
    إذا (!فشل && احصل_تكوين_التحقق()) {
        إذا (!اضف_وسيط(وسائط، "--verify")) { فشل = صواب. }
    }
    إذا (!فشل && !اضف_وسيط(وسائط، "--incremental")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(وسائط، "--cache-dir")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(وسائط، مسار_الكاش)) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(وسائط، "--emit-build-manifest")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(وسائط، مسار_البيان)) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(وسائط، "-o")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(وسائط، مسار_الناتج)) { فشل = صواب. }
    حرر_نص(مسار_الكاش).
    حرر_نص(مسار_البيان).

    إذا (فشل) {
        إذا (*كود_الخطة == ٠) { *كود_الخطة = كود_تكوين_خطأ_داخلي. }
        إذا (وسائط != عدم) { حرر_وسائط(وسائط). }
        إرجع عدم.
    }
    خطة_بناء خطة = غلف_خطة_البناء(وسائط، ترتيب_الأهداف).
    إذا (خطة == عدم) {
        حرر_وسائط(وسائط).
        *كود_الخطة = كود_تكوين_خطأ_داخلي.
    }
    إرجع خطة.
}

خطة_بناء ابن_خطة_الفحص(متجه وسائط_محلولة، متجه ترتيب_الأهداف،
                        صحيح* كود_الخطة) {
    *كود_الخطة = كود_تكوين_نجاح.
    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي فشل = وسائط == عدم.
    إذا (!فشل && !اضف_وسيط(وسائط، "baa")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(وسائط، "--check")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(وسائط، "--diagnostics=json")) { فشل = صواب. }
    إذا (!فشل && !اضف_ملفات_من(وسائط، "."، احصل_تكوين_المصدر()، احصل_تكوين_الملفات())) {
        فشل = صواب.
    }
    إذا (!فشل && !اضف_تضمينات_من(وسائط، "."، احصل_تكوين_مسارات_التضمين())) {
        فشل = صواب.
    }
    إذا (!فشل && !اضف_وسائط_محلولة(وسائط، وسائط_محلولة)) { فشل = صواب. }
    نص هدف_باء = احصل_تكوين_هدف_باء().
    إذا (!فشل && هدف_باء != عدم && طول_نص(هدف_باء) > ٠) {
        إذا (!اضف_وسيط_مملوك(وسائط، دمج_نص("--target="، هدف_باء))) { فشل = صواب. }
    }
    إذا (فشل) {
        إذا (*كود_الخطة == ٠) { *كود_الخطة = كود_تكوين_خطأ_داخلي. }
        إذا (وسائط != عدم) { حرر_وسائط(وسائط). }
        إرجع عدم.
    }
    خطة_بناء خطة = غلف_خطة_البناء(وسائط، ترتيب_الأهداف).
    إذا (خطة == عدم) {
        حرر_وسائط(وسائط).
        *كود_الخطة = كود_تكوين_خطأ_داخلي.
    }
    إرجع خطة.
}

نص هرب_جسون_خطة(نص قيمة) {
    نص ناتج = نسخ_نص("").
    إذا (قيمة == عدم) { إرجع ناتج. }
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        نص جزء = عدم.
        إذا (ح == '"') { جزء = نسخ_نص("\\\""). }
        وإلا إذا (ح == '\\') { جزء = نسخ_نص("\\\\"). }
        وإلا إذا (ح == '\س') { جزء = نسخ_نص("\\n"). }
        وإلا إذا (ح == '\ر') { جزء = نسخ_نص("\\r"). }
        وإلا إذا (ح == '\ت') { جزء = نسخ_نص("\\t"). }
        وإلا { جزء = نسق("%ح"، ح). }
        ناتج = الصق_وحرر_يسار(ناتج، جزء).
        حرر_نص(جزء).
        م = م + ١.
    }
    إرجع ناتج.
}

نص خطة_بناء_إلى_جسون(خطة_بناء خطة، نص العملية) {
    إذا (خطة == عدم) { إرجع عدم. }
    متجه وسائط = وسائط_خطة_البناء(خطة).
    متجه ترتيب = ترتيب_خطة_البناء(خطة).
    متجه نمط = نمط_خطة_البناء(خطة).
    إذا (وسائط == عدم || ترتيب == عدم || نمط == عدم ||
        طول_متجه(نمط) != ٣) { إرجع عدم. }
    نص مشروع = هرب_جسون_خطة(احصل_تكوين_الاسم()).
    نص هدف = هرب_جسون_خطة(احصل_اسم_الهدف()).
    نص عملية = هرب_جسون_خطة(العملية).
    نص ناتج = نسق("{\"schema_version\":\"takween-build-plan-v1\",\"operation\":\"%ن\",\"project\":\"%ن\",\"target\":\"%ن\"",
                   عملية، مشروع، هدف).
    حرر_نص(مشروع). حرر_نص(هدف). حرر_نص(عملية).
    إذا (ناتج == عدم) { إرجع عدم. }
    نص* بيانات_نمط = كـ<نص*>(بيانات_متجه(نمط)).
    نص اسم_نمط = هرب_جسون_خطة(*بيانات_نمط).
    نص جزء_نمط = نسق(",\"profile\":{\"name\":\"%ن\",\"optimization\":%ن,\"verify\":%ن},\"target_order\":[",
                       اسم_نمط، *(بيانات_نمط + ١)، *(بيانات_نمط + ٢)).
    حرر_نص(اسم_نمط).
    إذا (جزء_نمط == عدم) { حرر_نص(ناتج). إرجع عدم. }
    ناتج = الصق_وحرر_يسار(ناتج، جزء_نمط).
    حرر_نص(جزء_نمط).
    إذا (ناتج == عدم) { إرجع عدم. }

    نص* بيانات_ترتيب = كـ<نص*>(بيانات_متجه(ترتيب)).
    صحيح م = ٠.
    طالما (م < طول_متجه(ترتيب)) {
        نص آمن = هرب_جسون_خطة(*(بيانات_ترتيب + م)).
        نص جزء = عدم.
        إذا (م > ٠) { جزء = نسق(",\"%ن\""، آمن). }
        وإلا { جزء = نسق("\"%ن\""، آمن). }
        حرر_نص(آمن).
        إذا (جزء == عدم) { حرر_نص(ناتج). إرجع عدم. }
        ناتج = الصق_وحرر_يسار(ناتج، جزء).
        حرر_نص(جزء).
        إذا (ناتج == عدم) { إرجع عدم. }
        م = م + ١.
    }
    ناتج = الصق_وحرر_يسار(ناتج، "],\"argv\":[").
    إذا (ناتج == عدم) { إرجع عدم. }

    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    م = ٠.
    طالما (م < طول_متجه(وسائط)) {
        نص آمن = هرب_جسون_خطة(*(بيانات + م)).
        نص جزء = عدم.
        إذا (م > ٠) { جزء = نسق(",\"%ن\""، آمن). }
        وإلا { جزء = نسق("\"%ن\""، آمن). }
        حرر_نص(آمن).
        إذا (جزء == عدم) { حرر_نص(ناتج). إرجع عدم. }
        ناتج = الصق_وحرر_يسار(ناتج، جزء).
        حرر_نص(جزء).
        إذا (ناتج == عدم) { إرجع عدم. }
        م = م + ١.
    }
    إرجع الصق_وحرر_يسار(ناتج، "]}").
}
