#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص الصق_وحرر_يسار(نص يسار، نص يمين).
منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
منطقي اضف_ملفات_من(متجه وسائط، نص جذر، نص مصدر، نص قائمة_الملفات).
منطقي اضف_تضمينات_من(متجه وسائط، نص جذر، نص قائمة).

منطقي اضف_وسائط_محلولة(خطة_بناء خطة، متجه وسائط_محلولة) {
    إذا (وسائط_محلولة == عدم) { إرجع صواب. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط_محلولة)).
    صحيح م = ٠.
    طالما (م < طول_متجه(وسائط_محلولة)) {
        إذا (!اضف_وسيط(خطة، *(بيانات + م))) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

خطة_بناء ابن_خطة_البناء(متجه وسائط_محلولة، نص مسار_الناتج،
                          نص علم_التحسين، صحيح* كود_الخطة) {
    *كود_الخطة = كود_تكوين_نجاح.
    نص مسار_الكاش = ضم_مسار(احصل_تكوين_المخرج()، ".takween-cache").
    نص مسار_البيان = ضم_مسار(احصل_تكوين_المخرج()، "build-manifest.json").
    إذا (مسار_الكاش == عدم || مسار_البيان == عدم) {
        إذا (مسار_الكاش != عدم) { حرر_نص(مسار_الكاش). }
        إذا (مسار_البيان != عدم) { حرر_نص(مسار_البيان). }
        *كود_الخطة = كود_تكوين_خطأ_داخلي.
        إرجع عدم.
    }

    خطة_بناء خطة = أنشئ_متجه(حجم(نص)).
    منطقي فشل = خطة == عدم.
    إذا (!فشل && !اضف_وسيط(خطة، "baa")) { فشل = صواب. }
    إذا (!فشل && !اضف_ملفات_من(خطة، "."، احصل_تكوين_المصدر()، احصل_تكوين_الملفات())) {
        فشل = صواب.
    }
    إذا (!فشل && !اضف_تضمينات_من(خطة، "."، احصل_تكوين_مسارات_التضمين())) {
        فشل = صواب.
    }
    إذا (!فشل && !اضف_وسائط_محلولة(خطة، وسائط_محلولة)) { فشل = صواب. }

    نص هدف_باء = احصل_تكوين_هدف_باء().
    إذا (!فشل && هدف_باء != عدم && طول_نص(هدف_باء) > ٠) {
        إذا (!اضف_وسيط_مملوك(خطة، دمج_نص("--target="، هدف_باء))) { فشل = صواب. }
    }

    نص اختيار_المجمع = احصل_تكوين_المجمع().
    إذا (!فشل && اختيار_المجمع != عدم && طول_نص(اختيار_المجمع) > ٠) {
        إذا (قارن_نص(اختيار_المجمع، "نظم") == ٠) {
            إذا (!اضف_وسيط(خطة، "--assembler=nazm")) { فشل = صواب. }
        }
        وإلا إذا (قارن_نص(اختيار_المجمع، "غاز") == ٠) {
            إذا (!اضف_وسيط(خطة، "--assembler=gas")) { فشل = صواب. }
        }
        وإلا { فشل = صواب. }
    }
    وإلا إذا (!فشل) {
        // لا تعتمد الخطة الحتمية على تغير default المصرّف في إصدار لاحق.
        إذا (!اضف_وسيط(خطة، "--assembler=gas")) { فشل = صواب. }
    }

    إذا (!فشل && !اضف_وسيط(خطة، علم_التحسين)) { فشل = صواب. }
    إذا (!فشل && احصل_تكوين_التحقق()) {
        إذا (!اضف_وسيط(خطة، "--verify")) { فشل = صواب. }
    }
    إذا (!فشل && !اضف_وسيط(خطة، "--incremental")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(خطة، "--cache-dir")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(خطة، مسار_الكاش)) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(خطة، "--emit-build-manifest")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(خطة، مسار_البيان)) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(خطة، "-o")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(خطة، مسار_الناتج)) { فشل = صواب. }
    حرر_نص(مسار_الكاش).
    حرر_نص(مسار_البيان).

    إذا (فشل) {
        إذا (*كود_الخطة == ٠) { *كود_الخطة = كود_تكوين_خطأ_داخلي. }
        إذا (خطة != عدم) { حرر_وسائط(خطة). }
        إرجع عدم.
    }
    إرجع خطة.
}

خطة_بناء ابن_خطة_الفحص(متجه وسائط_محلولة، صحيح* كود_الخطة) {
    *كود_الخطة = كود_تكوين_نجاح.
    خطة_بناء خطة = أنشئ_متجه(حجم(نص)).
    منطقي فشل = خطة == عدم.
    إذا (!فشل && !اضف_وسيط(خطة، "baa")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(خطة، "--check")) { فشل = صواب. }
    إذا (!فشل && !اضف_وسيط(خطة، "--diagnostics=json")) { فشل = صواب. }
    إذا (!فشل && !اضف_ملفات_من(خطة، "."، احصل_تكوين_المصدر()، احصل_تكوين_الملفات())) {
        فشل = صواب.
    }
    إذا (!فشل && !اضف_تضمينات_من(خطة، "."، احصل_تكوين_مسارات_التضمين())) {
        فشل = صواب.
    }
    إذا (!فشل && !اضف_وسائط_محلولة(خطة، وسائط_محلولة)) { فشل = صواب. }
    نص هدف_باء = احصل_تكوين_هدف_باء().
    إذا (!فشل && هدف_باء != عدم && طول_نص(هدف_باء) > ٠) {
        إذا (!اضف_وسيط_مملوك(خطة، دمج_نص("--target="، هدف_باء))) { فشل = صواب. }
    }
    إذا (فشل) {
        إذا (*كود_الخطة == ٠) { *كود_الخطة = كود_تكوين_خطأ_داخلي. }
        إذا (خطة != عدم) { حرر_وسائط(خطة). }
        إرجع عدم.
    }
    إرجع خطة.
}

نص هرب_جسون_خطة(نص قيمة) {
    نص ناتج = نسخ_نص("").
    إذا (قيمة == عدم) { إرجع ناتج. }
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        نص جزء = عدم.
        إذا (ح == '"') { جزء = نسخ_نص("\\\""). }
        وإلا إذا (ح == '\\') { جزء = نسخ_نص("\\\\"). }
        وإلا إذا (ح == '\س') { جزء = نسخ_نص("\\n"). }
        وإلا إذا (ح == '\ر') { جزء = نسخ_نص("\\r"). }
        وإلا إذا (ح == '\ت') { جزء = نسخ_نص("\\t"). }
        وإلا { جزء = نسق("%ح"، ح). }
        ناتج = الصق_وحرر_يسار(ناتج، جزء).
        حرر_نص(جزء).
        م = م + ١.
    }
    إرجع ناتج.
}

نص خطة_بناء_إلى_جسون(خطة_بناء خطة، نص العملية) {
    إذا (خطة == عدم) { إرجع عدم. }
    نص مشروع = هرب_جسون_خطة(احصل_تكوين_الاسم()).
    نص هدف = هرب_جسون_خطة(احصل_اسم_الهدف()).
    نص عملية = هرب_جسون_خطة(العملية).
    نص ناتج = نسق("{\"schema_version\":\"takween-build-plan-v1\",\"operation\":\"%ن\",\"project\":\"%ن\",\"target\":\"%ن\",\"argv\":[",
                   عملية، مشروع، هدف).
    حرر_نص(مشروع). حرر_نص(هدف). حرر_نص(عملية).
    إذا (ناتج == عدم) { إرجع عدم. }

    نص* بيانات = كـ<نص*>(بيانات_متجه(خطة)).
    صحيح م = ٠.
    طالما (م < طول_متجه(خطة)) {
        نص آمن = هرب_جسون_خطة(*(بيانات + م)).
        نص جزء = عدم.
        إذا (م > ٠) { جزء = نسق(",\"%ن\""، آمن). }
        وإلا { جزء = نسق("\"%ن\""، آمن). }
        حرر_نص(آمن).
        إذا (جزء == عدم) { حرر_نص(ناتج). إرجع عدم. }
        ناتج = الصق_وحرر_يسار(ناتج، جزء).
        حرر_نص(جزء).
        إذا (ناتج == عدم) { إرجع عدم. }
        م = م + ١.
    }
    إرجع الصق_وحرر_يسار(ناتج، "]}").
}
