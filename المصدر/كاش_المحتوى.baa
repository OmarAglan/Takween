#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
نص قص_طرفين(نص قيمة).
نص هرب_جسون_خطة(نص قيمة).
نص قيمة_JSON_نصية(نص سطر).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
منطقي يحتوي_على_تنفيذ(نص النص، نص الجزء).
منطقي تجزئة_SHA256_صالحة(نص قيمة).

منطقي تجزئة_بيان_صالحة(نص قيمة) {
    إذا (قيمة == عدم ||
        (طول_نص(قيمة) != ١٦ && طول_نص(قيمة) != ٦٤)) { إرجع خطأ. }
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        إذا (!((ح >= '0' && ح <= '9') || (ح >= 'a' && ح <= 'f'))) {
            إرجع خطأ.
        }
        م = م + ١.
    }
    إرجع صواب.
}

صحيح موضع_جزء_كاش(نص قيمة، نص جزء) {
    إذا (قيمة == عدم || جزء == عدم || طول_نص(جزء) == ٠ ||
        طول_نص(جزء) > طول_نص(قيمة)) { إرجع -١. }
    صحيح م = ٠.
    طالما (م <= طول_نص(قيمة) - طول_نص(جزء)) {
        صحيح ن = ٠.
        منطقي مطابق = صواب.
        طالما (ن < طول_نص(جزء)) {
            إذا (قيمة[م + ن] != جزء[ن]) { مطابق = خطأ. توقف. }
            ن = ن + ١.
        }
        إذا (مطابق) { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

نص قيمة_تجزئة_اعتمادية(نص سطر) {
    نص علامة = "\"hash\": \"".
    صحيح موضع = موضع_جزء_كاش(سطر، علامة).
    إذا (موضع < ٠) { إرجع عدم. }
    صحيح بداية = موضع + طول_نص(علامة).
    صحيح نهاية = بداية.
    طالما (نهاية < طول_نص(سطر) && سطر[نهاية] != '"') {
        نهاية = نهاية + ١.
    }
    إذا (نهاية >= طول_نص(سطر)) { إرجع عدم. }
    نص تجزئة = نسخ_مقطع(سطر، بداية، نهاية).
    إذا (!تجزئة_بيان_صالحة(تجزئة)) {
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
        إرجع عدم.
    }
    إرجع تجزئة.
}

منطقي اضف_سطر_كاش(متجه سطور، نص مفتاح، نص قيمة) {
    نص سطر = نسق("%ن=%ن"، مفتاح، قيمة).
    إذا (سطر == عدم) { إرجع خطأ. }
    منطقي صالح = اضف_وسيط(سطور، سطر).
    حرر_نص(سطر).
    إرجع صالح.
}

منطقي اضف_سطر_كاش_مرقم(متجه سطور، نص مفتاح، صحيح رقم، نص قيمة) {
    نص اسم = نسق("%ن[%ص]"، مفتاح، رقم).
    إذا (اسم == عدم) { إرجع خطأ. }
    منطقي صالح = اضف_سطر_كاش(سطور، اسم، قيمة).
    حرر_نص(اسم).
    إرجع صالح.
}

منطقي وسيط_مسار_خرج_متغير(نص قيمة) {
    إرجع قارن_نص(قيمة، "--cache-dir") == ٠ ||
           قارن_نص(قيمة، "--emit-build-manifest") == ٠ ||
           قارن_نص(قيمة، "-o") == ٠.
}

منطقي ينتهي_مصدر_كاش(نص قيمة، نص لاحقة) {
    إذا (قيمة == عدم || لاحقة == عدم ||
        طول_نص(لاحقة) > طول_نص(قيمة)) { إرجع خطأ. }
    صحيح بداية = طول_نص(قيمة) - طول_نص(لاحقة).
    صحيح م = ٠.
    طالما (م < طول_نص(لاحقة)) {
        إذا (قيمة[بداية + م] != لاحقة[م]) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي اضف_تجزئة_مصدر_الخطة(متجه سطور، صحيح رقم، نص مسار) {
    إذا (!ينتهي_مصدر_كاش(مسار، ".baa") &&
        !ينتهي_مصدر_كاش(مسار، ".نظم")) { إرجع صواب. }
    نص تجزئة = تجزئة_ملف_SHA256(مسار).
    إذا (تجزئة == عدم || !تجزئة_SHA256_صالحة(تجزئة)) {
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
        إرجع خطأ.
    }
    منطقي صالح = اضف_سطر_كاش_مرقم(سطور، "argv_content_sha256"، رقم، تجزئة).
    حرر_نص(تجزئة).
    إرجع صالح.
}

منطقي اضف_هوية_الخطة_للكاش(متجه سطور، خطة_بناء خطة) {
    متجه ترتيب = ترتيب_خطة_البناء(خطة).
    متجه نمط = نمط_خطة_البناء(خطة).
    متجه وسائط = وسائط_خطة_البناء(خطة).
    إذا (ترتيب == عدم || نمط == عدم || وسائط == عدم ||
        طول_متجه(نمط) != ٣) { إرجع خطأ. }

    منطقي صالح = اضف_سطر_كاش(سطور، "project_target"، احصل_اسم_الهدف()).
    نص* بيانات_نمط = كـ<نص*>(بيانات_متجه(نمط)).
    إذا (صالح) { صالح = اضف_سطر_كاش(سطور، "profile.name"، *بيانات_نمط). }
    إذا (صالح) { صالح = اضف_سطر_كاش(سطور، "profile.optimization"، *(بيانات_نمط + ١)). }
    إذا (صالح) { صالح = اضف_سطر_كاش(سطور، "profile.verify"، *(بيانات_نمط + ٢)). }

    نص* بيانات_ترتيب = كـ<نص*>(بيانات_متجه(ترتيب)).
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(ترتيب)) {
        صالح = اضف_سطر_كاش_مرقم(سطور، "target_order"، م، *(بيانات_ترتيب + م)).
        م = م + ١.
    }

    نص* بيانات_وسائط = كـ<نص*>(بيانات_متجه(وسائط)).
    م = ١.
    صحيح رقم_ثابت = ٠.
    طالما (صالح && م < طول_متجه(وسائط)) {
        نص قيمة = *(بيانات_وسائط + م).
        إذا (وسيط_مسار_خرج_متغير(قيمة)) {
            م = م + ٢.
        }
        وإلا {
            صالح = اضف_سطر_كاش_مرقم(سطور، "argv"، رقم_ثابت، قيمة).
            إذا (صالح) {
                صالح = اضف_تجزئة_مصدر_الخطة(سطور، رقم_ثابت، قيمة).
            }
            رقم_ثابت = رقم_ثابت + ١.
            م = م + ١.
        }
    }
    إرجع صالح.
}

منطقي سطر_بيان_ثابت(نص سطر) {
    إرجع يحتوي_على_تنفيذ(سطر، "\"schema\":") ||
           يحتوي_على_تنفيذ(سطر، "\"compiler_version\":") ||
           يحتوي_على_تنفيذ(سطر، "\"target\":") ||
           يحتوي_على_تنفيذ(سطر، "\"mode\":") ||
           يحتوي_على_تنفيذ(سطر، "\"assembler\":") ||
           يحتوي_على_تنفيذ(سطر، "\"opt_level\":") ||
           يحتوي_على_تنفيذ(سطر، "\"runtime_checks\":") ||
           يحتوي_على_تنفيذ(سطر، "\"runtime_check_mask\":") ||
           يحتوي_على_تنفيذ(سطر، "\"incremental\":") ||
           يحتوي_على_تنفيذ(سطر، "\"source_kind\":").
}

منطقي اضف_بيان_باء_للكاش(متجه سطور، نص مسار،
                           صحيح* عدد_الوحدات، صحيح* عدد_المفعلة،
                           صحيح* عدد_الإصابات) {
    عدم* ملف = فتح_ملف(مسار، "قراءة").
    إذا (ملف == عدم) { إرجع خطأ. }
    منطقي صالح = صواب.
    منطقي مخطط = خطأ.
    منطقي إصدار = خطأ.
    منطقي هدف = خطأ.
    منطقي نمط = خطأ.
    منطقي تحسين = خطأ.
    منطقي فحوص = خطأ.
    منطقي تزايدي = خطأ.
    صحيح رقم_السطر = ٠.
    صحيح عدد_التجزئات = ٠.
    صحيح عدد_سجلات_كاش = ٠.
    *عدد_الوحدات = ٠.
    *عدد_المفعلة = ٠.
    *عدد_الإصابات = ٠.

    طالما (صالح && !نهاية_ملف(ملف)) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        نص نظيف = قص_طرفين(سطر).
        حرر_نص(سطر).
        إذا (نظيف == عدم) { صالح = خطأ. توقف. }

        إذا (يحتوي_على_تنفيذ(نظيف، "\"schema\": 1,")) { مخطط = صواب. }
        إذا (يحتوي_على_تنفيذ(نظيف، "\"compiler_version\":")) {
            نص قيمة_إصدار = قيمة_JSON_نصية(نظيف).
            إصدار = قيمة_إصدار != عدم &&
                     قارن_نص(قيمة_إصدار، اصدار_باء_فعلي()) == ٠.
            إذا (قيمة_إصدار != عدم) { حرر_نص(قيمة_إصدار). }
        }
        إذا (يحتوي_على_تنفيذ(نظيف، "\"target\":")) {
            نص قيمة_هدف = قيمة_JSON_نصية(نظيف).
            هدف = قيمة_هدف != عدم &&
                  قارن_نص(قيمة_هدف، هدف_باء_فعلي()) == ٠.
            إذا (قيمة_هدف != عدم) { حرر_نص(قيمة_هدف). }
        }
        إذا (يحتوي_على_تنفيذ(نظيف، "\"mode\":")) { نمط = صواب. }
        إذا (يحتوي_على_تنفيذ(نظيف، "\"opt_level\":")) { تحسين = صواب. }
        إذا (يحتوي_على_تنفيذ(نظيف، "\"runtime_check_mask\":")) { فحوص = صواب. }
        إذا (يحتوي_على_تنفيذ(نظيف، "\"incremental\": true")) { تزايدي = صواب. }
        إذا (يحتوي_على_تنفيذ(نظيف، "\"source_kind\":")) {
            *عدد_الوحدات = *عدد_الوحدات + ١.
        }
        إذا (يحتوي_على_تنفيذ(نظيف، "\"cache\":")) {
            عدد_سجلات_كاش = عدد_سجلات_كاش + ١.
            إذا (يحتوي_على_تنفيذ(نظيف، "\"enabled\": true")) {
                *عدد_المفعلة = *عدد_المفعلة + ١.
            }
            إذا (يحتوي_على_تنفيذ(نظيف، "\"hit\": true")) {
                *عدد_الإصابات = *عدد_الإصابات + ١.
            }
        }

        إذا (سطر_بيان_ثابت(نظيف)) {
            صالح = اضف_سطر_كاش_مرقم(سطور، "baa_manifest"، رقم_السطر، نظيف).
            رقم_السطر = رقم_السطر + ١.
        }
        وإلا إذا (يحتوي_على_تنفيذ(نظيف، "\"hash\":")) {
            نص تجزئة = قيمة_تجزئة_اعتمادية(نظيف).
            نص مسار_اعتمادية = قيمة_JSON_نصية(نظيف).
            نص تجزئة_SHA = عدم.
            إذا (مسار_اعتمادية != عدم) {
                تجزئة_SHA = تجزئة_ملف_SHA256(مسار_اعتمادية).
            }
            إذا (تجزئة == عدم || تجزئة_SHA == عدم ||
                !تجزئة_SHA256_صالحة(تجزئة_SHA)) { صالح = خطأ. }
            وإلا {
                صالح = اضف_سطر_كاش_مرقم(سطور، "dependency_hash"، عدد_التجزئات، تجزئة).
                إذا (صالح) {
                    صالح = اضف_سطر_كاش_مرقم(سطور، "dependency_sha256"،
                                             عدد_التجزئات، تجزئة_SHA).
                }
                عدد_التجزئات = عدد_التجزئات + ١.
            }
            إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
            إذا (مسار_اعتمادية != عدم) { حرر_نص(مسار_اعتمادية). }
            إذا (تجزئة_SHA != عدم) { حرر_نص(تجزئة_SHA). }
        }
        حرر_نص(نظيف).
    }
    اغلق_ملف(ملف).
    إرجع صالح && مخطط && إصدار && هدف && نمط && تحسين && فحوص &&
           تزايدي && *عدد_الوحدات > ٠ &&
           عدد_سجلات_كاش == *عدد_الوحدات.
}

نص تجزئة_القفل_او_فارغ() {
    عدم* ملف = فتح_ملف("تكوين.قفل"، "قراءة").
    إذا (ملف == عدم) { إرجع نسخ_نص("-"). }
    اغلق_ملف(ملف).
    نص تجزئة = تجزئة_ملف_SHA256("تكوين.قفل").
    إذا (تجزئة == عدم || !تجزئة_SHA256_صالحة(تجزئة)) {
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
        إرجع عدم.
    }
    إرجع تجزئة.
}

منطقي اكتب_سطور_كاش(نص مسار، متجه سطور) {
    عدم* ملف = فتح_ملف(مسار، "wb").
    إذا (ملف == عدم) { إرجع خطأ. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(سطور)).
    منطقي صالح = صواب.
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(سطور)) {
        صالح = اكتب_سطر(ملف، *(بيانات + م)) >= ٠.
        م = م + ١.
    }
    إذا (اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    إرجع صالح.
}

منطقي اكتب_هوية_كاش(نص مسار، نص مفتاح، نص تجزئة_قفل،
                      خطة_بناء خطة، صحيح عدد_الوحدات،
                      منطقي اكتب_الحالة، منطقي قابل_للإعادة،
                      منطقي إصابة) {
    متجه نمط = نمط_خطة_البناء(خطة).
    إذا (نمط == عدم || طول_متجه(نمط) != ٣) { إرجع خطأ. }
    نص* بيانات_نمط = كـ<نص*>(بيانات_متجه(نمط)).
    نص اسم_نمط = هرب_جسون_خطة(*بيانات_نمط).
    نص هدف_مشروع = هرب_جسون_خطة(احصل_اسم_الهدف()).
    نص إصدار_باء = هرب_جسون_خطة(اصدار_باء_فعلي()).
    نص هدف_باء = هرب_جسون_خطة(هدف_باء_فعلي()).
    إذا (اسم_نمط == عدم || هدف_مشروع == عدم || إصدار_باء == عدم || هدف_باء == عدم) {
        إذا (اسم_نمط != عدم) { حرر_نص(اسم_نمط). }
        إذا (هدف_مشروع != عدم) { حرر_نص(هدف_مشروع). }
        إذا (إصدار_باء != عدم) { حرر_نص(إصدار_باء). }
        إذا (هدف_باء != عدم) { حرر_نص(هدف_باء). }
        إرجع خطأ.
    }
    عدم* ملف = فتح_ملف(مسار، "wb").
    منطقي صالح = ملف != عدم.
    إذا (صالح) { صالح = اكتب_سطر(ملف، "{") >= ٠. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، "  \"schema_version\": \"takween-content-cache-v1\",") >= ٠. }
    نص سطر = نسق("  \"key\": \"%ن\","، مفتاح).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    إذا (صالح) { صالح = اكتب_سطر(ملف، "  \"scope\": \"baa-object-units\",") >= ٠. }
    سطر = نسق("  \"compiler_version\": \"%ن\","، إصدار_باء).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    سطر = نسق("  \"baa_target\": \"%ن\","، هدف_باء).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    سطر = نسق("  \"project_target\": \"%ن\","، هدف_مشروع).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    سطر = نسق("  \"profile\": {\"name\":\"%ن\",\"optimization\":%ن,\"verify\":%ن},"،
               اسم_نمط، *(بيانات_نمط + ١)، *(بيانات_نمط + ٢)).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    سطر = نسق("  \"lock_sha256\": \"%ن\","، تجزئة_قفل).
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    سطر = نسق("  \"units\": %ص"، عدد_الوحدات).
    إذا (اكتب_الحالة) {
        حرر_نص(سطر).
        نص قابل = "false".
        نص مصاب = "false".
        إذا (قابل_للإعادة) { قابل = "true". }
        إذا (إصابة) { مصاب = "true". }
        سطر = نسق("  \"units\": %ص,\س  \"cache\": {\"reusable\":%ن,\"hit\":%ن},\س  \"link_executed\": true"،
                   عدد_الوحدات، قابل، مصاب).
    }
    إذا (صالح) { صالح = اكتب_سطر(ملف، سطر) >= ٠. }
    حرر_نص(سطر).
    إذا (صالح) { صالح = اكتب_سطر(ملف، "}") >= ٠. }
    إذا (ملف != عدم && اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    حرر_نص(اسم_نمط). حرر_نص(هدف_مشروع).
    حرر_نص(إصدار_باء). حرر_نص(هدف_باء).
    إرجع صالح.
}

صحيح ثبت_كاش_محتوى_البناء(خطة_بناء خطة) {
    إذا (خطة == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    نص مجلد_كاش = ضم_مسار(احصل_تكوين_المخرج()، ".takween-cache").
    نص مجلد_محتوى = عدم.
    نص مسار_بيان = ضم_مسار(احصل_تكوين_المخرج()، "build-manifest.json").
    نص مسار_مدخل = عدم.
    نص تجزئة_قفل = عدم.
    متجه سطور = أنشئ_متجه(حجم(نص)).
    إذا (مجلد_كاش != عدم) { مجلد_محتوى = ضم_مسار(مجلد_كاش، "takween-content"). }
    إذا (مجلد_محتوى != عدم) { مسار_مدخل = ضم_مسار(مجلد_محتوى، "key-input.txt"). }
    منطقي صالح = مجلد_كاش != عدم && مجلد_محتوى != عدم && مسار_بيان != عدم &&
                  مسار_مدخل != عدم && سطور != عدم.
    إذا (صالح) { صالح = انشئ_مجلدات(مجلد_محتوى) == ٠. }
    إذا (صالح) { صالح = اضف_وسيط(سطور، "takween-content-key-v1"). }
    إذا (صالح) { صالح = اضف_هوية_الخطة_للكاش(سطور، خطة). }
    تجزئة_قفل = تجزئة_القفل_او_فارغ().
    إذا (صالح) { صالح = تجزئة_قفل != عدم && اضف_سطر_كاش(سطور، "lock_sha256"، تجزئة_قفل). }

    صحيح عدد_الوحدات = ٠.
    صحيح عدد_المفعلة = ٠.
    صحيح عدد_الإصابات = ٠.
    إذا (صالح) {
        صالح = اضف_بيان_باء_للكاش(سطور، مسار_بيان، &عدد_الوحدات،
                                   &عدد_المفعلة، &عدد_الإصابات).
    }
    إذا (صالح) { صالح = اكتب_سطور_كاش(مسار_مدخل، سطور). }
    نص مفتاح = عدم.
    إذا (صالح) {
        مفتاح = تجزئة_ملف_SHA256(مسار_مدخل).
        صالح = مفتاح != عدم && تجزئة_SHA256_صالحة(مفتاح).
    }

    نص مسار_دليل = عدم.
    نص مسار_هوية = عدم.
    نص مسار_احدث = عدم.
    إذا (صالح) {
        نص اسم_دليل = نسق("%ن.key"، مفتاح).
        نص اسم_هوية = نسق("%ن.json"، مفتاح).
        مسار_دليل = ضم_مسار(مجلد_محتوى، اسم_دليل).
        مسار_هوية = ضم_مسار(مجلد_محتوى، اسم_هوية).
        مسار_احدث = ضم_مسار(احصل_تكوين_المخرج()، "build-cache.json").
        إذا (اسم_دليل != عدم) { حرر_نص(اسم_دليل). }
        إذا (اسم_هوية != عدم) { حرر_نص(اسم_هوية). }
        صالح = مسار_دليل != عدم && مسار_هوية != عدم && مسار_احدث != عدم.
    }
    منطقي قابل = عدد_الوحدات > ٠ && عدد_المفعلة == عدد_الوحدات.
    منطقي إصابة = قابل && عدد_الإصابات == عدد_الوحدات.
    إذا (صالح) { صالح = اكتب_سطور_كاش(مسار_دليل، سطور). }
    إذا (صالح) {
        صالح = اكتب_هوية_كاش(مسار_هوية، مفتاح، تجزئة_قفل، خطة،
                              عدد_الوحدات، خطأ، قابل، إصابة).
    }
    إذا (صالح) {
        صالح = اكتب_هوية_كاش(مسار_احدث، مفتاح، تجزئة_قفل، خطة،
                              عدد_الوحدات، صواب، قابل، إصابة).
    }

    إذا (!صالح) {
        اطبع "[خطأ] تعذر إنشاء عقد takween-content-cache-v1 من بيان Baa.".
    }
    إذا (سطور != عدم) { حرر_وسائط(سطور). }
    إذا (مجلد_كاش != عدم) { حرر_نص(مجلد_كاش). }
    إذا (مجلد_محتوى != عدم) { حرر_نص(مجلد_محتوى). }
    إذا (مسار_بيان != عدم) { حرر_نص(مسار_بيان). }
    إذا (مسار_مدخل != عدم) { حرر_نص(مسار_مدخل). }
    إذا (تجزئة_قفل != عدم) { حرر_نص(تجزئة_قفل). }
    إذا (مفتاح != عدم) { حرر_نص(مفتاح). }
    إذا (مسار_دليل != عدم) { حرر_نص(مسار_دليل). }
    إذا (مسار_هوية != عدم) { حرر_نص(مسار_هوية). }
    إذا (مسار_احدث != عدم) { حرر_نص(مسار_احدث). }
    إذا (!صالح) { إرجع كود_تكوين_فشل_أداة. }
    إرجع كود_تكوين_نجاح.
}
