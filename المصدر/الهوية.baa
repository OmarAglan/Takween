#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

منطقي هوية_حزمة_عربية(نص قيمة) {
    إذا (قيمة == عدم || طول_نص(قيمة) == ٠) { إرجع خطأ. }
    منطقي فيها_حرف_عربي = خطأ.
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        منطقي حرف_عربي = (ح >= 'ء' && ح <= 'غ') || (ح >= 'ف' && ح <= 'ي').
        إذا (حرف_عربي) { فيها_حرف_عربي = صواب. }
        وإلا إذا (ح != '_' && !(ح >= '٠' && ح <= '٩')) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع فيها_حرف_عربي.
}

منطقي تحقق_هوية_حزمة_عربية(نص قيمة، نص موضع) {
    إذا (هوية_حزمة_عربية(قيمة)) { إرجع صواب. }
    اطبع_منسق("[خطأ] %ن يجب أن يكون اسما عربيا فقط؛ المسموح حروف عربية وأرقام عربية وشرطة سفلية.\س"، موضع).
    إرجع خطأ.
}
