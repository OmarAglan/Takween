#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).

منطقي هوية_حزمة_عربية(نص قيمة) {
    إذا (قيمة == عدم || طول_نص(قيمة) == ٠) { إرجع خطأ. }
    منطقي فيها_حرف_عربي = خطأ.
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        منطقي حرف_عربي = (ح >= 'ء' && ح <= 'غ') || (ح >= 'ف' && ح <= 'ي').
        إذا (حرف_عربي) { فيها_حرف_عربي = صواب. }
        وإلا إذا (ح != '_' && !(ح >= '٠' && ح <= '٩')) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع فيها_حرف_عربي.
}

// A package name is one identity segment, or a namespace segment and a name
// segment joined by one '/'. A name without a namespace keeps its v1 bytes.
منطقي هوية_حزمة_مؤهلة(نص قيمة) {
    إذا (قيمة == عدم) { إرجع خطأ. }
    صحيح فاصل = -١.
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        إذا (قيمة[م] == '/') {
            إذا (فاصل >= ٠) { إرجع خطأ. }
            فاصل = م.
        }
        م = م + ١.
    }
    إذا (فاصل < ٠) { إرجع هوية_حزمة_عربية(قيمة). }
    نص نطاق = نسخ_مقطع(قيمة، ٠، فاصل).
    نص اسم = نسخ_مقطع(قيمة، فاصل + ١، طول_نص(قيمة)).
    منطقي صالح = خطأ.
    إذا (نطاق != عدم && اسم != عدم) {
        صالح = هوية_حزمة_عربية(نطاق) && هوية_حزمة_عربية(اسم).
    }
    إذا (نطاق != عدم) { حرر_نص(نطاق). }
    إذا (اسم != عدم) { حرر_نص(اسم). }
    إرجع صالح.
}

// The NFC composition of a letter followed by a combining mark, or -1.
// Only alef, waw and yeh with madda or hamza compose into a letter that an
// identity accepts. Identities reject combining marks, so every accepted
// identity is already NFC and byte comparison is canonical comparison.
صحيح تركيب_هوية(صحيح أساس، صحيح علامة) {
    // U+0627 alef with U+0653 madda, U+0654 hamza above, U+0655 hamza below.
    إذا (أساس == 1575 && علامة == 1619) { إرجع 1570. }
    إذا (أساس == 1575 && علامة == 1620) { إرجع 1571. }
    إذا (أساس == 1575 && علامة == 1621) { إرجع 1573. }
    // U+0648 waw and U+064A yeh with hamza above.
    إذا (أساس == 1608 && علامة == 1620) { إرجع 1572. }
    إذا (أساس == 1610 && علامة == 1620) { إرجع 1574. }
    إرجع -١.
}

// Returns a new NFC copy of an identity typed by a person. It composes only
// the pairs above; any other mark stays and the identity check rejects it.
نص هوية_قياسية(نص قيمة) {
    إذا (قيمة == عدم) { إرجع عدم. }
    نص ناتج = نسخ_نص("").
    صحيح م = ٠.
    طالما (ناتج != عدم && م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        إذا (م + ١ < طول_نص(قيمة)) {
            صحيح مركب = تركيب_هوية(كـ<صحيح>(ح)، كـ<صحيح>(قيمة[م + ١])).
            إذا (مركب >= ٠) {
                ح = كـ<حرف>(مركب).
                م = م + ١.
            }
        }
        نص جزء = نسق("%ح"، ح).
        نص جديد = عدم.
        إذا (جزء != عدم) { جديد = دمج_نص(ناتج، جزء). حرر_نص(جزء). }
        حرر_نص(ناتج).
        ناتج = جديد.
        م = م + ١.
    }
    إرجع ناتج.
}

// Prints the NFC form when a rejected stored name is only a decomposed
// spelling of a valid one. Stored bytes are never rewritten silently.
عدم اقترح_هوية_قياسية(نص قيمة) {
    نص قياسية = هوية_قياسية(قيمة).
    إذا (قياسية == عدم) { إرجع. }
    إذا (قارن_نص(قياسية، قيمة) != ٠ && هوية_حزمة_مؤهلة(قياسية)) {
        اطبع_منسق("[خطأ] الاسم ليس بصيغة NFC القياسية؛ اكتبه: %ن\س"، قياسية).
    }
    حرر_نص(قياسية).
}

منطقي تحقق_هوية_حزمة_عربية(نص قيمة، نص موضع) {
    إذا (هوية_حزمة_عربية(قيمة)) { إرجع صواب. }
    اطبع_منسق("[خطأ] %ن يجب أن يكون اسما عربيا فقط؛ المسموح حروف عربية وأرقام عربية وشرطة سفلية.\س"، موضع).
    اقترح_هوية_قياسية(قيمة).
    إرجع خطأ.
}

منطقي تحقق_هوية_حزمة_مؤهلة(نص قيمة، نص موضع) {
    إذا (هوية_حزمة_مؤهلة(قيمة)) { إرجع صواب. }
    اطبع_منسق("[خطأ] %ن يجب أن يكون اسما عربيا فقط، أو نطاقا عربيا ثم '/' ثم اسما عربيا؛ المسموح حروف عربية وأرقام عربية وشرطة سفلية.\س"، موضع).
    اقترح_هوية_قياسية(قيمة).
    إرجع خطأ.
}

// Normalizes a name typed on the command line to NFC and says so when that
// changed it. Returns a new string, or عدم when the result is not a name.
نص هوية_من_الطرفية(نص قيمة، منطقي مؤهلة) {
    نص قياسية = هوية_قياسية(قيمة).
    إذا (قياسية == عدم) { إرجع عدم. }
    منطقي صالحة = هوية_حزمة_عربية(قياسية).
    إذا (مؤهلة) { صالحة = هوية_حزمة_مؤهلة(قياسية). }
    إذا (!صالحة) { حرر_نص(قياسية). إرجع عدم. }
    إذا (قارن_نص(قياسية، قيمة) != ٠) {
        اطبع_منسق("[ملاحظة] طُبّع الاسم إلى صيغة NFC: %ن\س"، قياسية).
    }
    إرجع قياسية.
}
