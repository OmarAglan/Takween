#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
نص حقل_أرشيف(نص سجل، صحيح رقم).
نص هرب_جسون_خطة(نص قيمة).
منطقي يبدأ_ب(نص النص، نص البادئة).
نص جذر_بيانات_تكوين().
نص ضم_وحرر_يسار_طقم(نص يسار، نص يمين).
منطقي ملف_موجود_طقم(نص مسار).
نص قمة_طقم(نص إصدار، نص مضيف).
منطقي اقرأ_فهرس_طقوم(نص مخزن، متجه أسطر).
نص اقرأ_إيصال_طقم(نص جذر، نص إصدار، نص مضيف).
منطقي تجزئة_سداسية_صالحة_طقم(نص قيمة).
منطقي قفل_صارم_مفعل().

// اختيار طقم باء للمشروع. الترتيب:
//   1. طقم يثبته سطر baa في تكوين.قفل، إن طابق المضيف وقيد إصدار_باء؛
//      غيابه عن المخزن خطأ لا يُستبدل بغيره بصمت.
//   2. مع --مقفل: قفل بلا طقم يعني مصرّف baa من PATH كما بُني القفل.
//   3. أعلى طقم مثبت لهذا المضيف يطابق إصدار_باء.
//   4. لا طقم مطابق: baa من PATH.
// يحسب الاختيار مرة واحدة لكل عملية؛ كل عضو في مساحة عمل عملية مستقلة.

منطقي طقم_محسوب = خطأ.
منطقي تجاهل_طقم_القفل = خطأ.
نص إصدار_طقم_مختار = "".
نص تجزئة_طقم_مختار = "".
نص جذر_طقم_مختار = "".
نص مصرف_طقم_مختار = "".

// تكوين حدّث يعيد اختيار الطقم ولا يتقيد بالقفل.
عدم اترك_طقم_القفل() {
    تجاهل_طقم_القفل = صواب.
}

منطقي طقم_باء_مختار() {
    إرجع طول_نص(إصدار_طقم_مختار) > ٠.
}

نص إصدار_طقم_باء() {
    إرجع إصدار_طقم_مختار.
}

نص تجزئة_طقم_باء() {
    إرجع تجزئة_طقم_مختار.
}

نص جذر_طقم_باء() {
    إرجع جذر_طقم_مختار.
}

// الأمر الذي يشغله تكوين للمصرّف: مسار مطلق داخل الطقم، أو baa من PATH.
نص أمر_باء() {
    إذا (طول_نص(مصرف_طقم_مختار) > ٠) { إرجع مصرف_طقم_مختار. }
    إرجع "baa".
}

منطقي مسار_مطلق_طقم(نص مسار) {
    إذا (مسار == عدم || طول_نص(مسار) == ٠) { إرجع خطأ. }
    إذا (مسار[٠] == '/' || مسار[٠] == '\\') { إرجع صواب. }
    إرجع طول_نص(مسار) >= ٣ && مسار[١] == ':' && (مسار[٢] == '/' || مسار[٢] == '\\').
}

صحيح موضع_نص_طقم(نص كل، نص جزء) {
    صحيح طول_كل = طول_نص(كل).
    صحيح طول_جزء = طول_نص(جزء).
    صحيح م = ٠.
    طالما (م + طول_جزء <= طول_كل) {
        صحيح ن = ٠.
        طالما (ن < طول_جزء && كل[م + ن] == جزء[ن]) { ن = ن + ١. }
        إذا (ن == طول_جزء) { إرجع م. }
        م = م + ١.
    }
    إرجع -١.
}

// قيمة "<مفتاح>":"<قيمة>" النصية بعد موضع البداية، أو عدم.
نص قيمة_مفتاح_طقم(نص سطر، نص مفتاح) {
    نص بادئة = نسق("\"%ن\":\""، مفتاح).
    إذا (بادئة == عدم) { إرجع عدم. }
    صحيح بداية = موضع_نص_طقم(سطر، بادئة).
    إذا (بداية >= ٠) { بداية = بداية + طول_نص(بادئة). }
    حرر_نص(بادئة).
    إذا (بداية < ٠) { إرجع عدم. }
    صحيح نهاية = بداية.
    طالما (نهاية < طول_نص(سطر) && سطر[نهاية] != '"' && سطر[نهاية] != '\\') {
        نهاية = نهاية + ١.
    }
    إذا (نهاية >= طول_نص(سطر) || سطر[نهاية] != '"') { إرجع عدم. }
    إرجع نسخ_مقطع(سطر، بداية، نهاية).
}

// طقم القفل: ٠ لا قفل، ١ قفل بلا طقم، ٢ قفل بطقم (القيم مملوكة)، -١ صيغة تالفة.
صحيح اقرأ_طقم_القفل(نص* إصدار، نص* مضيف، نص* تجزئة) {
    نص قيمة_إصدار = عدم.
    نص قيمة_مضيف = عدم.
    نص قيمة_تجزئة = عدم.
    صحيح نوع_قفل = ٠.
    عدم* ملف = فتح_ملف("تكوين.قفل"، "rb").
    إذا (ملف != عدم) { نوع_قفل = ١. }
    طالما (ملف != عدم) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        صحيح بداية = -١.
        إذا (يبدأ_ب(سطر، "  \"baa\": {")) { بداية = موضع_نص_طقم(سطر، "\"sdk\":{"). }
        إذا (بداية >= ٠ && قيمة_إصدار == عدم && قيمة_مضيف == عدم && قيمة_تجزئة == عدم) {
            نص ذيل = نسخ_مقطع(سطر، بداية، طول_نص(سطر)).
            إذا (ذيل != عدم) {
                قيمة_إصدار = قيمة_مفتاح_طقم(ذيل، "version").
                قيمة_مضيف = قيمة_مفتاح_طقم(ذيل، "host").
                قيمة_تجزئة = قيمة_مفتاح_طقم(ذيل، "archive_sha256").
                حرر_نص(ذيل).
            }
            منطقي صالح = قيمة_إصدار != عدم && قيمة_مضيف != عدم && قيمة_تجزئة != عدم &&
                          اصدار_دلالي_صالح(قيمة_إصدار) && تجزئة_سداسية_صالحة_طقم(قيمة_تجزئة).
            نوع_قفل = ٢.
            إذا (!صالح) { نوع_قفل = -١. }
        }
        حرر_نص(سطر).
    }
    إذا (ملف != عدم) { اغلق_ملف(ملف). }
    إذا (نوع_قفل != ٢) {
        إذا (قيمة_إصدار != عدم) { حرر_نص(قيمة_إصدار). قيمة_إصدار = عدم. }
        إذا (قيمة_مضيف != عدم) { حرر_نص(قيمة_مضيف). قيمة_مضيف = عدم. }
        إذا (قيمة_تجزئة != عدم) { حرر_نص(قيمة_تجزئة). قيمة_تجزئة = عدم. }
    }
    *إصدار = قيمة_إصدار.
    *مضيف = قيمة_مضيف.
    *تجزئة = قيمة_تجزئة.
    إرجع نوع_قفل.
}

// يعتمد طقما منشورا: يقرأ إيصاله ويطابق التجزئة المتوقعة إن وُجدت.
صحيح اعتمد_طقما(نص مخزن، نص إصدار، نص تجزئة_متوقعة) {
    نص مضيف = مضيف_تكوين().
    نص جذر = عدم.
    إذا (مخزن != عدم) {
        نص قمة = قمة_طقم(إصدار، مضيف).
        جذر = ضم_مسار(مخزن، قمة).
        حرر_نص(قمة).
    }
    نص تجزئة = عدم.
    إذا (جذر != عدم) { تجزئة = اقرأ_إيصال_طقم(جذر، إصدار، مضيف). }
    إذا (تجزئة == عدم) {
        إذا (تجزئة_متوقعة != عدم) {
            اطبع_منسق("[خطأ] تكوين.قفل يثبت طقم باء %ن غير المثبت لهذا المضيف؛ ثبته بـ: تكوين طقم ثبت <أرشيف>\س"، إصدار).
        }
        وإلا {
            اطبع_منسق("[خطأ] طقم باء %ن في فهرس الطقوم بلا إيصال صالح؛ افحصه بـ: تكوين طقم تحقق %ن\س"، إصدار، إصدار).
        }
        إذا (جذر != عدم) { حرر_نص(جذر). }
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (تجزئة_متوقعة != عدم && قارن_نص(تجزئة، تجزئة_متوقعة) != ٠) {
        اطبع_منسق("[خطأ] طقم باء %ن المثبت من أرشيف غير الذي يثبته تكوين.قفل.\س"، إصدار).
        حرر_نص(تجزئة). حرر_نص(جذر).
        إرجع كود_تكوين_خطأ_عام.
    }
    نص اسم_مصرف = "baa".
    إذا (قارن_نص(مضيف، "x86_64-windows") == ٠) { اسم_مصرف = "baa.exe". }
    نص مصرف = ضم_مسار(جذر، "bin").
    مصرف = ضم_وحرر_يسار_طقم(مصرف، اسم_مصرف).
    إذا (!ملف_موجود_طقم(مصرف)) {
        اطبع_منسق("[خطأ] طقم باء %ن بلا مصرّف في bin/؛ افحصه بـ: تكوين طقم تحقق %ن\س"، إصدار، إصدار).
        إذا (مصرف != عدم) { حرر_نص(مصرف). }
        حرر_نص(تجزئة). حرر_نص(جذر).
        إرجع كود_تكوين_خطأ_عام.
    }
    إصدار_طقم_مختار = نسخ_نص(إصدار).
    تجزئة_طقم_مختار = تجزئة.
    جذر_طقم_مختار = طبع_مسار(جذر).
    مصرف_طقم_مختار = طبع_مسار(مصرف).
    حرر_نص(جذر). حرر_نص(مصرف).
    إرجع كود_تكوين_نجاح.
}

// أعلى طقم منشور لهذا المضيف يطابق القيد؛ لا شيء مطابق ليس خطأ.
صحيح اختر_أعلى_طقم(نص مخزن، نص قيد) {
    إذا (مخزن == عدم) { إرجع كود_تكوين_نجاح. }
    متجه أسطر = أنشئ_متجه(حجم(نص)).
    إذا (أسطر == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    إذا (!اقرأ_فهرس_طقوم(مخزن، أسطر)) {
        حرر_وسائط(أسطر).
        إرجع كود_تكوين_خطأ_عام.
    }
    منطقي بقيد = قيد != عدم && طول_نص(قيد) > ٠.
    نص أفضل = عدم.
    نص* بيانات = كـ<نص*>(بيانات_متجه(أسطر)).
    صحيح م = ٠.
    طالما (م < طول_متجه(أسطر)) {
        نص إصدار = حقل_أرشيف(*(بيانات + م)، ٠).
        نص مضيف = حقل_أرشيف(*(بيانات + م)، ١).
        منطقي مرشح = إصدار != عدم && مضيف != عدم &&
                      قارن_نص(مضيف، مضيف_تكوين()) == ٠ &&
                      (!بقيد || يطابق_قيد_اصدار(إصدار، قيد)) &&
                      (أفضل == عدم || قارن_اصدار_دلالي(إصدار، أفضل) > ٠).
        إذا (مرشح) {
            إذا (أفضل != عدم) { حرر_نص(أفضل). }
            أفضل = إصدار.
            إصدار = عدم.
        }
        إذا (إصدار != عدم) { حرر_نص(إصدار). }
        إذا (مضيف != عدم) { حرر_نص(مضيف). }
        م = م + ١.
    }
    حرر_وسائط(أسطر).
    إذا (أفضل == عدم) { إرجع كود_تكوين_نجاح. }
    صحيح كود = اعتمد_طقما(مخزن، أفضل، عدم).
    حرر_نص(أفضل).
    إرجع كود.
}

صحيح اختر_طقم_باء() {
    إذا (طقم_محسوب) { إرجع كود_تكوين_نجاح. }
    طقم_محسوب = صواب.
    نص قيد = احصل_تكوين_اصدار_باء().
    منطقي بقيد = قيد != عدم && طول_نص(قيد) > ٠.
    نص مخزن = ضم_وحرر_يسار_طقم(جذر_بيانات_تكوين()، "طقوم").
    إذا (مخزن != عدم && !مسار_مطلق_طقم(مخزن)) {
        اطبع_منسق("[خطأ] مخزن الطقوم يجب أن يكون مسارا مطلقا؛ اضبط TAKWEEN_DATA_HOME مطلقا: %ن\س"، مخزن).
        حرر_نص(مخزن).
        إرجع كود_تكوين_خطأ_استخدام.
    }

    نص إصدار_قفل = عدم.
    نص مضيف_قفل = عدم.
    نص تجزئة_قفل = عدم.
    صحيح حالة_قفل = ٠.
    إذا (تكوين_بيان_في1() && !تجاهل_طقم_القفل) {
        حالة_قفل = اقرأ_طقم_القفل(&إصدار_قفل، &مضيف_قفل، &تجزئة_قفل).
    }
    صحيح كود = كود_تكوين_نجاح.
    إذا (حالة_قفل < ٠) {
        اطبع "[خطأ] سطر baa في تكوين.قفل يحمل طقم باء بصيغة غير صالحة.".
        كود = كود_تكوين_خطأ_عام.
    }
    وإلا إذا (حالة_قفل == ٢) {
        منطقي مناسب = قارن_نص(مضيف_قفل، مضيف_تكوين()) == ٠ &&
                       (!بقيد || يطابق_قيد_اصدار(إصدار_قفل، قيد)).
        إذا (مناسب) { كود = اعتمد_طقما(مخزن، إصدار_قفل، تجزئة_قفل). }
        وإلا إذا (قفل_صارم_مفعل()) {
            اطبع_منسق("[خطأ] --مقفل: تكوين.قفل يثبت طقم باء %ن-%ن الذي لا يطابق هذا المضيف أو قيد إصدار_باء.\س"،
                      إصدار_قفل، مضيف_قفل).
            كود = كود_تكوين_خطأ_عام.
        }
        وإلا { كود = اختر_أعلى_طقم(مخزن، قيد). }
    }
    وإلا إذا (حالة_قفل == ١ && قفل_صارم_مفعل()) {
        // القفل بني بمصرّف PATH؛ --مقفل يلتزم به.
    }
    وإلا { كود = اختر_أعلى_طقم(مخزن، قيد). }

    إذا (إصدار_قفل != عدم) { حرر_نص(إصدار_قفل). }
    إذا (مضيف_قفل != عدم) { حرر_نص(مضيف_قفل). }
    إذا (تجزئة_قفل != عدم) { حرر_نص(تجزئة_قفل). }
    إذا (مخزن != عدم) { حرر_نص(مخزن). }
    إرجع كود.
}

// هوية الطقم المختار كجسون مضغوط لسطر baa في القفل، أو عدم دون طقم.
نص طقم_القفل_جسون() {
    إذا (!طقم_باء_مختار()) { إرجع عدم. }
    إرجع نسق(",\"sdk\":{\"version\":\"%ن\",\"host\":\"%ن\",\"archive_sha256\":\"%ن\"}"،
              إصدار_طقم_مختار، مضيف_تكوين()، تجزئة_طقم_مختار).
}

// حقل sdk الاختياري في takween-build-plan-v1، أو عدم دون طقم.
نص طقم_الخطة_جسون() {
    إذا (!طقم_باء_مختار()) { إرجع عدم. }
    نص جذر = هرب_جسون_خطة(جذر_طقم_مختار).
    إذا (جذر == عدم) { إرجع عدم. }
    نص ناتج = نسق(",\"sdk\":{\"version\":\"%ن\",\"host\":\"%ن\",\"archive_sha256\":\"%ن\",\"root\":\"%ن\"}"،
                   إصدار_طقم_مختار، مضيف_تكوين()، تجزئة_طقم_مختار، جذر).
    حرر_نص(جذر).
    إرجع ناتج.
}

// تكوين طقم مختار: الطقم الذي سيبني به المشروع في المجلد الحالي.
صحيح اعرض_طقما_مختارا() {
    صحيح تحليل = تحليل_ملف_تكوين("مشروع.تكوين").
    إذا (تحليل != ٠) { إرجع تحليل. }
    صحيح كود = اختر_طقم_باء().
    إذا (كود != ٠) { إرجع كود. }
    إذا (طقم_باء_مختار()) {
        اطبع_منسق("%ن\ت%ن\ت%ن\س"، إصدار_طقم_مختار، مضيف_تكوين()، جذر_طقم_مختار).
    }
    وإلا {
        اطبع "لا طقم باء مثبت يطابق المشروع؛ يُستعمل baa من PATH.".
    }
    إرجع كود_تكوين_نجاح.
}
