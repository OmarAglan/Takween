#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
منطقي يحتوي_على_تنفيذ(نص النص، نص الجزء).
نص الصق_وحرر_يسار(نص يسار، نص يمين).

نص لاحقة_هدف = "".
منطقي لاحقة_مملوكة = خطأ.
نص هدف_مكتشف = "".
منطقي هدف_ملك = خطأ.
نص اصدار_باء_مكتشف = "".
منطقي اصدار_باء_ملك = خطأ.
منطقي قدرة_تجميع = خطأ.
منطقي قدرة_كائن = خطأ.
منطقي قدرة_ربط = خطأ.
منطقي قدرة_مكتبة_سي = خطأ.
منطقي قدرة_مكتبة_باء = خطأ.
منطقي قدرة_موضع_مستقل = خطأ.
منطقي قدرة_تنفيذي = خطأ.
منطقي قدرة_حماية = خطأ.
منطقي قدرة_نظم_ضمني = خطأ.

نص لاحقة_تنفيذ_الهدف() {
    إرجع لاحقة_هدف.
}

نص هدف_باء_فعلي() {
    إرجع هدف_مكتشف.
}

نص اصدار_باء_فعلي() {
    إرجع اصدار_باء_مكتشف.
}

منطقي قدرة_هدف_متاحة(نص اسم) {
    إذا (قارن_نص(اسم، "تجميع") == ٠) { إرجع قدرة_تجميع. }
    إذا (قارن_نص(اسم، "كائن") == ٠) { إرجع قدرة_كائن. }
    إذا (قارن_نص(اسم، "ربط") == ٠) { إرجع قدرة_ربط. }
    إذا (قارن_نص(اسم، "مكتبة_سي") == ٠) { إرجع قدرة_مكتبة_سي. }
    إذا (قارن_نص(اسم، "مكتبة_باء") == ٠) { إرجع قدرة_مكتبة_باء. }
    إذا (قارن_نص(اسم، "موضع_مستقل") == ٠) { إرجع قدرة_موضع_مستقل. }
    إذا (قارن_نص(اسم، "تنفيذي_مستقل") == ٠) { إرجع قدرة_تنفيذي. }
    إذا (قارن_نص(اسم، "حماية_المكدس") == ٠) { إرجع قدرة_حماية. }
    إذا (قارن_نص(اسم، "نظم_ضمني") == ٠) { إرجع قدرة_نظم_ضمني. }
    إرجع خطأ.
}

منطقي تحقق_قيود_باء_والهدف() {
    نص قيد = احصل_تكوين_اصدار_باء().
    إذا (قيد != عدم && طول_نص(قيد) > ٠) {
        إذا (!اصدار_دلالي_صالح(اصدار_باء_مكتشف) ||
            !يطابق_قيد_اصدار(اصدار_باء_مكتشف، قيد)) {
            اطبع_منسق("[خطأ] إصدار Baa %ن لا يطابق القيد المطلوب %ن.\س"،
                      اصدار_باء_مكتشف، قيد).
            إرجع خطأ.
        }
    }

    نص هدف_مطلوب = احصل_تكوين_هدف_باء().
    إذا (هدف_مطلوب != عدم && طول_نص(هدف_مطلوب) > ٠ &&
        قارن_نص(هدف_مطلوب، هدف_مكتشف) != ٠) {
        اطبع_منسق("[خطأ] الهدف الفعلي %ن لا يطابق هدف البيان %ن.\س"،
                  هدف_مكتشف، هدف_مطلوب).
        إرجع خطأ.
    }

    نص قدرات = احصل_تكوين_قدرات_الهدف().
    إذا (قدرات == عدم || طول_نص(قدرات) == ٠) { إرجع صواب. }
    صحيح بداية = ٠.
    صحيح م = ٠.
    طالما (م <= طول_نص(قدرات)) {
        إذا (م == طول_نص(قدرات) || قدرات[م] == '\س') {
            نص قدرة = نسخ_مقطع(قدرات، بداية، م).
            منطقي متاحة = قدرة != عدم && طول_نص(قدرة) > ٠ && قدرة_هدف_متاحة(قدرة).
            إذا (!متاحة) {
                اطبع_منسق("[خطأ] قدرة الهدف المطلوبة غير متاحة أو غير معروفة: %ن\س"، قدرة).
                إذا (قدرة != عدم) { حرر_نص(قدرة). }
                إرجع خطأ.
            }
            حرر_نص(قدرة).
            بداية = م + ١.
        }
        م = م + ١.
    }
    إرجع صواب.
}

منطقي تحقق_قدرات_بناء_الهدف() {
    إذا (قدرة_كائن && قدرة_ربط && قدرة_مكتبة_باء) { إرجع صواب. }
    اطبع "[خطأ] الهدف المختار لا يحقق قدرات البناء المطلوبة: كائن وربط ومكتبة_باء.".
    إرجع خطأ.
}

صحيح صنف_فشل_اكتشاف_الهدف(صحيح كود، نص هدف_مطلوب) {
    إذا (كود == كود_تكوين_خطأ_استخدام && هدف_مطلوب != عدم && طول_نص(هدف_مطلوب) > ٠) {
        إرجع كود_تكوين_غير_مدعوم.
    }
    إذا (كود > ٠) { إرجع كود. }
    إرجع كود_تكوين_فشل_أداة.
}

صحيح شغل_اكتشاف(متجه وسائط، نص مسار_الخرج، نص مسار_الخطأ) {
    إذا (وسائط == عدم || طول_متجه(وسائط) == ٠) { إرجع كود_تكوين_خطأ_داخلي. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    مقبض_عملية عملية = ابدأ_عملية(بيانات، طول_متجه(وسائط)، عدم، عدم، ٠،
                                  مسار_الخرج، مسار_الخطأ).
    إذا (عملية == عدم) { إرجع كود_تكوين_فشل_أداة. }
    صحيح كود = انتظر_عملية(عملية).
    حرر_عملية(عملية).
    إذا (كود < ٠) { إرجع كود_تكوين_فشل_أداة. }
    إرجع كود.
}

نص قيمة_JSON_نصية(نص سطر) {
    إذا (سطر == عدم) { إرجع عدم. }
    صحيح طول = طول_نص(سطر).
    صحيح موضع = ٠.
    طالما (موضع < طول && سطر[موضع] != ':') { موضع = موضع + ١. }
    إذا (موضع >= طول) { إرجع عدم. }
    موضع = موضع + ١.
    طالما (موضع < طول && سطر[موضع] != '"') { موضع = موضع + ١. }
    إذا (موضع >= طول) { إرجع عدم. }
    موضع = موضع + ١.

    نص ناتج = نسخ_نص("").
    طالما (موضع < طول && سطر[موضع] != '"') {
        نص كنص = نسق("%ح"، سطر[موضع]).
        ناتج = الصق_وحرر_يسار(ناتج، كنص).
        حرر_نص(كنص).
        موضع = موضع + ١.
    }
    إذا (موضع >= طول) { حرر_نص(ناتج). إرجع عدم. }
    إرجع ناتج.
}

منطقي حلل_وثيقة_الهدف(نص مسار) {
    عدم* ملف = فتح_ملف(مسار، "قراءة").
    إذا (ملف == عدم) { إرجع خطأ. }
    منطقي مخطط_صحيح = خطأ.
    منطقي داخل_الهدف = خطأ.
    منطقي لاحقة_موجودة = خطأ.
    منطقي صيغة_موجودة = خطأ.
    نص هدف_مختار = عدم.
    طالما (!نهاية_ملف(ملف)) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        إذا (يحتوي_على_تنفيذ(سطر، "\"schema_version\": \"target-info-v1\"")) {
            مخطط_صحيح = صواب.
        }
        وإلا إذا (يحتوي_على_تنفيذ(سطر، "\"selected_target\":")) {
            إذا (هدف_مختار != عدم) { حرر_نص(هدف_مختار). }
            هدف_مختار = قيمة_JSON_نصية(سطر).
        }
        وإلا إذا (يحتوي_على_تنفيذ(سطر، "\"name\":")) {
            نص اسم = قيمة_JSON_نصية(سطر).
            داخل_الهدف = اسم != عدم && هدف_مختار != عدم && قارن_نص(اسم، هدف_مختار) == ٠.
            إذا (اسم != عدم) { حرر_نص(اسم). }
        }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"object_format\":")) {
            نص صيغة = قيمة_JSON_نصية(سطر).
            صيغة_موجودة = صيغة != عدم &&
                (قارن_نص(صيغة، "coff") == ٠ || قارن_نص(صيغة، "elf") == ٠).
            إذا (صيغة != عدم) { حرر_نص(صيغة). }
        }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"executable_suffix\":")) {
            لاحقة_هدف = قيمة_JSON_نصية(سطر).
            لاحقة_مملوكة = لاحقة_هدف != عدم.
            لاحقة_موجودة = لاحقة_مملوكة.
        }
        حرر_نص(سطر).
    }
    اغلق_ملف(ملف).

    منطقي صالح = مخطط_صحيح && هدف_مختار != عدم && لاحقة_موجودة && صيغة_موجودة.
    إذا (صالح) {
        هدف_مكتشف = هدف_مختار.
        هدف_ملك = صواب.
        هدف_مختار = عدم.
    }
    إذا (هدف_مختار != عدم) { حرر_نص(هدف_مختار). }
    إرجع صالح.
}

منطقي حلل_قدرات_الهدف(نص مسار) {
    عدم* ملف = فتح_ملف(مسار، "قراءة").
    إذا (ملف == عدم) { إرجع خطأ. }
    منطقي داخل_الهدف = خطأ.
    طالما (!نهاية_ملف(ملف)) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        إذا (يحتوي_على_تنفيذ(سطر، "\"compiler_version\":")) {
            اصدار_باء_مكتشف = قيمة_JSON_نصية(سطر).
            اصدار_باء_ملك = اصدار_باء_مكتشف != عدم.
        }
        وإلا إذا (يحتوي_على_تنفيذ(سطر، "\"name\":")) {
            نص اسم = قيمة_JSON_نصية(سطر).
            داخل_الهدف = اسم != عدم && هدف_مكتشف != عدم && قارن_نص(اسم، هدف_مكتشف) == ٠.
            إذا (اسم != عدم) { حرر_نص(اسم). }
        }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"assembly\": true")) { قدرة_تجميع = صواب. }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"object\": true")) { قدرة_كائن = صواب. }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"link\": true")) { قدرة_ربط = صواب. }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"libc\": true")) { قدرة_مكتبة_سي = صواب. }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"stdlib\": true")) { قدرة_مكتبة_باء = صواب. }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"pic\": true")) { قدرة_موضع_مستقل = صواب. }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"pie\": true")) { قدرة_تنفيذي = صواب. }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"stack_protector\": true")) { قدرة_حماية = صواب. }
        وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"inline_asm\": true")) { قدرة_نظم_ضمني = صواب. }
        حرر_نص(سطر).
    }
    اغلق_ملف(ملف).
    إرجع اصدار_باء_ملك && اصدار_دلالي_صالح(اصدار_باء_مكتشف).
}

صحيح اكتشف_معلومات_الهدف() {
    إذا (لاحقة_مملوكة) {
        حرر_نص(لاحقة_هدف).
        لاحقة_هدف = "".
        لاحقة_مملوكة = خطأ.
    }
    إذا (هدف_ملك) {
        حرر_نص(هدف_مكتشف).
        هدف_مكتشف = "".
        هدف_ملك = خطأ.
    }
    إذا (اصدار_باء_ملك) {
        حرر_نص(اصدار_باء_مكتشف).
        اصدار_باء_مكتشف = "".
        اصدار_باء_ملك = خطأ.
    }
    قدرة_تجميع = خطأ. قدرة_كائن = خطأ. قدرة_ربط = خطأ.
    قدرة_مكتبة_سي = خطأ. قدرة_مكتبة_باء = خطأ.
    قدرة_موضع_مستقل = خطأ. قدرة_تنفيذي = خطأ.
    قدرة_حماية = خطأ. قدرة_نظم_ضمني = خطأ.

    نص مسار_الكاش = ضم_مسار(احصل_تكوين_المخرج()، ".takween-cache").
    نص مسار_الخرج = ضم_مسار(مسار_الكاش، "target-info.json").
    نص مسار_الخطأ = ضم_مسار(مسار_الكاش، "target-info.stderr").
    إذا (مسار_الكاش == عدم || مسار_الخرج == عدم || مسار_الخطأ == عدم) {
        إذا (مسار_الكاش != عدم) { حرر_نص(مسار_الكاش). }
        إذا (مسار_الخرج != عدم) { حرر_نص(مسار_الخرج). }
        إذا (مسار_الخطأ != عدم) { حرر_نص(مسار_الخطأ). }
        إرجع كود_تكوين_خطأ_داخلي.
    }
    إذا (انشئ_مجلدات(مسار_الكاش) != ٠) {
        حرر_نص(مسار_الكاش). حرر_نص(مسار_الخرج). حرر_نص(مسار_الخطأ).
        إرجع كود_تكوين_فشل_أداة.
    }

    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي فشل = وسائط == عدم || !اضف_وسيط(وسائط، "baa").
    نص هدف_مطلوب = احصل_تكوين_هدف_باء().
    إذا (!فشل && هدف_مطلوب != عدم && طول_نص(هدف_مطلوب) > ٠) {
        فشل = !اضف_وسيط_مملوك(وسائط، دمج_نص("--target="، هدف_مطلوب)).
    }
    إذا (!فشل) { فشل = !اضف_وسيط(وسائط، "--target-info=json"). }
    صحيح كود = كود_تكوين_خطأ_داخلي.
    إذا (!فشل) { كود = شغل_اكتشاف(وسائط، مسار_الخرج، مسار_الخطأ). }
    حرر_وسائط(وسائط).
    إذا (فشل || كود != ٠) {
        اطبع_منسق("[خطأ] فشل اكتشاف هدف Baa. كود الخروج: %ص\س"، كود).
        حرر_نص(مسار_الكاش). حرر_نص(مسار_الخرج). حرر_نص(مسار_الخطأ).
        إرجع صنف_فشل_اكتشاف_الهدف(كود، هدف_مطلوب).
    }

    منطقي صالح = حلل_وثيقة_الهدف(مسار_الخرج).
    إذا (صالح) { صالح = حلل_قدرات_الهدف(مسار_الخرج). }
    حرر_نص(مسار_الكاش). حرر_نص(مسار_الخرج). حرر_نص(مسار_الخطأ).
    إذا (!صالح) {
        إذا (لاحقة_مملوكة) { حرر_نص(لاحقة_هدف). }
        لاحقة_هدف = "".
        لاحقة_مملوكة = خطأ.
        اطبع "[خطأ] عقد target-info-v1 ناقص أو لا يصف الهدف المختار وصفا صالحا.".
        إرجع كود_تكوين_غير_مدعوم.
    }
    إرجع كود_تكوين_نجاح.
}
