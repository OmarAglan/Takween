#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
منطقي يحتوي_على_تنفيذ(نص النص، نص الجزء).
نص الصق_وحرر_يسار(نص يسار، نص يمين).

نص لاحقة_هدف = "".
منطقي لاحقة_مملوكة = خطأ.

نص لاحقة_تنفيذ_الهدف() {
    إرجع لاحقة_هدف.
}

صحيح شغل_اكتشاف(متجه وسائط، نص مسار_الخرج، نص مسار_الخطأ) {
    إذا (وسائط == عدم || طول_متجه(وسائط) == ٠) { إرجع -١. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(وسائط)).
    مقبض_عملية عملية = ابدأ_عملية(بيانات، طول_متجه(وسائط)، عدم، عدم، ٠،
                                  مسار_الخرج، مسار_الخطأ).
    إذا (عملية == عدم) { إرجع -١. }
    صحيح كود = انتظر_عملية(عملية).
    حرر_عملية(عملية).
    إرجع كود.
}

نص قيمة_JSON_نصية(نص سطر) {
    إذا (سطر == عدم) { إرجع عدم. }
    صحيح طول = طول_نص(سطر).
    صحيح موضع = ٠.
    طالما (موضع < طول && سطر[موضع] != ':') { موضع = موضع + ١. }
    إذا (موضع >= طول) { إرجع عدم. }
    موضع = موضع + ١.
    طالما (موضع < طول && سطر[موضع] != '"') { موضع = موضع + ١. }
    إذا (موضع >= طول) { إرجع عدم. }
    موضع = موضع + ١.

    نص ناتج = نسخ_نص("").
    طالما (موضع < طول && سطر[موضع] != '"') {
        نص كنص = نسق("%ح"، سطر[موضع]).
        ناتج = الصق_وحرر_يسار(ناتج، كنص).
        حرر_نص(كنص).
        موضع = موضع + ١.
    }
    إذا (موضع >= طول) { حرر_نص(ناتج). إرجع عدم. }
    إرجع ناتج.
}

صحيح اكتشف_معلومات_الهدف() {
    إذا (لاحقة_مملوكة) {
        حرر_نص(لاحقة_هدف).
        لاحقة_هدف = "".
        لاحقة_مملوكة = خطأ.
    }

    نص مسار_الكاش = ضم_مسار(احصل_تكوين_المخرج()، ".takween-cache").
    نص مسار_الخرج = ضم_مسار(مسار_الكاش، "target-info.json").
    نص مسار_الخطأ = ضم_مسار(مسار_الكاش، "target-info.stderr").
    إذا (مسار_الكاش == عدم || مسار_الخرج == عدم || مسار_الخطأ == عدم) {
        إذا (مسار_الكاش != عدم) { حرر_نص(مسار_الكاش). }
        إذا (مسار_الخرج != عدم) { حرر_نص(مسار_الخرج). }
        إذا (مسار_الخطأ != عدم) { حرر_نص(مسار_الخطأ). }
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (انشئ_مجلدات(مسار_الكاش) != ٠) {
        حرر_نص(مسار_الكاش). حرر_نص(مسار_الخرج). حرر_نص(مسار_الخطأ).
        إرجع كود_تكوين_خطأ_عام.
    }

    متجه وسائط = أنشئ_متجه(حجم(نص)).
    منطقي فشل = وسائط == عدم || !اضف_وسيط(وسائط، "baa").
    نص هدف_مطلوب = احصل_تكوين_هدف_باء().
    إذا (!فشل && هدف_مطلوب != عدم && طول_نص(هدف_مطلوب) > ٠) {
        فشل = !اضف_وسيط_مملوك(وسائط، دمج_نص("--target="، هدف_مطلوب)).
    }
    إذا (!فشل) { فشل = !اضف_وسيط(وسائط، "--target-info=json"). }
    صحيح كود = كود_تكوين_خطأ_عام.
    إذا (!فشل) { كود = شغل_اكتشاف(وسائط، مسار_الخرج، مسار_الخطأ). }
    حرر_وسائط(وسائط).
    إذا (فشل || كود != ٠) {
        اطبع_منسق("[خطأ] فشل اكتشاف هدف Baa. كود الخروج: %ص\س"، كود).
        حرر_نص(مسار_الكاش). حرر_نص(مسار_الخرج). حرر_نص(مسار_الخطأ).
        إذا (كود > ٠) { إرجع كود. }
        إرجع كود_تكوين_خطأ_عام.
    }

    عدم* ملف = فتح_ملف(مسار_الخرج، "قراءة").
    منطقي مخطط_صحيح = خطأ.
    منطقي داخل_الهدف = خطأ.
    منطقي لاحقة_موجودة = خطأ.
    منطقي صيغة_موجودة = خطأ.
    منطقي ربط_مدعوم = خطأ.
    نص هدف_مختار = عدم.
    إذا (ملف != عدم) {
        طالما (!نهاية_ملف(ملف)) {
            نص سطر = اقرأ_سطر(ملف).
            إذا (سطر == عدم) { توقف. }
            إذا (يحتوي_على_تنفيذ(سطر، "\"schema_version\": \"target-info-v1\"")) {
                مخطط_صحيح = صواب.
            }
            وإلا إذا (يحتوي_على_تنفيذ(سطر، "\"selected_target\":")) {
                إذا (هدف_مختار != عدم) { حرر_نص(هدف_مختار). }
                هدف_مختار = قيمة_JSON_نصية(سطر).
            }
            وإلا إذا (يحتوي_على_تنفيذ(سطر، "\"name\":")) {
                نص اسم = قيمة_JSON_نصية(سطر).
                داخل_الهدف = اسم != عدم && هدف_مختار != عدم && قارن_نص(اسم، هدف_مختار) == ٠.
                إذا (اسم != عدم) { حرر_نص(اسم). }
            }
            وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"object_format\":")) {
                نص صيغة = قيمة_JSON_نصية(سطر).
                صيغة_موجودة = صيغة != عدم &&
                    (قارن_نص(صيغة، "coff") == ٠ || قارن_نص(صيغة، "elf") == ٠).
                إذا (صيغة != عدم) { حرر_نص(صيغة). }
            }
            وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"executable_suffix\":")) {
                لاحقة_هدف = قيمة_JSON_نصية(سطر).
                لاحقة_مملوكة = لاحقة_هدف != عدم.
                لاحقة_موجودة = لاحقة_مملوكة.
            }
            وإلا إذا (داخل_الهدف && يحتوي_على_تنفيذ(سطر، "\"link\": true")) {
                ربط_مدعوم = صواب.
            }
            حرر_نص(سطر).
        }
        اغلق_ملف(ملف).
    }

    منطقي صالح = مخطط_صحيح && هدف_مختار != عدم && لاحقة_موجودة &&
                  صيغة_موجودة && ربط_مدعوم.
    إذا (هدف_مختار != عدم) { حرر_نص(هدف_مختار). }
    حرر_نص(مسار_الكاش). حرر_نص(مسار_الخرج). حرر_نص(مسار_الخطأ).
    إذا (!صالح) {
        إذا (لاحقة_مملوكة) { حرر_نص(لاحقة_هدف). }
        لاحقة_هدف = "".
        لاحقة_مملوكة = خطأ.
        اطبع "[خطأ] عقد target-info-v1 ناقص أو أن الهدف المختار لا يدعم الربط على هذا المضيف.".
        إرجع كود_تكوين_غير_مدعوم.
    }
    إرجع كود_تكوين_نجاح.
}
