#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

عدم حدد_هدف_تكوين(نص اسم).
صحيح تنفيذ_اختبار(نص اسم).
صحيح تنفيذ_حالة_الأهداف().

منطقي يساوي_أمر(نص قيمة، نص عربي، نص انجليزي) {
    إرجع قارن_نص(قيمة، عربي) == ٠ || قارن_نص(قيمة، انجليزي) == ٠.
}

عدم اطبع_المساعدة() {
    اطبع "تكوين (Takween) MVP CLI".
    اطبع "الاستخدام:".
    اطبع "  تكوين تهيئة    | تكوين init".
    اطبع "  تكوين بناء     | تكوين build".
    اطبع "  تكوين فحص      | تكوين check".
    اطبع "  تكوين اختبار   | تكوين test [اسم_هدف]".
    اطبع "  تكوين أهداف    | تكوين targets --json".
    اطبع "  تكوين تشغيل    | تكوين run".
    اطبع "  تكوين تنظيف    | تكوين clean".
    اطبع "  تكوين --إصدار  | تكوين --version".
    اطبع "  (alias) takween ...".
}

صحيح الرئيسية(صحيح عدد، نص[] معاملات) {
    إذا (عدد < ٢) {
        اطبع_المساعدة().
        إرجع كود_تكوين_خطأ_استخدام.
    }

    نص أمر = معاملات[١].

    إذا (قارن_نص(أمر، "--help") == ٠ || قارن_نص(أمر، "-h") == ٠) {
        اطبع_المساعدة().
        إرجع كود_تكوين_نجاح.
    }

    إذا (قارن_نص(أمر، "--إصدار") == ٠ || قارن_نص(أمر، "--version") == ٠ || قارن_نص(أمر، "-V") == ٠) {
        اطبع "تكوين 0.1.0".
        إرجع كود_تكوين_نجاح.
    }

    إذا (يساوي_أمر(أمر، "تهيئة"، "init")) {
        إرجع تنفيذ_تهيئة().
    }

    إذا (يساوي_أمر(أمر، "بناء"، "build")) {
        إذا (عدد > ٣) { اطبع "[خطأ] build يقبل اسم هدف واحدا فقط.". إرجع كود_تكوين_خطأ_استخدام. }
        إذا (عدد == ٣) { حدد_هدف_تكوين(معاملات[٢]). }
        إرجع تنفيذ_بناء().
    }

    إذا (يساوي_أمر(أمر، "فحص"، "check")) {
        إذا (عدد > ٣) { اطبع "[خطأ] check يقبل اسم هدف واحدا فقط.". إرجع كود_تكوين_خطأ_استخدام. }
        إذا (عدد == ٣) { حدد_هدف_تكوين(معاملات[٢]). }
        إرجع تنفيذ_فحص().
    }

    إذا (يساوي_أمر(أمر، "تشغيل"، "run")) {
        إذا (عدد > ٣) { اطبع "[خطأ] run يقبل اسم هدف واحدا فقط.". إرجع كود_تكوين_خطأ_استخدام. }
        إذا (عدد == ٣) { حدد_هدف_تكوين(معاملات[٢]). }
        إرجع تنفيذ_تشغيل().
    }

    إذا (يساوي_أمر(أمر، "اختبار"، "test")) {
        إذا (عدد > ٣) { اطبع "[خطأ] test يقبل اسم هدف واحدا فقط.". إرجع كود_تكوين_خطأ_استخدام. }
        نص اسم = عدم.
        إذا (عدد == ٣) { اسم = معاملات[٢]. }
        إرجع تنفيذ_اختبار(اسم).
    }

    إذا (يساوي_أمر(أمر، "أهداف"، "targets")) {
        إذا (عدد == ٣ && قارن_نص(معاملات[٢]، "--json") != ٠) {
            اطبع "[خطأ] targets يدعم --json فقط.".
            إرجع كود_تكوين_خطأ_استخدام.
        }
        إذا (عدد > ٣) { إرجع كود_تكوين_خطأ_استخدام. }
        إرجع تنفيذ_حالة_الأهداف().
    }

    إذا (يساوي_أمر(أمر، "تنظيف"، "clean")) {
        إرجع تنفيذ_تنظيف().
    }

    اطبع_منسق("[خطأ] أمر غير معروف: %ن\س"، أمر).
    اطبع_المساعدة().
    إرجع كود_تكوين_خطأ_استخدام.
}


