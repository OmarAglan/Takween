#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

عدم حدد_هدف_تكوين(نص اسم).
صحيح تنفيذ_اختبار(نص اسم).
صحيح تنفيذ_حالة_الأهداف().

منطقي يساوي_أمر(نص قيمة، نص عربي، نص انجليزي) {
    إرجع قارن_نص(قيمة، عربي) == ٠ || قارن_نص(قيمة، انجليزي) == ٠.
}

عدم اطبع_المساعدة() {
    اطبع "تكوين (Takween) MVP CLI".
    اطبع "الاستخدام:".
    اطبع "  تكوين تهيئة    | تكوين init".
    اطبع "  تكوين بناء [هدف] [--نمط اسم] | تكوين build [target] [--profile name]".
    اطبع "  تكوين خطة --جسون [هدف] [--نمط اسم] | تكوين plan --json [target] [--profile name]".
    اطبع "  تكوين فحص [هدف] [--نمط اسم] | تكوين check [target] [--profile name]".
    اطبع "  تكوين اختبار [هدف] [--نمط اسم] | تكوين test [target] [--profile name]".
    اطبع "  تكوين أهداف --جسون | تكوين targets --json".
    اطبع "  تكوين مساحة --جسون | تكوين workspace --json".
    اطبع "  تكوين بناء|اختبار --حزمة اسم | --كل_الحزم".
    اطبع "  تكوين تشغيل [هدف] [--نمط اسم] | تكوين run [target] [--profile name]".
    اطبع "  تكوين تنظيف    | تكوين clean".
    اطبع "  تكوين تحقق --بدون_شبكة | تكوين verify --offline".
    اطبع "  تكوين توريد    | تكوين vendor".
    اطبع "  تكوين --إصدار  | تكوين --version".
    اطبع "  أضف --مقفل/--locked إلى build/check/run/test للتحقق من تكوين.قفل دون تغييره.".
    اطبع "  (alias) takween ...".
}

نص هدف_طرفية = "".
نص حزمة_طرفية = "".
نص نمط_طرفية = "".
منطقي حزم_طرفية = خطأ.
منطقي قفل_طرفية = خطأ.

منطقي وسيط_مقفل(نص قيمة) {
    إرجع قارن_نص(قيمة، "--مقفل") == ٠ || قارن_نص(قيمة، "--locked") == ٠.
}

منطقي وسيط_جسون(نص قيمة) {
    إرجع قارن_نص(قيمة، "--جسون") == ٠ || قارن_نص(قيمة، "--json") == ٠.
}

منطقي وسيط_نمط(نص قيمة) {
    إرجع قارن_نص(قيمة، "--نمط") == ٠ || قارن_نص(قيمة، "--profile") == ٠.
}

منطقي وسيط_حزمة(نص قيمة) {
    إرجع قارن_نص(قيمة، "--حزمة") == ٠ || قارن_نص(قيمة، "--package") == ٠.
}

منطقي وسيط_كل_الحزم(نص قيمة) {
    إرجع قارن_نص(قيمة، "--كل_الحزم") == ٠ ||
           قارن_نص(قيمة، "--all-packages") == ٠.
}

منطقي طلب_مساحة_طرفية() {
    إرجع طول_نص(حزمة_طرفية) > ٠ || حزم_طرفية.
}

صحيح طبق_خيارات_هدف(صحيح عدد، نص[] معاملات) {
    نص اسم = عدم.
    نص نمط = عدم.
    نص حزمة = عدم.
    منطقي كل_الحزم = خطأ.
    منطقي مقفل = خطأ.
    صحيح م = ٢.
    طالما (م < عدد) {
        إذا (وسيط_مقفل(معاملات[م])) {
            إذا (مقفل) { اطبع "[خطأ] خيار --مقفل مكرر.". إرجع كود_تكوين_خطأ_استخدام. }
            مقفل = صواب.
        }
        وإلا إذا (وسيط_نمط(معاملات[م])) {
            إذا (نمط != عدم || م + ١ >= عدد) {
                اطبع "[خطأ] استخدم --نمط مرة واحدة مع اسم عربي.".
                إرجع كود_تكوين_خطأ_استخدام.
            }
            إذا (!هوية_حزمة_عربية(معاملات[م + ١])) {
                اطبع "[خطأ] استخدم --نمط مرة واحدة مع اسم عربي.".
                إرجع كود_تكوين_خطأ_استخدام.
            }
            م = م + ١.
            نمط = معاملات[م].
        }
        وإلا إذا (وسيط_حزمة(معاملات[م])) {
            إذا (حزمة != عدم || م + ١ >= عدد ||
                !هوية_حزمة_عربية(معاملات[م + ١])) {
                اطبع "[خطأ] استخدم --حزمة مرة واحدة مع اسم حزمة عربي.".
                إرجع كود_تكوين_خطأ_استخدام.
            }
            م = م + ١.
            حزمة = معاملات[م].
        }
        وإلا إذا (وسيط_كل_الحزم(معاملات[م])) {
            إذا (كل_الحزم) {
                اطبع "[خطأ] خيار --كل_الحزم مكرر.".
                إرجع كود_تكوين_خطأ_استخدام.
            }
            كل_الحزم = صواب.
        }
        وإلا {
            إذا (اسم != عدم) { اطبع "[خطأ] يقبل الأمر اسم هدف واحدا فقط.". إرجع كود_تكوين_خطأ_استخدام. }
            اسم = معاملات[م].
        }
        م = م + ١.
    }
    إذا ((حزمة != عدم && كل_الحزم) ||
        ((حزمة != عدم || كل_الحزم) && اسم != عدم)) {
        اطبع "[خطأ] اختيار الحزمة/كل الحزم لا يختلط مع اسم هدف.".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    حدد_وضع_مقفل(مقفل).
    إذا (نمط != عدم) { حدد_نمط_تكوين(نمط). }
    هدف_طرفية = اسم.
    حزمة_طرفية = "".
    إذا (حزمة != عدم) { حزمة_طرفية = حزمة. }
    نمط_طرفية = "".
    إذا (نمط != عدم) { نمط_طرفية = نمط. }
    حزم_طرفية = كل_الحزم.
    قفل_طرفية = مقفل.
    إذا (اسم != عدم) { حدد_هدف_تكوين(اسم). }
    إرجع كود_تكوين_نجاح.
}

صحيح طبق_خيارات_خطة(صحيح عدد، نص[] معاملات) {
    نص اسم = عدم.
    نص نمط = عدم.
    منطقي مقفل = خطأ.
    منطقي جسون = خطأ.
    صحيح م = ٢.
    طالما (م < عدد) {
        إذا (وسيط_مقفل(معاملات[م])) {
            إذا (مقفل) { اطبع "[خطأ] خيار --مقفل مكرر.". إرجع كود_تكوين_خطأ_استخدام. }
            مقفل = صواب.
        }
        وإلا إذا (وسيط_جسون(معاملات[م])) {
            إذا (جسون) { اطبع "[خطأ] خيار --جسون مكرر.". إرجع كود_تكوين_خطأ_استخدام. }
            جسون = صواب.
        }
        وإلا إذا (وسيط_نمط(معاملات[م])) {
            إذا (نمط != عدم || م + ١ >= عدد) {
                اطبع "[خطأ] استخدم --نمط مرة واحدة مع اسم عربي.".
                إرجع كود_تكوين_خطأ_استخدام.
            }
            إذا (!هوية_حزمة_عربية(معاملات[م + ١])) {
                اطبع "[خطأ] استخدم --نمط مرة واحدة مع اسم عربي.".
                إرجع كود_تكوين_خطأ_استخدام.
            }
            م = م + ١.
            نمط = معاملات[م].
        }
        وإلا {
            إذا (اسم != عدم) { اطبع "[خطأ] يقبل أمر خطة اسم هدف واحدا فقط.". إرجع كود_تكوين_خطأ_استخدام. }
            اسم = معاملات[م].
        }
        م = م + ١.
    }
    إذا (!جسون) {
        اطبع "[خطأ] استخدم: تكوين خطة --جسون [اسم_هدف]".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    حدد_وضع_مقفل(مقفل).
    إذا (نمط != عدم) { حدد_نمط_تكوين(نمط). }
    هدف_طرفية = اسم.
    إذا (اسم != عدم) { حدد_هدف_تكوين(اسم). }
    إرجع كود_تكوين_نجاح.
}

صحيح الرئيسية(صحيح عدد، نص[] معاملات) {
    إذا (عدد < ٢) {
        اطبع_المساعدة().
        إرجع كود_تكوين_خطأ_استخدام.
    }

    نص أمر = معاملات[١].

    إذا (قارن_نص(أمر، "--مساعدة") == ٠ || قارن_نص(أمر، "--help") == ٠ || قارن_نص(أمر، "-h") == ٠) {
        اطبع_المساعدة().
        إرجع كود_تكوين_نجاح.
    }

    إذا (قارن_نص(أمر، "--إصدار") == ٠ || قارن_نص(أمر، "--version") == ٠ || قارن_نص(أمر، "-V") == ٠) {
        اطبع "تكوين 0.1.0".
        إرجع كود_تكوين_نجاح.
    }

    إذا (يساوي_أمر(أمر، "تهيئة"، "init")) {
        إرجع تنفيذ_تهيئة().
    }

    إذا (يساوي_أمر(أمر، "بناء"، "build")) {
        صحيح خيارات = طبق_خيارات_هدف(عدد، معاملات).
        إذا (خيارات != ٠) { إرجع خيارات. }
        إذا (طلب_مساحة_طرفية()) {
            إرجع تنفيذ_عملية_مساحة("بناء"، حزمة_طرفية، حزم_طرفية،
                                    نمط_طرفية، قفل_طرفية، معاملات[٠]).
        }
        إرجع تنفيذ_بناء().
    }

    إذا (يساوي_أمر(أمر، "خطة"، "plan")) {
        صحيح خيارات = طبق_خيارات_خطة(عدد، معاملات).
        إذا (خيارات != ٠) { إرجع خيارات. }
        إرجع تنفيذ_عرض_خطة().
    }

    إذا (يساوي_أمر(أمر، "فحص"، "check")) {
        صحيح خيارات = طبق_خيارات_هدف(عدد، معاملات).
        إذا (خيارات != ٠) { إرجع خيارات. }
        إذا (طلب_مساحة_طرفية()) {
            اطبع "[خطأ] اختيار مساحة العمل مدعوم مع بناء/اختبار فقط.".
            إرجع كود_تكوين_خطأ_استخدام.
        }
        إرجع تنفيذ_فحص().
    }

    إذا (يساوي_أمر(أمر، "تشغيل"، "run")) {
        صحيح خيارات = طبق_خيارات_هدف(عدد، معاملات).
        إذا (خيارات != ٠) { إرجع خيارات. }
        إذا (طلب_مساحة_طرفية()) {
            اطبع "[خطأ] اختيار مساحة العمل مدعوم مع بناء/اختبار فقط.".
            إرجع كود_تكوين_خطأ_استخدام.
        }
        إرجع تنفيذ_تشغيل().
    }

    إذا (يساوي_أمر(أمر، "اختبار"، "test")) {
        صحيح خيارات = طبق_خيارات_هدف(عدد، معاملات).
        إذا (خيارات != ٠) { إرجع خيارات. }
        إذا (طلب_مساحة_طرفية()) {
            إرجع تنفيذ_عملية_مساحة("اختبار"، حزمة_طرفية، حزم_طرفية،
                                    نمط_طرفية، قفل_طرفية، معاملات[٠]).
        }
        إرجع تنفيذ_اختبار(هدف_طرفية).
    }

    إذا (يساوي_أمر(أمر، "أهداف"، "targets")) {
        إذا (عدد == ٣ && !وسيط_جسون(معاملات[٢])) {
            اطبع "[خطأ] أهداف يدعم --جسون فقط.".
            إرجع كود_تكوين_خطأ_استخدام.
        }
        إذا (عدد > ٣) { إرجع كود_تكوين_خطأ_استخدام. }
        إرجع تنفيذ_حالة_الأهداف().
    }

    إذا (يساوي_أمر(أمر، "مساحة"، "workspace")) {
        إذا (عدد != ٣ || !وسيط_جسون(معاملات[٢])) {
            اطبع "[خطأ] استخدم: تكوين مساحة --جسون".
            إرجع كود_تكوين_خطأ_استخدام.
        }
        إرجع تنفيذ_فهرس_مساحة_العمل().
    }

    إذا (يساوي_أمر(أمر، "تنظيف"، "clean")) {
        إرجع تنفيذ_تنظيف().
    }

    إذا (يساوي_أمر(أمر، "تحقق"، "verify")) {
        إذا (عدد != ٣ ||
            (قارن_نص(معاملات[٢]، "--بدون_شبكة") != ٠ &&
             قارن_نص(معاملات[٢]، "--offline") != ٠)) {
            اطبع "[خطأ] استخدم: تكوين تحقق --بدون_شبكة".
            إرجع كود_تكوين_خطأ_استخدام.
        }
        إرجع تنفيذ_تحقق_دون_شبكة().
    }

    إذا (يساوي_أمر(أمر، "توريد"، "vendor")) {
        إذا (عدد != ٢) { إرجع كود_تكوين_خطأ_استخدام. }
        إرجع تنفيذ_توريد().
    }

    اطبع_منسق("[خطأ] أمر غير معروف: %ن\س"، أمر).
    اطبع_المساعدة().
    إرجع كود_تكوين_خطأ_استخدام.
}
