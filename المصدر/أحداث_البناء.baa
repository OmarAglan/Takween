#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص مسار_أحداث = "".
نص عملية_أحداث = "".
منطقي يملك_مسار_أحداث = خطأ.
منطقي يملك_عملية_أحداث = خطأ.
صحيح تسلسل_أحداث = ٠.

نص هرب_نص_حدث(نص قيمة) {
    نص ناتج = نسخ_نص("").
    إذا (ناتج == عدم) { إرجع عدم. }
    إذا (قيمة == عدم) { إرجع ناتج. }

    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        حرف ح = قيمة[م].
        نص جزء = عدم.
        إذا (ح == '"') { جزء = نسخ_نص("\\\""). }
        وإلا إذا (ح == '\\') { جزء = نسخ_نص("\\\\"). }
        وإلا إذا (ح == '\س') { جزء = نسخ_نص("\\n"). }
        وإلا إذا (ح == '\ر') { جزء = نسخ_نص("\\r"). }
        وإلا إذا (ح == '\ت') { جزء = نسخ_نص("\\t"). }
        وإلا { جزء = نسق("%ح"، ح). }
        إذا (جزء == عدم) { حرر_نص(ناتج). إرجع عدم. }
        نص مدمج = دمج_نص(ناتج، جزء).
        حرر_نص(ناتج).
        حرر_نص(جزء).
        إذا (مدمج == عدم) { إرجع عدم. }
        ناتج = مدمج.
        م = م + ١.
    }
    إرجع ناتج.
}

منطقي اكتب_سطر_حدث(نص سطر) {
    إذا (!أحداث_مفعلة() || سطر == عدم) { إرجع خطأ. }
    عدم* ملف = فتح_ملف(مسار_أحداث، "ab").
    إذا (ملف == عدم) { إرجع خطأ. }
    صحيح نتيجة = اكتب_سطر(ملف، سطر).
    صحيح إغلاق = اغلق_ملف(ملف).
    إرجع نتيجة >= ٠ && إغلاق == ٠.
}

منطقي اضبط_ملف_أحداث(نص مسار) {
    إذا (مسار == عدم || طول_نص(مسار) == ٠) { إرجع خطأ. }
    عدم* ملف = فتح_ملف(مسار، "wb").
    إذا (ملف == عدم) { إرجع خطأ. }
    إذا (اغلق_ملف(ملف) != ٠) { إرجع خطأ. }

    إذا (يملك_مسار_أحداث) { حرر_نص(مسار_أحداث). }
    مسار_أحداث = نسخ_نص(مسار).
    يملك_مسار_أحداث = مسار_أحداث != عدم.
    إرجع يملك_مسار_أحداث.
}

منطقي أحداث_مفعلة() {
    إرجع يملك_مسار_أحداث.
}

عدم اصدر_حدث_بسيط(نص نوع، نص مرحلة، نص وضع، صحيح كود، منطقي له_كود) {
    تسلسل_أحداث = تسلسل_أحداث + ١.
    نص نوع_آمن = هرب_نص_حدث(نوع).
    نص عملية_آمنة = هرب_نص_حدث(عملية_أحداث).
    نص مرحلة_آمنة = هرب_نص_حدث(مرحلة).
    نص وضع_آمن = هرب_نص_حدث(وضع).
    إذا (نوع_آمن == عدم || عملية_آمنة == عدم || مرحلة_آمنة == عدم || وضع_آمن == عدم) {
        إذا (نوع_آمن != عدم) { حرر_نص(نوع_آمن). }
        إذا (عملية_آمنة != عدم) { حرر_نص(عملية_آمنة). }
        إذا (مرحلة_آمنة != عدم) { حرر_نص(مرحلة_آمنة). }
        إذا (وضع_آمن != عدم) { حرر_نص(وضع_آمن). }
        إرجع.
    }

    نص سطر = عدم.
    إذا (له_كود) {
        سطر = نسق("{\"schema_version\":\"takween-build-events-v1\",\"sequence\":%ص,\"event\":\"%ن\",\"operation\":\"%ن\",\"phase\":\"%ن\",\"status\":\"%ن\",\"exit_code\":%ص}"،
                   تسلسل_أحداث، نوع_آمن، عملية_آمنة، مرحلة_آمنة، وضع_آمن، كود).
    }
    وإلا {
        سطر = نسق("{\"schema_version\":\"takween-build-events-v1\",\"sequence\":%ص,\"event\":\"%ن\",\"operation\":\"%ن\",\"phase\":\"%ن\",\"status\":\"%ن\"}"،
                   تسلسل_أحداث، نوع_آمن، عملية_آمنة، مرحلة_آمنة، وضع_آمن).
    }
    إذا (سطر != عدم) { اكتب_سطر_حدث(سطر). حرر_نص(سطر). }
    حرر_نص(نوع_آمن).
    حرر_نص(عملية_آمنة).
    حرر_نص(مرحلة_آمنة).
    حرر_نص(وضع_آمن).
}

عدم ابدأ_أحداث_عملية(نص عملية) {
    إذا (يملك_عملية_أحداث) { حرر_نص(عملية_أحداث). }
    عملية_أحداث = نسخ_نص(عملية).
    يملك_عملية_أحداث = عملية_أحداث != عدم.
    تسلسل_أحداث = ٠.
    إذا (أحداث_مفعلة()) {
        اصدر_حدث_بسيط("operation_started"، "operation"، "started"، ٠، خطأ).
    }
}

عدم انه_أحداث_عملية(صحيح كود) {
    إذا (!أحداث_مفعلة()) { إرجع. }
    نص وضع = "failed".
    إذا (كود == ٠) { وضع = "succeeded". }
    اصدر_حدث_بسيط("operation_finished"، "operation"، وضع، كود، صواب).
}

عدم ابدأ_أحداث_مرحلة(نص مرحلة) {
    إذا (!أحداث_مفعلة()) { إرجع. }
    اصدر_حدث_بسيط("phase_started"، مرحلة، "started"، ٠، خطأ).
}

عدم انه_أحداث_مرحلة(نص مرحلة، صحيح كود) {
    إذا (!أحداث_مفعلة()) { إرجع. }
    نص وضع = "failed".
    إذا (كود == ٠) { وضع = "succeeded". }
    اصدر_حدث_بسيط("phase_finished"، مرحلة، وضع، كود، صواب).
}

عدم اصدر_حدث_هدف(نص نوع، نص اسم، صحيح كود) {
    إذا (!أحداث_مفعلة()) { إرجع. }
    تسلسل_أحداث = تسلسل_أحداث + ١.
    نص نوع_آمن = هرب_نص_حدث(نوع).
    نص عملية_آمنة = هرب_نص_حدث(عملية_أحداث).
    نص اسم_آمن = هرب_نص_حدث(اسم).
    إذا (نوع_آمن == عدم || عملية_آمنة == عدم || اسم_آمن == عدم) {
        إذا (نوع_آمن != عدم) { حرر_نص(نوع_آمن). }
        إذا (عملية_آمنة != عدم) { حرر_نص(عملية_آمنة). }
        إذا (اسم_آمن != عدم) { حرر_نص(اسم_آمن). }
        إرجع.
    }
    نص وضع = "started".
    منطقي نهاية = قارن_نص(نوع، "target_finished") == ٠.
    إذا (نهاية) {
        وضع = "failed".
        إذا (كود == ٠) { وضع = "succeeded". }
    }
    نص سطر = عدم.
    إذا (نهاية) {
        سطر = نسق("{\"schema_version\":\"takween-build-events-v1\",\"sequence\":%ص,\"event\":\"%ن\",\"operation\":\"%ن\",\"target\":\"%ن\",\"status\":\"%ن\",\"exit_code\":%ص}"،
                   تسلسل_أحداث، نوع_آمن، عملية_آمنة، اسم_آمن، وضع، كود).
    }
    وإلا {
        سطر = نسق("{\"schema_version\":\"takween-build-events-v1\",\"sequence\":%ص,\"event\":\"%ن\",\"operation\":\"%ن\",\"target\":\"%ن\",\"status\":\"started\"}"،
                   تسلسل_أحداث، نوع_آمن، عملية_آمنة، اسم_آمن).
    }
    إذا (سطر != عدم) { اكتب_سطر_حدث(سطر). حرر_نص(سطر). }
    حرر_نص(نوع_آمن).
    حرر_نص(عملية_آمنة).
    حرر_نص(اسم_آمن).
}

عدم اصدر_حدث_أثر(نص نوع_أثر، نص مسار) {
    إذا (!أحداث_مفعلة()) { إرجع. }
    تسلسل_أحداث = تسلسل_أحداث + ١.
    نص عملية_آمنة = هرب_نص_حدث(عملية_أحداث).
    نص نوع_آمن = هرب_نص_حدث(نوع_أثر).
    نص مسار_آمن = هرب_نص_حدث(مسار).
    إذا (عملية_آمنة == عدم || نوع_آمن == عدم || مسار_آمن == عدم) {
        إذا (عملية_آمنة != عدم) { حرر_نص(عملية_آمنة). }
        إذا (نوع_آمن != عدم) { حرر_نص(نوع_آمن). }
        إذا (مسار_آمن != عدم) { حرر_نص(مسار_آمن). }
        إرجع.
    }
    نص سطر = نسق("{\"schema_version\":\"takween-build-events-v1\",\"sequence\":%ص,\"event\":\"artifact\",\"operation\":\"%ن\",\"artifact\":{\"kind\":\"%ن\",\"path\":\"%ن\"}}"،
                   تسلسل_أحداث، عملية_آمنة، نوع_آمن، مسار_آمن).
    إذا (سطر != عدم) { اكتب_سطر_حدث(سطر). حرر_نص(سطر). }
    حرر_نص(عملية_آمنة).
    حرر_نص(نوع_آمن).
    حرر_نص(مسار_آمن).
}

عدم اصدر_حدث_حزمة(نص نوع، نص اسم، صحيح كود) {
    إذا (!أحداث_مفعلة()) { إرجع. }
    تسلسل_أحداث = تسلسل_أحداث + ١.
    نص نوع_آمن = هرب_نص_حدث(نوع).
    نص عملية_آمنة = هرب_نص_حدث(عملية_أحداث).
    نص اسم_آمن = هرب_نص_حدث(اسم).
    إذا (نوع_آمن == عدم || عملية_آمنة == عدم || اسم_آمن == عدم) {
        إذا (نوع_آمن != عدم) { حرر_نص(نوع_آمن). }
        إذا (عملية_آمنة != عدم) { حرر_نص(عملية_آمنة). }
        إذا (اسم_آمن != عدم) { حرر_نص(اسم_آمن). }
        إرجع.
    }
    منطقي نهاية = قارن_نص(نوع، "package_finished") == ٠.
    نص وضع = "started".
    إذا (نهاية) {
        وضع = "failed".
        إذا (كود == ٠) { وضع = "succeeded". }
    }
    نص سطر = عدم.
    إذا (نهاية) {
        سطر = نسق("{\"schema_version\":\"takween-build-events-v1\",\"sequence\":%ص,\"event\":\"%ن\",\"operation\":\"%ن\",\"package\":\"%ن\",\"status\":\"%ن\",\"exit_code\":%ص}"،
                   تسلسل_أحداث، نوع_آمن، عملية_آمنة، اسم_آمن، وضع، كود).
    }
    وإلا {
        سطر = نسق("{\"schema_version\":\"takween-build-events-v1\",\"sequence\":%ص,\"event\":\"%ن\",\"operation\":\"%ن\",\"package\":\"%ن\",\"status\":\"started\"}"،
                   تسلسل_أحداث، نوع_آمن، عملية_آمنة، اسم_آمن).
    }
    إذا (سطر != عدم) { اكتب_سطر_حدث(سطر). حرر_نص(سطر). }
    حرر_نص(نوع_آمن).
    حرر_نص(عملية_آمنة).
    حرر_نص(اسم_آمن).
}
