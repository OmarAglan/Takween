#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
منطقي اضف_وسيط(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
نص حقل_أرشيف(نص سجل، صحيح رقم).
منطقي يبدأ_ب(نص النص، نص البادئة).
منطقي ينتهي_ب(نص النص، نص اللاحقة).
منطقي هوية_حزمة_عربية(نص قيمة).

// مخزن طقوم باء (takween-sdk-store-v1). يفك تكوين أرشيف baa-sdk-v1 بنفسه
// (gzip ثم ustar) ولا يشغل شيئا من الأرشيف. يقبل الملفات التي يسردها
// BAA-SDK.json بالترتيب نفسه فقط، ويتحقق من حجم كل ملف وتجزئته، ثم ينشر الطقم
// بإعادة تسمية ذرية واحدة إلى <المخزن>/baa-sdk-<الإصدار>-<المضيف>.
// يفك المستهلك نفسه أرشيفات أدوات baa-tool-v1 لمخزن الأدوات (أدوات_البيئات.baa).

#تعريف حد_ملفات_الطقم 8192
#تعريف حد_حجم_ملف_الطقم 268435456
#تعريف حد_حجم_الطقم 1073741824
#تعريف حد_طول_مسار_الطقم 240
#تعريف حد_بيانات_الطقم 4194304
#تعريف حد_أسطر_رأس_الطقم 512
#تعريف حد_أصفار_نهاية_تار 65536
#تعريف اسم_بيانات_الطقم "BAA-SDK.json"
#تعريف اسم_بيانات_الأداة "BAA-TOOL.json"
#تعريف اسم_إيصال_الطقم ".تكوين-طقم-v1"
#تعريف رأس_إيصال_الطقم "takween-sdk-receipt-v1"
#تعريف رأس_فهرس_الطقوم "takween-sdk-index-v1"
#تعريف اسم_فهرس_الطقوم "طقوم.فهرس"

// ---------------------------------------------------------------------------
// المضيف والمخزن
// ---------------------------------------------------------------------------

// لا يعرّف باء رمزا مسبقا للمضيف، ومتغير OS يضبطه Windows دائما.
نص مضيف_تكوين() {
    نص نظام = متغير_بيئة("OS").
    منطقي ويندوز = نظام != عدم && قارن_نص(نظام، "Windows_NT") == ٠.
    إذا (نظام != عدم) { حرر_نص(نظام). }
    إذا (ويندوز) { إرجع "x86_64-windows". }
    إرجع "x86_64-linux".
}

منطقي مضيف_طقم_معروف(نص مضيف) {
    إرجع قارن_نص(مضيف، "x86_64-windows") == ٠ || قارن_نص(مضيف، "x86_64-linux") == ٠.
}

نص متغير_بيئة_غير_فارغ(نص اسم) {
    نص قيمة = متغير_بيئة(اسم).
    إذا (قيمة != عدم && طول_نص(قيمة) == ٠) {
        حرر_نص(قيمة).
        إرجع عدم.
    }
    إرجع قيمة.
}

نص ضم_وحرر_يسار_طقم(نص يسار، نص يمين) {
    إذا (يسار == عدم) { إرجع عدم. }
    نص ناتج = ضم_مسار(يسار، يمين).
    حرر_نص(يسار).
    إرجع ناتج.
}

// جذر بيانات تكوين: TAKWEEN_DATA_HOME، ثم %LOCALAPPDATA%/تكوين على Windows،
// ثم $XDG_DATA_HOME/takween، ثم ~/.local/share/takween.
نص جذر_بيانات_تكوين() {
    نص قيمة = متغير_بيئة_غير_فارغ("TAKWEEN_DATA_HOME").
    إذا (قيمة != عدم) { إرجع قيمة. }
    إذا (قارن_نص(مضيف_تكوين()، "x86_64-windows") == ٠) {
        قيمة = متغير_بيئة_غير_فارغ("LOCALAPPDATA").
        إذا (قيمة != عدم) { إرجع ضم_وحرر_يسار_طقم(قيمة، "تكوين"). }
    }
    قيمة = متغير_بيئة_غير_فارغ("XDG_DATA_HOME").
    إذا (قيمة != عدم) { إرجع ضم_وحرر_يسار_طقم(قيمة، "takween"). }
    قيمة = متغير_بيئة_غير_فارغ("HOME").
    إذا (قيمة != عدم) {
        قيمة = ضم_وحرر_يسار_طقم(قيمة، ".local").
        قيمة = ضم_وحرر_يسار_طقم(قيمة، "share").
        إرجع ضم_وحرر_يسار_طقم(قيمة، "takween").
    }
    إرجع عدم.
}

نص مخزن_الطقوم() {
    نص جذر = جذر_بيانات_تكوين().
    إذا (جذر == عدم) {
        اطبع "[خطأ] لا يوجد مجلد بيانات لتكوين؛ اضبط TAKWEEN_DATA_HOME.".
        إرجع عدم.
    }
    إرجع ضم_وحرر_يسار_طقم(جذر، "طقوم").
}

منطقي ملف_موجود_طقم(نص مسار) {
    إذا (مسار == عدم) { إرجع خطأ. }
    عدم* ملف = فتح_ملف(مسار، "rb").
    إذا (ملف == عدم) { إرجع خطأ. }
    اغلق_ملف(ملف).
    إرجع صواب.
}

نص قمة_طقم(نص إصدار، نص مضيف) {
    إرجع نسق("baa-sdk-%ن-%ن"، إصدار، مضيف).
}

// نوع الأرشيف الذي يفكه المستهلك: ٠ طقم baa-sdk-v1، ١ أداة baa-tool-v1.
صحيح نوع_أرشيف_طقم = ٠.

عدم اضبط_نوع_أرشيف(صحيح نوع) {
    نوع_أرشيف_طقم = نوع.
}

نص ملف_بيانات_تار() {
    إذا (نوع_أرشيف_طقم == ١) { إرجع اسم_بيانات_الأداة. }
    إرجع اسم_بيانات_الطقم.
}

نص اسم_نوع_تار() {
    إذا (نوع_أرشيف_طقم == ١) { إرجع "الأداة". }
    إرجع "الطقم".
}

نص قمة_أداة(نص اسم، نص إصدار، نص مضيف) {
    إرجع نسق("baa-tool-%ن-%ن-%ن"، اسم، إصدار، مضيف).
}

// قفل مجلد: ملف مؤقت يُنقل ذريا إلى .قفل، والنقل يفشل إن وُجد القفل.
نص مسار_قفل_الطقوم(نص مخزن) {
    إرجع ضم_مسار(مخزن، ".قفل").
}

منطقي اقفل_الطقوم(نص مخزن) {
    إرجع اقفل_مجلدا(مخزن، "مخزن الطقوم").
}

منطقي اقفل_مجلدا(نص مخزن، نص وصف) {
    نص اسم_مؤقت = نسق(".قفل-%ص-%ص"، وقت_حالي()، عشوائي()).
    نص مؤقت = ضم_مسار(مخزن، اسم_مؤقت).
    نص قفل = مسار_قفل_الطقوم(مخزن).
    منطقي صالح = مؤقت != عدم && قفل != عدم.
    عدم* ملف = عدم.
    إذا (صالح) { ملف = فتح_ملف(مؤقت، "wb"). صالح = ملف != عدم. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، "takween-sdk-lock-v1") >= ٠. }
    إذا (ملف != عدم && اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    منطقي مقفل = خطأ.
    إذا (صالح) { مقفل = انقل_مسار(مؤقت، قفل) == ٠. }
    إذا (!مقفل) {
        إذا (مؤقت != عدم) { احذف_شجرة(مؤقت). }
        إذا (صالح) {
            اطبع_منسق("[خطأ] %ن مقفل: %ن\س"، وصف، قفل).
            اطبع "[ملاحظة] إن لم يكن تكوين آخر يعمل فاحذف ملف القفل ثم أعد المحاولة.".
        }
        وإلا {
            اطبع_منسق("[خطأ] تعذر إنشاء قفل في %ن: %ن\س"، وصف، مخزن).
        }
    }
    إذا (اسم_مؤقت != عدم) { حرر_نص(اسم_مؤقت). }
    إذا (مؤقت != عدم) { حرر_نص(مؤقت). }
    إذا (قفل != عدم) { حرر_نص(قفل). }
    إرجع مقفل.
}

عدم افتح_قفل_الطقوم(نص مخزن) {
    نص قفل = مسار_قفل_الطقوم(مخزن).
    إذا (قفل != عدم) {
        احذف_شجرة(قفل).
        حرر_نص(قفل).
    }
}

// ---------------------------------------------------------------------------
// UTF-8 والمسارات
// ---------------------------------------------------------------------------

صحيح طول_يوتف_نص(نص قيمة) {
    صحيح ناتج = ٠.
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        صحيح رمز = كـ<صحيح>(قيمة[م]).
        إذا (رمز < 128) { ناتج = ناتج + ١. }
        وإلا إذا (رمز < 2048) { ناتج = ناتج + ٢. }
        وإلا إذا (رمز < 65536) { ناتج = ناتج + ٣. }
        وإلا { ناتج = ناتج + ٤. }
        م = م + ١.
    }
    إرجع ناتج.
}

// فك UTF-8 صارم: يرفض الصيغ الطويلة وأنصاف البدائل وما فوق U+10FFFF.
صحيح موضع_فك_طقم = ٠.

صحيح فك_يوتف_طقم(ط٨* بايتات، صحيح نهاية) {
    إذا (موضع_فك_طقم >= نهاية) { إرجع -١. }
    صحيح أول = بايتات[موضع_فك_طقم].
    إذا (أول < 128) {
        موضع_فك_طقم = موضع_فك_طقم + ١.
        إرجع أول.
    }
    صحيح طول = ٠.
    صحيح رمز = ٠.
    صحيح أدنى = ٠.
    إذا (أول >= 194 && أول <= 223) { طول = ٢. رمز = أول & 31. أدنى = 128. }
    وإلا إذا (أول >= 224 && أول <= 239) { طول = ٣. رمز = أول & 15. أدنى = 2048. }
    وإلا إذا (أول >= 240 && أول <= 244) { طول = ٤. رمز = أول & 7. أدنى = 65536. }
    وإلا { إرجع -١. }
    إذا (موضع_فك_طقم + طول > نهاية) { إرجع -١. }
    صحيح ك = ١.
    طالما (ك < طول) {
        صحيح تال = بايتات[موضع_فك_طقم + ك].
        إذا ((تال & 192) != 128) { إرجع -١. }
        رمز = (رمز << 6) | (تال & 63).
        ك = ك + ١.
    }
    إذا (رمز < أدنى || رمز > 1114111 || (رمز >= 55296 && رمز <= 57343)) { إرجع -١. }
    موضع_فك_طقم = موضع_فك_طقم + طول.
    إرجع رمز.
}

// يطابق بايتات UTF-8 من موضع_فك_طقم مع نص كامل، ويتقدم بعده.
منطقي بايتات_تطابق_نص_طقم(ط٨* بايتات، صحيح نهاية، نص قيمة) {
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        إذا (فك_يوتف_طقم(بايتات، نهاية) != كـ<صحيح>(قيمة[م])) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

// تحقق UTF-8 متدفق لبايتات BAA-SDK.json.
صحيح متبقي_يوتف_طقم = ٠.
صحيح رمز_يوتف_طقم = ٠.
صحيح أدنى_يوتف_طقم = ٠.

منطقي تحقق_بايت_يوتف_طقم(صحيح بايت) {
    إذا (متبقي_يوتف_طقم == ٠) {
        إذا (بايت < 128) { إرجع صواب. }
        إذا (بايت >= 194 && بايت <= 223) {
            متبقي_يوتف_طقم = ١. رمز_يوتف_طقم = بايت & 31. أدنى_يوتف_طقم = 128.
        }
        وإلا إذا (بايت >= 224 && بايت <= 239) {
            متبقي_يوتف_طقم = ٢. رمز_يوتف_طقم = بايت & 15. أدنى_يوتف_طقم = 2048.
        }
        وإلا إذا (بايت >= 240 && بايت <= 244) {
            متبقي_يوتف_طقم = ٣. رمز_يوتف_طقم = بايت & 7. أدنى_يوتف_طقم = 65536.
        }
        وإلا { إرجع خطأ. }
        إرجع صواب.
    }
    إذا ((بايت & 192) != 128) { إرجع خطأ. }
    رمز_يوتف_طقم = (رمز_يوتف_طقم << 6) | (بايت & 63).
    متبقي_يوتف_طقم = متبقي_يوتف_طقم - ١.
    إذا (متبقي_يوتف_طقم > ٠) { إرجع صواب. }
    إرجع رمز_يوتف_طقم >= أدنى_يوتف_طقم && رمز_يوتف_طقم <= 1114111 &&
           (رمز_يوتف_طقم < 55296 || رمز_يوتف_طقم > 57343).
}

صحيح كبير_أسكي_طقم(حرف ح) {
    صحيح رمز = كـ<صحيح>(ح).
    إذا (رمز >= 97 && رمز <= 122) { إرجع رمز - ٣٢. }
    إرجع رمز.
}

// أسماء أجهزة Windows (CON وPRN وAUX وNUL وCOM1-9 وLPT1-9) مع امتداد أو دونه.
منطقي اسم_جهاز_ويندوز_طقم(نص مسار، صحيح بداية، صحيح نهاية) {
    صحيح طول = ٠.
    طالما (بداية + طول < نهاية && مسار[بداية + طول] != '.') { طول = طول + ١. }
    إذا (طول != ٣ && طول != ٤) { إرجع خطأ. }
    صحيح أ = كبير_أسكي_طقم(مسار[بداية]).
    صحيح ب = كبير_أسكي_طقم(مسار[بداية + ١]).
    صحيح ج = كبير_أسكي_طقم(مسار[بداية + ٢]).
    إذا (طول == ٣) {
        إرجع (أ == 67 && ب == 79 && ج == 78) || (أ == 80 && ب == 82 && ج == 78) ||
               (أ == 65 && ب == 85 && ج == 88) || (أ == 78 && ب == 85 && ج == 76).
    }
    صحيح د = كـ<صحيح>(مسار[بداية + ٣]).
    إذا (د < 49 || د > 57) { إرجع خطأ. }
    إرجع (أ == 67 && ب == 79 && ج == 77) || (أ == 76 && ب == 80 && ج == 84).
}

منطقي رمز_مسار_طقم_مرفوض(صحيح رمز) {
    إرجع رمز < 32 || رمز == 127 || رمز == 34 || رمز == 92 || رمز == 58 ||
           رمز == 60 || رمز == 62 || رمز == 124 || رمز == 63 || رمز == 42.
}

// مسار نسبي بـ'/' لا يحتاج هروبا في JSON ويصلح على Windows وLinux.
منطقي مسار_طقم_صالح(نص مسار) {
    إذا (مسار == عدم || طول_نص(مسار) == ٠) { إرجع خطأ. }
    إذا (طول_يوتف_نص(مسار) > حد_طول_مسار_الطقم) { إرجع خطأ. }
    // أسماء البيانات ومقاطع .تكوين في أول المسار محجوزة للإيصالات وقاعدة البيئة.
    إذا (قارن_نص(مسار، اسم_بيانات_الطقم) == ٠ || قارن_نص(مسار، اسم_بيانات_الأداة) == ٠ ||
        يبدأ_ب(مسار، ".تكوين")) {
        إرجع خطأ.
    }
    صحيح طول = طول_نص(مسار).
    صحيح بداية = ٠.
    صحيح م = ٠.
    طالما (م <= طول) {
        إذا (م < طول && رمز_مسار_طقم_مرفوض(كـ<صحيح>(مسار[م]))) { إرجع خطأ. }
        إذا (م == طول || مسار[م] == '/') {
            إذا (م == بداية) { إرجع خطأ. }
            // يرفض '.' و'..' وكل مقطع ينتهي بنقطة أو مسافة.
            إذا (مسار[م - ١] == '.' || مسار[م - ١] == ' ') { إرجع خطأ. }
            إذا (اسم_جهاز_ويندوز_طقم(مسار، بداية، م)) { إرجع خطأ. }
            بداية = م + ١.
        }
        م = م + ١.
    }
    إرجع صواب.
}

// ترتيب نقاط الترميز هو ترتيب بايتات UTF-8.
صحيح قارن_مسار_طقم(نص أ، نص ب) {
    صحيح م = ٠.
    طالما (م < طول_نص(أ) && م < طول_نص(ب)) {
        صحيح س = كـ<صحيح>(أ[م]).
        صحيح ص = كـ<صحيح>(ب[م]).
        إذا (س < ص) { إرجع -١. }
        إذا (س > ص) { إرجع ١. }
        م = م + ١.
    }
    إذا (طول_نص(أ) < طول_نص(ب)) { إرجع -١. }
    إذا (طول_نص(أ) > طول_نص(ب)) { إرجع ١. }
    إرجع ٠.
}

منطقي تجزئة_سداسية_صالحة_طقم(نص قيمة) {
    إذا (قيمة == عدم || طول_نص(قيمة) != ٦٤) { إرجع خطأ. }
    صحيح م = ٠.
    طالما (م < ٦٤) {
        حرف ح = قيمة[م].
        إذا (!((ح >= '0' && ح <= '9') || (ح >= 'a' && ح <= 'f'))) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

// ---------------------------------------------------------------------------
// BAA-SDK.json بالصيغة القياسية
// ---------------------------------------------------------------------------

متجه مسارات_جرد_طقم = عدم.
متجه تجزئات_جرد_طقم = عدم.
صحيح* أحجام_جرد_طقم = عدم.
ط٨* تنفيذ_جرد_طقم = عدم.
صحيح عدد_جرد_طقم = ٠.
صحيح مجموع_جرد_طقم = ٠.
نص إصدار_جرد_طقم.
نص مضيف_جرد_طقم.
نص اسم_جرد_طقم.
صحيح مؤشر_سطر_طقم = ٠.
منطقي فاصلة_سطر_طقم = خطأ.

عدم امسح_جرد_طقم() {
    إذا (مسارات_جرد_طقم != عدم) { حرر_وسائط(مسارات_جرد_طقم). مسارات_جرد_طقم = عدم. }
    إذا (تجزئات_جرد_طقم != عدم) { حرر_وسائط(تجزئات_جرد_طقم). تجزئات_جرد_طقم = عدم. }
    إذا (أحجام_جرد_طقم != عدم) { تحرير_ذاكرة(أحجام_جرد_طقم). أحجام_جرد_طقم = عدم. }
    إذا (تنفيذ_جرد_طقم != عدم) { تحرير_ذاكرة(تنفيذ_جرد_طقم). تنفيذ_جرد_طقم = عدم. }
    إذا (إصدار_جرد_طقم != عدم) { حرر_نص(إصدار_جرد_طقم). إصدار_جرد_طقم = عدم. }
    إذا (مضيف_جرد_طقم != عدم) { حرر_نص(مضيف_جرد_طقم). مضيف_جرد_طقم = عدم. }
    إذا (اسم_جرد_طقم != عدم) { حرر_نص(اسم_جرد_طقم). اسم_جرد_طقم = عدم. }
    عدد_جرد_طقم = ٠.
    مجموع_جرد_طقم = ٠.
}

نص مسار_جرد_طقم(صحيح فهرس) {
    نص* بيانات = كـ<نص*>(بيانات_متجه(مسارات_جرد_طقم)).
    إرجع *(بيانات + فهرس).
}

نص تجزئة_جرد_طقم(صحيح فهرس) {
    نص* بيانات = كـ<نص*>(بيانات_متجه(تجزئات_جرد_طقم)).
    إرجع *(بيانات + فهرس).
}

صحيح عدد_جرد_أرشيف() { إرجع عدد_جرد_طقم. }
منطقي تنفيذي_جرد_أرشيف(صحيح فهرس) { إرجع تنفيذ_جرد_طقم[فهرس] != ٠. }
نص إصدار_جرد_أرشيف() { إرجع إصدار_جرد_طقم. }
نص مضيف_جرد_أرشيف() { إرجع مضيف_جرد_طقم. }
نص اسم_جرد_أرشيف() { إرجع اسم_جرد_طقم. }

منطقي طابق_سطر_طقم(نص سطر، نص حرفي) {
    صحيح طول = طول_نص(حرفي).
    إذا (مؤشر_سطر_طقم + طول > طول_نص(سطر)) { إرجع خطأ. }
    صحيح ك = ٠.
    طالما (ك < طول) {
        إذا (سطر[مؤشر_سطر_طقم + ك] != حرفي[ك]) { إرجع خطأ. }
        ك = ك + ١.
    }
    مؤشر_سطر_طقم = مؤشر_سطر_طقم + طول.
    إرجع صواب.
}

// قيمة نصية بين بادئة ولاحقة حرفيتين تشغلان السطر كله.
نص قيمة_سطر_طقم(نص سطر، نص بادئة، نص لاحقة) {
    إذا (سطر == عدم || !يبدأ_ب(سطر، بادئة) || !ينتهي_ب(سطر، لاحقة)) { إرجع عدم. }
    صحيح بداية = طول_نص(بادئة).
    صحيح نهاية = طول_نص(سطر) - طول_نص(لاحقة).
    إذا (نهاية <= بداية) { إرجع عدم. }
    صحيح م = بداية.
    طالما (م < نهاية) {
        إذا (سطر[م] == '"' || سطر[م] == '\\') { إرجع عدم. }
        م = م + ١.
    }
    إرجع نسخ_مقطع(سطر، بداية، نهاية).
}

//     {"path": "<p>", "size": <n>, "sha256": "<h>", "executable": true|false}[,]
منطقي حلل_سطر_جرد_طقم(نص سطر) {
    مؤشر_سطر_طقم = ٠.
    إذا (!طابق_سطر_طقم(سطر، "    {\"path\": \"")) { إرجع خطأ. }
    صحيح بداية = مؤشر_سطر_طقم.
    طالما (مؤشر_سطر_طقم < طول_نص(سطر) && سطر[مؤشر_سطر_طقم] != '"') {
        مؤشر_سطر_طقم = مؤشر_سطر_طقم + ١.
    }
    إذا (مؤشر_سطر_طقم >= طول_نص(سطر)) { إرجع خطأ. }
    نص مسار = نسخ_مقطع(سطر، بداية، مؤشر_سطر_طقم).
    إذا (مسار == عدم) { إرجع خطأ. }
    منطقي صالح = طابق_سطر_طقم(سطر، "\", \"size\": ").

    صحيح حجم_ملف = ٠.
    صحيح أرقام = ٠.
    طالما (صالح && مؤشر_سطر_طقم < طول_نص(سطر) &&
           سطر[مؤشر_سطر_طقم] >= '0' && سطر[مؤشر_سطر_طقم] <= '9') {
        إذا (أرقام == ١ && حجم_ملف == ٠) { صالح = خطأ. توقف. }
        حجم_ملف = حجم_ملف * ١٠ + (كـ<صحيح>(سطر[مؤشر_سطر_طقم]) - ٤٨).
        إذا (حجم_ملف > حد_حجم_ملف_الطقم) { صالح = خطأ. توقف. }
        أرقام = أرقام + ١.
        مؤشر_سطر_طقم = مؤشر_سطر_طقم + ١.
    }
    إذا (أرقام == ٠) { صالح = خطأ. }

    نص تجزئة = عدم.
    إذا (صالح) { صالح = طابق_سطر_طقم(سطر، ", \"sha256\": \""). }
    إذا (صالح && مؤشر_سطر_طقم + ٦٤ <= طول_نص(سطر)) {
        تجزئة = نسخ_مقطع(سطر، مؤشر_سطر_طقم، مؤشر_سطر_طقم + ٦٤).
        مؤشر_سطر_طقم = مؤشر_سطر_طقم + ٦٤.
    }
    صالح = صالح && تجزئة_سداسية_صالحة_طقم(تجزئة).
    إذا (صالح) { صالح = طابق_سطر_طقم(سطر، "\", \"executable\": "). }
    صحيح تنفيذي = ٠.
    إذا (صالح) {
        إذا (طابق_سطر_طقم(سطر، "true")) { تنفيذي = ١. }
        وإلا إذا (!طابق_سطر_طقم(سطر، "false")) { صالح = خطأ. }
    }
    إذا (صالح) { صالح = طابق_سطر_طقم(سطر، "}"). }
    إذا (صالح) {
        فاصلة_سطر_طقم = طابق_سطر_طقم(سطر، ",").
        صالح = مؤشر_سطر_طقم == طول_نص(سطر).
    }

    إذا (صالح && !مسار_طقم_صالح(مسار)) {
        اطبع_منسق("[خطأ] مسار غير مقبول في جرد الطقم: %ن\س"، مسار).
        صالح = خطأ.
    }
    إذا (صالح && عدد_جرد_طقم > ٠ &&
        قارن_مسار_طقم(مسار_جرد_طقم(عدد_جرد_طقم - ١)، مسار) >= ٠) {
        اطبع_منسق("[خطأ] جرد الطقم غير مرتب أو مكرر عند: %ن\س"، مسار).
        صالح = خطأ.
    }
    إذا (صالح && (عدد_جرد_طقم + ٢ > حد_ملفات_الطقم ||
                  مجموع_جرد_طقم + حجم_ملف > حد_حجم_الطقم)) {
        اطبع_منسق("[خطأ] يتجاوز %ن حدود الأرشيف للملفات أو الحجم.\س"، اسم_نوع_تار()).
        صالح = خطأ.
    }
    إذا (صالح) { صالح = اضف_وسيط(مسارات_جرد_طقم، مسار) && اضف_وسيط(تجزئات_جرد_طقم، تجزئة). }
    إذا (صالح) {
        أحجام_جرد_طقم[عدد_جرد_طقم] = حجم_ملف.
        تنفيذ_جرد_طقم[عدد_جرد_طقم] = كـ<ط٨>(تنفيذي).
        عدد_جرد_طقم = عدد_جرد_طقم + ١.
        مجموع_جرد_طقم = مجموع_جرد_طقم + حجم_ملف.
    }
    حرر_نص(مسار).
    إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    إرجع صالح.
}

منطقي سطر_يساوي_طقم(نص سطر، نص متوقع) {
    إرجع سطر != عدم && قارن_نص(سطر، متوقع) == ٠.
}

// يقرأ BAA-SDK.json أو BAA-TOOL.json بالصيغة القياسية سطرا سطرا، ويملأ الجرد والهوية.
منطقي حلل_بيانات_طقم(نص مسار) {
    امسح_جرد_طقم().
    مسارات_جرد_طقم = أنشئ_متجه(حجم(نص)).
    تجزئات_جرد_طقم = أنشئ_متجه(حجم(نص)).
    أحجام_جرد_طقم = كـ<صحيح*>(حجز_ذاكرة(حد_ملفات_الطقم * حجم(صحيح))).
    تنفيذ_جرد_طقم = كـ<ط٨*>(حجز_ذاكرة(حد_ملفات_الطقم)).
    إذا (مسارات_جرد_طقم == عدم || تجزئات_جرد_طقم == عدم ||
        أحجام_جرد_طقم == عدم || تنفيذ_جرد_طقم == عدم) {
        إرجع خطأ.
    }
    عدم* ملف = فتح_ملف(مسار، "rb").
    إذا (ملف == عدم) { إرجع خطأ. }

    نص سطر = اقرأ_سطر(ملف).
    منطقي صالح = سطر_يساوي_طقم(سطر، "{").
    إذا (سطر != عدم) { حرر_نص(سطر). }
    إذا (صالح) {
        سطر = اقرأ_سطر(ملف).
        إذا (نوع_أرشيف_طقم == ١) {
            صالح = سطر_يساوي_طقم(سطر، "  \"schema_version\": \"baa-tool-v1\",").
        }
        وإلا { صالح = سطر_يساوي_طقم(سطر، "  \"schema_version\": \"baa-sdk-v1\","). }
        إذا (سطر != عدم) { حرر_نص(سطر). }
    }
    إذا (صالح) {
        سطر = اقرأ_سطر(ملف).
        إذا (نوع_أرشيف_طقم == ١) {
            اسم_جرد_طقم = قيمة_سطر_طقم(سطر، "  \"name\": \""، "\",").
            صالح = اسم_جرد_طقم != عدم && هوية_حزمة_عربية(اسم_جرد_طقم).
        }
        وإلا { صالح = سطر_يساوي_طقم(سطر، "  \"name\": \"baa-sdk\","). }
        إذا (سطر != عدم) { حرر_نص(سطر). }
    }
    إذا (صالح) {
        سطر = اقرأ_سطر(ملف).
        إصدار_جرد_طقم = قيمة_سطر_طقم(سطر، "  \"version\": \""، "\",").
        صالح = إصدار_جرد_طقم != عدم && اصدار_دلالي_صالح(إصدار_جرد_طقم).
        إذا (سطر != عدم) { حرر_نص(سطر). }
    }
    إذا (صالح) {
        سطر = اقرأ_سطر(ملف).
        مضيف_جرد_طقم = قيمة_سطر_طقم(سطر، "  \"host\": \""، "\",").
        صالح = مضيف_جرد_طقم != عدم && مضيف_طقم_معروف(مضيف_جرد_طقم).
        إذا (سطر != عدم) { حرر_نص(سطر). }
    }
    صحيح أسطر = ٠.
    منطقي وجد_الملفات = خطأ.
    طالما (صالح && أسطر < حد_أسطر_رأس_الطقم) {
        سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        وجد_الملفات = قارن_نص(سطر، "  \"files\": [") == ٠.
        حرر_نص(سطر).
        إذا (وجد_الملفات) { توقف. }
        أسطر = أسطر + ١.
    }
    صالح = صالح && وجد_الملفات.

    منطقي أغلق = خطأ.
    منطقي سابقة_بفاصلة = صواب.
    طالما (صالح) {
        سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { صالح = خطأ. توقف. }
        إذا (قارن_نص(سطر، "  ]") == ٠) {
            حرر_نص(سطر).
            أغلق = صواب.
            توقف.
        }
        // كل مدخل قبل الأخير ينتهي بفاصلة.
        إذا (!سابقة_بفاصلة) { حرر_نص(سطر). صالح = خطأ. توقف. }
        صالح = حلل_سطر_جرد_طقم(سطر).
        سابقة_بفاصلة = فاصلة_سطر_طقم.
        حرر_نص(سطر).
    }
    صالح = صالح && أغلق && عدد_جرد_طقم > ٠ && !سابقة_بفاصلة.
    إذا (صالح) {
        سطر = اقرأ_سطر(ملف).
        صالح = سطر_يساوي_طقم(سطر، "}").
        إذا (سطر != عدم) { حرر_نص(سطر). }
    }
    إذا (صالح) {
        سطر = اقرأ_سطر(ملف).
        صالح = سطر == عدم.
        إذا (سطر != عدم) { حرر_نص(سطر). }
    }
    اغلق_ملف(ملف).
    إذا (!صالح) {
        إذا (نوع_أرشيف_طقم == ١) { اطبع "[خطأ] BAA-TOOL.json ليس بصيغة baa-tool-v1 القياسية.". }
        وإلا { اطبع "[خطأ] BAA-SDK.json ليس بصيغة baa-sdk-v1 القياسية.". }
    }
    إرجع صالح.
}

// ---------------------------------------------------------------------------
// مستهلك ustar
// ---------------------------------------------------------------------------

// الحالات: ٠ رأس، ١ بيانات، ٢ حشو، ٣ نهاية الأرشيف (أصفار فقط).
صحيح حالة_تار = ٠.
ط٨* رأس_تار = عدم.
صحيح ملء_رأس_تار = ٠.
ط٨* اسم_تار = عدم.
صحيح طول_اسم_تار = ٠.
ط٨* قمة_تار = عدم.
صحيح طول_قمة_تار = ٠.
صحيح متبقي_تار = ٠.
صحيح حجم_مدخل_تار = ٠.
صحيح حشو_تار = ٠.
صحيح أصفار_تار = ٠.
صحيح مدخلات_تار = ٠.
صحيح إجمالي_تار = ٠.
عدم* خرج_تار = عدم.
نص مرحلة_تار.
نص مخزن_تار.
نص قمة_نص_تار.
نص جذر_مرحلة_تار.
منطقي مثبت_مسبقا_تار = خطأ.

عدم امسح_حالة_تار() {
    حالة_تار = ٠.
    ملء_رأس_تار = ٠.
    طول_اسم_تار = ٠.
    طول_قمة_تار = ٠.
    متبقي_تار = ٠.
    حجم_مدخل_تار = ٠.
    حشو_تار = ٠.
    أصفار_تار = ٠.
    مدخلات_تار = ٠.
    إجمالي_تار = ٠.
    مثبت_مسبقا_تار = خطأ.
    متبقي_يوتف_طقم = ٠.
    إذا (خرج_تار != عدم) { اغلق_ملف(خرج_تار). خرج_تار = عدم. }
    إذا (قمة_نص_تار != عدم) { حرر_نص(قمة_نص_تار). قمة_نص_تار = عدم. }
    إذا (جذر_مرحلة_تار != عدم) { حرر_نص(جذر_مرحلة_تار). جذر_مرحلة_تار = عدم. }
}

عدم خطأ_تار(نص سبب) {
    اطبع_منسق("[خطأ] أرشيف %ن مرفوض: %ن.\س"، اسم_نوع_تار()، سبب).
}

صحيح ثماني_تار(صحيح بداية، صحيح طول) {
    صحيح قيمة = ٠.
    صحيح أرقام = ٠.
    صحيح م = بداية.
    صحيح نهاية = بداية + طول.
    طالما (م < نهاية) {
        صحيح بايت = رأس_تار[م].
        إذا (بايت < 48 || بايت > 55) { توقف. }
        قيمة = قيمة * ٨ + (بايت - ٤٨).
        أرقام = أرقام + ١.
        م = م + ١.
    }
    إذا (أرقام == ٠) { إرجع -١. }
    طالما (م < نهاية) {
        إذا (رأس_تار[م] != ٠ && رأس_تار[م] != ٣٢) { إرجع -١. }
        م = م + ١.
    }
    إرجع قيمة.
}

منطقي أصفار_رأس_تار(صحيح بداية، صحيح نهاية) {
    صحيح م = بداية.
    طالما (م < نهاية) {
        إذا (رأس_تار[م] != ٠) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

// طول حقل نصي منته بـNUL، أو -١ إن تلا NUL بايت غير صفري.
صحيح طول_حقل_تار(صحيح بداية، صحيح سعة) {
    صحيح طول = ٠.
    طالما (طول < سعة && رأس_تار[بداية + طول] != ٠) { طول = طول + ١. }
    إذا (!أصفار_رأس_تار(بداية + طول، بداية + سعة)) { إرجع -١. }
    إرجع طول.
}

// الاسم الكامل: البادئة (٣٤٥، ١٥٥ بايتا) ثم '/' ثم الاسم (٠، ١٠٠ بايت).
منطقي اجمع_اسم_تار() {
    صحيح طول_بادئة = طول_حقل_تار(٣٤٥، ١٥٥).
    صحيح طول_اسم = طول_حقل_تار(٠، ١٠٠).
    إذا (طول_بادئة < ٠ || طول_اسم <= ٠) { إرجع خطأ. }
    طول_اسم_تار = ٠.
    صحيح م = ٠.
    طالما (م < طول_بادئة) {
        اسم_تار[طول_اسم_تار] = رأس_تار[٣٤٥ + م].
        طول_اسم_تار = طول_اسم_تار + ١.
        م = م + ١.
    }
    إذا (طول_بادئة > ٠) {
        اسم_تار[طول_اسم_تار] = كـ<ط٨>(٤٧).
        طول_اسم_تار = طول_اسم_تار + ١.
    }
    م = ٠.
    طالما (م < طول_اسم) {
        اسم_تار[طول_اسم_تار] = رأس_تار[م].
        طول_اسم_تار = طول_اسم_تار + ١.
        م = م + ١.
    }
    إرجع صواب.
}

// أول مدخل: <قمة>/BAA-SDK.json أو <قمة>/BAA-TOOL.json. اللاحقة ASCII فطولها بايتاتها.
منطقي ابدأ_بيانات_تار(صحيح حجم_ملف، صحيح وضع) {
    نص لاحقة_نص = نسق("/%ن"، ملف_بيانات_تار()).
    إذا (لاحقة_نص == عدم) { إرجع خطأ. }
    صحيح لاحقة = طول_نص(لاحقة_نص).
    منطقي صالح = طول_اسم_تار > لاحقة.
    إذا (صالح) {
        موضع_فك_طقم = طول_اسم_تار - لاحقة.
        صالح = بايتات_تطابق_نص_طقم(اسم_تار، طول_اسم_تار، لاحقة_نص).
    }
    حرر_نص(لاحقة_نص).
    إذا (!صالح) { خطأ_تار("أول مدخل ليس ملف بيانات الأرشيف تحت المجلد الأعلى"). إرجع خطأ. }
    طول_قمة_تار = طول_اسم_تار - لاحقة.
    صحيح م = ٠.
    طالما (م < طول_قمة_تار) {
        إذا (اسم_تار[م] == ٤٧) {
            خطأ_تار("أول مدخل ليس ملف بيانات الأرشيف تحت المجلد الأعلى").
            إرجع خطأ.
        }
        قمة_تار[م] = اسم_تار[م].
        م = م + ١.
    }
    إذا (وضع != ٤٢٠ || حجم_ملف > حد_بيانات_الطقم) {
        خطأ_تار("ملف البيانات بوضع أو حجم غير مقبول").
        إرجع خطأ.
    }
    نص مسار = ضم_مسار(مرحلة_تار، ملف_بيانات_تار()).
    إذا (مسار != عدم) { خرج_تار = فتح_ملف(مسار، "wb"). حرر_نص(مسار). }
    إذا (خرج_تار == عدم) { اطبع "[خطأ] تعذر كتابة مجلد التثبيت المؤقت.". إرجع خطأ. }
    إرجع صواب.
}

منطقي ابدأ_ملف_تار(صحيح حجم_ملف، صحيح وضع) {
    صحيح فهرس = مدخلات_تار - ٢.
    إذا (فهرس >= عدد_جرد_طقم) { خطأ_تار("مدخل لا يسرده الجرد"). إرجع خطأ. }
    نص مسار = مسار_جرد_طقم(فهرس).
    موضع_فك_طقم = ٠.
    منطقي مطابق = بايتات_تطابق_نص_طقم(اسم_تار، طول_اسم_تار، قمة_نص_تار) &&
                   بايتات_تطابق_نص_طقم(اسم_تار، طول_اسم_تار، "/") &&
                   بايتات_تطابق_نص_طقم(اسم_تار، طول_اسم_تار، مسار) &&
                   موضع_فك_طقم == طول_اسم_تار.
    إذا (!مطابق) {
        اطبع_منسق("[خطأ] أرشيف %ن مرفوض: المدخل التالي يجب أن يكون %ن.\س"، اسم_نوع_تار()، مسار).
        إرجع خطأ.
    }
    صحيح وضع_متوقع = ٤٢٠.
    إذا (تنفيذ_جرد_طقم[فهرس] != ٠) { وضع_متوقع = ٤٩٣. }
    إذا (حجم_ملف != أحجام_جرد_طقم[فهرس] || وضع != وضع_متوقع) {
        اطبع_منسق("[خطأ] أرشيف %ن مرفوض: حجم أو وضع %ن لا يطابق الجرد.\س"، اسم_نوع_تار()، مسار).
        إرجع خطأ.
    }
    نص كامل = ضم_مسار(جذر_مرحلة_تار، مسار).
    نص مجلد = عدم.
    منطقي صالح = كامل != عدم.
    إذا (صالح) { مجلد = مجلد_مسار(كامل). صالح = مجلد != عدم. }
    إذا (صالح) { صالح = انشئ_مجلدات(مجلد) == ٠. }
    إذا (صالح) { خرج_تار = فتح_ملف(كامل، "wb"). صالح = خرج_تار != عدم. }
    إذا (!صالح) { اطبع_منسق("[خطأ] تعذر كتابة ملف %ن: %ن\س"، اسم_نوع_تار()، مسار). }
    إذا (كامل != عدم) { حرر_نص(كامل). }
    إذا (مجلد != عدم) { حرر_نص(مجلد). }
    إرجع صالح.
}

// بعد اكتمال ملف البيانات: يحلله، ويطابق القمة والمضيف، ثم ينقله إلى قمة المرحلة.
منطقي انه_بيانات_تار() {
    إذا (متبقي_يوتف_طقم != ٠) { خطأ_تار("ملف البيانات ليس UTF-8 صالحا"). إرجع خطأ. }
    نص مسار = ضم_مسار(مرحلة_تار، ملف_بيانات_تار()).
    إذا (مسار == عدم || !حلل_بيانات_طقم(مسار)) {
        إذا (مسار != عدم) { حرر_نص(مسار). }
        إرجع خطأ.
    }
    إذا (نوع_أرشيف_طقم == ١) {
        قمة_نص_تار = قمة_أداة(اسم_جرد_طقم، إصدار_جرد_طقم، مضيف_جرد_طقم).
    }
    وإلا { قمة_نص_تار = قمة_طقم(إصدار_جرد_طقم، مضيف_جرد_طقم). }
    موضع_فك_طقم = ٠.
    منطقي صالح = قمة_نص_تار != عدم &&
                  بايتات_تطابق_نص_طقم(قمة_تار، طول_قمة_تار، قمة_نص_تار) &&
                  موضع_فك_طقم == طول_قمة_تار.
    إذا (!صالح) {
        خطأ_تار("المجلد الأعلى لا يطابق الهوية والإصدار والمضيف في ملف البيانات").
        حرر_نص(مسار).
        إرجع خطأ.
    }
    إذا (قارن_نص(مضيف_جرد_طقم، مضيف_تكوين()) != ٠) {
        اطبع_منسق("[خطأ] %ن للمضيف %ن، وتكوين يعمل على %ن.\س"،
                   اسم_نوع_تار()، مضيف_جرد_طقم، مضيف_تكوين()).
        حرر_نص(مسار).
        إرجع خطأ.
    }
    // طقم بالإصدار نفسه مثبت: يعالجه المثبت دون فك بقية الأرشيف. مخزن الأدوات
    // يعنون مدخلاته بتجزئة الأرشيف ويفحصها قبل الفك.
    إذا (نوع_أرشيف_طقم == ٠) {
        نص منشور = ضم_مسار(مخزن_تار، قمة_نص_تار).
        نص منشور_بيانات = ضم_مسار(منشور، اسم_بيانات_الطقم).
        مثبت_مسبقا_تار = ملف_موجود_طقم(منشور_بيانات).
        إذا (منشور != عدم) { حرر_نص(منشور). }
        إذا (منشور_بيانات != عدم) { حرر_نص(منشور_بيانات). }
        إذا (مثبت_مسبقا_تار) { حرر_نص(مسار). إرجع خطأ. }
    }

    جذر_مرحلة_تار = ضم_مسار(مرحلة_تار، قمة_نص_تار).
    نص هدف = عدم.
    صالح = جذر_مرحلة_تار != عدم && انشئ_مجلدات(جذر_مرحلة_تار) == ٠.
    إذا (صالح) { هدف = ضم_مسار(جذر_مرحلة_تار، ملف_بيانات_تار()). صالح = هدف != عدم. }
    إذا (صالح) { صالح = انقل_مسار(مسار، هدف) == ٠. }
    إذا (!صالح) { اطبع "[خطأ] تعذر تجهيز مجلد التثبيت المؤقت.". }
    حرر_نص(مسار).
    إذا (هدف != عدم) { حرر_نص(هدف). }
    إرجع صالح.
}

منطقي انه_مدخل_تار() {
    إذا (خرج_تار != عدم) {
        منطقي مغلق = اغلق_ملف(خرج_تار) == ٠.
        خرج_تار = عدم.
        إذا (!مغلق) { اطبع_منسق("[خطأ] تعذر إكمال كتابة ملف من %ن.\س"، اسم_نوع_تار()). إرجع خطأ. }
    }
    إذا (مدخلات_تار == ١ && !انه_بيانات_تار()) { إرجع خطأ. }
    حشو_تار = (٥١٢ - حجم_مدخل_تار % ٥١٢) % ٥١٢.
    إذا (حشو_تار > ٠) { حالة_تار = ٢. }
    وإلا { حالة_تار = ٠. }
    إرجع صواب.
}

منطقي عالج_رأس_تار() {
    إذا (أصفار_رأس_تار(٠، ٥١٢)) {
        حالة_تار = ٣.
        أصفار_تار = ٥١٢.
        إرجع صواب.
    }
    صحيح مجموع = ٠.
    صحيح م = ٠.
    طالما (م < ٥١٢) {
        إذا (م >= ١٤٨ && م < ١٥٦) { مجموع = مجموع + ٣٢. }
        وإلا { مجموع = مجموع + رأس_تار[م]. }
        م = م + ١.
    }
    إذا (ثماني_تار(١٤٨، ٨) != مجموع) { خطأ_تار("مجموع تحقق رأس tar خاطئ"). إرجع خطأ. }
    منطقي أوستار = رأس_تار[٢٥٧] == ١١٧ && رأس_تار[٢٥٨] == ١١٥ && رأس_تار[٢٥٩] == ١١٦ &&
                  رأس_تار[٢٦٠] == ٩٧ && رأس_تار[٢٦١] == ١١٤ && رأس_تار[٢٦٢] == ٠ &&
                  رأس_تار[٢٦٣] == ٤٨ && رأس_تار[٢٦٤] == ٤٨.
    إذا (!أوستار) { خطأ_تار("المدخل ليس POSIX ustar"). إرجع خطأ. }
    إذا (رأس_تار[١٥٦] != ٤٨ && رأس_تار[١٥٦] != ٠) {
        خطأ_تار("الأرشيف يقبل الملفات العادية فقط، لا المجلدات ولا الروابط").
        إرجع خطأ.
    }
    إذا (!أصفار_رأس_تار(١٥٧، ٢٥٧) || !أصفار_رأس_تار(٢٦٥، ٣٢٩) || !أصفار_رأس_تار(٥٠٠، ٥١٢)) {
        خطأ_تار("رابط أو اسم مالك أو حشو غير فارغ في رأس tar").
        إرجع خطأ.
    }
    // أرقام الجهاز صفر ثماني أو NUL كلها، كما يكتبها tarfile لملف عادي.
    منطقي جهاز_صفر = أصفار_رأس_تار(٣٢٩، ٣٤٥) ||
                     (ثماني_تار(٣٢٩، ٨) == ٠ && ثماني_تار(٣٣٧، ٨) == ٠).
    إذا (ثماني_تار(١٠٨، ٨) != ٠ || ثماني_تار(١١٦، ٨) != ٠ || ثماني_تار(١٣٦، ١٢) != ٠ ||
        !جهاز_صفر) {
        خطأ_تار("uid وgid وmtime وأرقام الجهاز يجب أن تكون صفرا").
        إرجع خطأ.
    }
    صحيح وضع = ثماني_تار(١٠٠، ٨).
    صحيح حجم_ملف = ثماني_تار(١٢٤، ١٢).
    إذا (وضع != ٤٢٠ && وضع != ٤٩٣) { خطأ_تار("وضع الملف ليس 0644 ولا 0755"). إرجع خطأ. }
    إذا (حجم_ملف < ٠ || حجم_ملف > حد_حجم_ملف_الطقم) { خطأ_تار("حجم ملف غير مقبول"). إرجع خطأ. }
    إذا (!اجمع_اسم_تار()) { خطأ_تار("اسم مدخل tar غير صالح"). إرجع خطأ. }

    مدخلات_تار = مدخلات_تار + ١.
    حجم_مدخل_تار = حجم_ملف.
    متبقي_تار = حجم_ملف.
    منطقي صالح = خطأ.
    إذا (مدخلات_تار == ١) { صالح = ابدأ_بيانات_تار(حجم_ملف، وضع). }
    وإلا { صالح = ابدأ_ملف_تار(حجم_ملف، وضع). }
    إذا (!صالح) { إرجع خطأ. }
    حالة_تار = ١.
    إذا (حجم_ملف == ٠) { إرجع انه_مدخل_تار(). }
    إرجع صواب.
}

منطقي اكتب_بيانات_تار(ط٨* بيانات، صحيح عدد) {
    إذا (مدخلات_تار == ١) {
        صحيح م = ٠.
        طالما (م < عدد) {
            إذا (!تحقق_بايت_يوتف_طقم(بيانات[م])) {
                خطأ_تار("ملف البيانات ليس UTF-8 صالحا").
                إرجع خطأ.
            }
            م = م + ١.
        }
    }
    إذا (اكتب_ملف(خرج_تار، كـ<عدم*>(بيانات)، عدد) != عدد) {
        اطبع_منسق("[خطأ] تعذر كتابة ملف من %ن.\س"، اسم_نوع_تار()).
        إرجع خطأ.
    }
    إرجع صواب.
}

// يستقبل بايتات tar المفكوكة من فك_جزيب.
منطقي استهلك_مفكوك_جزيب(ط٨* بيانات، صحيح عدد) {
    إجمالي_تار = إجمالي_تار + عدد.
    صحيح م = ٠.
    طالما (م < عدد) {
        إذا (حالة_تار == ٠) {
            رأس_تار[ملء_رأس_تار] = بيانات[م].
            ملء_رأس_تار = ملء_رأس_تار + ١.
            م = م + ١.
            إذا (ملء_رأس_تار == ٥١٢) {
                ملء_رأس_تار = ٠.
                إذا (!عالج_رأس_تار()) { إرجع خطأ. }
            }
        }
        وإلا إذا (حالة_تار == ١) {
            صحيح جزء = عدد - م.
            إذا (جزء > متبقي_تار) { جزء = متبقي_تار. }
            إذا (!اكتب_بيانات_تار(بيانات + م، جزء)) { إرجع خطأ. }
            م = م + جزء.
            متبقي_تار = متبقي_تار - جزء.
            إذا (متبقي_تار == ٠ && !انه_مدخل_تار()) { إرجع خطأ. }
        }
        وإلا إذا (حالة_تار == ٢) {
            إذا (بيانات[م] != ٠) { خطأ_تار("حشو مدخل tar غير صفري"). إرجع خطأ. }
            م = م + ١.
            حشو_تار = حشو_تار - ١.
            إذا (حشو_تار == ٠) { حالة_تار = ٠. }
        }
        وإلا {
            إذا (بيانات[م] != ٠) { خطأ_تار("بيانات بعد نهاية أرشيف tar"). إرجع خطأ. }
            أصفار_تار = أصفار_تار + ١.
            إذا (أصفار_تار > حد_أصفار_نهاية_تار) { خطأ_تار("حشو نهاية tar طويل جدا"). إرجع خطأ. }
            م = م + ١.
        }
    }
    إرجع صواب.
}

// ---------------------------------------------------------------------------
// الإيصال والفهرس
// ---------------------------------------------------------------------------

منطقي اكتب_إيصال_طقم(نص جذر، نص تجزئة_أرشيف) {
    نص مسار = ضم_مسار(جذر، اسم_إيصال_الطقم).
    عدم* ملف = عدم.
    منطقي صالح = مسار != عدم.
    إذا (صالح) { ملف = فتح_ملف(مسار، "wb"). صالح = ملف != عدم. }
    نص أرشيف = نسق("أرشيف\ت%ن"، تجزئة_أرشيف).
    نص إصدار = نسق("إصدار\ت%ن"، إصدار_جرد_طقم).
    نص مضيف = نسق("مضيف\ت%ن"، مضيف_جرد_طقم).
    إذا (صالح) { صالح = اكتب_سطر(ملف، رأس_إيصال_الطقم) >= ٠. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، أرشيف) >= ٠. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، إصدار) >= ٠. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، مضيف) >= ٠. }
    إذا (ملف != عدم && اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    إذا (مسار != عدم) { حرر_نص(مسار). }
    إذا (أرشيف != عدم) { حرر_نص(أرشيف). }
    إذا (إصدار != عدم) { حرر_نص(إصدار). }
    إذا (مضيف != عدم) { حرر_نص(مضيف). }
    إرجع صالح.
}

نص قيمة_إيصال_طقم(نص سطر، نص مفتاح) {
    نص نوع = حقل_أرشيف(سطر، ٠).
    نص قيمة = حقل_أرشيف(سطر، ١).
    نص زائد = حقل_أرشيف(سطر، ٢).
    منطقي صالح = نوع != عدم && قيمة != عدم && زائد == عدم && قارن_نص(نوع، مفتاح) == ٠.
    إذا (نوع != عدم) { حرر_نص(نوع). }
    إذا (زائد != عدم) { حرر_نص(زائد). }
    إذا (!صالح && قيمة != عدم) { حرر_نص(قيمة). قيمة = عدم. }
    إرجع قيمة.
}

// يرجع تجزئة الأرشيف من إيصال طقم منشور إن طابق الإصدار والمضيف.
نص اقرأ_إيصال_طقم(نص جذر، نص إصدار، نص مضيف) {
    نص مسار = ضم_مسار(جذر، اسم_إيصال_الطقم).
    عدم* ملف = عدم.
    إذا (مسار != عدم) { ملف = فتح_ملف(مسار، "rb"). حرر_نص(مسار). }
    إذا (ملف == عدم) { إرجع عدم. }
    نص رأس = اقرأ_سطر(ملف).
    نص سطر_أرشيف = اقرأ_سطر(ملف).
    نص سطر_إصدار = اقرأ_سطر(ملف).
    نص سطر_مضيف = اقرأ_سطر(ملف).
    نص زائد = اقرأ_سطر(ملف).
    اغلق_ملف(ملف).
    نص تجزئة = عدم.
    نص قيمة_إصدار = عدم.
    نص قيمة_مضيف = عدم.
    منطقي صالح = سطر_يساوي_طقم(رأس، رأس_إيصال_الطقم) && زائد == عدم &&
                  سطر_أرشيف != عدم && سطر_إصدار != عدم && سطر_مضيف != عدم.
    إذا (صالح) {
        تجزئة = قيمة_إيصال_طقم(سطر_أرشيف، "أرشيف").
        قيمة_إصدار = قيمة_إيصال_طقم(سطر_إصدار، "إصدار").
        قيمة_مضيف = قيمة_إيصال_طقم(سطر_مضيف، "مضيف").
        صالح = تجزئة_سداسية_صالحة_طقم(تجزئة) && قيمة_إصدار != عدم && قيمة_مضيف != عدم &&
               قارن_نص(قيمة_إصدار، إصدار) == ٠ && قارن_نص(قيمة_مضيف، مضيف) == ٠.
    }
    إذا (رأس != عدم) { حرر_نص(رأس). }
    إذا (سطر_أرشيف != عدم) { حرر_نص(سطر_أرشيف). }
    إذا (سطر_إصدار != عدم) { حرر_نص(سطر_إصدار). }
    إذا (سطر_مضيف != عدم) { حرر_نص(سطر_مضيف). }
    إذا (زائد != عدم) { حرر_نص(زائد). }
    إذا (قيمة_إصدار != عدم) { حرر_نص(قيمة_إصدار). }
    إذا (قيمة_مضيف != عدم) { حرر_نص(قيمة_مضيف). }
    إذا (!صالح && تجزئة != عدم) { حرر_نص(تجزئة). تجزئة = عدم. }
    إرجع تجزئة.
}

// سطر فهرس: <الإصدار>\t<المضيف>\t<sha256 الأرشيف>.
منطقي سطر_فهرس_طقوم_صالح(نص سطر) {
    نص إصدار = حقل_أرشيف(سطر، ٠).
    نص مضيف = حقل_أرشيف(سطر، ١).
    نص تجزئة = حقل_أرشيف(سطر، ٢).
    نص زائد = حقل_أرشيف(سطر، ٣).
    منطقي صالح = إصدار != عدم && مضيف != عدم && زائد == عدم &&
                  اصدار_دلالي_صالح(إصدار) && مضيف_طقم_معروف(مضيف) &&
                  تجزئة_سداسية_صالحة_طقم(تجزئة).
    إذا (إصدار != عدم) { حرر_نص(إصدار). }
    إذا (مضيف != عدم) { حرر_نص(مضيف). }
    إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    إذا (زائد != عدم) { حرر_نص(زائد). }
    إرجع صالح.
}

// يقرأ أسطر الفهرس؛ غياب الملف فهرس فارغ.
منطقي اقرأ_فهرس_طقوم(نص مخزن، متجه أسطر) {
    نص مسار = ضم_مسار(مخزن، اسم_فهرس_الطقوم).
    عدم* ملف = عدم.
    إذا (مسار != عدم) { ملف = فتح_ملف(مسار، "rb"). حرر_نص(مسار). }
    إذا (ملف == عدم) { إرجع صواب. }
    نص رأس = اقرأ_سطر(ملف).
    منطقي صالح = سطر_يساوي_طقم(رأس، رأس_فهرس_الطقوم).
    إذا (رأس != عدم) { حرر_نص(رأس). }
    طالما (صالح) {
        نص سطر = اقرأ_سطر(ملف).
        إذا (سطر == عدم) { توقف. }
        صالح = سطر_فهرس_طقوم_صالح(سطر) && اضف_وسيط(أسطر، سطر).
        حرر_نص(سطر).
    }
    اغلق_ملف(ملف).
    إذا (!صالح) { اطبع "[خطأ] فهرس الطقوم تالف.". }
    إرجع صالح.
}

صحيح قارن_سطر_فهرس_طقوم(نص أ، نص ب) {
    نص إصدار_أ = حقل_أرشيف(أ، ٠).
    نص إصدار_ب = حقل_أرشيف(ب، ٠).
    صحيح ناتج = قارن_اصدار_دلالي(إصدار_أ، إصدار_ب).
    إذا (ناتج == ٠) {
        نص مضيف_أ = حقل_أرشيف(أ، ١).
        نص مضيف_ب = حقل_أرشيف(ب، ١).
        ناتج = قارن_مسار_طقم(مضيف_أ، مضيف_ب).
        حرر_نص(مضيف_أ).
        حرر_نص(مضيف_ب).
    }
    حرر_نص(إصدار_أ).
    حرر_نص(إصدار_ب).
    إرجع ناتج.
}

منطقي سطر_فهرس_لطقم(نص سطر، نص إصدار، نص مضيف) {
    نص س_إصدار = حقل_أرشيف(سطر، ٠).
    نص س_مضيف = حقل_أرشيف(سطر، ١).
    منطقي ناتج = س_إصدار != عدم && س_مضيف != عدم &&
                  قارن_نص(س_إصدار، إصدار) == ٠ && قارن_نص(س_مضيف، مضيف) == ٠.
    إذا (س_إصدار != عدم) { حرر_نص(س_إصدار). }
    إذا (س_مضيف != عدم) { حرر_نص(س_مضيف). }
    إرجع ناتج.
}

// يضيف سطر الطقم أو يحذفه (تجزئة == عدم) ويستبدل الفهرس ذريا. يتطلب القفل.
منطقي حدث_فهرس_طقوم(نص مخزن، نص إصدار، نص مضيف، نص تجزئة) {
    متجه قديمة = أنشئ_متجه(حجم(نص)).
    متجه جديدة = أنشئ_متجه(حجم(نص)).
    إذا (قديمة == عدم || جديدة == عدم) { إرجع خطأ. }
    منطقي صالح = اقرأ_فهرس_طقوم(مخزن، قديمة).
    نص سطر_جديد = عدم.
    إذا (تجزئة != عدم) { سطر_جديد = نسق("%ن\ت%ن\ت%ن"، إصدار، مضيف، تجزئة). }
    نص* بيانات = كـ<نص*>(بيانات_متجه(قديمة)).
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(قديمة)) {
        نص سطر = *(بيانات + م).
        إذا (!سطر_فهرس_لطقم(سطر، إصدار، مضيف)) {
            إذا (سطر_جديد != عدم && قارن_سطر_فهرس_طقوم(سطر_جديد، سطر) < ٠) {
                صالح = اضف_وسيط(جديدة، سطر_جديد).
                حرر_نص(سطر_جديد).
                سطر_جديد = عدم.
            }
            صالح = صالح && اضف_وسيط(جديدة، سطر).
        }
        م = م + ١.
    }
    إذا (صالح && سطر_جديد != عدم) { صالح = اضف_وسيط(جديدة، سطر_جديد). }
    إذا (سطر_جديد != عدم) { حرر_نص(سطر_جديد). }

    نص مؤقت = ضم_مسار(مخزن، ".فهرس-مؤقت").
    نص نهائي = ضم_مسار(مخزن، اسم_فهرس_الطقوم).
    عدم* ملف = عدم.
    صالح = صالح && مؤقت != عدم && نهائي != عدم.
    إذا (صالح) { ملف = فتح_ملف(مؤقت، "wb"). صالح = ملف != عدم. }
    إذا (صالح) { صالح = اكتب_سطر(ملف، رأس_فهرس_الطقوم) >= ٠. }
    بيانات = كـ<نص*>(بيانات_متجه(جديدة)).
    م = ٠.
    طالما (صالح && م < طول_متجه(جديدة)) {
        صالح = اكتب_سطر(ملف، *(بيانات + م)) >= ٠.
        م = م + ١.
    }
    إذا (ملف != عدم && اغلق_ملف(ملف) != ٠) { صالح = خطأ. }
    إذا (صالح) { صالح = استبدل_ملف(مؤقت، نهائي) == ٠. }
    إذا (!صالح) {
        إذا (مؤقت != عدم) { احذف_شجرة(مؤقت). }
        اطبع "[خطأ] تعذر تحديث فهرس الطقوم.".
    }
    إذا (مؤقت != عدم) { حرر_نص(مؤقت). }
    إذا (نهائي != عدم) { حرر_نص(نهائي). }
    حرر_وسائط(قديمة).
    حرر_وسائط(جديدة).
    إرجع صالح.
}

// ---------------------------------------------------------------------------
// التثبيت
// ---------------------------------------------------------------------------

// يقرأ التجزئة من <أرشيف>.sha256 بصيغة sha256sum.
نص تجزئة_ملف_جانبي_طقم(نص أرشيف) {
    نص مسار = نسق("%ن.sha256"، أرشيف).
    عدم* ملف = عدم.
    إذا (مسار != عدم) { ملف = فتح_ملف(مسار، "rb"). حرر_نص(مسار). }
    إذا (ملف == عدم) { إرجع عدم. }
    نص سطر = اقرأ_سطر(ملف).
    اغلق_ملف(ملف).
    إذا (سطر == عدم) { إرجع عدم. }
    نص تجزئة = عدم.
    إذا (طول_نص(سطر) > ٦٥ && سطر[٦٤] == ' ') { تجزئة = نسخ_مقطع(سطر، ٠، ٦٤). }
    حرر_نص(سطر).
    إذا (!تجزئة_سداسية_صالحة_طقم(تجزئة)) {
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
        إرجع عدم.
    }
    إرجع تجزئة.
}

// يتحقق من كل ملف في الجرد تحت جذر، ويعيد إليه بت التنفيذ عند الطلب.
منطقي تحقق_ملفات_طقم(نص جذر، منطقي اضبط_التنفيذ) {
    صحيح م = ٠.
    طالما (م < عدد_جرد_طقم) {
        نص مسار = مسار_جرد_طقم(م).
        نص كامل = ضم_مسار(جذر، مسار).
        نص فعلية = عدم.
        إذا (كامل != عدم) { فعلية = تجزئة_ملف_شا٢٥٦(كامل). }
        منطقي صالح = فعلية != عدم && قارن_نص(فعلية، تجزئة_جرد_طقم(م)) == ٠.
        إذا (صالح && اضبط_التنفيذ && تنفيذ_جرد_طقم[م] != ٠) {
            صالح = اجعل_قابلا_للتنفيذ(كامل) == ٠.
        }
        إذا (كامل != عدم) { حرر_نص(كامل). }
        إذا (فعلية != عدم) { حرر_نص(فعلية). }
        إذا (!صالح) {
            اطبع_منسق("[خطأ] ملف %ن لا يطابق تجزئته في %ن: %ن\س"،
                       اسم_نوع_تار()، ملف_بيانات_تار()، مسار).
            إرجع خطأ.
        }
        م = م + ١.
    }
    إرجع صواب.
}

// طقم بالإصدار والمضيف نفسيهما منشور: نجاح إن كان من الأرشيف نفسه.
صحيح عالج_طقم_مثبت(نص مخزن، نص تجزئة_أرشيف) {
    نص جذر = ضم_مسار(مخزن، قمة_نص_تار).
    نص تجزئة = اقرأ_إيصال_طقم(جذر، إصدار_جرد_طقم، مضيف_جرد_طقم).
    صحيح كود = كود_تكوين_نجاح.
    إذا (تجزئة != عدم && قارن_نص(تجزئة، تجزئة_أرشيف) == ٠) {
        إذا (!حدث_فهرس_طقوم(مخزن، إصدار_جرد_طقم، مضيف_جرد_طقم، تجزئة_أرشيف)) {
            كود = كود_تكوين_خطأ_عام.
        }
        وإلا {
            اطبع_منسق("[تم] طقم باء %ن (%ن) مثبت مسبقا: %ن\س"،
                       إصدار_جرد_طقم، مضيف_جرد_طقم، جذر).
        }
    }
    وإلا {
        اطبع_منسق("[خطأ] طقم باء %ن (%ن) مثبت من أرشيف آخر: %ن\س"،
                   إصدار_جرد_طقم، مضيف_جرد_طقم، جذر).
        اطبع_منسق("[ملاحظة] احذفه أولا: تكوين طقم احذف %ن\س"، إصدار_جرد_طقم).
        كود = كود_تكوين_خطأ_عام.
    }
    إذا (جذر != عدم) { حرر_نص(جذر). }
    إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    إرجع كود.
}

// يفك أرشيفا من نوع_أرشيف_طقم إلى <المرحلة>/<القمة>، ويتحقق من اكتماله ومن
// كل ملف في جرده. يرجع -١ إن كان طقم بالقمة نفسها منشورا في المخزن. يحرر
// انه_فك_أرشيف حالة الفك بعد أن ينشر المستدعي جذر_مرحلة_أرشيف.
صحيح فك_أرشيف_طقم(نص أرشيف، نص مخزن، نص مرحلة) {
    إذا (احذف_شجرة(مرحلة) != ٠ || انشئ_مجلدات(مرحلة) != ٠) {
        اطبع_منسق("[خطأ] تعذر تجهيز مجلد التثبيت المؤقت: %ن\س"، مرحلة).
        إرجع كود_تكوين_خطأ_عام.
    }
    امسح_جرد_طقم().
    انه_فك_أرشيف().
    مرحلة_تار = مرحلة.
    مخزن_تار = مخزن.
    رأس_تار = كـ<ط٨*>(حجز_ذاكرة(٥١٢)).
    اسم_تار = كـ<ط٨*>(حجز_ذاكرة(٥١٢)).
    قمة_تار = كـ<ط٨*>(حجز_ذاكرة(٥١٢)).
    إذا (رأس_تار == عدم || اسم_تار == عدم || قمة_تار == عدم) {
        إرجع كود_تكوين_خطأ_داخلي.
    }

    منطقي مفكوك = فك_جزيب(أرشيف).
    إذا (خرج_تار != عدم) { اغلق_ملف(خرج_تار). خرج_تار = عدم. }
    إذا (مثبت_مسبقا_تار) { إرجع -١. }
    إذا (!مفكوك) { إرجع كود_تكوين_خطأ_عام. }

    // اكتمل tar: كل مدخلات الجرد، ثم كتلتا أصفار على الأقل، وطول مضاعف ٥١٢.
    إذا (حالة_تار != ٣ || أصفار_تار < ١٠٢٤ || إجمالي_تار % ٥١٢ != ٠) {
        خطأ_تار("أرشيف tar مبتور أو بلا نهاية صحيحة").
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (مدخلات_تار != عدد_جرد_طقم + ١) {
        خطأ_تار("بعض ملفات الجرد غائبة عن الأرشيف").
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (!تحقق_ملفات_طقم(جذر_مرحلة_تار، صواب)) { إرجع كود_تكوين_خطأ_عام. }
    إرجع كود_تكوين_نجاح.
}

نص جذر_مرحلة_أرشيف() { إرجع جذر_مرحلة_تار. }

عدم انه_فك_أرشيف() {
    امسح_حالة_تار().
    مرحلة_تار = عدم.
    مخزن_تار = عدم.
    إذا (رأس_تار != عدم) { تحرير_ذاكرة(كـ<عدم*>(رأس_تار)). رأس_تار = عدم. }
    إذا (اسم_تار != عدم) { تحرير_ذاكرة(كـ<عدم*>(اسم_تار)). اسم_تار = عدم. }
    إذا (قمة_تار != عدم) { تحرير_ذاكرة(كـ<عدم*>(قمة_تار)). قمة_تار = عدم. }
}

// يعمل والقفل محجوز. ينشر <المرحلة>/<القمة> إلى <المخزن>/<القمة>.
صحيح ثبت_طقم_مقفل(نص أرشيف، نص تجزئة_أرشيف، نص مخزن، نص مرحلة) {
    اضبط_نوع_أرشيف(٠).
    صحيح مفكوك = فك_أرشيف_طقم(أرشيف، مخزن، مرحلة).
    إذا (مفكوك == -١) { إرجع عالج_طقم_مثبت(مخزن، تجزئة_أرشيف). }
    إذا (مفكوك != كود_تكوين_نجاح) { إرجع مفكوك. }
    إذا (!اكتب_إيصال_طقم(جذر_مرحلة_تار، تجزئة_أرشيف)) {
        اطبع "[خطأ] تعذر كتابة إيصال الطقم.".
        إرجع كود_تكوين_خطأ_عام.
    }
    نص منشور = ضم_مسار(مخزن، قمة_نص_تار).
    إذا (منشور == عدم || انقل_مسار(جذر_مرحلة_تار، منشور) != ٠) {
        اطبع_منسق("[خطأ] تعذر نشر الطقم إلى %ن\س"، منشور).
        إذا (منشور != عدم) { حرر_نص(منشور). }
        إرجع كود_تكوين_خطأ_عام.
    }
    صحيح كود = كود_تكوين_نجاح.
    إذا (!حدث_فهرس_طقوم(مخزن، إصدار_جرد_طقم، مضيف_جرد_طقم، تجزئة_أرشيف)) {
        كود = كود_تكوين_خطأ_عام.
    }
    وإلا {
        اطبع_منسق("[تم] ثُبّت طقم باء %ن (%ن، %ص ملفا) في %ن\س"،
                   إصدار_جرد_طقم، مضيف_جرد_طقم، عدد_جرد_طقم، منشور).
    }
    حرر_نص(منشور).
    إرجع كود.
}

صحيح ثبت_طقم(نص أرشيف، نص تجزئة_مطلوبة) {
    نص متوقعة = عدم.
    إذا (تجزئة_مطلوبة != عدم) { متوقعة = نسخ_نص(تجزئة_مطلوبة). }
    وإلا { متوقعة = تجزئة_ملف_جانبي_طقم(أرشيف). }
    إذا (!تجزئة_سداسية_صالحة_طقم(متوقعة)) {
        إذا (تجزئة_مطلوبة != عدم) {
            اطبع "[خطأ] --تجزئة تتطلب SHA-256 من ٦٤ خانة hex صغيرة.".
            إذا (متوقعة != عدم) { حرر_نص(متوقعة). }
            إرجع كود_تكوين_خطأ_استخدام.
        }
        اطبع_منسق("[خطأ] لا تجزئة متوقعة للأرشيف؛ مرر --تجزئة أو ضع %ن.sha256 بجواره.\س"، أرشيف).
        إرجع كود_تكوين_خطأ_عام.
    }
    نص فعلية = تجزئة_ملف_شا٢٥٦(أرشيف).
    إذا (فعلية == عدم) {
        اطبع_منسق("[خطأ] تعذر قراءة الأرشيف: %ن\س"، أرشيف).
        حرر_نص(متوقعة).
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (قارن_نص(فعلية، متوقعة) != ٠) {
        اطبع_منسق("[خطأ] تجزئة الأرشيف %ن لا تطابق المتوقعة %ن.\س"، فعلية، متوقعة).
        حرر_نص(فعلية).
        حرر_نص(متوقعة).
        إرجع كود_تكوين_خطأ_عام.
    }
    حرر_نص(متوقعة).

    نص مخزن = مخزن_الطقوم().
    إذا (مخزن == عدم) { حرر_نص(فعلية). إرجع كود_تكوين_خطأ_عام. }
    إذا (انشئ_مجلدات(مخزن) != ٠) {
        اطبع_منسق("[خطأ] تعذر إنشاء مخزن الطقوم: %ن\س"، مخزن).
        حرر_نص(فعلية).
        حرر_نص(مخزن).
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (!اقفل_الطقوم(مخزن)) {
        حرر_نص(فعلية).
        حرر_نص(مخزن).
        إرجع كود_تكوين_خطأ_عام.
    }
    نص مرحلة = ضم_مسار(مخزن، ".مؤقت").
    صحيح كود = كود_تكوين_خطأ_داخلي.
    إذا (مرحلة != عدم) { كود = ثبت_طقم_مقفل(أرشيف، فعلية، مخزن، مرحلة). }
    انه_فك_أرشيف().
    إذا (مرحلة != عدم) {
        احذف_شجرة(مرحلة).
        حرر_نص(مرحلة).
    }
    افتح_قفل_الطقوم(مخزن).
    حرر_نص(فعلية).
    حرر_نص(مخزن).
    إرجع كود.
}
