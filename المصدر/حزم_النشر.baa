#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

// تكوين حزّم: يكتب أرشيف takween-archive-v1 حتميا من ملفات [الحزمة] الصريحة،
// ويسجله اختياريا في فهرس محلي takween-index-v1. الإصدار المسجل لا يتغير.

#تعريف حد_ملفات_الحزمة 1024
#تعريف حد_حجم_ملف_الحزمة 8388608
#تعريف حد_حجم_الحزمة 67108864
#تعريف حجم_قطعة_الحزمة 4096

نص نسق(نص تنسيق_ثابت، ...).
نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
منطقي اضف_وسيط_مملوك(متجه وسائط، نص قيمة).
عدم حرر_وسائط(متجه وسائط).
نص حقل_سجل_اعتمادية(نص سجل، صحيح رقم).
منطقي مسار_أرشيف_آمن(نص مسار).
منطقي قائمة_مسارات_تتصادم(متجه مسارات، نص مسار).
نص احصل_ملفات_الحزمة().

نص عنصر_حزمة(متجه قائمة، صحيح فهرس) {
    نص* بيانات = كـ<نص*>(بيانات_متجه(قائمة)).
    إرجع *(بيانات + فهرس).
}

منطقي وسيط_فهرس_حزمة(نص قيمة) {
    إرجع قارن_نص(قيمة، "--فهرس") == ٠ || قارن_نص(قيمة، "--index") == ٠.
}

// مسار مطلق على Linux أو Windows؛ غيره نسبي إلى مجلد الفهرس.
منطقي مسار_مطلق_محلي(نص مسار) {
    إذا (مسار == عدم || طول_نص(مسار) == ٠) { إرجع خطأ. }
    إذا (مسار[٠] == '/' || مسار[٠] == '\\') { إرجع صواب. }
    إرجع طول_نص(مسار) >= ٢ && مسار[١] == ':'.
}

// صواب إذا احتوى المسار مقطع "..". وقت تشغيل Baa يرفض الكتابة عبره.
منطقي مسار_فيه_أصل(نص مسار) {
    صحيح طول = طول_نص(مسار).
    صحيح بداية = ٠.
    صحيح م = ٠.
    طالما (م <= طول) {
        إذا (م == طول || مسار[م] == '/' || مسار[م] == '\\') {
            إذا (م - بداية == ٢ && مسار[بداية] == '.' && مسار[بداية + ١] == '.') { إرجع صواب. }
            بداية = م + ١.
        }
        م = م + ١.
    }
    إرجع خطأ.
}

// يقسم قائمة البيان (سطر لكل مسار) ويضيف مشروع.تكوين، ثم يرتبها تصاعديا.
متجه مسارات_الحزمة(نص ملفات) {
    متجه مسارات = أنشئ_متجه(حجم(نص)).
    إذا (مسارات == عدم) { إرجع عدم. }
    منطقي صالح = اضف_وسيط_مملوك(مسارات، نسخ_نص("مشروع.تكوين")).
    صحيح بداية = ٠.
    صحيح م = ٠.
    طالما (صالح && م <= طول_نص(ملفات)) {
        منطقي نهاية = م == طول_نص(ملفات).
        إذا (!نهاية) { نهاية = ملفات[م] == '\س'. }
        إذا (نهاية) {
            نص مسار = نسخ_مقطع(ملفات، بداية، م).
            إذا (مسار == عدم) { صالح = خطأ. }
            وإلا إذا (قارن_نص(مسار، "مشروع.تكوين") == ٠) {
                اطبع "[خطأ] مشروع.تكوين يضاف إلى الحزمة تلقائيا؛ احذفه من [الحزمة] الملفات.".
                حرر_نص(مسار). صالح = خطأ.
            }
            وإلا إذا (!مسار_أرشيف_آمن(مسار)) {
                اطبع_منسق("[خطأ] مسار غير آمن في [الحزمة] الملفات: %ن\س"، مسار).
                حرر_نص(مسار). صالح = خطأ.
            }
            وإلا إذا (قائمة_مسارات_تتصادم(مسارات، مسار)) {
                اطبع_منسق("[خطأ] مسار مكرر أو متصادم في [الحزمة] الملفات: %ن\س"، مسار).
                حرر_نص(مسار). صالح = خطأ.
            }
            وإلا { صالح = اضف_وسيط_مملوك(مسارات، مسار). }
            بداية = م + ١.
        }
        م = م + ١.
    }
    إذا (صالح && طول_متجه(مسارات) > حد_ملفات_الحزمة) {
        اطبع "[خطأ] الحزمة تتجاوز 1024 ملفا.".
        صالح = خطأ.
    }
    إذا (!صالح) { حرر_وسائط(مسارات). إرجع عدم. }
    نص* بيانات = كـ<نص*>(بيانات_متجه(مسارات)).
    م = ١.
    طالما (م < طول_متجه(مسارات)) {
        صحيح ن = م.
        طالما (ن > ٠ && قارن_نص(*(بيانات + ن - ١)، *(بيانات + ن)) > ٠) {
            نص مؤقت = *(بيانات + ن - ١).
            *(بيانات + ن - ١) = *(بيانات + ن).
            *(بيانات + ن) = مؤقت.
            ن = ن - ١.
        }
        م = م + ١.
    }
    إرجع مسارات.
}

// عدد بايتات الملف، أو -١ إن تعذرت قراءته أو تجاوز الحد.
صحيح حجم_ملف_حزمة(نص مسار) {
    عدم* ملف = فتح_ملف(مسار، "rb").
    إذا (ملف == عدم) { إرجع -١. }
    عدم* مخزن = حجز_ذاكرة(حجم_قطعة_الحزمة).
    صحيح مجموع = ٠.
    إذا (مخزن == عدم) { مجموع = -١. }
    طالما (مجموع >= ٠) {
        صحيح عدد = اقرأ_ملف(ملف، مخزن، حجم_قطعة_الحزمة).
        إذا (عدد <= ٠) { توقف. }
        مجموع = مجموع + عدد.
        إذا (مجموع > حد_حجم_ملف_الحزمة) { مجموع = -١. }
    }
    إذا (مخزن != عدم) { تحرير_ذاكرة(مخزن). }
    اغلق_ملف(ملف).
    إرجع مجموع.
}

منطقي اكتب_نص_حزمة(عدم* ملف، نص قيمة) {
    صحيح م = ٠.
    طالما (م < طول_نص(قيمة)) {
        إذا (اكتب_حرف(ملف، قيمة[م]) < ٠) { إرجع خطأ. }
        م = م + ١.
    }
    إرجع صواب.
}

ط٨ رقم_سداسي_حزمة(صحيح قيمة) {
    إذا (قيمة < ١٠) { إرجع كـ<ط٨>(قيمة + ٤٨). }
    إرجع كـ<ط٨>(قيمة + ٨٧).
}

// يكتب بايتات الملف كـ hex صغير بالترتيب، ويتأكد أن الحجم لم يتغير.
منطقي اكتب_حمولة_حزمة(عدم* خرج، نص مسار، صحيح حجم_متوقع) {
    عدم* ملف = فتح_ملف(مسار، "rb").
    إذا (ملف == عدم) { إرجع خطأ. }
    ط٨* دخل = كـ<ط٨*>(حجز_ذاكرة(حجم_قطعة_الحزمة)).
    ط٨* سداسي = كـ<ط٨*>(حجز_ذاكرة(حجم_قطعة_الحزمة + حجم_قطعة_الحزمة)).
    منطقي صالح = دخل != عدم && سداسي != عدم.
    صحيح مجموع = ٠.
    طالما (صالح) {
        صحيح عدد = اقرأ_ملف(ملف، كـ<عدم*>(دخل)، حجم_قطعة_الحزمة).
        إذا (عدد <= ٠) { توقف. }
        صحيح م = ٠.
        طالما (م < عدد) {
            صحيح بايت = كـ<صحيح>(*(دخل + م)).
            *(سداسي + م + م) = رقم_سداسي_حزمة(بايت / ١٦).
            *(سداسي + م + م + ١) = رقم_سداسي_حزمة(بايت % ١٦).
            م = م + ١.
        }
        صالح = اكتب_ملف(خرج، كـ<عدم*>(سداسي)، عدد + عدد) == عدد + عدد.
        مجموع = مجموع + عدد.
    }
    إذا (صالح) { صالح = مجموع == حجم_متوقع. }
    إذا (دخل != عدم) { تحرير_ذاكرة(كـ<عدم*>(دخل)). }
    إذا (سداسي != عدم) { تحرير_ذاكرة(كـ<عدم*>(سداسي)). }
    اغلق_ملف(ملف).
    إرجع صالح.
}

// يكتب الأرشيف كاملا إلى مسار مؤقت. لا يلمس الوجهة النهائية.
منطقي اكتب_أرشيف_حزمة(نص وجهة، متجه مسارات) {
    عدم* خرج = فتح_ملف(وجهة، "wb").
    إذا (خرج == عدم) {
        اطبع_منسق("[خطأ] تعذر إنشاء الأرشيف: %ن\س"، وجهة).
        إرجع خطأ.
    }
    منطقي صالح = اكتب_سطر(خرج، "takween-archive-v1") >= ٠.
    صحيح مجموع = ٠.
    صحيح م = ٠.
    طالما (صالح && م < طول_متجه(مسارات)) {
        نص مسار = عنصر_حزمة(مسارات، م).
        صحيح حجم_ملف = حجم_ملف_حزمة(مسار).
        إذا (حجم_ملف < ٠) {
            اطبع_منسق("[خطأ] تعذرت قراءة ملف الحزمة أو تجاوز 8 MiB: %ن\س"، مسار).
            صالح = خطأ.
        }
        إذا (صالح && مجموع + حجم_ملف > حد_حجم_الحزمة) {
            اطبع "[خطأ] الحزمة تتجاوز 64 MiB.".
            صالح = خطأ.
        }
        نص تجزئة = عدم.
        إذا (صالح) { تجزئة = تجزئة_ملف_شا٢٥٦(مسار). صالح = تجزئة != عدم. }
        نص رأس = عدم.
        إذا (صالح) {
            رأس = نسق("ملف\ت%ن\ت%ص\ت%ن\ت"، مسار، حجم_ملف، تجزئة).
            صالح = رأس != عدم.
        }
        إذا (صالح) { صالح = اكتب_نص_حزمة(خرج، رأس). }
        إذا (صالح) { صالح = اكتب_حمولة_حزمة(خرج، مسار، حجم_ملف). }
        إذا (صالح) { صالح = اكتب_حرف(خرج، '\س') >= ٠. }
        إذا (!صالح && حجم_ملف >= ٠) {
            اطبع_منسق("[خطأ] تعذرت كتابة الملف في الأرشيف: %ن\س"، مسار).
        }
        إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
        إذا (رأس != عدم) { حرر_نص(رأس). }
        مجموع = مجموع + حجم_ملف.
        م = م + ١.
    }
    إذا (صالح) {
        نص نهاية = نسق("نهاية\ت%ص\ت%ص"، طول_متجه(مسارات)، مجموع).
        صالح = نهاية != عدم.
        إذا (صالح) { صالح = اكتب_سطر(خرج، نهاية) >= ٠. حرر_نص(نهاية). }
    }
    إذا (اغلق_ملف(خرج) != ٠) { صالح = خطأ. }
    إرجع صالح.
}

// اسم ملف الأرشيف: نطاق-اسم-إصدار.tkw (الشرطة لا تظهر في الأسماء العربية).
نص اسم_ملف_حزمة(نص اسم، نص إصدار) {
    صحيح فاصل = -١.
    صحيح م = ٠.
    طالما (م < طول_نص(اسم)) {
        إذا (اسم[م] == '/') { فاصل = م. }
        م = م + ١.
    }
    إذا (فاصل < ٠) { إرجع نسق("%ن-%ن.tkw"، اسم، إصدار). }
    نص نطاق = نسخ_مقطع(اسم، ٠، فاصل).
    نص قصير = نسخ_مقطع(اسم، فاصل + ١، طول_نص(اسم)).
    نص ناتج = عدم.
    إذا (نطاق != عدم && قصير != عدم) { ناتج = نسق("%ن-%ن-%ن.tkw"، نطاق، قصير، إصدار). }
    إذا (نطاق != عدم) { حرر_نص(نطاق). }
    إذا (قصير != عدم) { حرر_نص(قصير). }
    إرجع ناتج.
}

// يفحص الفهرس ثم يضيف السجل عند الطلب: ٠ غير مسجل (أو أضيف الآن)، ١ مسجل
// مسبقا بالتجزئة نفسها، -١ خطأ أو إصدار مسجل بتجزئة أخرى.
صحيح سجل_في_فهرس_حزم(نص فهرس، نص اسم، نص إصدار، نص تجزئة، نص ملف، منطقي اكتب) {
    متجه أسطر = أنشئ_متجه(حجم(نص)).
    إذا (أسطر == عدم) { إرجع -١. }
    منطقي صالح = صواب.
    منطقي موجود = خطأ.
    عدم* قائم = فتح_ملف(فهرس، "rb").
    إذا (قائم != عدم) {
        نص رأس = اقرأ_سطر(قائم).
        صالح = رأس != عدم && قارن_نص(رأس، "takween-index-v1") == ٠.
        إذا (رأس != عدم) { حرر_نص(رأس). }
        إذا (!صالح) { اطبع "[خطأ] الفهرس الموجود لا يطابق takween-index-v1.". }
        طالما (صالح) {
            نص سطر = اقرأ_سطر(قائم).
            إذا (سطر == عدم) { توقف. }
            إذا (طول_نص(سطر) == ٠) { حرر_نص(سطر). استمر. }
            نص اسم_سطر = حقل_سجل_اعتمادية(سطر، ٠).
            نص إصدار_سطر = حقل_سجل_اعتمادية(سطر، ١).
            نص تجزئة_سطر = حقل_سجل_اعتمادية(سطر، ٢).
            إذا (اسم_سطر == عدم || إصدار_سطر == عدم || تجزئة_سطر == عدم) {
                اطبع "[خطأ] سجل غير صالح في takween-index-v1.".
                صالح = خطأ.
            }
            وإلا إذا (قارن_نص(اسم_سطر، اسم) == ٠ && قارن_نص(إصدار_سطر، إصدار) == ٠) {
                إذا (قارن_نص(تجزئة_سطر، تجزئة) == ٠) { موجود = صواب. }
                وإلا {
                    اطبع_منسق("[خطأ] %ن %ن مسجل في الفهرس بتجزئة أخرى؛ الإصدار المنشور لا يتغير، ارفع رقم الإصدار.\س"، اسم، إصدار).
                    صالح = خطأ.
                }
            }
            إذا (اسم_سطر != عدم) { حرر_نص(اسم_سطر). }
            إذا (إصدار_سطر != عدم) { حرر_نص(إصدار_سطر). }
            إذا (تجزئة_سطر != عدم) { حرر_نص(تجزئة_سطر). }
            إذا (صالح) { صالح = اضف_وسيط_مملوك(أسطر، سطر). } وإلا { حرر_نص(سطر). }
        }
        اغلق_ملف(قائم).
    }
    صحيح ناتج = -١.
    إذا (صالح && موجود) { ناتج = ١. }
    إذا (صالح && !موجود && !اكتب) { ناتج = ٠. }
    إذا (صالح && !موجود && اكتب) {
        صالح = اضف_وسيط_مملوك(أسطر، نسق("%ن\ت%ن\ت%ن\ت%ن"، اسم، إصدار، تجزئة، ملف)).
        نص مؤقت = نسق("%ن.مؤقت"، فهرس).
        عدم* خرج = عدم.
        إذا (صالح) { صالح = مؤقت != عدم. }
        إذا (صالح) { خرج = فتح_ملف(مؤقت، "wb"). صالح = خرج != عدم. }
        إذا (صالح) { صالح = اكتب_سطر(خرج، "takween-index-v1") >= ٠. }
        صحيح م = ٠.
        طالما (صالح && م < طول_متجه(أسطر)) {
            صالح = اكتب_سطر(خرج، عنصر_حزمة(أسطر، م)) >= ٠.
            م = م + ١.
        }
        إذا (خرج != عدم && اغلق_ملف(خرج) != ٠) { صالح = خطأ. }
        إذا (صالح) { صالح = استبدل_ملف(مؤقت، فهرس) == ٠. }
        إذا (!صالح) {
            اطبع_منسق("[خطأ] تعذر تحديث الفهرس: %ن\س"، فهرس).
            إذا (مؤقت != عدم) { احذف_شجرة(مؤقت). }
        }
        إذا (مؤقت != عدم) { حرر_نص(مؤقت). }
        إذا (صالح) { ناتج = ٠. }
    }
    حرر_وسائط(أسطر).
    إرجع ناتج.
}

صحيح نفذ_حزم(نص فهرس) {
    صحيح تحليل = تحليل_ملف_تكوين("مشروع.تكوين").
    إذا (تحليل != ٠) { إرجع تحليل. }
    إذا (!تكوين_بيان_في1()) {
        اطبع "[خطأ] تكوين حزّم يعمل على بيان takween-manifest-v1 فقط.".
        إرجع كود_تكوين_غير_مدعوم.
    }
    نص ملفات = احصل_ملفات_الحزمة().
    إذا (طول_نص(ملفات) == ٠) {
        اطبع "[خطأ] حدد ملفات الحزمة صراحة: [الحزمة] ثم الملفات = [\"...\"].".
        إرجع كود_تكوين_خطأ_عام.
    }
    نص اسم = احصل_تكوين_الاسم().
    نص إصدار = احصل_تكوين_الإصدار().
    إذا (طول_نص(اسم) == ٠ || طول_نص(إصدار) == ٠) {
        اطبع "[خطأ] الحزمة تحتاج [المشروع] الاسم والإصدار.".
        إرجع كود_تكوين_خطأ_عام.
    }
    متجه مسارات = مسارات_الحزمة(ملفات).
    إذا (مسارات == عدم) { إرجع كود_تكوين_خطأ_عام. }

    نص مجلد = عدم.
    إذا (فهرس != عدم) { مجلد = مجلد_مسار(فهرس). }
    وإلا {
        نص مخرج = احصل_تكوين_المخرج().
        إذا (طول_نص(مخرج) == ٠) { مخرج = "build". }
        مجلد = ضم_مسار(مخرج، "حزم").
    }
    نص ملف = اسم_ملف_حزمة(اسم، إصدار).
    منطقي صالح = مجلد != عدم && ملف != عدم.
    // مجلد الفهرس قد يكون "." الذي يرفضه انشئ_مجلدات؛ فشل الكتابة بعده يبلغ عنه.
    إذا (صالح && انشئ_مجلدات(مجلد) != ٠ && فهرس == عدم) {
        اطبع_منسق("[خطأ] تعذر إنشاء المجلد: %ن\س"، مجلد).
        صالح = خطأ.
    }
    نص أرشيف = عدم.
    نص مؤقت = عدم.
    إذا (صالح) {
        أرشيف = ضم_مسار(مجلد، ملف).
        مؤقت = نسق("%ن.مؤقت"، أرشيف).
        صالح = أرشيف != عدم && مؤقت != عدم.
    }
    إذا (صالح) { صالح = اكتب_أرشيف_حزمة(مؤقت، مسارات). }
    نص تجزئة = عدم.
    إذا (صالح) { تجزئة = تجزئة_ملف_شا٢٥٦(مؤقت). صالح = تجزئة != عدم. }
    صحيح تسجيل = ٠.
    إذا (صالح && فهرس != عدم) {
        // يفحص الفهرس قبل نشر الأرشيف كي لا يستبدل إصدارا منشورا بتجزئة أخرى.
        تسجيل = سجل_في_فهرس_حزم(فهرس، اسم، إصدار، تجزئة، ملف، خطأ).
        صالح = تسجيل >= ٠.
    }
    إذا (صالح) {
        صالح = استبدل_ملف(مؤقت، أرشيف) == ٠.
        إذا (!صالح) { اطبع_منسق("[خطأ] تعذر نشر الأرشيف: %ن\س"، أرشيف). }
    }
    إذا (صالح && فهرس != عدم && تسجيل == ٠) {
        صالح = سجل_في_فهرس_حزم(فهرس، اسم، إصدار، تجزئة، ملف، صواب) == ٠.
    }
    إذا (مؤقت != عدم) {
        احذف_شجرة(مؤقت).
        حرر_نص(مؤقت).
    }
    إذا (صالح) {
        اطبع_منسق("[معلومة] حُزّمت %ن %ن (%ص ملفات): %ن\س"، اسم، إصدار، طول_متجه(مسارات)، أرشيف).
        اطبع_منسق("sha256 %ن\س"، تجزئة).
        إذا (فهرس != عدم) {
            إذا (تسجيل == ١) { اطبع_منسق("[ملاحظة] %ن %ن مسجل مسبقا في الفهرس بالتجزئة نفسها.\س"، اسم، إصدار). }
            وإلا { اطبع_منسق("[معلومة] سُجل في الفهرس: %ن\س"، فهرس). }
        }
        وإلا { اطبع_منسق("%ن\ت%ن\ت%ن\ت%ن\س"، اسم، إصدار، تجزئة، أرشيف). }
    }
    إذا (تجزئة != عدم) { حرر_نص(تجزئة). }
    إذا (أرشيف != عدم) { حرر_نص(أرشيف). }
    إذا (ملف != عدم) { حرر_نص(ملف). }
    إذا (مجلد != عدم) { حرر_نص(مجلد). }
    حرر_وسائط(مسارات).
    إذا (!صالح) { إرجع كود_تكوين_خطأ_عام. }
    إرجع كود_تكوين_نجاح.
}

صحيح تنفيذ_حزم(صحيح عدد، نص[] معاملات) {
    إذا (عدد == ٢) { إرجع نفذ_حزم(عدم). }
    إذا (عدد == ٤ && وسيط_فهرس_حزمة(معاملات[٢]) && طول_نص(معاملات[٣]) > ٠) {
        إذا (مسار_فيه_أصل(معاملات[٣])) {
            اطبع "[خطأ] مسار الفهرس لا يقبل ..؛ استخدم مسارا مطلقا أو نسبيا داخل المجلد الحالي.".
            إرجع كود_تكوين_خطأ_استخدام.
        }
        إرجع نفذ_حزم(معاملات[٣]).
    }
    اطبع "[خطأ] استخدم: تكوين حزّم [--فهرس <ملف>]".
    إرجع كود_تكوين_خطأ_استخدام.
}
