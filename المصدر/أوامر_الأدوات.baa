#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسق(نص تنسيق_ثابت، ...).
عدم حرر_وسائط(متجه وسائط).
نص هرب_جسون_خطة(نص قيمة).
منطقي يساوي_أمر(نص قيمة، نص عربي، نص انجليزي).
منطقي وسيط_جسون(نص قيمة).
منطقي وسيط_ملف_أحداث(نص قيمة).
عدم افتح_قفل_الطقوم(نص مخزن).
منطقي جهز_بيئة(نص اسم).
عدم حرر_بيئة().
نص جذر_الأدوات().
نص اسم_البيئة().
نص جذر_البيئة().
منطقي بيئة_موجودة().
منطقي اقفل_الأدوات().
منطقي أنشئ_بيئة_مقفلة().
منطقي استعد_بيئة().
منطقي حمل_قاعدة().
عدم امسح_قاعدة().
صحيح عدد_حزم_قاعدة().
منطقي حدث_فهرس_بيئات(منطقي إضافة).
منطقي اقرأ_فهرس_بيئات(متجه أسماء).
نص عنصر_نصي(متجه أسطر، صحيح فهرس).
صحيح ثبت_أداة(نص أرشيف، نص تجزئة_مطلوبة).
صحيح احذف_أداة(نص اسم).
صحيح اعرض_الأدوات(منطقي جسون).
صحيح اعرض_مالك(نص مدخل، منطقي جسون).

// أوامر أداة وبيئة فوق مخزن الأدوات وبيئاتها (أدوات_البيئات.baa).

#تعريف البيئة_الافتراضية "افتراضية"

// ---------------------------------------------------------------------------
// أوامر البيئات
// ---------------------------------------------------------------------------

صحيح أنشئ_بيئة() {
    إذا (!اقفل_الأدوات()) { إرجع كود_تكوين_خطأ_عام. }
    منطقي موجودة = بيئة_موجودة().
    منطقي صالح = أنشئ_بيئة_مقفلة().
    افتح_قفل_الطقوم(جذر_الأدوات()).
    إذا (!صالح) { إرجع كود_تكوين_خطأ_عام. }
    إذا (موجودة) { اطبع_منسق("[تم] البيئة %ن موجودة مسبقا: %ن\س"، اسم_البيئة()، جذر_البيئة()). }
    وإلا { اطبع_منسق("[تم] أُنشئت البيئة %ن: %ن\س"، اسم_البيئة()، جذر_البيئة()). }
    إرجع كود_تكوين_نجاح.
}

// تُحذف البادئة كلها، ومعها أي ملف لا تملكه أداة. ترفض بيئة فيها أدوات.
صحيح احذف_بيئة_مقفلة() {
    إذا (!بيئة_موجودة()) {
        اطبع_منسق("[خطأ] البيئة %ن غير موجودة.\س"، اسم_البيئة()).
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (!استعد_بيئة() || !حمل_قاعدة()) { إرجع كود_تكوين_خطأ_عام. }
    صحيح حزم = عدد_حزم_قاعدة().
    إذا (حزم > ٠) {
        اطبع_منسق("[خطأ] في البيئة %ن %ص أداة مثبتة؛ احذفها أولا.\س"، اسم_البيئة()، حزم).
        إرجع كود_تكوين_خطأ_عام.
    }
    // إعادة التسمية تخرج البيئة من مكانها ذريا قبل حذف ملفاتها.
    نص محذوفة = ضم_مسار(جذر_الأدوات()، ".بيئة-محذوفة").
    منطقي صالح = محذوفة != عدم && احذف_شجرة(محذوفة) == ٠ &&
                  انقل_مسار(جذر_البيئة()، محذوفة) == ٠.
    إذا (!صالح) { اطبع_منسق("[خطأ] تعذر حذف البيئة: %ن\س"، جذر_البيئة()). }
    صالح = صالح && حدث_فهرس_بيئات(خطأ).
    إذا (صالح) {
        احذف_شجرة(محذوفة).
        اطبع_منسق("[تم] حُذفت البيئة %ن.\س"، اسم_البيئة()).
    }
    إذا (محذوفة != عدم) { حرر_نص(محذوفة). }
    إذا (!صالح) { إرجع كود_تكوين_خطأ_عام. }
    إرجع كود_تكوين_نجاح.
}

صحيح احذف_بيئة() {
    إذا (!اقفل_الأدوات()) { إرجع كود_تكوين_خطأ_عام. }
    صحيح كود = احذف_بيئة_مقفلة().
    امسح_قاعدة().
    افتح_قفل_الطقوم(جذر_الأدوات()).
    إرجع كود.
}

صحيح اعرض_مسار_بيئة() {
    إذا (!بيئة_موجودة()) {
        اطبع_منسق("[خطأ] البيئة %ن غير موجودة.\س"، اسم_البيئة()).
        إرجع كود_تكوين_خطأ_عام.
    }
    اطبع جذر_البيئة().
    إرجع كود_تكوين_نجاح.
}

صحيح اعرض_البيئات(منطقي جسون) {
    نص جذر_أدوات = نسخ_نص(جذر_الأدوات()).
    متجه أسماء = أنشئ_متجه(حجم(نص)).
    إذا (جذر_أدوات == عدم || أسماء == عدم || !اقرأ_فهرس_بيئات(أسماء)) {
        إذا (جذر_أدوات != عدم) { حرر_نص(جذر_أدوات). }
        إذا (أسماء != عدم) { حرر_وسائط(أسماء). }
        إرجع كود_تكوين_خطأ_عام.
    }
    إذا (جسون) {
        نص جذر_آمن = هرب_جسون_خطة(جذر_أدوات).
        اطبع "{".
        اطبع "  \"schema_version\": \"takween-env-list-v1\",".
        اطبع_منسق("  \"tools_root\": \"%ن\",\س"، جذر_آمن).
        اطبع "  \"environments\": [".
        إذا (جذر_آمن != عدم) { حرر_نص(جذر_آمن). }
    }
    صحيح كود = كود_تكوين_نجاح.
    صحيح معروض = ٠.
    نص سابق = عدم.
    صحيح م = ٠.
    طالما (م < طول_متجه(أسماء)) {
        نص اسم = عنصر_نصي(أسماء، م).
        // اسم بلا قاعدة بقية إنشاء أو حذف انقطع؛ لا يُعرض.
        إذا (جهز_بيئة(اسم) && بيئة_موجودة()) {
            إذا (!حمل_قاعدة()) { كود = كود_تكوين_خطأ_عام. توقف. }
            صحيح حزم = عدد_حزم_قاعدة().
            إذا (جسون) {
                إذا (سابق != عدم) { اطبع_منسق("%ن,\س"، سابق). حرر_نص(سابق). }
                نص جذر_آمن = هرب_جسون_خطة(جذر_البيئة()).
                سابق = نسق("    {\"name\": \"%ن\", \"path\": \"%ن\", \"tools\": %ص}"، اسم، جذر_آمن، حزم).
                إذا (جذر_آمن != عدم) { حرر_نص(جذر_آمن). }
            }
            وإلا { اطبع_منسق("%ن\ت%ص\ت%ن\س"، اسم، حزم، جذر_البيئة()). }
            معروض = معروض + ١.
            امسح_قاعدة().
        }
        م = م + ١.
    }
    إذا (كود == كود_تكوين_نجاح && جسون) {
        إذا (سابق != عدم) { اطبع سابق. حرر_نص(سابق). }
        اطبع "  ]".
        اطبع "}".
    }
    وإلا إذا (كود == كود_تكوين_نجاح && معروض == ٠) {
        اطبع_منسق("لا توجد بيئات أدوات في %ن\س"، جذر_أدوات).
    }
    امسح_قاعدة().
    حرر_نص(جذر_أدوات).
    حرر_وسائط(أسماء).
    إرجع كود.
}

// ---------------------------------------------------------------------------
// الأوامر
// ---------------------------------------------------------------------------

نص بيئة_خيار.
نص تجزئة_خيار.
نص أحداث_خيار.
نص موضعي_خيار.
منطقي جسون_خيار = خطأ.

// يحلل ما بعد الأمر الفرعي. القيم مستعارة من المعاملات.
منطقي حلل_خيارات_أداة(صحيح عدد، نص[] معاملات) {
    بيئة_خيار = عدم.
    تجزئة_خيار = عدم.
    أحداث_خيار = عدم.
    موضعي_خيار = عدم.
    جسون_خيار = خطأ.
    صحيح م = ٣.
    طالما (م < عدد) {
        نص وسيط = معاملات[م].
        منطقي بقيمة = قارن_نص(وسيط، "--بيئة") == ٠ || قارن_نص(وسيط، "--env") == ٠ ||
                       قارن_نص(وسيط، "--تجزئة") == ٠ || قارن_نص(وسيط، "--sha256") == ٠ ||
                       وسيط_ملف_أحداث(وسيط).
        إذا (بقيمة && م + ١ >= عدد) { إرجع خطأ. }
        إذا (قارن_نص(وسيط، "--بيئة") == ٠ || قارن_نص(وسيط، "--env") == ٠) {
            إذا (بيئة_خيار != عدم) { إرجع خطأ. }
            م = م + ١.
            بيئة_خيار = معاملات[م].
        }
        وإلا إذا (قارن_نص(وسيط، "--تجزئة") == ٠ || قارن_نص(وسيط، "--sha256") == ٠) {
            إذا (تجزئة_خيار != عدم) { إرجع خطأ. }
            م = م + ١.
            تجزئة_خيار = معاملات[م].
        }
        وإلا إذا (وسيط_ملف_أحداث(وسيط)) {
            إذا (أحداث_خيار != عدم) { إرجع خطأ. }
            م = م + ١.
            أحداث_خيار = معاملات[م].
        }
        وإلا إذا (وسيط_جسون(وسيط)) {
            إذا (جسون_خيار) { إرجع خطأ. }
            جسون_خيار = صواب.
        }
        وإلا {
            إذا (موضعي_خيار != عدم) { إرجع خطأ. }
            موضعي_خيار = وسيط.
        }
        م = م + ١.
    }
    إرجع صواب.
}

// يجهز البيئة المسماة بـ--بيئة، أو الافتراضية.
صحيح جهز_بيئة_خيار(نص قيمة) {
    نص اسم = عدم.
    إذا (قيمة == عدم) { اسم = نسخ_نص(البيئة_الافتراضية). }
    وإلا { اسم = هوية_من_الطرفية(قيمة، خطأ). }
    إذا (اسم == عدم) {
        اطبع_منسق("[خطأ] اسم بيئة غير صالح: %ن\س"، قيمة).
        اطبع "[ملاحظة] اسم البيئة حروف عربية وأرقام و_ فقط.".
        إرجع كود_تكوين_خطأ_استخدام.
    }
    منطقي صالح = جهز_بيئة(اسم).
    حرر_نص(اسم).
    إذا (!صالح) { إرجع كود_تكوين_خطأ_عام. }
    إرجع كود_تكوين_نجاح.
}

عدم اطبع_استخدام_أداة() {
    اطبع "[خطأ] استخدم: تكوين أداة ثبت <أرشيف> [--بيئة اسم] [--تجزئة sha256] [--ملف_أحداث مسار]".
    اطبع "               تكوين أداة احذف <اسم> [--بيئة اسم] [--ملف_أحداث مسار]".
    اطبع "               تكوين أداة قائمة [--بيئة اسم] [--جسون]".
    اطبع "               تكوين أداة مالك <مسار> [--بيئة اسم] [--جسون]".
}

صحيح نفذ_عملية_أداة(نص عملية، نص قيمة) {
    إذا (أحداث_خيار != عدم && !اضبط_ملف_أحداث(أحداث_خيار)) {
        اطبع "[خطأ] تعذر فتح ملف الأحداث.".
        إرجع كود_تكوين_فشل_أداة.
    }
    ابدأ_أحداث_عملية(عملية).
    صحيح كود = كود_تكوين_نجاح.
    إذا (قارن_نص(عملية، "tool_install") == ٠) { كود = ثبت_أداة(قيمة، تجزئة_خيار). }
    وإلا { كود = احذف_أداة(قيمة). }
    انه_أحداث_عملية(كود).
    إرجع كود.
}

صحيح تنفيذ_أداة(صحيح عدد، نص[] معاملات) {
    إذا (عدد < ٣) {
        اطبع_استخدام_أداة().
        إرجع كود_تكوين_خطأ_استخدام.
    }
    نص فرعي = هوية_قياسية(معاملات[٢]).
    إذا (فرعي == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    منطقي ثبت = يساوي_أمر(فرعي، "ثبت"، "install") || قارن_نص(فرعي، "ثبّت") == ٠.
    منطقي احذف = يساوي_أمر(فرعي، "احذف"، "remove").
    منطقي قائمة = يساوي_أمر(فرعي، "قائمة"، "list").
    منطقي مالك = يساوي_أمر(فرعي، "مالك"، "owner").
    حرر_نص(فرعي).
    إذا (!ثبت && !احذف && !قائمة && !مالك) {
        اطبع_منسق("[خطأ] أمر أداة غير معروف: %ن\س"، معاملات[٢]).
        اطبع_استخدام_أداة().
        إرجع كود_تكوين_خطأ_استخدام.
    }
    منطقي صالح = حلل_خيارات_أداة(عدد، معاملات).
    إذا (ثبت) { صالح = صالح && موضعي_خيار != عدم && !جسون_خيار. }
    إذا (احذف) { صالح = صالح && موضعي_خيار != عدم && !جسون_خيار && تجزئة_خيار == عدم. }
    إذا (قائمة) { صالح = صالح && موضعي_خيار == عدم && تجزئة_خيار == عدم && أحداث_خيار == عدم. }
    إذا (مالك) { صالح = صالح && موضعي_خيار != عدم && تجزئة_خيار == عدم && أحداث_خيار == عدم. }
    إذا (!صالح) {
        اطبع_استخدام_أداة().
        إرجع كود_تكوين_خطأ_استخدام.
    }
    صحيح كود = جهز_بيئة_خيار(بيئة_خيار).
    إذا (كود != كود_تكوين_نجاح) { حرر_بيئة(). إرجع كود. }
    إذا (ثبت) { كود = نفذ_عملية_أداة("tool_install"، موضعي_خيار). }
    وإلا إذا (احذف) {
        نص اسم = هوية_من_الطرفية(موضعي_خيار، خطأ).
        إذا (اسم == عدم) {
            اطبع_منسق("[خطأ] اسم أداة غير صالح: %ن\س"، موضعي_خيار).
            كود = كود_تكوين_خطأ_استخدام.
        }
        وإلا {
            كود = نفذ_عملية_أداة("tool_remove"، اسم).
            حرر_نص(اسم).
        }
    }
    وإلا إذا (قائمة) { كود = اعرض_الأدوات(جسون_خيار). }
    وإلا { كود = اعرض_مالك(موضعي_خيار، جسون_خيار). }
    حرر_بيئة().
    إرجع كود.
}

عدم اطبع_استخدام_بيئة() {
    اطبع "[خطأ] استخدم: تكوين بيئة أنشئ|احذف <اسم>".
    اطبع "               تكوين بيئة مسار [اسم]".
    اطبع "               تكوين بيئة قائمة [--جسون]".
}

صحيح تنفيذ_بيئة(صحيح عدد، نص[] معاملات) {
    إذا (عدد < ٣) {
        اطبع_استخدام_بيئة().
        إرجع كود_تكوين_خطأ_استخدام.
    }
    نص فرعي = هوية_قياسية(معاملات[٢]).
    إذا (فرعي == عدم) { إرجع كود_تكوين_خطأ_داخلي. }
    منطقي أنشئ = يساوي_أمر(فرعي، "أنشئ"، "create").
    منطقي احذف = يساوي_أمر(فرعي، "احذف"، "remove").
    منطقي مسار = يساوي_أمر(فرعي، "مسار"، "path").
    منطقي قائمة = يساوي_أمر(فرعي، "قائمة"، "list").
    حرر_نص(فرعي).
    إذا (!أنشئ && !احذف && !مسار && !قائمة) {
        اطبع_منسق("[خطأ] أمر بيئة غير معروف: %ن\س"، معاملات[٢]).
        اطبع_استخدام_بيئة().
        إرجع كود_تكوين_خطأ_استخدام.
    }
    منطقي صالح = حلل_خيارات_أداة(عدد، معاملات) && بيئة_خيار == عدم &&
                  تجزئة_خيار == عدم && أحداث_خيار == عدم.
    إذا (أنشئ || احذف) { صالح = صالح && موضعي_خيار != عدم && !جسون_خيار. }
    إذا (مسار) { صالح = صالح && !جسون_خيار. }
    إذا (قائمة) { صالح = صالح && موضعي_خيار == عدم. }
    إذا (!صالح) {
        اطبع_استخدام_بيئة().
        إرجع كود_تكوين_خطأ_استخدام.
    }
    صحيح كود = جهز_بيئة_خيار(موضعي_خيار).
    إذا (كود != كود_تكوين_نجاح) { حرر_بيئة(). إرجع كود. }
    إذا (أنشئ) { كود = أنشئ_بيئة(). }
    وإلا إذا (احذف) { كود = احذف_بيئة(). }
    وإلا إذا (مسار) { كود = اعرض_مسار_بيئة(). }
    وإلا { كود = اعرض_البيئات(جسون_خيار). }
    حرر_بيئة().
    إرجع كود.
}
