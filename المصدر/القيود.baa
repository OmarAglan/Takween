#تضمين "baalib.baahd"
#تضمين "تكوين.baahd"

نص نسخ_مقطع(نص قيمة، صحيح بداية، صحيح نهاية).
نص احذف_تعليق_في1(نص سطر).
صحيح موضع_إسناد_في1(نص سطر).
نص قص_طرفين(نص قيمة).
نص حلل_نص_في1(نص خام).
منطقي يحتوي_على(نص النص، نص الجزء).

نص قيد_باء_البيان = "".
منطقي قيد_باء_مملوك = خطأ.

نص احصل_تكوين_اصدار_باء() {
    إرجع قيد_باء_البيان.
}

نص احصل_تكوين_قدرات_الهدف() {
    نص اختيار_المجمع = احصل_تكوين_المجمع().
    إذا ((اختيار_المجمع != عدم && قارن_نص(اختيار_المجمع، "نظم") == ٠) ||
        يحتوي_على(احصل_تكوين_الملفات()، ".نظم")) {
        إرجع "تجميع\سمصدر_نظم".
    }
    إرجع "تجميع".
}

منطقي حلل_قيود_ملف(نص مسار) {
    إذا (قيد_باء_مملوك) { حرر_نص(قيد_باء_البيان). }
    قيد_باء_البيان = "".
    قيد_باء_مملوك = خطأ.
    إذا (مسار == عدم) { إرجع صواب. }

    عدم* ملف = فتح_ملف(مسار، "قراءة").
    إذا (ملف == عدم) { إرجع خطأ. }
    منطقي داخل_المشروع = خطأ.
    منطقي صالح = صواب.
    طالما (صواب) {
        نص خام = اقرأ_سطر(ملف).
        إذا (خام == عدم) { توقف. }
        نص سطر = احذف_تعليق_في1(خام).
        حرر_نص(خام).
        إذا (سطر == عدم || طول_نص(سطر) == ٠) {
            إذا (سطر != عدم) { حرر_نص(سطر). }
            استمر.
        }
        إذا (سطر[٠] == '[') {
            داخل_المشروع = قارن_نص(سطر، "[المشروع]") == ٠.
            حرر_نص(سطر).
            استمر.
        }
        إذا (!داخل_المشروع) { حرر_نص(سطر). استمر. }
        صحيح موضع = موضع_إسناد_في1(سطر).
        إذا (موضع > ٠) {
            نص خام_مفتاح = نسخ_مقطع(سطر، ٠، موضع).
            نص مفتاح = قص_طرفين(خام_مفتاح).
            حرر_نص(خام_مفتاح).
            إذا (مفتاح != عدم && قارن_نص(مفتاح، "إصدار_باء") == ٠) {
                نص خام_قيمة = نسخ_مقطع(سطر، موضع + ١، طول_نص(سطر)).
                نص قيمة = حلل_نص_في1(خام_قيمة).
                إذا (خام_قيمة != عدم) { حرر_نص(خام_قيمة). }
                إذا (قيمة == عدم || قيد_باء_مملوك || !قيد_اصدار_دلالي_صالح(قيمة)) {
                    اطبع "[خطأ] إصدار_باء يجب أن يكون قيد Semantic Versioning صالحا وغير مكرر.".
                    إذا (قيمة != عدم) { حرر_نص(قيمة). }
                    صالح = خطأ.
                }
                وإلا {
                    قيد_باء_البيان = قيمة.
                    قيد_باء_مملوك = صواب.
                }
            }
            إذا (مفتاح != عدم) { حرر_نص(مفتاح). }
        }
        حرر_نص(سطر).
    }
    اغلق_ملف(ملف).
    إرجع صالح.
}
